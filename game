}

.build-ghost.valid {
border-color: #4f4;
background: rgba(68, 255, 68, 0.2);
}

/* ===== ELIMINATION POPUP ===== */
#elimination-popup {
position: absolute;
top: 50%;
left: 50%;
transform: translate(-50%, -50%) scale(0.8);
background: linear-gradient(180deg, rgba(20, 20, 30, 0.98) 0%, rgba(10, 10, 20, 0.98) 100%);
border: 2px solid #f90;
border-radius: 15px;
padding: 2rem 3rem;
text-align: center;
z-index: 60;
