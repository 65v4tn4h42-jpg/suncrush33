    const W2 = textCanvas.width, H2 = textCanvas.height;
    const face = new Uint8Array(W2 * H2);
    for (let i = 0; i < W2 * H2; i++) face[i] = td.data[i * 4 + 3] ? 1 : 0;
    c.fillStyle = '#7c2d12';
    for (let y = 0; y < H2; y++) for (let x = 0; x < W2; x++) if (face[y * W2 + x]) { c.fillRect(x + 1, y + 1, 1, 1); c.fillRect(x + 2, y + 2, 1, 1); c.fillRect(x + 1, y + 2, 1, 1); }
    c.fillStyle = '#2a0c04';
    for (let y = 0; y < H2; y++) for (let x = 0; x < W2; x++) {
        if (face[y * W2 + x]) continue;
        const n = (x > 0 && face[y * W2 + x - 1]) || (x < W2 - 1 && face[y * W2 + x + 1]) || (y > 0 && face[(y - 1) * W2 + x]) || (y < H2 - 1 && face[(y + 1) * W2 + x]);
        if (n) c.fillRect(x, y, 1, 1);
    }
    c.drawImage(textCanvas, 0, 0);
    // top-edge highlight pixels on each letter
    c.fillStyle = '#ffffff';
    for (let y = 1; y < H2; y++) for (let x = 0; x < W2; x++) if (face[y * W2 + x] && !face[(y - 1) * W2 + x] && (x + y) % 3 === 0) c.fillRect(x, y, 1, 1);
    // --- compose: bloom behind, crisp pixels on top ---
    const glow = ctx.createRadialGradient(sx * PX, sy * PX, 20, sx * PX, sy * PX, 150);
    glow.addColorStop(0, 'rgba(255,200,90,0.45)'); glow.addColorStop(0.5, 'rgba(249,115,22,0.16)'); glow.addColorStop(1, 'rgba(249,115,22,0)');
    ctx.fillStyle = glow; ctx.fillRect(0, 0, CW, CH);
    ctx.imageSmoothingEnabled = false;
    ctx.drawImage(low, 0, 0, low.width * PX, low.height * PX);
    // twinkles
    ctx.fillStyle = 'rgba(255,255,255,0.9)';
    for (const [x, y] of [[40, 30], [560, 52], [88, 170], [520, 180], [300, 8]]) { ctx.fillRect(x, y - 3, 1, 7); ctx.fillRect(x - 3, y, 7, 1); }
}

