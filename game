// ---- geometry helpers ----
function isBuildingEntity(e) { return !!e && Array.isArray(e.trainingQueue); }
function entityRadius(e) {
    if (!e) return 8;
    if (isBuildingEntity(e)) return e.size / 2;
    const r = (UNIT_RADIUS_RACE[e.race] && UNIT_RADIUS_RACE[e.race][e.type]) || UNIT_RADIUS[e.type];
