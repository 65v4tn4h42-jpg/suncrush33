            if (!u.isFlying && !src.canAttackGround) continue;
            const d = Math.hypot(u.x - target.x, u.y - target.y);
            if (d < bestD) { bestD = d; best = u; }
        }
        if (best) {
            gameState.projectiles.push({
                x: target.x, y: target.y, targetX: best.x, targetY: best.y, target: best, source: src,
                damage: proj.damage, dmgMult: (proj.dmgMult || 1) * COMBAT_V33.glaiveFalloff,
                bounces: left - 1, hitIds: hit, speed: WEAPON_SPEED.glaive, isPlayerSource: src.isPlayer,
                color: proj.color, race: src.race, fx: 'glaive', z: target.isFlying ? COMBAT.flyingUnitElevation : 6
            });
        }
    }
}

