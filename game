        ctx.beginPath(); ctx.moveTo((b.x - viewX) * sx, (b.y - viewY) * sy); ctx.lineTo((b.rallyPoint.x - viewX) * sx, (b.rallyPoint.y - viewY) * sy); ctx.stroke();
    }
