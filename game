    });
    
    // Touch events for minimap
    minimap.addEventListener('touchstart', handleMinimapTouchStart, { passive: false });
    minimap.addEventListener('touchmove', handleMinimapTouchMove, { passive: false });
    minimap.addEventListener('touchend', handleMinimapTouchEnd, { passive: false });
}

// Minimap zoom button
const minimapZoomBtn = document.getElementById('minimap-zoom-btn');
if (minimapZoomBtn) {
    minimapZoomBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        gameState.minimapZoomed = !gameState.minimapZoomed;
        minimapZoomBtn.classList.toggle('active', gameState.minimapZoomed);
        renderMinimap();
    });
}

// Speed slider
const speedSlider = document.getElementById('speed-slider');
if (speedSlider) {
    speedSlider.addEventListener('input', (e) => {
        gameState.gameSpeed = parseFloat(e.target.value);
        document.getElementById('speed-value').textContent = gameState.gameSpeed.toFixed(2) + 'x';
    });
}

}

// === MOUSE HANDLERS ===
function handleMouseDown(e) {
if (gameState.phase !== 'playing') return;

const worldPos = screenToWorld(e.clientX, e.clientY);

if (e.button === 2) {
    // v33: right-click cancels a pending targeting order (BW)
    if (gameState.attackMoveMode || gameState.patrolMode || gameState.moveMode || gameState.abilityMode || gameState.phaseMode || gameState.buildMode) {
        cancelPendingOrders();
        return;
    }
    // Right click - issue command if units selected, otherwise pan
    if (gameState.selectedUnits.length > 0 &&
        gameState.selectedUnits.some(u => u.isPlayer)) {
        issueCommand(worldPos.x, worldPos.y);
        return;
    }
    // v33: right-click with your production structure selected sets its rally point (BW)
    const selB = gameState.selectedBuilding;
    if (selB && selB.isPlayer && selB.produces && selB.produces.length) {
        selB.rallyPoint = { x: worldPos.x, y: worldPos.y };
        gameState.rallyMode = false;
        spawnClickParticle(worldPos.x, worldPos.y, '#4f4');
        SoundSystem.play('move');
        return;
    }
    // No player units selected, pan instead
    gameState.isPanning = true;
    gameState.dragStart = { x: e.clientX, y: e.clientY };
    return;
}

// Left click
if (gameState.buildMode) {
    tryPlaceBuilding(worldPos.x, worldPos.y);
    return;
}

// Check for rally mode
if (gameState.rallyMode) {
    // Will be handled by handleClick
}

gameState.isDragging = true;
gameState.dragStart = { x: e.clientX, y: e.clientY };
gameState.dragEnd = { x: e.clientX, y: e.clientY };
gameState.touchStartTime = Date.now();
gameState.isCommandDrag = false;  // Explicitly reset

// Check if starting drag from selected unit (command drag)
// ONLY trigger if clicking DIRECTLY on a selected player unit (tight radius)
if (gameState.selectedUnits.length > 0 && gameState.selectedUnits.some(u => u.isPlayer)) {
    const worldPos = screenToWorld(e.clientX, e.clientY);
    for (const unit of gameState.selectedUnits) {
        if (!unit.isPlayer) continue;
        // Use world distance with tight radius - must click directly on unit
        const unitRadius = unit.size ? unit.size / 2 : 15;
        const clickDist = distance(worldPos.x, worldPos.y, unit.x, unit.y);
        if (clickDist < unitRadius + 10) {  // Small buffer around unit
            gameState.isCommandDrag = true;
            showDragIndicator('Drag to move/attack');
            return;
        }
    }
}

}

function handleMouseMove(e) {
if (gameState.phase !== 'playing') return;

// Update build ghost position
if (gameState.buildMode) {
    const worldPos = screenToWorld(e.clientX, e.clientY);
    updateBuildGhost(worldPos.x, worldPos.y);
}

// Panning
if (gameState.isPanning) {
    const dx = e.clientX - gameState.dragStart.x;
    const dy = e.clientY - gameState.dragStart.y;
    
    gameState.camera.x -= dx / gameState.camera.zoom;
    gameState.camera.y -= dy / gameState.camera.zoom;
    clampCamera();
    
    gameState.dragStart = { x: e.clientX, y: e.clientY };
    return;
}

// Selection/command drag
if (gameState.isDragging) {
    gameState.dragEnd = { x: e.clientX, y: e.clientY };
}

}

function handleMouseUp(e) {
if (gameState.phase !== 'playing') return;

if (gameState.isPanning) {
    gameState.isPanning = false;
    return;
}

if (gameState.isDragging) {
    const dragDist = distance(
        gameState.dragStart.x, gameState.dragStart.y,
        gameState.dragEnd.x, gameState.dragEnd.y
    );
    
    if (gameState.isCommandDrag && dragDist > 20) {
        const worldPos = screenToWorld(gameState.dragEnd.x, gameState.dragEnd.y);
        issueCommand(worldPos.x, worldPos.y);
    } else if (dragDist > 10) {
        handleBoxSelection();
    } else {
        const worldPos = screenToWorld(e.clientX, e.clientY);
        handleClick(worldPos.x, worldPos.y);
    }
    
    gameState.isDragging = false;
    gameState.isCommandDrag = false;
    hideDragIndicator();
}

}

function handleWheel(e) {
if (gameState.phase !== 'playing') return;
e.preventDefault();

const zoomFactor = e.deltaY > 0 ? 0.9 : 1.1;
const newZoom = gameState.camera.zoom * zoomFactor;
// v33: zoom about the cursor
const before = screenToWorld(e.clientX, e.clientY);

gameState.camera.zoom = Math.max(
    gameState.camera.minZoom,
    Math.min(gameState.camera.maxZoom, newZoom)
);
const after = screenToWorld(e.clientX, e.clientY);
gameState.camera.x += before.x - after.x;
gameState.camera.y += before.y - after.y;

clampCamera();

}

// === TOUCH CONTROL CONSTANTS ===
const TOUCH_CONFIG = {
    tapThreshold: 200,          // ms - faster than this = tap/quick drag (selection)
    panDelayThreshold: 200,     // ms - hold longer than this before drag = pan mode
    dragDistanceMin: 15,        // px - minimum distance to count as drag
    commandDragDist: 20,        // px - minimum distance for command drag
    selectionDragMin: 15,       // px - minimum for selection box
    longPressTime: 400          // ms - long press for move command
};

// === TOUCH HANDLERS ===
function handleTouchStart(e) {
if (gameState.phase !== 'playing') return;
e.preventDefault();

const touches = e.touches;

// Two-finger gesture: pinch zoom + pan
if (touches.length === 2) {
    // Cancel any single-finger drag in progress
    gameState.isDragging = false;
    gameState.isSingleFingerPan = false;
    gameState.isSelectionDrag = false;
    
    gameState.lastPinchDist = distance(
        touches[0].clientX, touches[0].clientY,
        touches[1].clientX, touches[1].clientY
    );
    gameState.isPanning = true;
    gameState.dragStart = {
        x: (touches[0].clientX + touches[1].clientX) / 2,
        y: (touches[0].clientY + touches[1].clientY) / 2
    };
    return;
}

const touch = touches[0];
const worldPos = screenToWorld(touch.clientX, touch.clientY);

// Build mode - place building on tap
if (gameState.buildMode) {
    tryPlaceBuilding(worldPos.x, worldPos.y);
    return;
}

// Initialize touch tracking
gameState.isDragging = true;
gameState.dragStart = { x: touch.clientX, y: touch.clientY };
gameState.dragEnd = { x: touch.clientX, y: touch.clientY };
gameState.touchStartTime = Date.now();
gameState.touchModeDecided = false;     // Haven't decided pan vs select yet
gameState.isSingleFingerPan = false;    // Will be set if delayed drag
gameState.isSelectionDrag = false;      // Will be set if quick drag
gameState.isCommandDrag = false;

// Check if starting drag on a selected unit (command drag)
// Use world coordinates with slightly larger touch radius for mobile
if (gameState.selectedUnits.length > 0 && gameState.selectedUnits.some(u => u.isPlayer)) {
    for (const unit of gameState.selectedUnits) {
        if (!unit.isPlayer) continue;
        // Use world distance - must touch directly on unit (with touch-friendly buffer)
        const unitRadius = unit.size ? unit.size / 2 : 15;
        const touchWorldPos = screenToWorld(touch.clientX, touch.clientY);
        const touchDist = distance(touchWorldPos.x, touchWorldPos.y, unit.x, unit.y);
        if (touchDist < unitRadius + 20) {  // Slightly larger buffer for touch
            gameState.isCommandDrag = true;
            gameState.touchModeDecided = true;
            showDragIndicator('Drag to command');
            return;
        }
    }
}

}

function handleTouchMove(e) {
if (gameState.phase !== 'playing') return;
e.preventDefault();

const touches = e.touches;

// Two-finger gesture: pinch zoom + pan
if (touches.length === 2) {
    const newDist = distance(
        touches[0].clientX, touches[0].clientY,
        touches[1].clientX, touches[1].clientY
    );
    
    if (gameState.lastPinchDist > 0) {
        const scale = newDist / gameState.lastPinchDist;
        gameState.camera.zoom = Math.max(
            gameState.camera.minZoom,
            Math.min(gameState.camera.maxZoom, gameState.camera.zoom * scale)
        );
    }
    
    gameState.lastPinchDist = newDist;
    
    const centerX = (touches[0].clientX + touches[1].clientX) / 2;
    const centerY = (touches[0].clientY + touches[1].clientY) / 2;
    
    if (gameState.isPanning) {
        const dx = centerX - gameState.dragStart.x;
        const dy = centerY - gameState.dragStart.y;
        
        gameState.camera.x -= dx / gameState.camera.zoom;
        gameState.camera.y -= dy / gameState.camera.zoom;
        clampCamera();
    }
    
    gameState.dragStart = { x: centerX, y: centerY };
    return;
}

// Single finger drag
if (gameState.isDragging && touches.length === 1) {
    const touch = touches[0];
    gameState.dragEnd = { x: touch.clientX, y: touch.clientY };
    
    const dragDist = distance(
        gameState.dragStart.x, gameState.dragStart.y,
        gameState.dragEnd.x, gameState.dragEnd.y
    );
    const touchDuration = Date.now() - gameState.touchStartTime;
    
    // Build mode ghost update
    if (gameState.buildMode) {
        const worldPos = screenToWorld(touch.clientX, touch.clientY);
        updateBuildGhost(worldPos.x, worldPos.y);
        return;
    }
    
    // Command drag - already decided
    if (gameState.isCommandDrag) {
        return;
    }
    
    // Decide touch mode if not yet decided and moved enough
    if (!gameState.touchModeDecided && dragDist > TOUCH_CONFIG.dragDistanceMin) {
        if (touchDuration < TOUCH_CONFIG.tapThreshold) {
            // Quick drag = selection box
            gameState.isSelectionDrag = true;
            gameState.touchModeDecided = true;
        } else if (touchDuration >= TOUCH_CONFIG.panDelayThreshold) {
            // Delayed drag = camera pan
            gameState.isSingleFingerPan = true;
            gameState.touchModeDecided = true;
        }
    }
    
    // If still undecided but time threshold passed, default to pan
    if (!gameState.touchModeDecided && touchDuration >= TOUCH_CONFIG.panDelayThreshold && dragDist > 5) {
        gameState.isSingleFingerPan = true;
        gameState.touchModeDecided = true;
    }
    
    // Execute single-finger pan
    if (gameState.isSingleFingerPan) {
        const dx = touch.clientX - gameState.dragStart.x;
        const dy = touch.clientY - gameState.dragStart.y;
        
        gameState.camera.x -= dx / gameState.camera.zoom;
        gameState.camera.y -= dy / gameState.camera.zoom;
        clampCamera();
        
        gameState.dragStart = { x: touch.clientX, y: touch.clientY };
    }
}

}

function handleTouchEnd(e) {
if (gameState.phase !== 'playing') return;
e.preventDefault();

gameState.isPanning = false;
gameState.lastPinchDist = 0;

if (gameState.isDragging) {
    const dragDist = distance(
        gameState.dragStart.x, gameState.dragStart.y,
        gameState.dragEnd.x, gameState.dragEnd.y
    );
    const touchDuration = Date.now() - gameState.touchStartTime;
    
    // Command drag - move selected units to drag endpoint
    if (gameState.isCommandDrag && dragDist > TOUCH_CONFIG.commandDragDist) {
        const worldPos = screenToWorld(gameState.dragEnd.x, gameState.dragEnd.y);
        issueCommand(worldPos.x, worldPos.y);
    }
    // Selection box drag
    else if (gameState.isSelectionDrag && dragDist > TOUCH_CONFIG.selectionDragMin) {
        handleBoxSelection();
    }
    // Single-finger pan was happening - no action on release
    else if (gameState.isSingleFingerPan) {
        // Pan already applied in move handler, nothing to do
    }
    // Long press with units selected = move command
    else if (touchDuration > TOUCH_CONFIG.longPressTime && 
             gameState.selectedUnits.length > 0 && 
             gameState.selectedUnits.some(u => u.isPlayer) &&
             dragDist < TOUCH_CONFIG.dragDistanceMin) {
        const worldPos = screenToWorld(gameState.dragStart.x, gameState.dragStart.y);
        issueCommand(worldPos.x, worldPos.y);
        addMessage('Move command issued', '#4af');
    }
    // Quick tap - select unit/building
    else if (dragDist < TOUCH_CONFIG.dragDistanceMin) {
        const worldPos = screenToWorld(gameState.dragStart.x, gameState.dragStart.y);
        handleClick(worldPos.x, worldPos.y);
    }
    // Undecided short drag that wasn't fast enough for selection - treat as tap
    else if (!gameState.touchModeDecided && dragDist < 30) {
        const worldPos = screenToWorld(gameState.dragStart.x, gameState.dragStart.y);
        handleClick(worldPos.x, worldPos.y);
    }
    
    // Reset all touch state
    gameState.isDragging = false;
    gameState.isCommandDrag = false;
    gameState.isSingleFingerPan = false;
    gameState.isSelectionDrag = false;
    gameState.touchModeDecided = false;
    hideDragIndicator();
}

}

// === KEYBOARD HANDLER ===
function handleKeyDown(e) {
// ignore typing in form controls
const tag = e.target && e.target.tagName;
if (tag === 'INPUT' || tag === 'SELECT' || tag === 'TEXTAREA') return;

// Handle pause toggle even when paused (P or Escape when paused)
if (e.key.toUpperCase() === 'P' || (e.key === 'Escape' && gameState.paused)) {
    if (gameState.phase === 'playing') {
        togglePause();
        return;
    }
}

if (gameState.paused) return;
if (gameState.phase !== 'playing') return;

// v33: arrow-key scrolling (StarCraft)
if (e.key.startsWith('Arrow')) {
    KEYS_DOWN.add(e.key);
    e.preventDefault();
    return;
}

const key = e.key.toUpperCase();

if (e.key === 'Escape') {
    if (gameState.buildMode) {
        gameState.buildMode = null;
        addMessage('Building cancelled', '#888');
    } else if (gameState.rallyMode) {
        gameState.rallyMode = false;
        addMessage('Rally point cancelled', '#888');
    } else if (gameState.phaseMode) {
        gameState.phaseMode = false;
        addMessage('Phase cancelled', '#888');
    } else if (gameState.abilityMode) {
        gameState.abilityMode = null;
        addMessage('Ability cancelled', '#888');
    } else if (gameState.attackMoveMode || gameState.patrolMode || gameState.moveMode) {
        gameState.attackMoveMode = false; gameState.patrolMode = false; gameState.moveMode = false;
        addMessage('Order cancelled', '#888');
    } else if (gameState.commandMenu !== MENU.MAIN) {
        gameState.commandMenu = MENU.MAIN;
    } else {
        togglePause();
    }
    updateCommandCard();
    return;
}

// Control groups: Ctrl+N assign, Shift+N add to group (BW), N select (twice to centre)
const num = parseInt(e.key);
if (num >= 1 && num <= 9) {
    if (e.ctrlKey || e.metaKey) {
        e.preventDefault();
        assignControlGroup(num, false);
        return;
    }
    if (e.shiftKey) {
        assignControlGroup(num, true);
        return;
    }
    if (!e.altKey) {
        recallControlGroup(num);
        return;
    }
}

// BW aliases on the main card: A attack, S stop, H hold, M move (P stays pause)
if (gameState.commandMenu === MENU.MAIN && playerSelection().length && !e.ctrlKey && !e.metaKey && !e.altKey) {
    if (key === 'A') { if (playerSelection().some(u => u.damage > 0)) beginOrder('attack'); return; }
    if (key === 'S') { stopSelected(); return; }
    if (key === 'H') { holdSelected(); return; }
    if (key === 'M') { beginOrder('move'); return; }
}

handleHotkey(key);

}

// === CONTROL GROUP FUNCTIONS ===
// v33: groups can hold a structure (BW), Shift+N adds to a group, and a double-tap centres
function assignControlGroup(groupNum, add) {
    const playerUnits = gameState.selectedUnits.filter(u => u.isPlayer);
    if (playerUnits.length === 0) {
        const b = gameState.selectedBuilding;
        if (b && b.isPlayer && !add) {
            gameState.controlGroups[groupNum] = [b.id];
            addMessage(`Group ${groupNum}: ${RACES[b.race].buildings[b.type].name}`, '#4af');
            return;
        }
        addMessage('Select units first!', '#fa4');
        return;
    }
    let ids = playerUnits.map(u => u.id);
    if (add) {
        const prev = (gameState.controlGroups[groupNum] || []).filter(id => gameState.units.some(u => u.id === id));
        ids = [...new Set([...prev, ...ids])];
    }
    gameState.controlGroups[groupNum] = ids;
    addMessage(`Group ${groupNum}: ${ids.length} unit${ids.length > 1 ? 's' : ''}${add ? ' (added)' : ' assigned'}`, '#4af');
}

function recallControlGroup(groupNum) {
    const ids = gameState.controlGroups[groupNum];
    if (!ids || ids.length === 0) return;

    const now = Date.now();
    const doubleTap = gameState._lastGroupKey === groupNum && now - (gameState._lastGroupT || 0) < 350;
    gameState._lastGroupKey = groupNum;
    gameState._lastGroupT = now;

    const units = gameState.units.filter(u => ids.includes(u.id) && u.hp > 0);
    let cx, cy;
    if (units.length > 0) {
        gameState.controlGroups[groupNum] = units.map(u => u.id);
        gameState.selectedUnits = [...units];
        gameState.selectedBuilding = null;
        cx = units.reduce((s, u) => s + u.x, 0) / units.length;
        cy = units.reduce((s, u) => s + u.y, 0) / units.length;
    } else {
        const b = gameState.buildings.find(bb => ids.includes(bb.id) && bb.hp > 0);
        if (!b) { gameState.controlGroups[groupNum] = []; return; }
        gameState.selectedUnits = [];
        gameState.selectedBuilding = b;
        cx = b.x; cy = b.y;
    }
    gameState.commandMenu = MENU.MAIN;

    if (doubleTap) {
        gameState.camera.x = cx - (VIEW.w / gameState.camera.zoom) / 2;
        gameState.camera.y = cy - (VIEW.h / gameState.camera.zoom) / 2;
        clampCamera();
    }
    SoundSystem.play('select');
    updateSelectionPanel();
    updateCommandCard();
}

// v33: a hotkey fires only the first matching enabled button
function handleHotkey(key) {
    const buttons = document.querySelectorAll('.cmd-button');
    for (const btn of buttons) {
        const hotkey = btn.dataset.hotkey;
        if (hotkey && hotkey.toUpperCase() === key && !btn.classList.contains('disabled') && !btn.classList.contains('empty')) {
            btn.click();
            return;
        }
    }
}

// === MINIMAP HANDLERS ===
let minimapTouchStart = null;
let minimapLongPressTimer = null;

function handleMinimapClick(e) {
const minimap = document.getElementById('minimap-canvas');
const rect = minimap.getBoundingClientRect();

const clickX = e.clientX - rect.left;
const clickY = e.clientY - rect.top;

// Calculate world position based on current minimap view
const worldPos = minimapToWorld(clickX, clickY, rect.width, rect.height);
const worldX = worldPos.x;
const worldY = worldPos.y;

// Rally mode - set rally point on minimap click
if (gameState.rallyMode && gameState.selectedBuilding) {
    gameState.selectedBuilding.rallyPoint = { x: worldX, y: worldY };
    gameState.rallyMode = false;
    addMessage('Rally point set via minimap!', '#4f4');
    return;
}

// v33: a pending attack / patrol / move order can target the minimap (BW)
if ((gameState.attackMoveMode || gameState.patrolMode || gameState.moveMode) && gameState.selectedUnits.some(u => u.isPlayer)) {
    handleClick(worldX, worldY);
    return;
}

// If units are selected and shift is held OR right-click, move units there
if (gameState.selectedUnits.length > 0 && 
    gameState.selectedUnits.some(u => u.isPlayer)) {
    // Check if this is a right-click or shift+click for movement
    if (e.shiftKey || e.button === 2) {
        // Move selected player units to this location
        issueCommand(worldX, worldY);
        addMessage('Moving to minimap location', '#4af');
        return;
    }
}

// Default behavior: pan camera to location
const canvas = document.getElementById('game-canvas');
gameState.camera.x = worldX - (VIEW.w / gameState.camera.zoom) / 2;
gameState.camera.y = worldY - (VIEW.h / gameState.camera.zoom) / 2;
clampCamera();

}

// Helper function to convert minimap coordinates to world coordinates
function minimapToWorld(clickX, clickY, mmWidth, mmHeight) {
    let viewX, viewY, viewW, viewH;
    
    if (gameState.minimapZoomed) {
        // Zoomed out - entire map
        viewX = 0;
        viewY = 0;
        viewW = MAP_WIDTH;
        viewH = MAP_HEIGHT;
    } else {
        // Normal view - centered on camera
        const canvas = document.getElementById('game-canvas');
        const camW = VIEW.w / gameState.camera.zoom;
        const camH = VIEW.h / gameState.camera.zoom;
        
        viewW = Math.min(MAP_WIDTH, camW * 3);
        viewH = Math.min(MAP_HEIGHT, camH * 3);
        viewX = Math.max(0, Math.min(MAP_WIDTH - viewW, gameState.camera.x + camW/2 - viewW/2));
        viewY = Math.max(0, Math.min(MAP_HEIGHT - viewH, gameState.camera.y + camH/2 - viewH/2));
    }
    
    return {
        x: viewX + (clickX / mmWidth) * viewW,
        y: viewY + (clickY / mmHeight) * viewH
    };
}

function handleMinimapDrag(e) {
if (e.buttons !== 1) return;
// Only pan camera on drag, not move units
const minimap = document.getElementById('minimap-canvas');
const rect = minimap.getBoundingClientRect();

const clickX = e.clientX - rect.left;
const clickY = e.clientY - rect.top;

const worldPos = minimapToWorld(clickX, clickY, rect.width, rect.height);

const canvas = document.getElementById('game-canvas');
gameState.camera.x = worldPos.x - (VIEW.w / gameState.camera.zoom) / 2;
gameState.camera.y = worldPos.y - (VIEW.h / gameState.camera.zoom) / 2;
clampCamera();
}

// === MINIMAP TOUCH HANDLERS (for mobile) ===
function handleMinimapTouchStart(e) {
    e.preventDefault();
    e.stopPropagation();
    
    const touch = e.touches[0];
    const minimap = document.getElementById('minimap-canvas');
    const rect = minimap.getBoundingClientRect();
    
    const clickX = touch.clientX - rect.left;
    const clickY = touch.clientY - rect.top;
    
    const worldPos = minimapToWorld(clickX, clickY, rect.width, rect.height);
    
    minimapTouchStart = {
        x: clickX,
        y: clickY,
        worldX: worldPos.x,
        worldY: worldPos.y,
        time: Date.now()
    };
    
    // Long press timer for move command on minimap
    minimapLongPressTimer = setTimeout(() => {
        if (minimapTouchStart && gameState.selectedUnits.length > 0 &&
            gameState.selectedUnits.some(u => u.isPlayer)) {
            issueCommand(worldPos.x, worldPos.y);
            addMessage('Moving to minimap location', '#4af');
            minimapTouchStart = null;
        }
    }, 500);
}

function handleMinimapTouchMove(e) {
    e.preventDefault();
    e.stopPropagation();
    
    // Cancel long press if finger moves
    if (minimapLongPressTimer) {
        clearTimeout(minimapLongPressTimer);
        minimapLongPressTimer = null;
    }
    
    const touch = e.touches[0];
    const minimap = document.getElementById('minimap-canvas');
    const rect = minimap.getBoundingClientRect();
    
    const clickX = touch.clientX - rect.left;
    const clickY = touch.clientY - rect.top;
    
    const worldPos = minimapToWorld(clickX, clickY, rect.width, rect.height);
    
    // Pan camera as finger drags
    const canvas = document.getElementById('game-canvas');
    gameState.camera.x = worldPos.x - (VIEW.w / gameState.camera.zoom) / 2;
    gameState.camera.y = worldPos.y - (VIEW.h / gameState.camera.zoom) / 2;
    clampCamera();
}

function handleMinimapTouchEnd(e) {
    e.preventDefault();
    e.stopPropagation();
    
    // Cancel long press timer
    if (minimapLongPressTimer) {
        clearTimeout(minimapLongPressTimer);
        minimapLongPressTimer = null;
    }
    
    if (!minimapTouchStart) return;
    
    const touchDuration = Date.now() - minimapTouchStart.time;
    const worldX = minimapTouchStart.worldX;
    const worldY = minimapTouchStart.worldY;
    
    // Short tap = set rally point (if in rally mode) or pan camera
    if (touchDuration < 300) {
        // Rally mode - set rally point on minimap tap
        if (gameState.rallyMode && gameState.selectedBuilding) {
            gameState.selectedBuilding.rallyPoint = { x: worldX, y: worldY };
            gameState.rallyMode = false;
            addMessage('Rally point set via minimap!', '#4f4');
        } else {
            // Pan camera to tap location
            const canvas = document.getElementById('game-canvas');
            gameState.camera.x = worldX - (VIEW.w / gameState.camera.zoom) / 2;
            gameState.camera.y = worldY - (VIEW.h / gameState.camera.zoom) / 2;
            clampCamera();
        }
    }
    
    minimapTouchStart = null;
}

// === CLICK SELECTION ===
function handleClick(worldX, worldY) {
// Check for rally mode first
if (gameState.rallyMode && gameState.selectedBuilding) {
    gameState.selectedBuilding.rallyPoint = { x: worldX, y: worldY };
    gameState.rallyMode = false;
    addMessage('Rally point set!', '#4f4');
    spawnClickParticle(worldX, worldY, '#4f4');
    return;
}

// Check for phase mode (Ascended Colossus teleport)
if (gameState.phaseMode && gameState.selectedUnits.length > 0) {
    const unit = gameState.selectedUnits[0];
    if (unit.isPlayer && executePhase(unit, worldX, worldY)) {
        gameState.phaseMode = false;
        updateCommandCard();
        return;
    }
    gameState.phaseMode = false;
    return;
}

// Check for ability targeting mode
if (gameState.abilityMode) {
    const { abilityId, unit } = gameState.abilityMode;
    const ability = ABILITIES[abilityId];
    
    if (ability) {
        // Check range
        const dist = distance(unit.x, unit.y, worldX, worldY);
        const maxRange = ability.range * TILE_SIZE;
        
        if (dist <= maxRange) {
            // Find target if unit-targeted
            let target = null;
            if (ability.targetType === 'enemy_unit') {
                target = findUnitAt(worldX, worldY, gameState.enemyUnits);
                if (!target) {
                    addMessage('Must target an enemy unit!', '#fa4');
                    gameState.abilityMode = null;
                    return;
                }
            } else if (ability.targetType === 'friendly_unit') {
                target = findUnitAt(worldX, worldY, gameState.units);
                if (!target) {
                    addMessage('Must target a friendly unit!', '#fa4');
                    gameState.abilityMode = null;
                    return;
                }
            }
            
            useAbility(abilityId, unit, worldX, worldY, target);
            spawnClickParticle(worldX, worldY, '#a6f');
        } else {
            addMessage('Target out of range!', '#fa4');
        }
    }
    
    gameState.abilityMode = null;
    updateCommandCard();
    return;
}

// Check for attack-move mode
// v33: A-click an enemy to attack it, A-click ground to attack-move (BW). Sieged / burrowed units
// only retarget; hold and patrol are replaced.
if (gameState.attackMoveMode && gameState.selectedUnits.length > 0) {
    const playerUnits = gameState.selectedUnits.filter(u => u.isPlayer && u.damage > 0);
    const clicked = findUnitAt(worldX, worldY, gameState.enemyUnits);
    const visibleUnit = clicked && isVisible(clicked.x, clicked.y) && (!clicked.burrowed || isDetected(clicked, true)) ? clicked : null;
    const target = visibleUnit || findBuildingAt(worldX, worldY, gameState.enemyBuildings);
    if (playerUnits.length > 0) {
        const formationPositions = calculateFormationPositions(playerUnits, worldX, worldY);
        for (let i = 0; i < playerUnits.length; i++) {
            const unit = playerUnits[i];
            unit.holdPosition = false;
            unit.patrol = null;
            const canHit = target && (target.isFlying ? unit.canAttackAir : unit.canAttackGround);
            if (canHit && targetableBy(unit, target)) {
                unit.target = target;
                unit.attackMoveTarget = null;
                unit.state = UNIT_STATE.ATTACKING;
                continue;
            }
            if (unit.siegeMode || unit.burrowed) continue;
            const formPos = formationPositions[i];
            unit.attackMoveTarget = { x: formPos.x, y: formPos.y };
            unit.targetX = formPos.x;
            unit.targetY = formPos.y;
            unit.state = UNIT_STATE.MOVING;
            unit.target = null;
        }
    }
    gameState.attackMoveMode = false;
    SoundSystem.play('attack');
    addMessage(target ? 'Attacking!' : 'Attack-move issued', '#f88');
    spawnClickParticle(worldX, worldY, '#f88');
    updateCommandCard();
    return;
}

// v33: Patrol (BW) — walk between here and the clicked point, engaging anything on the way
if (gameState.patrolMode && gameState.selectedUnits.length > 0) {
    const playerUnits = gameState.selectedUnits.filter(u => u.isPlayer && !u.siegeMode && !u.burrowed && u.speed > 0);
    const formationPositions = calculateFormationPositions(playerUnits, worldX, worldY);
    for (let i = 0; i < playerUnits.length; i++) {
        const unit = playerUnits[i];
        const b = formationPositions[i];
        unit.patrol = { a: { x: unit.x, y: unit.y }, b: { x: b.x, y: b.y }, toB: true };
        unit.holdPosition = false;
        unit.target = null;
        unit.attackMoveTarget = (unit.type !== 'worker' && unit.damage > 0) ? { x: b.x, y: b.y } : null;
        unit.targetX = b.x;
        unit.targetY = b.y;
        unit.state = UNIT_STATE.MOVING;
        if (unit.type === 'worker') { unit.gatherTarget = null; unit.returnTarget = null; unit.buildTarget = null; }
    }
    gameState.patrolMode = false;
    SoundSystem.play('move');
    addMessage('Patrolling', '#7dd3fc');
    spawnClickParticle(worldX, worldY, '#7dd3fc');
    updateCommandCard();
    return;
}

// v33: Move order (Q / M, then click) — same as a right-click
if (gameState.moveMode && gameState.selectedUnits.length > 0) {
    gameState.moveMode = false;
    issueCommand(worldX, worldY);
    updateCommandCard();
    return;
}

const now = Date.now();
const timeSinceLastClick = now - gameState.lastClickTime;
const distFromLastClick = distance(worldX, worldY, gameState.lastClickPos.x, gameState.lastClickPos.y);
const isDoubleClick = timeSinceLastClick < gameState.doubleClickThreshold && distFromLastClick < 50;

gameState.lastClickTime = now;
gameState.lastClickPos = { x: worldX, y: worldY };

gameState.selectedUnits = [];
gameState.selectedBuilding = null;
gameState.commandMenu = MENU.MAIN;

const playerUnit = findUnitAt(worldX, worldY, gameState.units);
if (playerUnit) {
    if (isDoubleClick) {
        // Double-click: select all units of same type visible on screen
        const canvas = document.getElementById('game-canvas');
        const viewLeft = gameState.camera.x;
        const viewTop = gameState.camera.y;
        const viewRight = viewLeft + VIEW.w / gameState.camera.zoom;
        const viewBottom = viewTop + VIEW.h / gameState.camera.zoom;
        
        gameState.selectedUnits = gameState.units.filter(u => 
            u.type === playerUnit.type &&
            u.x >= viewLeft && u.x <= viewRight &&
            u.y >= viewTop && u.y <= viewBottom
        );
        addMessage(`Selected ${gameState.selectedUnits.length} ${playerUnit.type}s`, '#4af');
    } else {
        gameState.selectedUnits = [playerUnit];
    }
    SoundSystem.play('select');
    updateCommandCard();
    updateSelectionPanel();
    return;
}

const playerBuilding = findBuildingAt(worldX, worldY, gameState.buildings);
if (playerBuilding) {
    gameState.selectedUnits = [];  // Clear unit selection when selecting building
    gameState.selectedBuilding = playerBuilding;
    SoundSystem.play('select');
    updateCommandCard();
    updateSelectionPanel();
    return;
}

const enemyUnit = findUnitAt(worldX, worldY, gameState.enemyUnits);
if (enemyUnit) {
    if (isDoubleClick) {
        // Double-click: select all visible enemy units of same type (for info only)
        const canvas = document.getElementById('game-canvas');
        const viewLeft = gameState.camera.x;
        const viewTop = gameState.camera.y;
        const viewRight = viewLeft + VIEW.w / gameState.camera.zoom;
        const viewBottom = viewTop + VIEW.h / gameState.camera.zoom;
        
        gameState.selectedUnits = gameState.enemyUnits.filter(u => 
            u.type === enemyUnit.type &&
            u.x >= viewLeft && u.x <= viewRight &&
            u.y >= viewTop && u.y <= viewBottom &&
            isVisible(u.x, u.y)
        );
    } else {
        gameState.selectedUnits = [enemyUnit];
    }
    updateCommandCard();
    updateSelectionPanel();
    return;
}

const enemyBuilding = findBuildingAt(worldX, worldY, gameState.enemyBuildings);
if (enemyBuilding) {
    gameState.selectedBuilding = enemyBuilding;
    updateCommandCard();
    updateSelectionPanel();
    return;
}

updateCommandCard();
updateSelectionPanel();

}

// === BOX SELECTION ===
function handleBoxSelection() {
const start = screenToWorld(gameState.dragStart.x, gameState.dragStart.y);
const end = screenToWorld(gameState.dragEnd.x, gameState.dragEnd.y);

const minX = Math.min(start.x, end.x);
const maxX = Math.max(start.x, end.x);
const minY = Math.min(start.y, end.y);
const maxY = Math.max(start.y, end.y);

// Add a small buffer to the selection box for better unit capture
const buffer = 10;

gameState.selectedUnits = gameState.units.filter(unit => {
    // Get unit's effective radius for selection
    const unitRadius = unit.size ? unit.size / 2 : 15;
    
    // Check if any part of the unit overlaps with selection box
    const unitLeft = unit.x - unitRadius;
    const unitRight = unit.x + unitRadius;
    const unitTop = unit.y - unitRadius;
    const unitBottom = unit.y + unitRadius;
    
    // Box intersection check with buffer
    return unitRight >= (minX - buffer) && 
           unitLeft <= (maxX + buffer) &&
           unitBottom >= (minY - buffer) && 
           unitTop <= (maxY + buffer);
});

gameState.selectedBuilding = null;
gameState.commandMenu = MENU.MAIN;

if (gameState.selectedUnits.length > 0) {
    addMessage(`Selected ${gameState.selectedUnits.length} unit(s)`, '#4af');
}

updateCommandCard();
updateSelectionPanel();

}

// === ISSUE COMMAND ===
function issueCommand(targetX, targetY) {
if (gameState.selectedUnits.length === 0) return;

const playerUnits = gameState.selectedUnits.filter(u => u.isPlayer);
if (playerUnits.length === 0) return;

const rawEnemyUnit = findUnitAt(targetX, targetY, gameState.enemyUnits);
// v33: hidden (fogged, or burrowed and undetected) units can't be clicked on
const enemyUnit = rawEnemyUnit && isVisible(rawEnemyUnit.x, rawEnemyUnit.y) && (!rawEnemyUnit.burrowed || isDetected(rawEnemyUnit, true)) ? rawEnemyUnit : null;
const enemyBuilding = findBuildingAt(targetX, targetY, gameState.enemyBuildings);
const ownBuilding = findBuildingAt(targetX, targetY, gameState.buildings);
const resource = findResourceAt(targetX, targetY);
const attackTarget = enemyUnit || enemyBuilding;

// Calculate formation positions for movement commands
const formationPositions = calculateFormationPositions(playerUnits, targetX, targetY);
let attacked = false;

for (let i = 0; i < playerUnits.length; i++) {
    const unit = playerUnits[i];
    unit.target = null;
    // v33: a new order replaces hold / patrol / attack-move (BW)
    unit.holdPosition = false;
    unit.patrol = null;
    unit.attackMoveTarget = null;
    if (unit.type === 'worker') unit.buildTarget = null;

    const canHit = attackTarget && unit.damage > 0 && (attackTarget.isFlying ? unit.canAttackAir : unit.canAttackGround);

    // Sieged tanks and burrowed units can't move: they only accept a new target
    if (unit.siegeMode || unit.burrowed) {
        if (canHit && targetableBy(unit, attackTarget)) { unit.target = attackTarget; unit.state = UNIT_STATE.ATTACKING; attacked = true; }
        continue;
    }

    if (canHit) {
        unit.target = attackTarget;
        unit.state = UNIT_STATE.ATTACKING;
        unit.targetX = attackTarget.x;
        unit.targetY = attackTarget.y;
        attacked = true;
        // Workers keep their gatherTarget and resume after combat
    } else if (unit.type === 'worker' && ownBuilding && ownBuilding.isConstructing && ownBuilding.race === 'coalition') {
        // v33: BW — right-click an unfinished Terran structure to resume building it
        unit.buildTarget = ownBuilding;
        unit.targetX = ownBuilding.x;
        unit.targetY = ownBuilding.y + ownBuilding.size / 2 + 14;
        unit.state = UNIT_STATE.MOVING;
    } else if (resource && unit.type === 'worker') {
        unit.gatherTarget = resource;
        unit.state = UNIT_STATE.GATHERING;
        unit.targetX = resource.x;
        unit.targetY = resource.y;
        unit.returnTarget = findNearestBase(unit.x, unit.y, true);
    } else if (unit.type === 'worker' && unit.carryAmount > 0 && ownBuilding && ownBuilding.type === 'base' && !ownBuilding.isConstructing) {
        // v33: right-click your base while carrying to return the cargo (BW)
        unit.returnTarget = ownBuilding;
        unit.state = UNIT_STATE.RETURNING;
    } else {
        // Movement command - use formation position
        const formPos = formationPositions[i];
        unit.targetX = formPos.x;
        unit.targetY = formPos.y;
        unit.state = UNIT_STATE.MOVING;
        if (unit.type === 'worker') {
            unit.gatherTarget = null;
            unit.returnTarget = null;
            // v33 fix: keep carryingResource — v32 cleared it, so the load was lost on the next return
        }
    }
}

spawnClickParticle(targetX, targetY, attacked ? '#f44' : '#4f4');

if (attacked) {
    SoundSystem.play('attack');
    addMessage('Attacking!', '#f44');
} else if (resource) {
    SoundSystem.play('move');
    addMessage('Gathering resources', '#4af');
} else {
    SoundSystem.play('move');
}

}

// === CALCULATE FORMATION POSITIONS ===
// Creates a grid formation centered on target point, facing toward units' average position
function calculateFormationPositions(units, targetX, targetY) {
    if (units.length === 0) return [];
    if (units.length === 1) return [{ x: targetX, y: targetY }];
    
    // Calculate average unit position (formation will face this direction)
    let avgX = 0, avgY = 0;
    for (const unit of units) {
        avgX += unit.x;
        avgY += unit.y;
    }
    avgX /= units.length;
    avgY /= units.length;
    
    // Calculate direction from target to units (formation faces this way)
    const dx = avgX - targetX;
    const dy = avgY - targetY;
    const dist = Math.sqrt(dx * dx + dy * dy);
    
    // Normalize direction (if units are on target, default to facing up)
    let dirX = 0, dirY = -1;
    if (dist > 10) {
        dirX = dx / dist;
        dirY = dy / dist;
    }
    
    // Perpendicular direction for row spreading
    const perpX = -dirY;
    const perpY = dirX;
    
    // Formation spacing
    const spacing = 35;  // Distance between units
    
    // Calculate grid dimensions - prefer wider formations (more columns than rows)
    const numUnits = units.length;
    let cols = Math.ceil(Math.sqrt(numUnits * 1.5));  // Wider than square
    let rows = Math.ceil(numUnits / cols);
    
    // Generate positions in a grid centered on target
    const positions = [];
    let unitIndex = 0;
    
    for (let row = 0; row < rows && unitIndex < numUnits; row++) {
        // How many units in this row
        const unitsInRow = Math.min(cols, numUnits - unitIndex);
        // Center this row
        const rowOffset = (unitsInRow - 1) / 2;
        
        for (let col = 0; col < unitsInRow && unitIndex < numUnits; col++) {
            // Position offset from center
            const colOffset = col - rowOffset;
            
            // Calculate world position
            // Row goes backward (away from units), columns spread perpendicular
            const posX = targetX + 
                         dirX * row * spacing +           // Rows go toward units
                         perpX * colOffset * spacing;     // Columns spread sideways
            const posY = targetY + 
                         dirY * row * spacing + 
                         perpY * colOffset * spacing;
            
            positions.push({ x: posX, y: posY });
            unitIndex++;
        }
    }
    
    // Sort units by distance to formation positions and assign greedily
    // This prevents units from crossing paths as much
    const assignments = assignUnitsToPositions(units, positions);
    
    return assignments;
}

// Greedy assignment: each unit gets closest available position
function assignUnitsToPositions(units, positions) {
    const result = new Array(units.length);
    const usedPositions = new Set();
    
    // Sort units by their index for consistent ordering
    const unitIndices = units.map((_, i) => i);
    
    // For each unit, find closest unused position
    for (const unitIdx of unitIndices) {
        const unit = units[unitIdx];
        let bestPos = null;
        let bestDist = Infinity;
        let bestPosIdx = -1;
        
        for (let p = 0; p < positions.length; p++) {
            if (usedPositions.has(p)) continue;
            const pos = positions[p];
            const d = distance(unit.x, unit.y, pos.x, pos.y);
            if (d < bestDist) {
                bestDist = d;
                bestPos = pos;
                bestPosIdx = p;
            }
        }
        
        if (bestPos) {
            result[unitIdx] = bestPos;
            usedPositions.add(bestPosIdx);
        } else {
            // Fallback - shouldn't happen
            result[unitIdx] = positions[unitIdx % positions.length];
        }
    }
    
    return result;
}

// === FIND NEAREST BASE ===
function findNearestBase(x, y, isPlayer) {
const buildings = isPlayer ? gameState.buildings : gameState.enemyBuildings;
let nearest = null;
let nearestDist = Infinity;

for (const b of buildings) {
    if (b.type === 'base') {
        const d = distance(x, y, b.x, b.y);
        if (d < nearestDist) {
            nearestDist = d;
            nearest = b;
        }
    }
}

return nearest;

}

// === BUILD GHOST ===
function updateBuildGhost(worldX, worldY) {
// Snap to build grid for cleaner placement (v33: refineries snap onto the nearest geyser)
const gas = gameState.buildMode === 'refinery' ? nearestFreeGeyser(worldX, worldY, 100) : null;
const snapped = gas ? { x: gas.x, y: gas.y } : snapToBuildGrid(worldX, worldY);
gameState.buildGhost.x = snapped.x;
gameState.buildGhost.y = snapped.y;
gameState.buildGhost.valid = canPlaceBuilding(snapped.x, snapped.y, gameState.buildMode);
}

// === VIEWPORT CULLING HELPER ===
function isOnScreen(x, y, margin = 100) {
    const cam = gameState.camera;
    const viewLeft = cam.x - margin;
    const viewTop = cam.y - margin;
    const viewRight = cam.x + VIEW.w / cam.zoom + margin;
    const viewBottom = cam.y + VIEW.h / cam.zoom + margin;
    return x >= viewLeft && x <= viewRight && y >= viewTop && y <= viewBottom;
}

// === AI BUILDING PLACEMENT CHECK (race-parameterized) ===
function canPlaceBuildingForRace(x, y, buildingType, race) {
    if (!buildingType || !race) return false;
    const raceData = RACES[race];
    if (!raceData) return false;
    const buildingData = raceData.buildings[buildingType];
    if (!buildingData) return false;
    const halfSize = buildingData.size / 2;
    
    if (x - halfSize < 0 || x + halfSize > MAP_WIDTH ||
        y - halfSize < 0 || y + halfSize > MAP_HEIGHT) return false;
    
    const allBuildings = [...gameState.buildings, ...gameState.enemyBuildings];
    for (const b of allBuildings) {
        const bHalf = b.size / 2;
        if (Math.abs(x - b.x) < halfSize + bHalf + 10 &&
            Math.abs(y - b.y) < halfSize + bHalf + 10) return false;
    }
    
    if (buildingType === 'refinery') {
        let foundValidGas = false;
        for (const res of gameState.resources) {
            if (res.type === 'gas' && !res.hasRefinery && distance(x, y, res.x, res.y) < 80) {
                foundValidGas = true;
                break;
            }
        }
        if (!foundValidGas) return false;
        for (const res of gameState.resources) {
            if (res.type === 'mineral' && distance(x, y, res.x, res.y) < halfSize + 25) return false;
        }
        return true;
    }
    
    for (const res of gameState.resources) {
        const resourceRadius = res.type === 'gas' ? 60 : 40;
        if (distance(x, y, res.x, res.y) < halfSize + resourceRadius) return false;
    }
    
    const centerTerrain = getTerrainAt(x, y);
    const corners = [
        { x: x - halfSize + 5, y: y - halfSize + 5 },
        { x: x + halfSize - 5, y: y - halfSize + 5 },
        { x: x - halfSize + 5, y: y + halfSize - 5 },
        { x: x + halfSize - 5, y: y + halfSize - 5 }
    ];
    for (const corner of corners) {
        const ct = getTerrainAt(corner.x, corner.y);
        if (ct !== centerTerrain && ct !== TERRAIN.RAMP && centerTerrain !== TERRAIN.RAMP) return false;
    }
    return true;
}

function canPlaceBuilding(x, y, buildingType) {
if (!buildingType) return false;

const raceData = RACES[gameState.selectedRace];
const buildingData = raceData.buildings[buildingType];
const halfSize = buildingData.size / 2;

// v33: a refinery is tested where it will actually stand — on the geyser it snaps to
if (buildingType === 'refinery') {
    const gas = nearestFreeGeyser(x, y, 80);
    if (!gas) return false;
    x = gas.x; y = gas.y;
}

if (x - halfSize < 0 || x + halfSize > MAP_WIDTH ||
    y - halfSize < 0 || y + halfSize > MAP_HEIGHT) {
    return false;
}

const allBuildings = [...gameState.buildings, ...gameState.enemyBuildings];
for (const b of allBuildings) {
    const bHalf = b.size / 2;
    if (Math.abs(x - b.x) < halfSize + bHalf + 10 &&
        Math.abs(y - b.y) < halfSize + bHalf + 10) {
        return false;
    }
}

// Special handling for refinery - must be ON a gas geyser
if (buildingType === 'refinery') {
    let foundValidGas = false;
    let nearestGasDistance = Infinity;
    for (const res of gameState.resources) {
        if (res.type === 'gas' && !res.hasRefinery) {
            const gasDistance = distance(x, y, res.x, res.y);
            if (gasDistance < nearestGasDistance) {
                nearestGasDistance = gasDistance;
            }
            if (gasDistance < 80) {  // Increased snap range from 60 to 80
                foundValidGas = true;
                break;
            }
        }
    }
    if (!foundValidGas) return false;
    
    // Also ensure not overlapping minerals
    for (const res of gameState.resources) {
        if (res.type === 'mineral') {
            if (distance(x, y, res.x, res.y) < halfSize + 25) {
                return false;  // Too close to minerals
            }
        }
    }
    return true;
}

// For non-refinery buildings, check collision with ALL resources
// Use larger buffer zone to prevent blocking resource access
for (const res of gameState.resources) {
    const resourceRadius = res.type === 'gas' ? 60 : 40;  // Larger protection zone
    if (distance(x, y, res.x, res.y) < halfSize + resourceRadius) {
        return false;
    }
}

// Check terrain - don't allow building on cliffs or mixed terrain
const centerTerrain = getTerrainAt(x, y);
const corners = [
    { x: x - halfSize + 5, y: y - halfSize + 5 },
    { x: x + halfSize - 5, y: y - halfSize + 5 },
    { x: x - halfSize + 5, y: y + halfSize - 5 },
    { x: x + halfSize - 5, y: y + halfSize - 5 }
];

for (const corner of corners) {
    const cornerTerrain = getTerrainAt(corner.x, corner.y);
    if (cornerTerrain !== centerTerrain && cornerTerrain !== TERRAIN.RAMP && centerTerrain !== TERRAIN.RAMP) {
        return false;  // Building would span terrain levels
    }
}

// v33: BW — every Empyeran structure except Caldera, Pylon and Magma Tap needs Pylon power
if (buildingData.requiresPower && gameState.selectedRace === 'ascended' && !isPositionPowered(x, y, true)) {
    return false;
}

return true;

}

// === BUILDING GRID CONSTANTS ===
const BUILD_GRID_SIZE = TILE_SIZE / 2;  // 4x finer grid (16px grid cells)

// === SNAP TO BUILD GRID ===
function snapToBuildGrid(x, y) {
    return {
        x: Math.round(x / BUILD_GRID_SIZE) * BUILD_GRID_SIZE,
        y: Math.round(y / BUILD_GRID_SIZE) * BUILD_GRID_SIZE
    };
}

// === PLACE BUILDING ===
function tryPlaceBuilding(worldX, worldY) {
if (!gameState.buildMode) return;

const buildingType = gameState.buildMode;
const raceData = RACES[gameState.selectedRace];
const buildingData = raceData.buildings[buildingType];

// Snap to build grid
const snapped = snapToBuildGrid(worldX, worldY);
worldX = snapped.x;
worldY = snapped.y;

if (!canPlaceBuilding(worldX, worldY, buildingType)) {
    const noPower = buildingData.requiresPower && gameState.selectedRace === 'ascended' && !isPositionPowered(worldX, worldY, true);
    addMessage(noPower ? 'Must be placed in a Pylon power field!' : 'Cannot build here!', '#f44');
    SoundSystem.play('error');
    return;
}

if (gameState.minerals < buildingData.cost.minerals ||
    gameState.gas < (buildingData.cost.gas || 0)) {
    addMessage(gameState.minerals < buildingData.cost.minerals ? 'Not enough minerals!' : 'Not enough gas!', '#f44');
    SoundSystem.play('error');
    return;
}

// v33: the selected worker builds (BW); otherwise the nearest one
let builder = gameState.selectedUnits.find(u => u.isPlayer && u.type === 'worker' && u.hp > 0) || null;
if (!builder) {
    const workers = gameState.units.filter(u => u.type === 'worker' && u.hp > 0);
    workers.sort((a, b) => distance(a.x, a.y, worldX, worldY) - distance(b.x, b.y, worldX, worldY));
    builder = workers[0] || null;
}
if (!builder) {
    addMessage('No worker available!', '#f44');
    SoundSystem.play('error');
    return;
}

gameState.minerals -= buildingData.cost.minerals;
gameState.gas -= buildingData.cost.gas || 0;

let placeX = worldX;
let placeY = worldY;

if (buildingType === 'refinery') {
    for (const res of gameState.resources) {
        if (res.type === 'gas' && !res.hasRefinery && distance(worldX, worldY, res.x, res.y) < 80) {
            placeX = res.x;
            placeY = res.y;
            res.hasRefinery = true;
            break;
        }
    }
}

const building = createBuilding(buildingType, gameState.selectedRace, placeX, placeY, true);
building.isConstructing = true;
building.hp = building.maxHp * 0.1;

gameState.buildings.push(building);
gameState.stats.buildingsBuilt++;

if (gameState.selectedRace === 'swarm') {
    // Terra Firma: the Drone becomes the structure (BW) — and its supply is freed (v32 leaked it)
    gameState.units = gameState.units.filter(u => u !== builder);
    gameState.supplyUsed = Math.max(0, gameState.supplyUsed - (builder.supply || 0));
    const si = gameState.selectedUnits.indexOf(builder);
    if (si !== -1) gameState.selectedUnits.splice(si, 1);
    addMessage('Drone morphing into structure...', '#4af');
} else if (gameState.selectedRace === 'coalition') {
    // Coalition: the SCV walks to the site and stays until the structure is finished
    builder.buildTarget = building;
    builder.target = null;
    builder.targetX = placeX;
    builder.targetY = placeY + building.size / 2 + 14;
    builder.state = UNIT_STATE.MOVING;
} else {
    // Empyeran: the Probe opens the warp and is immediately free
    addMessage('Warp-in initiated...', '#88f');
}

SoundSystem.play('build');

// v33: supply arrives when the structure completes (BW), not at placement
addMessage(`Building ${buildingData.name}...`, '#4af');

gameState.buildMode = null;
gameState.commandMenu = MENU.MAIN;
updateCommandCard();
updateHUD();

}

