    function build(theme, S, map, tx, ty, avoid) {
        tx = Math.ceil(tx); ty = Math.ceil(ty);     // medium maps are 67.5 tiles tall
        st = { theme, S, map, tx, ty };
        const withDetail = (extra) => Object.assign({}, theme, { detailKind: theme.detail }, extra || {});
        st.mega = { 0: makeMegatile(theme.low, S, 11, withDetail()), 1: makeMegatile(theme.high, S, 29, withDetail()), 2: makeMegatile(theme.ramp, S, 47, theme) };
        // transition patches (dirt paths, basalt crust, rust / grated deck)
        st.patchMega = {};
        if (theme.patchLow) st.patchMega[0] = makeMegatile(theme.patchLow, S, 61, withDetail({ plates: false, detailKind: theme.detail === 'grass' ? 'scuffs' : theme.detail }));
        if (theme.patchHigh) {
            st.patchMega[1] = makeMegatile(theme.patchHigh, S, 83, withDetail({ plates: !!theme.gratedHigh, detailKind: 'scuffs' }));
            if (theme.gratedHigh) gratePass(st.patchMega[1].getContext('2d'), st.patchMega[1].width, S);
        }
        st.patchTiles = new Map();
        st.wall = makeWall(theme, S);
        st.sideLit = makeSide(theme, S, true);
        st.sideDark = makeSide(theme, S, false);
        st.doodadSprites = makeDoodads(theme, S);
        // low-frequency tint map (1 px per tile), dirt worn around bases/resources
        const tint = document.createElement('canvas'); tint.width = tx; tint.height = ty;
        const tc = tint.getContext('2d'); const tid = tc.createImageData(tx, ty);
        const nA = makeNoise(64, 8, 5), nB = makeNoise(64, 5, 9);
        for (let y = 0; y < ty; y++) for (let x = 0; x < tx; x++) {
            const i = (y * tx + x) * 4;
            let wear = 0;
            for (const a of avoid) { const dx = (x + 0.5) * T - a.x, dy = (y + 0.5) * T - a.y; const dd = Math.sqrt(dx * dx + dy * dy); wear = Math.max(wear, 1 - dd / (a.r * 1.6)); }
            const na = nA(x * 1.7, y * 1.7), nb = nB(x * 1.3, y * 1.3);
            let col, alpha;
            if (wear > 0.1) { col = theme.tintA; alpha = Math.min(0.55, wear * 0.7); }
            else if (na > 0.62) { col = theme.tintC; alpha = (na - 0.62) * 0.9; }
            else if (nb < 0.35) { col = theme.tintB; alpha = (0.35 - nb) * 1.1; }
            else { col = [0, 0, 0]; alpha = 0; }
            tid.data[i] = col[0]; tid.data[i + 1] = col[1]; tid.data[i + 2] = col[2]; tid.data[i + 3] = Math.round(alpha * 255);
        }
        tc.putImageData(tid, 0, 0);
        st.tint = tint;
        // edge classification
        const at = (x, y) => (x < 0 || y < 0 || x >= tx || y >= ty) ? -1 : map[y][x];
        const isHi = (x, y) => { const v = at(x, y); return v === 1 || v === 2; };
        st.at = at; st.isHi = isHi;
        // transition field at tile corners: patches grow where noise is high and around bases
        // (worn ground), never on ramps. case = TL<<3 | TR<<2 | BR<<1 | BL (marching squares)
        const wearAt = (wx, wy) => { let w = 0; for (const a of avoid) { const dx = wx - a.x, dy = wy - a.y; w = Math.max(w, 1 - Math.sqrt(dx * dx + dy * dy) / (a.r * 1.5)); } return w; };
        const corner = [];
        for (let y = 0; y <= ty; y++) {
            corner[y] = new Uint8Array(tx + 1);
            for (let x = 0; x <= tx; x++) {
                const f = fbm(x * 0.13, y * 0.13, 404) + Math.max(0, wearAt(x * T, y * T)) * 0.45;
                corner[y][x] = f > 0.6 ? 1 : 0;
            }
        }
        st.patchCase = [];
        for (let y = 0; y < ty; y++) {
            st.patchCase[y] = new Uint8Array(tx);
            for (let x = 0; x < tx; x++) {
                const v = map[y][x];
                if (v === 2 || !st.patchMega[v]) continue;
                st.patchCase[y][x] = (corner[y][x] << 3) | (corner[y][x + 1] << 2) | (corner[y + 1][x + 1] << 1) | corner[y + 1][x];
            }
        }
        // doodads: clustered (dense groves / rubble fields, open ground between), themed per patch
        st.doodads = [];
        const nearAvoid = (wx, wy) => { for (const a of avoid) { const dx = wx - a.x, dy = wy - a.y; if (dx * dx + dy * dy < a.r * a.r) return true; } return false; };
        for (let y = 0; y < ty; y++) for (let x = 0; x < tx; x++) {
            const v = at(x, y);
            if (v === 2) continue;
            if (y + 1 < ty && isHi(x, y) !== isHi(x, y + 1)) continue;
            const cl = fbm(x * 0.21, y * 0.21, 505);
            const prob = 0.04 + Math.max(0, cl - 0.48) * 1.25;
            for (let k = 0; k < 2; k++) {
                if (hash(x, y, 77 + k * 5) > prob * (k ? 0.5 : 1)) continue;
                const wx = (x + 0.15 + hash(x, y, 78 + k) * 0.7) * T, wy = (y + 0.2 + hash(x, y, 79 + k) * 0.65) * T;
                if (nearAvoid(wx, wy)) continue;
                const onPatch = st.patchCase[y][x] === 15;
                const list = onPatch && theme.patchDoodads ? theme.patchDoodads : (v === 1 ? theme.highDoodads : theme.doodads);
                const kind = list[Math.floor(hash(x, y, 80 + k) * list.length)];
                if (!st.doodadSprites[kind]) continue;
                st.doodads.push({ x: wx, y: wy, spr: st.doodadSprites[kind][Math.floor(hash(x, y, 81 + k) * 3)], ty: y });
            }
        }
        // flat decals (puddles, craters, lava pools, grates, hazard paint ...)
        st.decalArt = makeDecals(theme, S);
        st.decals = [];
        if (theme.decals) for (let y = 1; y < ty - 1; y++) for (let x = 1; x < tx - 1; x++) {
            if (at(x, y) !== 0 || isHi(x, y - 1) || hash(x, y, 606) > 0.022) continue;
            const wx = (x + 0.5) * T, wy = (y + 0.5) * T;
            if (nearAvoid(wx, wy)) continue;
            const kind = theme.decals[Math.floor(hash(x, y, 607) * theme.decals.length)];
            const art = st.decalArt[kind];
            if (!art) continue;
            st.decals.push({ x: wx + (hash(x, y, 608) - 0.5) * 12, y: wy, art: art[Math.floor(hash(x, y, 609) * 3)], ty: y, tx: x });
        }
        st.decalRows = [];
        for (const dc of st.decals) (st.decalRows[dc.ty] = st.decalRows[dc.ty] || []).push(dc);
        st.doodadRows = [];
        for (const dd of st.doodads) { (st.doodadRows[dd.ty] = st.doodadRows[dd.ty] || []).push(dd); }
        // minimap base image (1px per tile)
        const mm = document.createElement('canvas'); mm.width = tx; mm.height = ty;
        const mc = mm.getContext('2d');
        for (let y = 0; y < ty; y++) for (let x = 0; x < tx; x++) {
            const v = at(x, y);
            const pc = st.patchCase[y][x];
            const base = v === 1 ? theme.high[3] : (v === 2 ? theme.ramp[3] : theme.low[3]);
            const nb = ((pc >> 3) & 1) + ((pc >> 2) & 1) + ((pc >> 1) & 1) + (pc & 1);
            mc.fillStyle = nb >= 3 && st.patchMega[v] ? (v === 1 ? theme.patchHigh[3] : theme.patchLow[3]) : base;
            mc.fillRect(x, y, 1, 1);
            if (v !== 1 && v !== 2 && isHi(x, y - 1)) { mc.fillStyle = theme.cliff[1]; mc.fillRect(x, y, 1, 1); }
        }
        mc.globalAlpha = 0.6; mc.drawImage(tint, 0, 0);
        st.minimap = mm;
        return st;
    }

    function drawTile(ctx, x, y) {
        const v = st.map[y][x];
        const tex = st.mega[v] || st.mega[0];
        const S = st.S;
        const sx = (x % MEGA) * T * S, sy = (y % MEGA) * T * S;
        ctx.drawImage(tex, sx, sy, T * S, T * S, x * T, y * T, T + 0.5, T + 0.5);
    }

    // world-space draw of the visible tile window
    function draw(ctx, x0, y0, x1, y1) {
        if (!st) return;
        const S = st.S, at = st.at, isHi = st.isHi;
        x0 = Math.max(0, x0); y0 = Math.max(0, y0); x1 = Math.min(st.tx - 1, x1); y1 = Math.min(st.ty - 1, y1);
        for (let y = y0; y <= y1; y++) for (let x = x0; x <= x1; x++) drawTile(ctx, x, y);
        // transition patches
        for (let y = y0; y <= y1; y++) for (let x = x0; x <= x1; x++) {
            const c = st.patchCase[y][x];
            if (!c) continue;
            const v = st.map[y][x];
            const sub = (y % MEGA) * MEGA + (x % MEGA);
            if (c === 15) {
                const src = st.patchMega[v];
                ctx.drawImage(src, (x % MEGA) * T * S, (y % MEGA) * T * S, T * S, T * S, x * T, y * T, T + 0.5, T + 0.5);
            } else {
                ctx.drawImage(patchTile(v, c, sub), x * T, y * T, T + 0.5, T + 0.5);
            }
        }
        // tint map (smooth large-scale variation)
        ctx.save(); ctx.imageSmoothingEnabled = true;
        ctx.drawImage(st.tint, x0, y0, x1 - x0 + 1, y1 - y0 + 1, x0 * T, y0 * T, (x1 - x0 + 1) * T, (y1 - y0 + 1) * T);
        ctx.restore();
