ctx.globalAlpha = 1;

// Draw placement outline
ctx.strokeStyle = gameState.buildGhost.valid ? '#4f4' : '#f44';
ctx.lineWidth = 2;
ctx.setLineDash([5, 5]);
ctx.strokeRect(x - size/2, y - size/2, size, size);
ctx.setLineDash([]);

// For refinery, show snap indicator to nearest gas
if (gameState.buildMode === 'refinery') {
    for (const res of gameState.resources) {
        if (res.type === 'gas' && !res.hasRefinery) {
            const gasDistance = distance(x, y, res.x, res.y);
            if (gasDistance < 120) {  // Show indicator at larger range
                ctx.strokeStyle = gasDistance < 80 ? '#4f4' : '#ff0';  // Green when in snap range
                ctx.lineWidth = 2;
                ctx.setLineDash([3, 3]);
                ctx.beginPath();
                ctx.moveTo(x, y);
                ctx.lineTo(res.x, res.y);
                ctx.stroke();
                ctx.setLineDash([]);
                
