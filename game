function runSimulation(simState, maxTime) {
    const dt = 0.1;  // Fixed timestep (100ms game time)
    
    while (simState.gameTime < maxTime && simState.phase === 'playing') {
        // Update game logic (no rendering)
        updateSimulation(simState, dt);
        
        // Check for game over
        if (simState.buildings.length === 0) {
            return { winner: 'ai', duration: simState.gameTime, ...simState.stats };
        }
        if (simState.enemyBuildings.length === 0) {
            return { winner: 'player', duration: simState.gameTime, ...simState.stats };
        }
        
        simState.gameTime += dt;
    }
    
    // Time limit reached - determine winner by score
    const playerScore = simState.buildings.length * 100 + simState.units.length * 10;
    const aiScore = simState.enemyBuildings.length * 100 + simState.enemyUnits.length * 10;
    
    let winner = 'draw';
    if (playerScore > aiScore * 1.2) winner = 'player';
    else if (aiScore > playerScore * 1.2) winner = 'ai';
    
    return { winner, duration: simState.gameTime, ...simState.stats };
}

// === UPDATE SIMULATION (Headless) ===
function updateSimulation(simState, dt) {
    // Update player units
    for (let i = simState.units.length - 1; i >= 0; i--) {
        const unit = simState.units[i];
        if (unit && unit.hp > 0) {
            updateSimUnit(simState, unit, dt, true);
        } else if (unit && unit.hp <= 0) {
            simState.units.splice(i, 1);
            simState.stats.playerUnitsLost++;
        }
    }
    
    // Update AI units
    for (let i = simState.enemyUnits.length - 1; i >= 0; i--) {
        const unit = simState.enemyUnits[i];
        if (unit && unit.hp > 0) {
            updateSimUnit(simState, unit, dt, false);
        } else if (unit && unit.hp <= 0) {
            simState.enemyUnits.splice(i, 1);
            simState.stats.aiUnitsLost++;
        }
    }
    
    // Update buildings
    for (let i = simState.buildings.length - 1; i >= 0; i--) {
        const building = simState.buildings[i];
        if (building && building.hp > 0) {
            updateSimBuilding(simState, building, dt, true);
        } else if (building) {
            simState.buildings.splice(i, 1);
        }
    }
    
    for (let i = simState.enemyBuildings.length - 1; i >= 0; i--) {
        const building = simState.enemyBuildings[i];
        if (building && building.hp > 0) {
            updateSimBuilding(simState, building, dt, false);
        } else if (building) {
            simState.enemyBuildings.splice(i, 1);
        }
    }
    
    // Update projectiles
    updateSimProjectiles(simState, dt);
    
    // Run both AIs (player uses simple AI, enemy uses genome-based AI)
    updateSimPlayerAI(simState, dt);
    updateSimGenomeAI(simState, dt);
}

// === SIMPLIFIED UNIT UPDATE FOR SIMULATION ===
function updateSimUnit(simState, unit, dt, isPlayer) {
    if (unit.attackCooldown > 0) {
        unit.attackCooldown -= dt;
    }
    
    const enemies = isPlayer ? simState.enemyUnits : simState.units;
    const enemyBuildings = isPlayer ? simState.enemyBuildings : simState.buildings;
    
    switch (unit.state) {
        case UNIT_STATE.IDLE:
            // Auto-attack nearby enemies
            let nearestTarget = null;
            let nearestDist = COMBAT.autoAttackRange * TILE_SIZE;
            
            for (const enemy of enemies) {
                const d = Math.sqrt(
                    (enemy.x - unit.x) ** 2 + (enemy.y - unit.y) ** 2
                );
                if (d < nearestDist) {
                    nearestDist = d;
                    nearestTarget = enemy;
                }
            }
            
            if (nearestTarget) {
                unit.target = nearestTarget;
                unit.state = UNIT_STATE.ATTACKING;
            }
            break;
            
        case UNIT_STATE.MOVING:
            if (unit.targetX !== undefined && unit.targetY !== undefined) {
                const dx = unit.targetX - unit.x;
                const dy = unit.targetY - unit.y;
                const dist = Math.sqrt(dx * dx + dy * dy);
                
                if (dist < 5) {
                    unit.state = UNIT_STATE.IDLE;
                    unit.targetX = undefined;
                    unit.targetY = undefined;
                } else {
                    const speed = unit.speed * TILE_SIZE * dt;
                    unit.x += (dx / dist) * speed;
                    unit.y += (dy / dist) * speed;
                    
                    // Update facing direction
                    unit.angle = Math.atan2(dy, dx);
                }
            } else {
                unit.state = UNIT_STATE.IDLE;
            }
            break;
            
        case UNIT_STATE.ATTACKING:
            if (!unit.target || unit.target.hp <= 0) {
                unit.target = null;
                unit.state = UNIT_STATE.IDLE;
                return;
            }
            
            const targetDist = Math.sqrt(
                (unit.target.x - unit.x) ** 2 + (unit.target.y - unit.y) ** 2
            );
            const attackRange = unit.range * TILE_SIZE;
            
            if (targetDist > attackRange) {
                // Move toward target
                const dx = unit.target.x - unit.x;
                const dy = unit.target.y - unit.y;
                const speed = unit.speed * TILE_SIZE * dt;
                unit.x += (dx / targetDist) * speed;
                unit.y += (dy / targetDist) * speed;
                unit.angle = Math.atan2(dy, dx);
            } else if (unit.attackCooldown <= 0) {
                // Attack!
                const damage = unit.damage || 10;
                
                // Apply damage to shields first, then HP
                if (unit.target.shield > 0) {
                    const shieldDamage = Math.min(unit.target.shield, damage);
                    unit.target.shield -= shieldDamage;
                    const hpDamage = damage - shieldDamage;
                    if (hpDamage > 0) {
                        unit.target.hp -= hpDamage;
                    }
                } else {
                    unit.target.hp -= damage;
                }
                
                // Track damage
                if (isPlayer) {
                    simState.stats.playerDamageDealt += damage;
                } else {
                    simState.stats.aiDamageDealt += damage;
                }
                
                // Check for kill
                if (unit.target.hp <= 0) {
                    if (isPlayer) {
                        simState.stats.aiUnitsLost++;
                    } else {
                        simState.stats.playerUnitsLost++;
                    }
                }
                
                unit.attackCooldown = unit.attackSpeed || 1;
            }
            break;
            
        case UNIT_STATE.GATHERING:
        case UNIT_STATE.RETURNING:
            // Simplified resource gathering for simulation
            updateSimWorker(simState, unit, dt, isPlayer);
            break;
    }
}

// === SIMPLIFIED WORKER UPDATE ===
function updateSimWorker(simState, unit, dt, isPlayer) {
    if (unit.state === UNIT_STATE.GATHERING) {
        if (!unit.gatherTarget || unit.gatherTarget.amount <= 0) {
            unit.state = UNIT_STATE.IDLE;
            return;
        }
        
        const dist = Math.sqrt(
            (unit.gatherTarget.x - unit.x) ** 2 + (unit.gatherTarget.y - unit.y) ** 2
        );
        
        if (dist < 30) {
            // Gathering
            if (!unit.gatherTimer) unit.gatherTimer = 0;
            unit.gatherTimer += dt;
            
            if (unit.gatherTimer >= 2) {  // 2 seconds to gather
                const amount = Math.min(8, unit.gatherTarget.amount);
                unit.carryAmount = amount;
                unit.carryType = unit.gatherTarget.type;
                unit.gatherTarget.amount -= amount;
                unit.gatherTimer = 0;
                unit.state = UNIT_STATE.RETURNING;
            }
        } else {
            // Move to resource
            const dx = unit.gatherTarget.x - unit.x;
            const dy = unit.gatherTarget.y - unit.y;
            const speed = unit.speed * TILE_SIZE * dt;
            unit.x += (dx / dist) * speed;
            unit.y += (dy / dist) * speed;
        }
    } else if (unit.state === UNIT_STATE.RETURNING) {
        const bases = isPlayer ? simState.buildings : simState.enemyBuildings;
        const base = bases.find(b => b.type === 'base');
        
        if (!base) {
            unit.state = UNIT_STATE.IDLE;
            return;
        }
        
        const dist = Math.sqrt((base.x - unit.x) ** 2 + (base.y - unit.y) ** 2);
        
        if (dist < base.size / 2 + 20) {
            // Deposit resources
            if (isPlayer) {
                if (unit.carryType === 'mineral') {
                    simState.minerals += unit.carryAmount;
                } else {
                    simState.gas += unit.carryAmount;
                }
            } else {
                if (unit.carryType === 'mineral') {
                    simState.aiState.minerals += unit.carryAmount;
                } else {
                    simState.aiState.gas += unit.carryAmount;
                }
            }
            
            unit.carryAmount = 0;
            unit.carryType = null;
            
            // Return to gathering if target still has resources
            if (unit.gatherTarget && unit.gatherTarget.amount > 0) {
                unit.state = UNIT_STATE.GATHERING;
            } else {
                unit.state = UNIT_STATE.IDLE;
            }
        } else {
            // Move to base
            const dx = base.x - unit.x;
            const dy = base.y - unit.y;
            const speed = unit.speed * TILE_SIZE * dt;
            unit.x += (dx / dist) * speed;
            unit.y += (dy / dist) * speed;
        }
    }
}

// === SIMPLIFIED BUILDING UPDATE ===
function updateSimBuilding(simState, building, dt, isPlayer) {
    // Process training queue
    if (building.trainingQueue && building.trainingQueue.length > 0) {
        if (!building.trainingProgress) building.trainingProgress = 0;
        
        const currentUnit = building.trainingQueue[0];
        const raceData = RACES[building.race];
        const unitData = raceData.units[currentUnit];
        
        if (unitData) {
            building.trainingProgress += dt;
            
            if (building.trainingProgress >= unitData.buildTime) {
                // Spawn unit
                const spawnX = building.x + (Math.random() - 0.5) * 40;
                const spawnY = building.y + building.size / 2 + 20;
                
                const newUnit = {
                    id: 'u' + simState.nextId++,
                    type: currentUnit,
                    race: building.race,
                    x: spawnX,
                    y: spawnY,
                    hp: unitData.hp,
                    maxHp: unitData.hp,
                    shield: unitData.shield || 0,
                    maxShield: unitData.shield || 0,
                    damage: unitData.damage,
                    range: unitData.range,
                    speed: unitData.speed,
                    sight: unitData.sight,
                    attackSpeed: unitData.attackSpeed || 1,
                    attackCooldown: 0,
                    state: UNIT_STATE.IDLE,
                    target: null,
                    isFlying: unitData.isFlying || false,
                    canAttackAir: unitData.canAttackAir,
                    canAttackGround: unitData.canAttackGround
                };
                
                if (isPlayer) {
                    simState.units.push(newUnit);
                    simState.supplyUsed += unitData.supply;
                    simState.stats.playerUnitsBuilt++;
                } else {
                    simState.enemyUnits.push(newUnit);
                    simState.aiState.supplyUsed += unitData.supply;
                    simState.stats.aiUnitsBuilt++;
                }
                
                // Move to rally point if set
                if (building.rallyPoint) {
                    newUnit.targetX = building.rallyPoint.x;
                    newUnit.targetY = building.rallyPoint.y;
                    newUnit.state = UNIT_STATE.MOVING;
                }
                
                building.trainingQueue.shift();
                building.trainingProgress = 0;
            }
        }
    }
    
    // Turret attacking
    if (building.type === 'turret' && !building.isConstructing) {
        const raceData = RACES[building.race];
        const turretData = raceData.buildings.turret;
        
        if (!building.attackCooldown) building.attackCooldown = 0;
        building.attackCooldown -= dt;
        
        if (building.attackCooldown <= 0) {
            const enemies = isPlayer ? simState.enemyUnits : simState.units;
            const range = turretData.range * TILE_SIZE;
            
            for (const enemy of enemies) {
                const dist = Math.sqrt(
                    (enemy.x - building.x) ** 2 + (enemy.y - building.y) ** 2
                );
                if (dist < range) {
                    // Check air/ground targeting
                    if (enemy.isFlying && !turretData.canAttackAir) continue;
                    if (!enemy.isFlying && !turretData.canAttackGround) continue;
                    
                    // Attack
                    enemy.hp -= turretData.damage;
                    building.attackCooldown = turretData.attackSpeed;
                    
                    if (isPlayer) {
                        simState.stats.playerDamageDealt += turretData.damage;
                    } else {
                        simState.stats.aiDamageDealt += turretData.damage;
                    }
                    break;
                }
            }
        }
    }
}

