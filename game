    }

    // tileable megatile texture for one terrain class
    function makeMegatile(ramp, S, seed, opts) {
        const W = Math.round(T * MEGA * S);
        const cv = document.createElement('canvas'); cv.width = W; cv.height = W;
        const cx = cv.getContext('2d');
        const id = cx.createImageData(W, W), d = id.data;
        const n1 = makeNoise(W, 6, seed), n2 = makeNoise(W, 14, seed + 7), n3 = makeNoise(W, 36, seed + 13);
        const cols = ramp.map(hexRgb);
        const bayer = [0, 8, 2, 10, 12, 4, 14, 6, 3, 11, 1, 9, 15, 7, 13, 5];
        const px = Math.max(1, Math.round(S));  // chunk art pixels so grain reads as pixel-art
        for (let y = 0; y < W; y += px) for (let x = 0; x < W; x += px) {
            let n = n1(x, y) * 0.55 + n2(x, y) * 0.3 + n3(x, y) * 0.15;
            n += (hash(x, y, seed + 3) - 0.5) * (opts.grain || 0.1);
            const bx = (x / px) & 3, by = (y / px) & 3;
            n += (bayer[by * 4 + bx] / 16 - 0.5) * 0.12;
            const idx = Math.max(0, Math.min(cols.length - 1, Math.round(n * 3.1)));
            const c = cols[idx];
            for (let yy = 0; yy < px && y + yy < W; yy++) for (let xx = 0; xx < px && x + xx < W; xx++) {
                const i = ((y + yy) * W + (x + xx)) * 4;
