// === UPDATE REGENERATION ===
// Rates unchanged from v32 (see handoff: canon deltas). v33: the shield upgrade now adds shield
// armour (BW Plasma Shields) instead of capacity, so shields regenerate to the base maximum.
function updateRegeneration(dt) {
const hpRegen = RACES.swarm.special.hpPerSecond * dt;
const shRegen = RACES.ascended.special.shieldPerSecond * dt;

// Swarm HP regen / Ascended shield regen — units
for (const pool of [gameState.units, gameState.enemyUnits]) {
    for (const unit of pool) {
        if (unit.race === 'swarm') {
            if (unit.hp < unit.maxHp) unit.hp = Math.min(unit.maxHp, unit.hp + hpRegen);
        } else if (unit.race === 'ascended' && unit.maxShield > 0 && unit.shield < unit.maxShield) {
            unit.shield = Math.min(unit.maxShield, unit.shield + shRegen);
        }
    }
}

// v31 fix kept: Swarm structures regenerate (sc_research.pdf p.1). Ascended structure shields.
for (const pool of [gameState.buildings, gameState.enemyBuildings]) {
    for (const b of pool) {
        if (b.race === 'swarm') {
            if (!b.isConstructing && b.hp < b.maxHp) b.hp = Math.min(b.maxHp, b.hp + hpRegen);
        } else if (b.race === 'ascended' && b.maxShield > 0 && b.shield < b.maxShield) {
            b.shield = Math.min(b.maxShield, b.shield + shRegen);
        }
    }
}

}

// === ENEMY AI ===
function updateEnemyAI(dt) {
const difficulty = AI_DIFFICULTY[gameOptions.aiDifficulty] || AI_DIFFICULTY.normal;

// Workers auto-gather with difficulty bonus
for (const unit of gameState.enemyUnits) {
if (unit.type === 'worker' && unit.state === UNIT_STATE.IDLE && !(unit.buildTarget && unit.buildTarget.isConstructing && unit.buildTarget.hp > 0)) {
// Find nearest mineral
let nearestRes = null;
let nearestDist = Infinity;

        for (const res of gameState.resources) {
            if (res.type === 'mineral' && res.amount > 0) {
                const d = distance(unit.x, unit.y, res.x, res.y);
                if (d < nearestDist) {
                    nearestDist = d;
                    nearestRes = res;
                }
            }
        }
        
        if (nearestRes && nearestDist < 400) {
            unit.gatherTarget = nearestRes;
            unit.state = UNIT_STATE.GATHERING;
            unit.returnTarget = findNearestBase(unit.x, unit.y, false);
        }
    }
    
    // Apply difficulty resource bonus when returning resources
    if (unit.type === 'worker' && unit.state === UNIT_STATE.RETURNING && unit.carrying > 0) {
        unit.difficultyBonus = difficulty.resourceBonus;
    }
}

// AI army management - collect army and coordinate attacks
updateAIArmyCoordination(difficulty, dt);

// AI building construction with collision checking
updateAIBuildingConstruction(difficulty, dt);

// AI gas harvesting - assign workers to refineries
updateAIGasHarvesting();

// Train units based on difficulty
updateAIUnitProduction(difficulty, dt);

// AI Upgrade Research
updateAIUpgrades(dt);

// AI Micro management
if (difficulty.microLevel > 0) {
    updateAIMicro(difficulty);
}

}

// === AI BUILDING CONSTRUCTION WITH COLLISION CHECKING ===
function updateAIBuildingConstruction(difficulty, dt) {
    for (const aiPlayer of gameState.aiPlayers) {
        if (aiPlayer.eliminated) continue;
        
        // Initialize build timers
        if (!aiPlayer.buildTimers) {
            aiPlayer.buildTimers = {
                refinery: 0,
                supply: 0,
                production: 0,
                techlab: 0,
                turret: 0
            };
        }
        
        // Update timers
        for (const key in aiPlayer.buildTimers) {
            aiPlayer.buildTimers[key] += dt;
        }
        
        const race = aiPlayer.race;
        const raceData = RACES[race];
        const aiBuildings = gameState.enemyBuildings.filter(b => b.aiPlayerIndex === aiPlayer.index);
        const aiUnits = gameState.enemyUnits.filter(u => u.aiPlayerIndex === aiPlayer.index);
        const aiBase = aiBuildings.find(b => b.type === 'base' && !b.isConstructing);
        if (!aiBase) continue;

        // v33: an unfinished Terran structure always has an SCV on it (re-assign if it was lost)
        if (race === 'coalition') {
            for (const b of aiBuildings) {
                if (b.isConstructing && !aiUnits.some(u => u.buildTarget === b)) aiAssignBuilder(aiPlayer, b);
            }
        }
        
        const minerals = aiPlayer.minerals || 0;
        const gas = aiPlayer.gas || 0;
        const supply = aiPlayer.supply || 0;
        const supplyMax = aiPlayer.supplyMax || 10;
        
        // --- REFINERY: first at 30 s; v33: a second once the tech structure stands (gas starved the late army)
        const refineries = aiBuildings.filter(b => b.type === 'refinery');
        const wantGas = refineries.length === 0
            ? aiPlayer.buildTimers.refinery > 30
            : refineries.length === 1 && aiPlayer.buildTimers.refinery > 60 && aiBuildings.some(b => b.type === 'techlab' && !b.isConstructing);
        if (wantGas && minerals >= (raceData.buildings.refinery?.cost?.minerals || 75)) {
            // Find unclaimed gas geyser near base — v33: nearest one that can actually be built on
            // (v32 gave up if the single nearest geyser was blocked)
            let bestGas = null;
            const geysers = gameState.resources
                .filter(res => res.type === 'gas' && !res.hasRefinery && distance(aiBase.x, aiBase.y, res.x, res.y) < 500)
                .sort((p, q) => distance(aiBase.x, aiBase.y, p.x, p.y) - distance(aiBase.x, aiBase.y, q.x, q.y));
            for (const res of geysers) {
                if (canPlaceBuildingForRace(res.x, res.y, 'refinery', race)) { bestGas = res; break; }
            }
            if (bestGas) {
                const b = createBuilding('refinery', race, bestGas.x, bestGas.y, false);
                b.aiPlayerIndex = aiPlayer.index;
                b.isConstructing = true;
                b.hp = b.maxHp * 0.1;
                gameState.enemyBuildings.push(b);
                aiAssignBuilder(aiPlayer, b);
                bestGas.hasRefinery = true;
                aiPlayer.minerals -= raceData.buildings.refinery.cost.minerals;
                aiPlayer.buildTimers.refinery = 0;
            }
        }
        
        // --- SUPPLY: Build when near cap ---
        // v33: supply now arrives on completion, so structures still building count as pending;
        // an Empyeran AI with no Pylon builds one first (everything else needs its power)
        const supplyBuildings = aiBuildings.filter(b => b.type === 'supply');
        const supplyCost = raceData.buildings.supply?.cost?.minerals || 100;
        const pendingSupply = supplyBuildings.filter(b => b.isConstructing).length * (raceData.buildings.supply?.providesSupply || 8);
        const needPylon = race === 'ascended' && supplyBuildings.length === 0;
        const prodDone = aiBuildings.filter(b => b.type === 'production' && !b.isConstructing).length;
        const headroom = 3 + 2 * prodDone;                  // v33: more production burns supply faster
        const supplyGate = prodDone >= 3 ? 6 : 15;          // seconds between supply structures
        if ((supply >= supplyMax + pendingSupply - headroom || needPylon) && supplyBuildings.length < 24 &&
            supplyMax + pendingSupply < SUPPLY_LIMIT + 8 && aiPlayer.buildTimers.supply > supplyGate && minerals >= supplyCost) {
            const pos = findAIBuildingSpot(aiBase, 'supply', race);
            if (pos) {
                const b = createBuilding('supply', race, pos.x, pos.y, false);
                b.aiPlayerIndex = aiPlayer.index;
                b.isConstructing = true;
                b.hp = b.maxHp * 0.1;
                gameState.enemyBuildings.push(b);
                aiAssignBuilder(aiPlayer, b);
                aiPlayer.minerals -= supplyCost;
                // v33: supplyMax is granted in onBuildingComplete()
                aiPlayer.buildTimers.supply = 0;
            }
        }
        
        // --- PRODUCTION: second at 90 s; v33: more while the bank piles up, to a per-difficulty cap
        const prodBuildings = aiBuildings.filter(b => b.type === 'production');
        const prodCost = raceData.buildings.production?.cost?.minerals || 150;
        const prodCap = 2 + (difficulty.microLevel || 0) + (difficulty.resourceBonus > 0 ? 1 : 0);   // easy 2 · normal 3 · hard 4 · brutal 5
        const wantProd = prodBuildings.length < 2
            ? aiPlayer.buildTimers.production > 90
            : prodBuildings.length < prodCap && aiPlayer.buildTimers.production > 30 &&
              minerals >= prodCost + 250 + 100 * prodBuildings.length && !prodBuildings.some(b => b.isConstructing);
        if (wantProd && minerals >= prodCost) {
            const pos = findAIBuildingSpot(aiBase, 'production', race);
            if (pos) {
                const b = createBuilding('production', race, pos.x, pos.y, false);
                b.aiPlayerIndex = aiPlayer.index;
                b.isConstructing = true;
                b.hp = b.maxHp * 0.1;
                gameState.enemyBuildings.push(b);
                aiAssignBuilder(aiPlayer, b);
                aiPlayer.minerals -= prodCost;
                aiPlayer.buildTimers.production = 0;
            }
        }
        
        // --- TECH LAB: Build at 2 min ---
        const techlabs = aiBuildings.filter(b => b.type === 'techlab');
        const techCost = raceData.buildings.techlab?.cost || { minerals: 150, gas: 100 };
        if (techlabs.length === 0 && aiPlayer.buildTimers.techlab > 120 && 
            minerals >= techCost.minerals && gas >= (techCost.gas || 0)) {
            const pos = findAIBuildingSpot(aiBase, 'techlab', race);
            if (pos) {
                const b = createBuilding('techlab', race, pos.x, pos.y, false);
                b.aiPlayerIndex = aiPlayer.index;
                b.isConstructing = true;
                b.hp = b.maxHp * 0.1;
                gameState.enemyBuildings.push(b);
                aiAssignBuilder(aiPlayer, b);
                aiPlayer.minerals -= techCost.minerals;
                aiPlayer.gas -= techCost.gas || 0;
                aiPlayer.buildTimers.techlab = 0;
            }
        }
        
        // --- TURRET: Build at 3 min for defense ---
        const turrets = aiBuildings.filter(b => b.type === 'turret');
        const turretCost = raceData.buildings.turret?.cost?.minerals || 125;
        if (turrets.length < 2 && aiPlayer.buildTimers.turret > 180 && minerals >= turretCost) {
            const pos = findAIBuildingSpot(aiBase, 'turret', race, 80);
            if (pos) {
                const b = createBuilding('turret', race, pos.x, pos.y, false);
                b.aiPlayerIndex = aiPlayer.index;
                b.isConstructing = true;
                b.hp = b.maxHp * 0.1;
                gameState.enemyBuildings.push(b);
                aiAssignBuilder(aiPlayer, b);
                aiPlayer.minerals -= turretCost;
                aiPlayer.buildTimers.turret = 0;
            }
        }
    }
}

// Find valid AI building placement near base with collision checking
// v33: powered Empyeran structures are sited inside the AI's own Pylon fields (BW)
function findAIBuildingSpot(base, buildingType, race, minDist = 60) {
    const raceData = RACES[race];
    const buildingData = raceData.buildings[buildingType];
    if (!buildingData) return null;

    const needsPower = race === 'ascended' && !!buildingData.requiresPower;
    const centres = needsPower
        ? gameState.enemyBuildings.filter(b => b.type === 'supply' && b.race === 'ascended' && !b.isConstructing && b.hp > 0 && b.aiPlayerIndex === base.aiPlayerIndex)
        : [base];

    const gridSize = BUILD_GRID_SIZE || 16;
    for (const c of centres) {
        const md = needsPower ? 40 : minDist;
        for (let ring = 1; ring <= 8; ring++) {
            const radius = md + ring * gridSize * 2;
            const steps = Math.max(8, ring * 4);
            for (let i = 0; i < steps; i++) {
                const angle = (i / steps) * Math.PI * 2;
                const tx = c.x + Math.cos(angle) * radius;
                const ty = c.y + Math.sin(angle) * radius;
                const snapped = { x: Math.round(tx / gridSize) * gridSize, y: Math.round(ty / gridSize) * gridSize };
                if (!canPlaceBuildingForRace(snapped.x, snapped.y, buildingType, race)) continue;
                if (needsPower && !isPositionPowered(snapped.x, snapped.y, false, base.aiPlayerIndex)) continue;
                return snapped;
            }
        }
    }
    return null;
}

// === AI GAS HARVESTING ===
function updateAIGasHarvesting() {
    for (const aiPlayer of gameState.aiPlayers) {
        if (aiPlayer.eliminated) continue;
        
        const aiBuildings = gameState.enemyBuildings.filter(b => b.aiPlayerIndex === aiPlayer.index);
        const aiUnits = gameState.enemyUnits.filter(u => u.aiPlayerIndex === aiPlayer.index);
        const refineries = aiBuildings.filter(b => b.type === 'refinery' && !b.isConstructing);
        
        for (const refinery of refineries) {
            // Count workers currently gathering gas at this refinery
            // v33: count every worker assigned to this geyser (v32 skipped those walking back with gas,
            // so the AI kept pulling drones until nearly all of them mined gas)
            const gasWorkers = aiUnits.filter(u =>
                u.type === 'worker' &&
                u.gatherTarget && u.gatherTarget.type === 'gas' &&
                distance(u.gatherTarget.x, u.gatherTarget.y, refinery.x, refinery.y) < 60
            );
            
            if (gasWorkers.length < 3) {
                // Find idle or mineral-gathering worker near refinery
                const nearbyWorker = aiUnits.find(u =>
                    u.type === 'worker' && !u.buildTarget && 
                    (u.state === UNIT_STATE.IDLE || 
                     (u.state === UNIT_STATE.GATHERING && u.gatherTarget?.type === 'mineral')) &&
                    distance(u.x, u.y, refinery.x, refinery.y) < 400
                );
                
                if (nearbyWorker) {
                    // Find the gas resource at this refinery
                    const gasRes = gameState.resources.find(r => 
                        r.type === 'gas' && distance(r.x, r.y, refinery.x, refinery.y) < 60
                    );
                    if (gasRes) {
                        nearbyWorker.gatherTarget = gasRes;
                        nearbyWorker.state = UNIT_STATE.GATHERING;
                        nearbyWorker.returnTarget = findNearestBase(nearbyWorker.x, nearbyWorker.y, false);
                    }
                }
            }
        }
    }
}

// === AI ARMY COORDINATION ===
function updateAIArmyCoordination(difficulty, dt) {
    const ai = gameState.aiState;
    
    // Initialize AI army state if needed
    if (!ai.armyState) {
        ai.armyState = 'gathering';
        ai.lastAttackTime = 0;
        ai.rallyPoint = null;
        ai.targetBuilding = null;
    }
    
    // Count combat units
    const combatUnits = gameState.enemyUnits.filter(u => u.type !== 'worker');
    // v33: each AI rallies its own army outside its own base, toward the map centre (v32 rallied
    // every AI army beside the first AI's base, where it clogged that AI's mineral line)
    const rallyCache = {};
    const rallyOf = (u) => { const k = u.aiPlayerIndex; if (!(k in rallyCache)) rallyCache[k] = aiRallyFor(u); return rallyCache[k]; };
    const armySize = combatUnits.length;
    
    // Find AI base for rally point
    const aiBase = gameState.enemyBuildings.find(b => b.type === 'base' && !b.isConstructing);
    if (!ai.rallyPoint && aiBase) {
        ai.rallyPoint = { x: aiBase.x + 100, y: aiBase.y };
    }
    
    // State machine for AI army behavior
    const timeSinceLastAttack = gameState.gameTime - ai.lastAttackTime;
    const shouldAttack = gameState.gameTime >= (difficulty.firstAttackDelay || 0) &&
                         timeSinceLastAttack > difficulty.attackInterval &&
                         armySize >= difficulty.minWaveSize;
    
    if (ai.armyState === 'gathering') {
        // Rally units to staging point
        for (const unit of combatUnits) {
            const rp = rallyOf(unit);
            if (unit.state === UNIT_STATE.IDLE && rp) {
                const distToRally = distance(unit.x, unit.y, rp.x, rp.y);
                if (distToRally > 110) {
                    unit.targetX = rp.x + (Math.random() - 0.5) * 90;
                    unit.targetY = rp.y + (Math.random() - 0.5) * 90;
                    unit.state = UNIT_STATE.MOVING;
                }
            }
        }
        
        // Check if ready to attack
        if (shouldAttack) {
            // Gather army composition
            const attackForce = combatUnits.filter(u => {
                const rp = rallyOf(u);
                if (!rp) return true;
                return distance(u.x, u.y, rp.x, rp.y) < 220 ||
                       u.state === UNIT_STATE.IDLE;
            });
            
            if (attackForce.length >= difficulty.minWaveSize) {
                // Limit wave size
                // v33: the wave grows with the army (difficulty 'aggression' share, at least maxWaveSize)
                const waveSize = Math.min(attackForce.length, Math.max(difficulty.maxWaveSize, Math.floor(attackForce.length * (difficulty.aggression || 0.5))));
                const attackWave = attackForce.slice(0, waveSize);
                
                // Find target - prioritize production buildings, then base
                const playerBase = gameState.buildings.find(b => b.type === 'base');
                const playerProd = gameState.buildings.find(b => b.type === 'production');
                const target = playerProd || playerBase;
                
                if (target) {
                    ai.targetBuilding = target;
                    ai.armyState = 'attacking';
                    ai.attackWave = attackWave;
                    ai.lastAttackTime = gameState.gameTime;
                    
                    // Send attack wave
                    for (const unit of attackWave) {
                        unit.target = target;
                        unit.targetX = target.x + (Math.random() - 0.5) * 40;
                        unit.targetY = target.y + (Math.random() - 0.5) * 40;
                        unit.state = UNIT_STATE.ATTACKING;
                    }
                    
                    addMessage('Enemy attack incoming!', '#f44');
                }
            }
        }
    } else if (ai.armyState === 'attacking') {
        // Check if attack is complete (target destroyed or most units dead)
        const attackWave = ai.attackWave || [];
        const survivingAttackers = attackWave.filter(u => gameState.enemyUnits.includes(u));
        
        // Target destroyed or most attackers dead - return to gathering
        if (!ai.targetBuilding || !gameState.buildings.includes(ai.targetBuilding) || 
            survivingAttackers.length < 2) {
            ai.armyState = 'gathering';
            ai.attackWave = [];
            ai.targetBuilding = null;
            
            // Retreat survivors
            for (const unit of survivingAttackers) {
                const rp = rallyOf(unit);
                if (unit.state !== UNIT_STATE.ATTACKING && rp) {
                    unit.targetX = rp.x;
                    unit.targetY = rp.y;
                    unit.state = UNIT_STATE.MOVING;
                }
            }
        } else {
            // Re-direct idle attackers back to the building target
            // This ensures AI doesn't get distracted chasing workers forever
            for (const unit of survivingAttackers) {
                if (unit.state === UNIT_STATE.IDLE || 
                    (unit.target && unit.target.type === 'worker')) {
                    // Re-assign to building target
                    unit.target = ai.targetBuilding;
                    unit.targetX = ai.targetBuilding.x + (Math.random() - 0.5) * 40;
                    unit.targetY = ai.targetBuilding.y + (Math.random() - 0.5) * 40;
                    unit.state = UNIT_STATE.ATTACKING;
                }
            }
        }
    }
}

// === AI UNIT PRODUCTION ===
function updateAIUnitProduction(difficulty, dt) {
    
    for (const building of gameState.enemyBuildings) {
        if (building.isConstructing) continue;
        if (!building.produces || building.produces.length === 0) continue;
        if (building.trainingQueue.length >= 3) continue;
        if (building.unpowered) continue;   // v33: unpowered Empyeran structures can't train
        
        // Get per-player economy
        const aiPlayer = gameState.aiPlayers[building.aiPlayerIndex];
        if (!aiPlayer) continue;
        
        // Check build chance
        if (Math.random() > difficulty.buildChance) continue;
        
        // Count this player's army
        const myUnits = gameState.enemyUnits.filter(u => u.aiPlayerIndex === building.aiPlayerIndex);
        const workers = myUnits.filter(u => u.type === 'worker').length;
        const soldiers = myUnits.filter(u => u.type === 'soldier').length;
        const heavies = myUnits.filter(u => u.type === 'heavy').length;
        const specialists = myUnits.filter(u => u.type === 'specialist').length;
        
        // v33: +3 workers per finished refinery keeps the mineral line whole now that AIs mine gas
        const refineriesDone = gameState.enemyBuildings.filter(b => b.aiPlayerIndex === building.aiPlayerIndex && b.type === 'refinery' && !b.isConstructing).length;
        const desiredWorkers = 6 + (difficulty.microLevel * 2) + 3 * refineriesDone;
        const flyers = myUnits.filter(u => u.type === 'flyer').length;
        const totalCombat = soldiers + heavies * 3 + specialists;
        const army = soldiers + heavies + specialists + flyers;
        
        // Decide what to build based on composition
        let unitToBuild = null;
        const raceData = RACES[building.race || gameState.enemyRace];
        
        if (building.type === 'base') {
            if (workers < desiredWorkers) {
                unitToBuild = 'worker';
            }
        } else if (building.type === 'production') {
            // v33: the tech mix grows with the army (v32 stopped at 2 heavies and 2 specialists and never
            // made flyers). An anti-air-only flyer is built only once the player has air units.
            const want = { heavy: Math.max(2, Math.floor(army * 0.2)), specialist: Math.max(2, Math.floor(army * 0.12)), flyer: Math.floor(army * 0.12) };
            const fdef = raceData.units.flyer;
            const flyerUseful = !!fdef && (fdef.canAttackGround !== false || gameState.units.some(u => u.isFlying));
            if (soldiers < 4 || (totalCombat < 8 && Math.random() < 0.7)) {
                unitToBuild = 'soldier';
            } else if (heavies < want.heavy && Math.random() < 0.45) {
                unitToBuild = 'heavy';
            } else if (flyerUseful && flyers < want.flyer && Math.random() < 0.35) {
                unitToBuild = 'flyer';
            } else if (specialists < want.specialist && Math.random() < 0.3) {
                unitToBuild = 'specialist';
            } else {
                unitToBuild = 'soldier';
            }
        }
        
        if (unitToBuild && building.produces.includes(unitToBuild)) {
            // v32: AI obeys the same tech tree as the player.
            // If the desired unit is tech-locked, fall back to soldier (always tier 1).
            let prereq = unitPrereqsMet(building.race || gameState.enemyRace, unitToBuild, false, building.aiPlayerIndex);
            if (!prereq.met && unitToBuild !== 'soldier' && unitToBuild !== 'worker') {
                unitToBuild = 'soldier';
                prereq = unitPrereqsMet(building.race || gameState.enemyRace, unitToBuild, false, building.aiPlayerIndex);
            }
            if (!prereq.met) continue;

            // v33: short on gas for the tech unit → keep the queue moving with a soldier
            if (unitToBuild !== 'soldier' && unitToBuild !== 'worker' && aiPlayer.gas < (raceData.units[unitToBuild].cost.gas || 0)) unitToBuild = 'soldier';
            const unitData = raceData.units[unitToBuild];
            const unitSupply = unitSupplyCost(unitData);   // v33: a Seedling pair costs 1
            if (aiPlayer.minerals >= unitData.cost.minerals && 
                aiPlayer.gas >= (unitData.cost.gas || 0) &&
                (aiPlayer.supply || 0) + unitSupply <= supplyCap(aiPlayer.supplyMax || 10)) {
                aiPlayer.minerals -= unitData.cost.minerals;
                aiPlayer.gas -= unitData.cost.gas || 0;
                aiPlayer.supply = (aiPlayer.supply || 0) + unitSupply;
                building.trainingQueue.push(unitToBuild);
            }
        }
    }
}

// === AI MICRO MANAGEMENT ===
function updateAIMicro(difficulty) {
    // Basic micro: retreat low HP units, focus fire
    for (const unit of gameState.enemyUnits) {
        if (unit.type === 'worker') continue;
        
        // Retreat if very low HP
        if (unit.hp < unit.maxHp * 0.2 && difficulty.microLevel >= 1) {
            const nearestBase = gameState.enemyBuildings.find(b => b.type === 'base');
            if (nearestBase && unit.state === UNIT_STATE.ATTACKING) {
                // Check if we're far from base
                const distToBase = distance(unit.x, unit.y, nearestBase.x, nearestBase.y);
                if (distToBase > 200) {
                    unit.targetX = nearestBase.x;
                    unit.targetY = nearestBase.y;
                    unit.state = UNIT_STATE.MOVING;
                    unit.target = null;
                }
            }
        }
        
        // Focus fire on low HP targets (advanced micro)
        if (difficulty.microLevel >= 2 && unit.state === UNIT_STATE.ATTACKING) {
            // Find lowest HP enemy in range
            let lowestHPTarget = null;
            let lowestHP = Infinity;
            
            for (const enemy of gameState.units) {
                const dist = distance(unit.x, unit.y, enemy.x, enemy.y);
                if (dist < unit.range * TILE_SIZE + 50) {
                    if (enemy.hp < lowestHP) {
                        lowestHP = enemy.hp;
                        lowestHPTarget = enemy;
                    }
                }
            }
            
            if (lowestHPTarget && (!unit.target || unit.target.hp > lowestHP * 1.5)) {
                unit.target = lowestHPTarget;
            }
        }
    }
}

// === AI UPGRADE RESEARCH ===
function updateAIUpgrades(dt) {
    const ai = gameState.aiState;
    
    // Check each AI player's techlabs
    for (const techlab of gameState.enemyBuildings) {
        if (techlab.type !== 'techlab' || techlab.isConstructing || techlab.unpowered) continue;
        
        // Get this player's economy
        const aiPlayer = gameState.aiPlayers[techlab.aiPlayerIndex];
        if (!aiPlayer) continue;
    
    // If currently researching, update progress
    if (techlab.aiResearchQueue) {
        techlab.aiResearchQueue.progress += dt;
        
        if (techlab.aiResearchQueue.progress >= techlab.aiResearchQueue.totalTime) {
            const upgradeType = techlab.aiResearchQueue.type;
            ai.upgrades[upgradeType] = (ai.upgrades[upgradeType] || 0) + 1;
            applyAIUpgrade(upgradeType);
            addMessage(`Enemy upgraded ${UPGRADES[upgradeType].name}!`, '#f88');
            techlab.aiResearchQueue = null;
        }
        continue;
    }
    
    // Check if it's time to consider researching
    if (gameState.gameTime < ai.nextUpgradeCheck) continue;
    
    const attackLevel = ai.upgrades.attackUpgrade || 0;
    const armorLevel = ai.upgrades.armorUpgrade || 0;
    const shieldLevel = ai.upgrades.shieldUpgrade || 0;
    
    let upgradeType = null;
    let upgradeLevel = 0;
    
    if (attackLevel < 3 && attackLevel <= armorLevel) {
        upgradeType = 'attackUpgrade';
        upgradeLevel = attackLevel;
    } else if (armorLevel < 3) {
        upgradeType = 'armorUpgrade';
        upgradeLevel = armorLevel;
    } else if (techlab.race === 'ascended' && shieldLevel < 3) {
        upgradeType = 'shieldUpgrade';
        upgradeLevel = shieldLevel;
    }
    
    if (!upgradeType) continue;
    
    const cost = UPGRADES[upgradeType].cost[upgradeLevel];
    if (aiPlayer.minerals >= cost.minerals && aiPlayer.gas >= cost.gas) {
        aiPlayer.minerals -= cost.minerals;
        aiPlayer.gas -= cost.gas;
        
        techlab.aiResearchQueue = {
            type: upgradeType,
            progress: 0,
            totalTime: UPGRADES[upgradeType].researchTime[upgradeLevel]
        };
        ai.nextUpgradeCheck = gameState.gameTime + 60;
    } else {
        ai.nextUpgradeCheck = gameState.gameTime + 15;
    }
    }
}

