.train-btn.primary {
background: linear-gradient(180deg, #2563eb 0%, #1d4ed8 100%);
border-color: #2563eb;
color: #fff;
}

.train-btn.primary:hover:not(:disabled) {
box-shadow: 0 0 15px rgba(37, 99, 235, 0.4);
}

.train-btn.danger {
border-color: #7f1d1d;
color: #f87171;
}

.train-btn.danger:hover:not(:disabled) {
background: #7f1d1d;
color: #fff;
}

.training-progress {
background: rgba(0, 0, 0, 0.3);
border-radius: 8px;
padding: 1rem;
margin-bottom: 1rem;
}

.progress-section {
display: flex;
justify-content: space-between;
margin-bottom: 0.5rem;
}

.progress-label {
color: #666;
font-size: 0.8rem;
}

.progress-section span:last-child {
color: #c4b5fd;
font-size: 0.85rem;
}

.progress-bar-container {
height: 8px;
background: #0d0d1a;
border-radius: 4px;
overflow: hidden;
margin-top: 0.5rem;
}

.progress-bar {
height: 100%;
width: 0%;
background: linear-gradient(90deg, #8b5cf6 0%, #c4b5fd 100%);
border-radius: 4px;
transition: width 0.3s;
}

.training-stats h3,
.training-genome h3,
.training-log h3 {
color: #9ca3af;
font-size: 0.9rem;
margin: 0 0 0.8rem 0;
text-transform: uppercase;
letter-spacing: 0.1em;
}

.stats-grid {
display: grid;
grid-template-columns: 1fr 1fr;
gap: 0.5rem;
margin-bottom: 1rem;
}

.stat-item {
background: rgba(0, 0, 0, 0.3);
padding: 0.6rem;
border-radius: 6px;
display: flex;
justify-content: space-between;
}

.stat-label {
color: #666;
font-size: 0.75rem;
}

.stat-item span:last-child {
color: #4ade80;
font-size: 0.85rem;
font-weight: bold;
}

.fitness-graph-container {
background: rgba(0, 0, 0, 0.4);
border-radius: 6px;
padding: 0.5rem;
margin-bottom: 1rem;
