    if (reqs.length === 0) return { met: true, missing: null };

    const pool = isPlayer ? gameState.buildings : gameState.enemyBuildings;
    for (const req of reqs) {
        let count = 0;
        for (const b of pool) {
            if (b.type !== req.type || b.isConstructing) continue;
