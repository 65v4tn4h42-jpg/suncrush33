let lastFrameTime = 0;

// === MAIN GAME LOOP ===
function gameLoop(timestamp) {
if (gameState.phase !== 'playing') {
requestAnimationFrame(gameLoop);
return;
}

// Skip update when paused, but still render
if (gameState.paused) {
    render();
    requestAnimationFrame(gameLoop);
    return;
}

try {
    const realDt = Math.min((timestamp - lastFrameTime) / 1000, 0.1);
    const dt = realDt * gameState.gameSpeed;
    lastFrameTime = timestamp;
    frameUI(realDt);   // v33: arrow-key scrolling, targeting cursor

    update(dt);
    render();
} catch (error) {
    console.error('Game loop error:', error);
    // Continue running to avoid complete freeze
}

requestAnimationFrame(gameLoop);

}

// === MAIN UPDATE ===
function update(dt) {
gameState.gameTime += dt;

// v33: Pylon power grid (Red Empyeran) refreshed four times a second
gameState._powerT = (gameState._powerT || 0) - dt;
if (gameState._powerT <= 0) {
    gameState._powerT = 0.25;
    try { updatePowerGrid(); } catch (e) { console.error('updatePowerGrid error:', e); }
}

try {
    // Update fog of war
    updateFog();
} catch (e) { console.error('updateFog error:', e); }

// Update player units - iterate in reverse for safe removal
for (let i = gameState.units.length - 1; i >= 0; i--) {
    try {
        const unit = gameState.units[i];
        if (unit && unit.hp > 0) {
            updateUnit(unit, dt, true);
        }
    } catch (e) { console.error('updateUnit error:', e); }
}

// Update enemy units
for (let i = gameState.enemyUnits.length - 1; i >= 0; i--) {
    try {
        const unit = gameState.enemyUnits[i];
        if (unit && unit.hp > 0) {
            updateUnit(unit, dt, false);
        }
    } catch (e) { console.error('updateEnemyUnit error:', e); }
}

// Update buildings
for (let i = gameState.buildings.length - 1; i >= 0; i--) {
    try {
        const building = gameState.buildings[i];
        if (building && building.hp > 0) {
            updateBuilding(building, dt, true);
        }
    } catch (e) { console.error('updateBuilding error:', e); }
}
for (let i = gameState.enemyBuildings.length - 1; i >= 0; i--) {
    try {
        const building = gameState.enemyBuildings[i];
        if (building && building.hp > 0) {
            updateBuilding(building, dt, false);
        }
    } catch (e) { console.error('updateEnemyBuilding error:', e); }
}

try {
    // Update projectiles
    updateProjectiles(dt);
} catch (e) { console.error('updateProjectiles error:', e); }

try {
    // Update particles
    updateParticles(dt);
} catch (e) { console.error('updateParticles error:', e); }

try {
    // Update regeneration
    updateRegeneration(dt);
} catch (e) { console.error('updateRegeneration error:', e); }

try {
    // Update ability system
    updateUnitEnergy(dt);
    updatePsiStorms(dt);
} catch (e) { console.error('updateAbilities error:', e); }

try {
    // Update enemy AI
    updateEnemyAI(dt);
} catch (e) { console.error('updateEnemyAI error:', e); }

try {
    // Check win/lose
    checkGameOver();
} catch (e) { console.error('checkGameOver error:', e); }

try {
    // Update HUD
    updateHUD();
} catch (e) { console.error('updateHUD error:', e); }

try {
    // Update selection panel continuously (for progress bars)
    updateSelectionPanel();
} catch (e) { console.error('updateSelectionPanel error:', e); }

}

// === UPDATE UNIT ===
function updateUnit(unit, dt, isPlayer) {
// Update attack cooldown
if (unit.attackCooldown > 0) {
unit.attackCooldown -= dt;
}

switch (unit.state) {
    case UNIT_STATE.IDLE:
        updateUnitIdle(unit, isPlayer, dt);
        break;
    case UNIT_STATE.MOVING:
        updateUnitMoving(unit, dt);
        break;
    case UNIT_STATE.ATTACKING:
        updateUnitAttacking(unit, dt, isPlayer);
        break;
    case UNIT_STATE.GATHERING:
        updateUnitGathering(unit, dt);
        break;
    case UNIT_STATE.RETURNING:
        updateUnitReturning(unit, dt);
        break;
}

}

// === UNIT IDLE STATE ===
function updateUnitIdle(unit, isPlayer, dt = 0.016) {
// Apply separation from nearby friendly units when idle (not sieged, burrowed or holding)
const separationForce = calculateSeparation(unit);
const separationMagnitude = Math.sqrt(separationForce.x * separationForce.x + separationForce.y * separationForce.y);

if (separationMagnitude > 10 && !unit.siegeMode && !unit.burrowed && !unit.holdPosition) {
    const pushSpeed = 0.5;  // Slow movement when idle
    unit.x += separationForce.x * pushSpeed * 0.016;
    unit.y += separationForce.y * pushSpeed * 0.016;
    unit.x = Math.max(10, Math.min(MAP_WIDTH - 10, unit.x));
    unit.y = Math.max(10, Math.min(MAP_HEIGHT - 10, unit.y));
}

// v33: an SCV assigned to a structure stays with it until it is finished (BW)
if (unit.type === 'worker' && unit.buildTarget) {
    const bt = unit.buildTarget;
    const owned = (unit.isPlayer ? gameState.buildings : gameState.enemyBuildings).includes(bt);
    if (owned && bt.hp > 0 && bt.isConstructing) {
        if (distance(unit.x, unit.y, bt.x, bt.y) > bt.size / 2 + 34) {
            unit.targetX = bt.x;
            unit.targetY = bt.y + bt.size / 2 + 14;
            unit.state = UNIT_STATE.MOVING;
        } else {
            unit.angle = Math.atan2(bt.y - unit.y, bt.x - unit.x);
            if (Math.random() < 0.06) unit.lastFiredAt = Date.now();   // welding
        }
        return;
    }
    unit.buildTarget = null;
}

// Worker auto-return to gathering if they have a valid resource target
if (unit.type === 'worker' && isPlayer) {
    if (unit.carryAmount > 0) {
        unit.state = UNIT_STATE.RETURNING;
        unit.returnTarget = findNearestBase(unit.x, unit.y, true);
        return;
    }
    if (unit.gatherTarget && unit.gatherTarget.amount > 0) {
        unit.state = UNIT_STATE.GATHERING;
        return;
    }
}

const raceData = RACES[unit.race];
const unitData = raceData?.units?.[unit.type];

// v33: Medic heals continuously (BW), costing energy
if (unitData?.healer) {
    updateHealer(unit, unitData, isPlayer, dt);
    return;
}

// v33: burrowed units neither acquire nor attack; workers never auto-acquire (BW)
if (unit.burrowed || unit.type === 'worker') return;
if (!(unit.damage > 0)) return;

const enemies = isPlayer ? gameState.enemyUnits : gameState.units;
const enemyBuildings = isPlayer ? gameState.enemyBuildings : gameState.buildings;

// v33: hold position engages only what is already in weapon range. Otherwise units acquire at
// the larger of their weapon range and the 6-tile acquisition radius, so a sieged tank now
// opens fire at 13 tiles instead of waiting until enemies close to 6.
const hgBonus = getTerrainAt(unit.x, unit.y) === TERRAIN.HIGH ? COMBAT.highGroundRangeBonus : 1;
const acquire = unit.holdPosition
    ? unit.range * TILE_SIZE * hgBonus
    : Math.max(COMBAT.autoAttackRange, unit.range * hgBonus) * TILE_SIZE;

const target = findBestTarget(unit, enemies, enemyBuildings, acquire);

if (target) {
    unit.target = target;
    unit.state = UNIT_STATE.ATTACKING;
}

}

// === UNIT MOVING STATE ===
function updateUnitMoving(unit, dt) {
if (unit.targetX === null || unit.targetY === null) {
unit.state = UNIT_STATE.IDLE;
return;
}
// v33: sieged tanks and burrowed units cannot move
if (unit.siegeMode || unit.burrowed) {
    if (unit.state === UNIT_STATE.MOVING) unit.state = UNIT_STATE.IDLE;
    unit.targetX = null;
    unit.targetY = null;
    return;
}

// Attack-move: check for enemies while moving
// v33 fix: only while actually moving. When called from a chase (state ATTACKING) this scan used to
// retarget and return before moving, freezing attack-moving units just outside their weapon range.
if (unit.attackMoveTarget && unit.type !== 'worker' && unit.state === UNIT_STATE.MOVING) {
    const raceData = RACES[unit.race];
    const unitData = raceData?.units?.[unit.type];
    if (!unitData?.healer) {  // Healers don't attack-move
        const enemies = unit.isPlayer ? gameState.enemyUnits : gameState.units;
        const enemyBuildings = unit.isPlayer ? gameState.enemyBuildings : gameState.buildings;
        const sightRange = Math.max(COMBAT.autoAttackRange, unit.range || 0) * TILE_SIZE;
        
        // Use intelligent target selection
        const target = findBestTarget(unit, enemies, enemyBuildings, sightRange);
        
        if (target) {
            // Found enemy - switch to attack but remember attack-move destination
            unit.target = target;
            unit.state = UNIT_STATE.ATTACKING;
            return;
        }
    }
}

const dx = unit.targetX - unit.x;
const dy = unit.targetY - unit.y;
const dist = Math.sqrt(dx * dx + dy * dy);

// Update facing angle toward movement direction
if (dist > 1) {
    unit.angle = Math.atan2(dy, dx);
}

if (dist < 15) {
    if (unit._chasing) return;          // chasing: let updateUnitAttacking decide
    // v33: patrol — turn around at each end and keep scanning (BW)
    if (unit.patrol && unit.state === UNIT_STATE.MOVING) {
        const p = unit.patrol;
        p.toB = !p.toB;
        const dest = p.toB ? p.b : p.a;
        unit.targetX = dest.x;
        unit.targetY = dest.y;
        unit.attackMoveTarget = (unit.type !== 'worker' && unit.damage > 0) ? { x: dest.x, y: dest.y } : null;
        unit.rampWaypoint = null;
        return;
    }
    unit.state = UNIT_STATE.IDLE;
    unit.targetX = null;
    unit.targetY = null;
    unit.rampWaypoint = null;
    unit.attackMoveTarget = null;  // Clear attack-move when reached
    return;
}

// Calculate separation from nearby units
const separationForce = calculateSeparation(unit);

// Move toward target with separation
const speed = unit.speed * TILE_SIZE * dt;
let moveX = (dx / dist) * speed + separationForce.x * dt;
let moveY = (dy / dist) * speed + separationForce.y * dt;

// Calculate proposed new position
let newX = unit.x + moveX;
let newY = unit.y + moveY;

// Check building collision - units cannot walk through buildings
const buildingCollision = checkBuildingCollision(newX, newY, unit);
if (buildingCollision.blocked) {
    // Try to slide around the building
    const slideResult = findBuildingSlide(unit, moveX, moveY, buildingCollision.building);
    if (slideResult) {
        newX = unit.x + slideResult.moveX;
        newY = unit.y + slideResult.moveY;
    } else {
        // Can't slide - need to pathfind around
        if (!unit.buildingWaypoint) {
            const waypoint = findBuildingWaypoint(unit, buildingCollision.building, unit.targetX, unit.targetY);
            if (waypoint) {
                unit.buildingWaypoint = waypoint;
                unit.originalTarget = { x: unit.targetX, y: unit.targetY };
            }
        }
        
        if (unit.buildingWaypoint) {
            // Move toward waypoint instead
            const wdx = unit.buildingWaypoint.x - unit.x;
            const wdy = unit.buildingWaypoint.y - unit.y;
            const wdist = Math.sqrt(wdx * wdx + wdy * wdy);
            
            if (wdist < 20) {
                // Reached waypoint, continue to original target
                unit.buildingWaypoint = null;
                if (unit.originalTarget) {
                    unit.targetX = unit.originalTarget.x;
                    unit.targetY = unit.originalTarget.y;
                    unit.originalTarget = null;
                }
            } else if (wdist > 0) {
                moveX = (wdx / wdist) * speed;
                moveY = (wdy / wdist) * speed;
                newX = unit.x + moveX;
                newY = unit.y + moveY;
                
                // Re-check collision on waypoint path
                const waypointCollision = checkBuildingCollision(newX, newY, unit);
                if (waypointCollision.blocked) {
                    // Still blocked - don't move
                    newX = unit.x;
                    newY = unit.y;
                }
            }
        } else {
            // No waypoint found - don't move into building
            newX = unit.x;
            newY = unit.y;
        }
    }
} else {
    // Clear building waypoint if we can now move freely
    if (unit.buildingWaypoint) {
        const directPath = checkBuildingCollision(unit.targetX, unit.targetY, unit);
        if (!directPath.blocked) {
            unit.buildingWaypoint = null;
            unit.originalTarget = null;
        }
    }
}

// Check if terrain transition is valid
if (!canTraverseTerrain(unit.x, unit.y, newX, newY, unit)) {
    // Need to find a ramp - set waypoint if not already set
    if (!unit.rampWaypoint) {
        const ramp = findNearestRamp(unit.x, unit.y, unit.targetX, unit.targetY);
        if (ramp) {
            unit.rampWaypoint = ramp;
            unit.finalTarget = { x: unit.targetX, y: unit.targetY };
        } else {
            // No ramp found - stop
            unit.state = UNIT_STATE.IDLE;
            unit.targetX = null;
            unit.targetY = null;
            addMessage('Cannot reach target - no ramp!', '#f88');
            return;
        }
    }
    
    // Move toward ramp waypoint instead
    if (unit.rampWaypoint) {
        const rdx = unit.rampWaypoint.x - unit.x;
        const rdy = unit.rampWaypoint.y - unit.y;
        const rdist = Math.sqrt(rdx * rdx + rdy * rdy);
        
        if (rdist < 30) {
            // Reached ramp, continue to final target
            unit.rampWaypoint = null;
            if (unit.finalTarget) {
                unit.targetX = unit.finalTarget.x;
                unit.targetY = unit.finalTarget.y;
                unit.finalTarget = null;
            }
            // Continue moving this frame toward new target
            const ndx = unit.targetX - unit.x;
            const ndy = unit.targetY - unit.y;
            const ndist = Math.sqrt(ndx * ndx + ndy * ndy);
            if (ndist > 0) {
                unit.x += (ndx / ndist) * speed;
                unit.y += (ndy / ndist) * speed;
            }
        } else {
            // Move toward ramp - also apply terrain check for intermediate moves
            const rampMoveX = (rdx / rdist) * speed;
            const rampMoveY = (rdy / rdist) * speed;
            const testX = unit.x + rampMoveX;
            const testY = unit.y + rampMoveY;
            
            // If we can't move directly to ramp either, try smaller steps
            if (canTraverseTerrain(unit.x, unit.y, testX, testY, unit)) {
                unit.x = testX + separationForce.x * dt;
                unit.y = testY + separationForce.y * dt;
            } else {
                // Try moving parallel to cliff edge
                const slideX = unit.x + rampMoveX;
                const slideY = unit.y;
                if (canTraverseTerrain(unit.x, unit.y, slideX, slideY, unit)) {
                    unit.x = slideX;
                } else {
                    unit.y += rampMoveY;
                }
            }
        }
    }
} else {
    // Clear waypoint if we can now traverse directly
    if (unit.rampWaypoint && canTraverseTerrain(unit.x, unit.y, unit.targetX, unit.targetY, unit)) {
        unit.rampWaypoint = null;
        unit.finalTarget = null;
    }
    
    unit.x += moveX;
    unit.y += moveY;
}

// Clamp to map bounds
unit.x = Math.max(10, Math.min(MAP_WIDTH - 10, unit.x));
unit.y = Math.max(10, Math.min(MAP_HEIGHT - 10, unit.y));

// Stuck detection - check if unit has moved since last check
const movedDist = distance(unit.x, unit.y, unit.lastPositionX || unit.x, unit.lastPositionY || unit.y);
const expectedMoveDist = unit.speed * TILE_SIZE * dt * 0.3; // 30% of expected movement

if (movedDist < expectedMoveDist && dist > 30) {
    // Unit hasn't moved much but still has distance to target
    unit.stuckTime = (unit.stuckTime || 0) + dt;
    
    if (unit.stuckTime > 2.0) { // Stuck for 2 seconds
        unit.stuckAttempts = (unit.stuckAttempts || 0) + 1;
        unit.stuckTime = 0;
        
        if (unit.stuckAttempts >= 3) {
            // Give up and disperse - move to random nearby location
            const disperseAngle = Math.random() * Math.PI * 2;
            const disperseDist = 60 + Math.random() * 60;
            unit.targetX = unit.x + Math.cos(disperseAngle) * disperseDist;
            unit.targetY = unit.y + Math.sin(disperseAngle) * disperseDist;
            unit.targetX = Math.max(50, Math.min(MAP_WIDTH - 50, unit.targetX));
            unit.targetY = Math.max(50, Math.min(MAP_HEIGHT - 50, unit.targetY));
            unit.rampWaypoint = null;
            unit.finalTarget = null;
            unit.attackMoveTarget = null;
            unit.stuckAttempts = 0;
        } else {
            // Try alternate path - offset target slightly
            const offsetAngle = Math.random() * Math.PI * 2;
            const offsetDist = 40 + Math.random() * 40;
            const altX = unit.targetX + Math.cos(offsetAngle) * offsetDist;
            const altY = unit.targetY + Math.sin(offsetAngle) * offsetDist;
            unit.rampWaypoint = { x: altX, y: altY };
        }
    }
} else {
    // Unit is moving - reset stuck timer
    unit.stuckTime = 0;
    if (movedDist > expectedMoveDist * 2) {
        unit.stuckAttempts = 0; // Reset attempts if making good progress
    }
}

// Update last position for next frame
unit.lastPositionX = unit.x;
unit.lastPositionY = unit.y;

}

// === CALCULATE UNIT SEPARATION FORCE ===
function calculateSeparation(unit) {
const separationRadius = 35;  // Units try to stay this far apart
const separationStrength = 150;  // How strongly they push apart
const buildingPushStrength = 300; // Stronger push from buildings
let forceX = 0;
let forceY = 0;

// Get all friendly units
const friendlyUnits = unit.isPlayer ? gameState.units : gameState.enemyUnits;

for (const other of friendlyUnits) {
    if (other.id === unit.id) continue;
    
    // Flying units only separate from other flying units
    if (unit.isFlying !== other.isFlying) continue;
    
    const dx = unit.x - other.x;
    const dy = unit.y - other.y;
    const dist = Math.sqrt(dx * dx + dy * dy);
    
    if (dist < separationRadius && dist > 0) {
        // Push away from nearby unit
        const strength = (separationRadius - dist) / separationRadius;
        forceX += (dx / dist) * strength * separationStrength;
        forceY += (dy / dist) * strength * separationStrength;
    }
}

// Flying units don't collide with buildings
if (unit.isFlying) {
    return { x: forceX, y: forceY };
}

// Push units away from buildings
const allBuildings = [...gameState.buildings, ...gameState.enemyBuildings];

// Find if this unit is gathering from a refinery (exempt that building from push)
let targetRefinery = null;
if (unit.state === UNIT_STATE.GATHERING && unit.gatherTarget && unit.gatherTarget.type === 'gas') {
    targetRefinery = getRefineryOnGas(unit.gatherTarget, unit.isPlayer);
}

for (const building of allBuildings) {
    // Don't push workers away from their target refinery
    if (targetRefinery && building.id === targetRefinery.id) continue;
    
    const halfSize = building.size / 2 + 15; // Building radius plus buffer
    const dx = unit.x - building.x;
    const dy = unit.y - building.y;
    const dist = Math.sqrt(dx * dx + dy * dy);
    
    if (dist < halfSize && dist > 0) {
        // Strong push away from building center
        const strength = (halfSize - dist) / halfSize;
        forceX += (dx / dist) * strength * buildingPushStrength;
        forceY += (dy / dist) * strength * buildingPushStrength;
    }
}

return { x: forceX, y: forceY };
}

// === BUILDING COLLISION DETECTION ===
function checkBuildingCollision(x, y, unit) {
    // Flying units don't collide with buildings
    if (unit && unit.isFlying) {
        return { blocked: false, building: null };
    }
    
    const allBuildings = [...gameState.buildings, ...gameState.enemyBuildings];
    const unitRadius = 12; // Unit collision radius
    
    // Find if this unit is gathering from a refinery (exempt that building)
    let targetRefinery = null;
    if (unit && unit.state === UNIT_STATE.GATHERING && unit.gatherTarget && unit.gatherTarget.type === 'gas') {
        targetRefinery = getRefineryOnGas(unit.gatherTarget, unit.isPlayer);
    }
    
    for (const building of allBuildings) {
        // Don't block workers from their target refinery
        if (targetRefinery && building.id === targetRefinery.id) continue;
        
        // Calculate building bounds with buffer
        const halfSize = building.size / 2;
        const left = building.x - halfSize - unitRadius;
        const right = building.x + halfSize + unitRadius;
        const top = building.y - halfSize - unitRadius;
        const bottom = building.y + halfSize + unitRadius;
        
        if (x >= left && x <= right && y >= top && y <= bottom) {
            // v33: already inside this footprint (leaving a refinery, spawned against a wall)?
            // then any move that doesn't go deeper is allowed
            if (unit && unit.x >= left && unit.x <= right && unit.y >= top && unit.y <= bottom) {
                const dNew = Math.max(Math.abs(x - building.x), Math.abs(y - building.y));
                const dOld = Math.max(Math.abs(unit.x - building.x), Math.abs(unit.y - building.y));
                if (dNew >= dOld - 0.01) continue;
            }
            return { blocked: true, building: building };
        }
    }
    
    return { blocked: false, building: null };
}

// === FIND SLIDE PATH AROUND BUILDING ===
function findBuildingSlide(unit, moveX, moveY, building) {
    const halfSize = building.size / 2 + 15;
    const unitRadius = 12;
    
    // Try horizontal slide
    const slideX = unit.x + moveX;
    const collision1 = checkBuildingCollision(slideX, unit.y, unit);
    if (!collision1.blocked) {
        return { moveX: moveX, moveY: 0 };
    }
    
    // Try vertical slide
    const slideY = unit.y + moveY;
    const collision2 = checkBuildingCollision(unit.x, slideY, unit);
    if (!collision2.blocked) {
        return { moveX: 0, moveY: moveY };
    }
    
    return null; // Can't slide
}

// === FIND WAYPOINT TO PATH AROUND BUILDING ===
function findBuildingWaypoint(unit, building, targetX, targetY) {
    const halfSize = building.size / 2 + 25; // Buffer for pathfinding
    
    // Determine which corners to consider based on target direction
    const corners = [
        { x: building.x - halfSize, y: building.y - halfSize }, // Top-left
        { x: building.x + halfSize, y: building.y - halfSize }, // Top-right
        { x: building.x - halfSize, y: building.y + halfSize }, // Bottom-left
        { x: building.x + halfSize, y: building.y + halfSize }, // Bottom-right
    ];
    
    // Find the corner that minimizes total path distance
    let bestCorner = null;
    let bestDist = Infinity;
    
    for (const corner of corners) {
        // Distance from unit to corner + corner to target
        const distToCorner = distance(unit.x, unit.y, corner.x, corner.y);
        const distToTarget = distance(corner.x, corner.y, targetX, targetY);
        const totalDist = distToCorner + distToTarget;
        
        // Make sure the corner itself isn't blocked
        const cornerBlocked = checkBuildingCollision(corner.x, corner.y, unit);
        
        if (totalDist < bestDist && !cornerBlocked.blocked) {
            bestDist = totalDist;
            bestCorner = corner;
        }
    }
    
    return bestCorner;
}

// === INTELLIGENT TARGET SELECTION ===
// Prioritizes targets based on threat level, distance, and tactical value
function findBestTarget(unit, enemies, enemyBuildings, maxRange) {
    let bestTarget = null;
    let bestScore = -Infinity;
    
    // Target scoring weights
    const WEIGHTS = {
        distance: -0.5,         // Prefer closer targets (negative = closer is better)
        threat: 2.0,            // Prioritize threats attacking us or allies
        lowHp: 1.5,             // Prioritize finishing off weak targets
        damageDealer: 1.2,      // Prioritize high-damage units
        activeTarget: 3.0,      // Heavily prioritize units/buildings that are attacking
        workerPenalty: -1.5,    // De-prioritize workers (unless nothing else)
        buildingPenalty: -2.0,  // De-prioritize buildings when units are available
    };
    
    // Check if any enemy units are actively attacking (not idle/passive)
    const hasActiveEnemyUnits = enemies.some(e => 
        e.hp > 0 && e.state === UNIT_STATE.ATTACKING && 
        distance(unit.x, unit.y, e.x, e.y) <= maxRange
    );
    
    // Evaluate enemy units
    for (const enemy of enemies) {
        if (enemy.hp <= 0 || !targetableBy(unit, enemy)) continue;
        
        // Check air/ground targeting compatibility
        if (enemy.isFlying && !unit.canAttackAir) continue;
        if (!enemy.isFlying && !unit.canAttackGround) continue;
        
        const dist = distance(unit.x, unit.y, enemy.x, enemy.y);
        if (rangeGap(unit, enemy) > maxRange) continue;
        
        let score = 0;
        
        // Distance scoring (normalized to 0-1 range)
        score += (1 - dist / maxRange) * 50 * WEIGHTS.distance * -1; // Convert to positive for closer
        
        // Is this enemy actively attacking? Big priority boost
        if (enemy.state === UNIT_STATE.ATTACKING) {
            score += WEIGHTS.activeTarget * 30;
            
            // Extra priority if attacking US or nearby allies
            if (enemy.target) {
                if (enemy.target.id === unit.id) {
                    score += 40; // Definitely attack back!
                } else if (distance(unit.x, unit.y, enemy.target.x, enemy.target.y) < 150) {
                    score += 20; // Attacking nearby ally
                }
            }
        }
        
        // Low HP bonus - finish them off
        const hpPercent = enemy.hp / enemy.maxHp;
        if (hpPercent < 0.3) {
            score += WEIGHTS.lowHp * 25;
        } else if (hpPercent < 0.5) {
            score += WEIGHTS.lowHp * 15;
        }
        
        // High damage dealers are priority targets
        if (enemy.damage && enemy.damage > 15) {
            score += WEIGHTS.damageDealer * 15;
        }
        
        // Worker penalty (unless they're the only option)
        if (enemy.type === 'worker') {
            score += WEIGHTS.workerPenalty * 20;
        }
        
        // Flying targets are harder to hit with ground units
        if (enemy.isFlying && unit.canAttackAir && !unit.isFlying) {
            score -= 5; // Slight penalty for ground-to-air
        }
        
        // Bonus for targets in attack range (can shoot immediately)
        const attackRange = (unit.range || 1) * TILE_SIZE;
        if (rangeGap(unit, enemy) <= attackRange) {
            score += 15;
        }
        
        if (score > bestScore) {
            bestScore = score;
            bestTarget = enemy;
        }
    }
    
    // Evaluate enemy buildings (buildings are always ground targets)
    // Only units that can attack ground can attack buildings
    if (unit.canAttackGround) {
        for (const building of enemyBuildings) {
            if (building.hp <= 0 || !targetableBy(unit, building)) continue;
            const dist = distance(unit.x, unit.y, building.x, building.y);
            if (rangeGap(unit, building) > maxRange) continue;
            
            let score = 0;
            
            // Distance scoring
            score += (1 - dist / maxRange) * 50 * WEIGHTS.distance * -1;
            
            // Is building actively attacking us? (turrets/defensive buildings)
            if (building.canAttack && building.target) {
                score += WEIGHTS.activeTarget * 25;
                if (building.target.id === unit.id) {
                    score += 30;
                }
            }
            
            // Heavy penalty for buildings when active enemy units exist
            if (hasActiveEnemyUnits) {
                score += WEIGHTS.buildingPenalty * 40;
            } else {
                // No active enemy units - buildings become more valuable targets
                score += WEIGHTS.buildingPenalty * 10; // Reduced penalty
            }
            
            // Production buildings are higher priority than others
            if (building.type === 'production' || building.type === 'base') {
                score += 10;
            }
            
            // Low HP buildings
            const hpPercent = building.hp / building.maxHp;
            if (hpPercent < 0.3) {
                score += WEIGHTS.lowHp * 15;
            }
            
            if (score > bestScore) {
                bestScore = score;
                bestTarget = building;
            }
        }
    }
    
    return bestTarget;
}

// === UNIT ATTACKING STATE ===
function updateUnitAttacking(unit, dt, isPlayer) {
if (!unit.target) {
    // No target - check if worker should return to gathering
    if (unit.type === 'worker' && unit.gatherTarget && unit.gatherTarget.amount > 0) {
        unit.state = UNIT_STATE.GATHERING;
    } else if (unit.attackMoveTarget) {
        // Resume attack-move to original destination
        unit.targetX = unit.attackMoveTarget.x;
        unit.targetY = unit.attackMoveTarget.y;
        unit.state = UNIT_STATE.MOVING;
    } else {
        unit.state = UNIT_STATE.IDLE;
    }
    return;
}

// Check if target is dead
if (unit.target.hp <= 0) {
    unit.target = null;
    // Workers should return to gathering if they have a valid target
    if (unit.type === 'worker' && unit.gatherTarget && unit.gatherTarget.amount > 0) {
        unit.state = UNIT_STATE.GATHERING;
    } else if (unit.attackMoveTarget) {
        // Resume attack-move to original destination
        unit.targetX = unit.attackMoveTarget.x;
        unit.targetY = unit.attackMoveTarget.y;
        unit.state = UNIT_STATE.MOVING;
    } else {
        unit.state = UNIT_STATE.IDLE;
    }
    return;
}

// Re-evaluate target periodically when attacking passive targets (buildings or idle units)
// This ensures units switch to active threats
if (!unit.targetRevalTime) unit.targetRevalTime = 0;
unit.targetRevalTime -= dt;

if (unit.targetRevalTime <= 0 && unit.type !== 'worker') {
    unit.targetRevalTime = 0.8; // Re-evaluate every 0.8 seconds
    
    const currentTarget = unit.target;
    const isCurrentTargetPassive = (
        (currentTarget.type && !currentTarget.isConstructing) || // It's a building
        (currentTarget.state && currentTarget.state !== UNIT_STATE.ATTACKING) // It's a non-attacking unit
    );
    
    if (isCurrentTargetPassive) {
        // Current target is passive - look for active threats
        const enemies = isPlayer ? gameState.enemyUnits : gameState.units;
        const enemyBuildings = isPlayer ? gameState.enemyBuildings : gameState.buildings;
        const searchRange = COMBAT.autoAttackRange * TILE_SIZE;
        
        // Check for active enemy units attacking us or nearby
        const activeThreats = enemies.filter(e => {
            if (e.hp <= 0) return false;
            if (e.state !== UNIT_STATE.ATTACKING) return false;
            const d = distance(unit.x, unit.y, e.x, e.y);
            return d <= searchRange;
        });
        
        if (activeThreats.length > 0) {
            // Switch to best active threat
            const betterTarget = findBestTarget(unit, enemies, enemyBuildings, searchRange);
            if (betterTarget && betterTarget !== currentTarget) {
                // Make sure the new target is actually better (is an active threat)
                const isNewTargetActive = (
                    betterTarget.state === UNIT_STATE.ATTACKING ||
                    (betterTarget.canAttack && betterTarget.target)
                );
                if (isNewTargetActive) {
                    unit.target = betterTarget;
                }
            }
        }
    }
}

const targetX = unit.target.x;
const targetY = unit.target.y;
// v33: BW measures weapon range edge to edge — melee units can finally reach structures
const gap = rangeGap(unit, unit.target);

// Face the target
unit.angle = Math.atan2(targetY - unit.y, targetX - unit.x);

// Calculate effective range
let effectiveRange = unit.range * TILE_SIZE;

// High ground range bonus
const unitTerrain = getTerrainAt(unit.x, unit.y);
const targetTerrain = getTerrainAt(targetX, targetY);
if (unitTerrain === TERRAIN.HIGH && targetTerrain === TERRAIN.LOW) {
    effectiveRange *= COMBAT.highGroundRangeBonus;
}

// v33: burrowed units cannot attack; lost detection or a target inside siege minimum range drops it
if (unit.burrowed || !targetableBy(unit, unit.target)) {
    unit.target = null;
    unit.state = UNIT_STATE.IDLE;
    return;
}

if (gap <= effectiveRange) {
    // In range - attack
    if (unit.attackCooldown <= 0) {
        fireProjectile(unit, unit.target, isPlayer);
        unit.attackCooldown = unit.attackSpeed || 1;
    }
} else if (unit.holdPosition || unit.siegeMode || !(unit.speed > 0)) {
    // v33: hold position / sieged — never chase
    unit.target = null;
    unit.state = UNIT_STATE.IDLE;
} else {
    // Move closer
    unit.targetX = targetX;
    unit.targetY = targetY;
    unit._chasing = true;
    updateUnitMoving(unit, dt);
    unit._chasing = false;
}

}

// === UNIT GATHERING STATE ===
function updateUnitGathering(unit, dt) {
// Safety check - if somehow not a worker, go idle
if (unit.type !== 'worker') {
    unit.state = UNIT_STATE.IDLE;
    unit.gatherTarget = null;
    return;
}

// Check if gather target is still valid
if (!unit.gatherTarget) {
    // Try to find a new resource
    const newTarget = findNearbyResource(unit.x, unit.y, null, unit.isPlayer);
    if (newTarget) {
        unit.gatherTarget = newTarget;
        unit.targetX = newTarget.x;
        unit.targetY = newTarget.y;
    } else {
        unit.state = UNIT_STATE.IDLE;
        return;
    }
}

// Check if resource is depleted
if (unit.gatherTarget.amount <= 0) {
    const resourceType = unit.gatherTarget.type;
    const newTarget = findNearbyResource(unit.x, unit.y, resourceType, unit.isPlayer);
    if (newTarget) {
        unit.gatherTarget = newTarget;
        unit.targetX = newTarget.x;
        unit.targetY = newTarget.y;
        if (unit.isPlayer) addMessage('Worker found new resource', '#4af');   // v33: AI workers stay silent
    } else {
        unit.gatherTarget = null;
        unit.state = UNIT_STATE.IDLE;
    }
    return;
}

// For gas, check if there's a refinery on it
if (unit.gatherTarget.type === 'gas') {
    const refinery = getRefineryOnGas(unit.gatherTarget, unit.isPlayer);
    if (!refinery) {
        // Can't gather gas without refinery - try to find minerals instead
        if (unit.isPlayer) {   // v33: AI workers stay silent; name the race's own gas structure
            const gasDef = RACES[unit.race] && RACES[unit.race].buildings.refinery;
            addMessage(`Need a ${gasDef ? gasDef.name : 'Refinery'} to gather gas!`, '#fa4');
        }
        const mineralTarget = findNearbyResource(unit.x, unit.y, 'mineral', unit.isPlayer);
        if (mineralTarget) {
            unit.gatherTarget = mineralTarget;
            unit.targetX = mineralTarget.x;
            unit.targetY = mineralTarget.y;
        } else {
            unit.gatherTarget = null;
            unit.state = UNIT_STATE.IDLE;
        }
        return;
    }
    
    // For gas, move to the refinery location, not the gas geyser
    const gatherDist = distance(unit.x, unit.y, refinery.x, refinery.y);
    
    if (gatherDist > 40) {
        // Move to refinery
        unit.targetX = refinery.x;
        unit.targetY = refinery.y;
        updateUnitMoving(unit, dt);
        unit.state = UNIT_STATE.GATHERING; // Stay in gathering state
    } else {
        // At refinery - gather gas
        const gatherAmount = RESOURCE.GAS.gatherRate * dt;
        const gathered = Math.min(gatherAmount, unit.gatherTarget.amount, 
            unit.carryCapacity - unit.carryAmount);
        
        unit.carryAmount += gathered;
        unit.gatherTarget.amount -= gathered;
        unit.carryingResource = 'gas';
        
        // Check if full
        if (unit.carryAmount >= unit.carryCapacity) {
            unit.state = UNIT_STATE.RETURNING;
            unit.returnTarget = null; // Will be set to base when returning
        }
    }
} else {
    // Mineral gathering
    const dist = distance(unit.x, unit.y, unit.gatherTarget.x, unit.gatherTarget.y);
    
    if (dist > 30) {
        // Move to resource
        unit.targetX = unit.gatherTarget.x;
        unit.targetY = unit.gatherTarget.y;
        updateUnitMoving(unit, dt);
        unit.state = UNIT_STATE.GATHERING; // Stay in gathering state
    } else {
        // At resource - gather
        const gatherAmount = RESOURCE.MINERAL.gatherRate * dt;
        const gathered = Math.min(gatherAmount, unit.gatherTarget.amount, 
            unit.carryCapacity - unit.carryAmount);
        
        unit.carryAmount += gathered;
        unit.gatherTarget.amount -= gathered;
        unit.carryingResource = 'mineral';
        
        // Check if full
        if (unit.carryAmount >= unit.carryCapacity) {
            unit.state = UNIT_STATE.RETURNING;
            unit.returnTarget = null; // Will be set when returning
        }
    }
}

}

// === GET REFINERY ON GAS (returns the refinery building or null) ===
function getRefineryOnGas(gasResource, isPlayer) {
    const buildings = isPlayer ? gameState.buildings : gameState.enemyBuildings;
    for (const b of buildings) {
        if (b.type === 'refinery' && !b.isConstructing) {
            if (distance(b.x, b.y, gasResource.x, gasResource.y) < 50) {
                return b;
            }
        }
    }
    return null;
}

// === CHECK IF GAS HAS REFINERY ===
function hasRefineryOnGas(gasResource, isPlayer) {
    return getRefineryOnGas(gasResource, isPlayer) !== null;
}

// === FIND NEARBY RESOURCE ===
function findNearbyResource(x, y, preferredType, isPlayer) {
    let nearest = null;
    let nearestDist = Infinity;
    const searchRadius = 500; // Search within this radius
    
    for (const res of gameState.resources) {
        if (res.amount <= 0) continue;
        
        // For gas, only consider if there's a refinery
        if (res.type === 'gas') {
            if (!hasRefineryOnGas(res, isPlayer)) continue;
        }
        
        const d = distance(x, y, res.x, res.y);
        if (d < searchRadius && d < nearestDist) {
            // Prefer same type if specified
            if (preferredType && res.type === preferredType) {
                nearestDist = d;
                nearest = res;
            } else if (!preferredType || !nearest) {
                nearestDist = d;
                nearest = res;
            }
        }
    }
    
    return nearest;
}

// === UNIT RETURNING STATE ===
function updateUnitReturning(unit, dt) {
if (!unit.returnTarget) {
    unit.returnTarget = findNearestDropoff(unit.x, unit.y, unit.isPlayer, unit.carryingResource);
    if (!unit.returnTarget) {
        unit.state = UNIT_STATE.IDLE;
        return;
    }
}

const dist = distance(unit.x, unit.y, unit.returnTarget.x, unit.returnTarget.y);
// v33: cargo is handed in anywhere along the depot's edge (box distance, like BW), not only
// inside a circle that diagonal approaches could never reach past the collision box
const edgeGap = Math.max(Math.abs(unit.x - unit.returnTarget.x), Math.abs(unit.y - unit.returnTarget.y)) - unit.returnTarget.size / 2;

if (edgeGap > 20) {
    // Move to dropoff point
    unit.targetX = unit.returnTarget.x;
    unit.targetY = unit.returnTarget.y;
    updateUnitMoving(unit, dt);
    unit.state = UNIT_STATE.RETURNING;
} else {
    // At dropoff - deposit
    if (unit.isPlayer) {
        if (unit.carryingResource === 'mineral') {
            gameState.minerals += unit.carryAmount;
            gameState.stats.resourcesGathered += unit.carryAmount;
        } else if (unit.carryingResource === 'gas') {
            gameState.gas += unit.carryAmount;
            gameState.stats.resourcesGathered += unit.carryAmount;
        }
    } else {
        // AI resource collection - per-player economy
        const aiPlayer = gameState.aiPlayers[unit.aiPlayerIndex];
        if (aiPlayer) {
            if (unit.carryingResource === 'mineral') {
                // v33 fix: the difficulty resource bonus (hard +1, brutal +2 per trip) now applies;
                // v32 tested a misspelt field so it never did
                aiPlayer.minerals += unit.carryAmount + ((AI_DIFFICULTY[gameOptions.aiDifficulty] || AI_DIFFICULTY.normal).resourceBonus || 0);
            } else if (unit.carryingResource === 'gas') {
                aiPlayer.gas += unit.carryAmount;
            }
        }
    }
    
    unit.carryAmount = 0;
    unit.carryingResource = null;
    unit.returnTarget = null;  // Clear return target so it will be recalculated
    
    // Go back to gathering
    if (unit.gatherTarget && unit.gatherTarget.amount > 0) {
        // For gas, re-check refinery exists
        if (unit.gatherTarget.type === 'gas') {
            if (hasRefineryOnGas(unit.gatherTarget, unit.isPlayer)) {
                unit.state = UNIT_STATE.GATHERING;
            } else {
                unit.gatherTarget = null;
                unit.state = UNIT_STATE.IDLE;
            }
        } else {
            unit.state = UNIT_STATE.GATHERING;
        }
    } else {
        // Try to find a new resource nearby
        const newTarget = findNearbyResource(unit.x, unit.y, unit.gatherTarget?.type, unit.isPlayer);
        if (newTarget) {
            unit.gatherTarget = newTarget;
            unit.state = UNIT_STATE.GATHERING;
        } else {
            unit.gatherTarget = null;
            unit.state = UNIT_STATE.IDLE;
        }
    }
}

}

// === FIND NEAREST DROPOFF POINT ===
// StarCraft-accurate: ALL resources (minerals AND gas) are returned to
// the nearest Command Center/Nexus/Hatchery. Refineries are harvest-from
// structures only, never dropoff points.
function findNearestDropoff(x, y, isPlayer, resourceType) {
    const buildings = isPlayer ? gameState.buildings : gameState.enemyBuildings;
    let nearest = null;
    let nearestDist = Infinity;
    
    for (const b of buildings) {
        // Only bases accept resource dropoffs
        if (b.type === 'base' && !b.isConstructing) {
            const d = distance(x, y, b.x, b.y);
            if (d < nearestDist) {
                nearestDist = d;
                nearest = b;
            }
        }
    }
    
    return nearest;
}

// === UPDATE BUILDING ===
function updateBuilding(building, dt, isPlayer) {
if (building.attackCooldown > 0) {
    building.attackCooldown -= dt;
}

// Construction progress - race-specific behaviors
if (building.isConstructing) {
    let buildRate = dt;

    // Coalition (Terran-like): an SCV must stay at the site — construction pauses without one
    if (building.race === 'coalition') {
        const pool = isPlayer ? gameState.units : gameState.enemyUnits;
        let attached = false;
        for (const u of pool) {
            if (u.type === 'worker' && distance(u.x, u.y, building.x, building.y) < building.size + 30) { attached = true; break; }
        }
        if (!attached) buildRate = 0;
    }
    // Terra Firma morphs on its own; Empyeran warps in on its own

    building.constructionProgress += buildRate;
    // v33: HP rises with progress, but damage taken while building now persists (BW)
    building.hp = Math.min(building.maxHp, building.hp + building.maxHp * 0.9 * buildRate / building.constructionTime);

    if (building.constructionProgress >= building.constructionTime) {
        building.constructionProgress = building.constructionTime;
        building.isConstructing = false;
        onBuildingComplete(building, isPlayer);
    }
    return;
}

// v33: BW — Empyeran structures outside Pylon power shut down completely
if (building.unpowered) return;

// Training queue
if (building.trainingQueue.length > 0) {
    const unitType = building.trainingQueue[0];
    const unitData = RACES[building.race].units[unitType];

    building.trainingProgress += dt;

    if (building.trainingProgress >= unitData.buildTime) {
        spawnUnitFromBuilding(building, unitType);
        building.trainingQueue.shift();
        building.trainingProgress = 0;

        if (isPlayer) {
            SoundSystem.play('complete');
            addMessage(`${unitData.name} ready!`, '#4f4');
            gameState.stats.unitsBuilt++;
        }
    }
}

// Research queue (for techlab buildings)
if (building.researchQueue && isPlayer) {
    building.researchQueue.progress += dt;

    if (building.researchQueue.progress >= building.researchQueue.totalTime) {
        const upgradeType = building.researchQueue.type;
        const upgradeData = UPGRADES[upgradeType];
        gameState.upgrades[upgradeType] = (gameState.upgrades[upgradeType] || 0) + 1;

        SoundSystem.play('upgrade');
        addMessage(`${upgradeData.name} Level ${gameState.upgrades[upgradeType]} complete!`, '#4f4');
        building.researchQueue = null;
        updateCommandCard();
    }
}

// Turret attack — v33: edge-to-edge range, keeps its target, detects burrowed units
if (building.damage > 0) {
    const enemies = isPlayer ? gameState.enemyUnits : gameState.units;
    const range = building.range * TILE_SIZE;
    const canAttackAir = building.canAttackAir !== false;
    const canAttackGround = building.canAttackGround !== false;
    const valid = (e) => e && e.hp > 0 && (e.isFlying ? canAttackAir : canAttackGround) && rangeGap(building, e) <= range && enemies.includes(e);

    if (!valid(building.target)) {
        building.target = null;
        let bestGap = Infinity;
        for (const enemy of enemies) {
            if (enemy.hp <= 0) continue;
            if (enemy.isFlying && !canAttackAir) continue;
            if (!enemy.isFlying && !canAttackGround) continue;
            const g = rangeGap(building, enemy);
            if (g <= range && g < bestGap) { bestGap = g; building.target = enemy; }
        }
    }
    if (building.target) {
        building.angle = Math.atan2(building.target.y - building.y, building.target.x - building.x);
        if (building.attackCooldown <= 0) {
            fireProjectile(building, building.target, isPlayer);
            building.attackCooldown = building.attackSpeed || 1;
        }
    }
}

}

// === FIRE PROJECTILE ===
// v33: per-weapon presentation and speed (WEAPON_FX / WEAPON_SPEED). Melee strikes resolve on the
// swing (BW melee has no projectile) and the Magma Titan's lance is an instant beam. Damage is
// computed here with the attacker's per-weapon upgrade step.
function fireProjectile(source, target, isPlayerSource) {
const colors = getRaceColors(source.race);
const projColor = colors ? colors.glow || colors.primary : (isPlayerSource ? '#4af' : '#f44');

// v32: record firing moment for muzzle flash / attack frame
source.lastFiredAt = Date.now();

const isB = isBuildingEntity(source);
const fxTable = WEAPON_FX[source.race] || {};
let fx = isB ? (source.type === 'turret' ? fxTable.turret : null) : fxTable[source.type];
if (source.siegeMode) fx = 'bigshell';
fx = fx || 'bolt';

const z0 = isB ? source.size * 0.42 : (source.isFlying ? COMBAT.flyingUnitElevation + 2 : 9);
const z1 = target.isFlying ? COMBAT.flyingUnitElevation : 6;
const proj = {
    x: source.x,
    y: source.y,
    targetX: target.x,
    targetY: target.y,
    target: target,
    source: source,
    damage: weaponDamageFor(source),
    speed: WEAPON_SPEED[fx] || COMBAT.projectileSpeed,
    isPlayerSource: isPlayerSource,
    color: projColor,
    race: source.race,
    fx: fx,
    z: z0, z0: z0, z1: z1
};

if (fx.startsWith('melee-')) {
    spawnMeleeFX(fx, source, target);
    resolveAttackHit(proj, target);
} else if (fx === 'beam') {
    if (!gameState.beams) gameState.beams = [];
    const a = Math.atan2(target.y - source.y, target.x - source.x);
    gameState.beams.push({ x1: source.x + Math.cos(a) * 10, y1: source.y - 26, x2: target.x, y2: target.y - z1, t: Date.now(), dur: 170, w: 2.4, inner: '#fff1c2', outer: 'rgba(251, 146, 60, 0.9)' });
    proj.impactX = target.x; proj.impactY = target.y;
    resolveAttackHit(proj, target);
    spawnImpactFX('beam', target.x, target.y, target);
} else {
    // muzzle flash at the weapon
    const a = Math.atan2(target.y - source.y, target.x - source.x);
    const r = isB ? source.size * 0.25 : entityRadius(source) * 0.9;
    proj.x = source.x + Math.cos(a) * r;
    proj.y = source.y + Math.sin(a) * r * 0.6;
    if (isOnScreen(proj.x, proj.y, 20)) {
        gameState.particles.push({ kind: 'flash', x: proj.x, y: proj.y - z0, vx: 0, vy: 0, life: 0.09, maxLife: 0.09, size: fx === 'bigshell' ? 14 : 7, color: fx === 'tracer' || fx.includes('shell') ? 'rgba(255, 214, 120, 0.95)' : projColor, noGravity: true });
    }
    gameState.projectiles.push(proj);
}

// Play attack sound (throttled)
if (Math.random() < 0.2) {
    SoundSystem.play('attack', { volume: 0.4 });
}
}

// === UPDATE PROJECTILES ===
function updateProjectiles(dt) {
const list = gameState.projectiles;
for (let i = list.length - 1; i >= 0; i--) {
    const proj = list[i];
    // v33 fix: Spine Volley shards had no speed (NaN positions — they never landed)
    if (!(proj.speed > 0)) proj.speed = COMBAT.projectileSpeed;

    // Home on the target while it lives
    if (proj.target && proj.target.hp > 0) {
        proj.targetX = proj.target.x;
        proj.targetY = proj.target.y;
    }

    const dx = proj.targetX - proj.x;
    const dy = proj.targetY - proj.y;
    const dist = Math.sqrt(dx * dx + dy * dy);
    if (proj.d0 === undefined) proj.d0 = Math.max(1, dist);
    const step = proj.speed * dt;

    if (dist < 10 || step >= dist || !isFinite(dist)) {
        proj.x = proj.targetX;
        proj.y = proj.targetY;
        if (proj.target && proj.target.hp > 0) resolveAttackHit(proj, proj.target);
        spawnImpactFX(proj.fx || 'bolt', proj.x, proj.y, proj.target);
        list.splice(i, 1);
        continue;
    }

    proj.x += (dx / dist) * step;
    proj.y += (dy / dist) * step;
    if (proj.z0 !== undefined) {
        const t = Math.max(0, Math.min(1, 1 - dist / proj.d0));
        proj.z = proj.z0 + (proj.z1 - proj.z0) * t + Math.sin(t * Math.PI) * (proj.fx === 'shell' || proj.fx === 'bigshell' ? 6 : 0);
    }
    // missile exhaust trail
    if (proj.fx === 'missile' && Math.random() < 0.5) {
        gameState.particles.push({ kind: 'smoke', x: proj.x, y: proj.y - (proj.z || 0), vx: 0, vy: -4, life: 0.5, maxLife: 0.5, size: 1.6, color: '#9ca3af', noGravity: true });
    }
}

}

// === DEAL DAMAGE ===
// v33: Brood War damage order. The attack's damage (base + per-weapon upgrade step) arrives from
// fireProjectile; shields absorb it first, less shield armour and immune to size modifiers; any
// overflow loses the target's armour, then the damage-type × size modifier applies, minimum 0.5.
// Spells (no weapon source) ignore armour and modifiers. proj.dmgMult scales splash/bounce hits.
function dealDamage(target, damage, proj) {
if (!target || target.hp <= 0) return 0;
const src = proj && proj.source;
const isSpell = !src || !!(proj && proj.isSpell);

// v33: BW high ground — a ranged shot from low ground at a target on high ground misses 46.875%
// of the time, with or without vision (v32: 30%, and only when the player could not see the tile)
if (attacksUphill(src, target, proj) && Math.random() < COMBAT.highGroundMissChance) {
    spawnMissParticle(target.x, target.y);
    return 0;
}

let dmg = damage * ((proj && proj.dmgMult) || 1);
const hp0 = target.hp, sh0 = target.shield || 0;

// Shields first: reduced by shield armour, no size modifier (BW)
if (target.shield > 0) {
    const sd = Math.max(0, dmg - (isSpell ? 0 : shieldArmorFor(target)));
    if (target.shield >= sd) { target.shield -= sd; dmg = 0; }
    else { dmg = sd - target.shield; target.shield = 0; }
}

// Overflow to hit points: armour, then type × size modifier, then the 0.5 floor
if (dmg > 0) {
    if (!isSpell) {
        dmg = Math.max(0, dmg - armorFor(target));
        const dmgType = src.damageType || (isBuildingEntity(src) && RACES[src.race]?.buildings?.[src.type]?.damageType) || 'normal';
        const targetSize = target.sizeClass || (isBuildingEntity(target) ? 'large' : 'medium');
        const mods = DAMAGE_MODIFIERS[dmgType];
        if (mods && mods[targetSize] !== undefined) dmg *= mods[targetSize];
        dmg = Math.max(COMBAT_V33.minDamage, dmg);
    }
    target.hp -= dmg;
}

const dealt = (hp0 - target.hp) + (sh0 - (target.shield || 0));

// v32: record hit moment for impact flash render
target.lastHitAt = Date.now();

// Play hit sound (throttled to prevent sound spam)
if (Math.random() < 0.15) {
    SoundSystem.play('hit', { volume: 0.6 });
}

// Track damage stats
if (target.isPlayer) {
    gameState.stats.damageTaken += dealt;
} else {
    gameState.stats.damageDealt += dealt;
}

// v33: StarCraft adviser alert + minimap ping when your forces are hit
const hostile = src ? !src.isPlayer : !!(proj && proj.ownerIsPlayer === false);
if (target.isPlayer && hostile && dealt > 0) notifyUnderAttack(target);

if (target.hp <= 0) {
    handleDeath(target);
}
return dealt;

}

// === HANDLE DEATH ===
function handleDeath(entity) {
if (entity._dead) return;
entity._dead = true;

// v33: race-specific death effects and lasting remains
spawnDeathFX(entity);

// Play death sound (throttled)
if (Math.random() < 0.3) {
    SoundSystem.play('death', { volume: 0.5 });
}

// v33: the dead leave the selection (v32 kept showing them in the console)
let selChanged = false;
const si = gameState.selectedUnits.indexOf(entity);
if (si !== -1) { gameState.selectedUnits.splice(si, 1); selChanged = true; }
if (gameState.selectedBuilding === entity) { gameState.selectedBuilding = null; selChanged = true; }
if (selChanged) { try { updateCommandCard(); } catch (e) { /* UI refresh is best-effort */ } }

let index = gameState.units.indexOf(entity);
if (index !== -1) {
    gameState.units.splice(index, 1);
    gameState.supplyUsed = Math.max(0, gameState.supplyUsed - (entity.supply || 0));
    gameState.stats.unitsLost++;
    return;
}

index = gameState.enemyUnits.indexOf(entity);
if (index !== -1) {
    gameState.enemyUnits.splice(index, 1);
    // v33 fix: AI supply is released when its units die (v32 never freed it — the AI supply-capped itself)
    const ai = gameState.aiPlayers && gameState.aiPlayers[entity.aiPlayerIndex];
    if (ai) ai.supply = Math.max(0, (ai.supply || 0) - (entity.supply || 0));
    gameState.stats.unitsKilled++;
    return;
}

index = gameState.buildings.indexOf(entity);
if (index !== -1) {
    gameState.buildings.splice(index, 1);
    // v33: only finished structures ever granted supply
    if (entity.providesSupply && !entity.isConstructing) {
        gameState.supplyMax -= entity.providesSupply;
    }
    if (entity.type === 'refinery') releaseGeyser(entity);
    releaseBuilders(entity);
    gameState.stats.buildingsLost++;
    return;
}

index = gameState.enemyBuildings.indexOf(entity);
if (index !== -1) {
    gameState.enemyBuildings.splice(index, 1);
    const ai = gameState.aiPlayers && gameState.aiPlayers[entity.aiPlayerIndex];
    if (ai && entity.providesSupply && !entity.isConstructing) ai.supplyMax = Math.max(0, (ai.supplyMax || 0) - entity.providesSupply);
    if (entity.type === 'refinery') releaseGeyser(entity);
    releaseBuilders(entity);
    gameState.stats.buildingsDestroyed++;
    return;
}

}

