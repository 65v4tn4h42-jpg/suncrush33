align-items: center;
gap: 6px;
margin-bottom: 2px;
font-size: 0.5rem;
margin-left: 4px;
}

#info-panel-content .pip-color {
width: 10px;
height: 10px;
border-radius: 2px;
}

/* ===== MESSAGE LOG ===== */
#message-log {
position: absolute;
bottom: 150px;
right: 10px;
width: 300px;
max-height: 120px;
overflow: hidden;
pointer-events: none;
z-index: 5;
text-align: right;
}

.game-message {
font-size: 0.75rem;
padding: 3px 8px;
margin-bottom: 2px;
background: rgba(0,0,0,0.6);
