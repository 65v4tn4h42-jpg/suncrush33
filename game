// Medic healing (BW): continuous, biological allies only, 1 energy per 2 HP
function updateHealer(unit, def, isPlayer, dt) {
    const allies = isPlayer ? gameState.units : gameState.enemyUnits;
    const reach = unit.range * TILE_SIZE * 2;
    let best = null, bestPct = 0.999;
    for (const a of allies) {
        if (a === unit || a.hp <= 0 || a.hp >= a.maxHp || !isBiological(a)) continue;
        const pct = a.hp / a.maxHp;
        if (pct < bestPct && distance(unit.x, unit.y, a.x, a.y) < reach) { bestPct = pct; best = a; }
    }
    if (!best) { unit.healTarget = null; return; }
    let amount = Math.min((def.healRate || 8) * dt, best.maxHp - best.hp);
    if (unit.maxEnergy > 0) amount = Math.min(amount, unit.energy * HEAL_HP_PER_ENERGY);
    if (amount <= 0.0001) { unit.healTarget = null; return; }
    if (unit.maxEnergy > 0) unit.energy = Math.max(0, unit.energy - amount / HEAL_HP_PER_ENERGY);
    best.hp = Math.min(best.maxHp, best.hp + amount);
    unit.healTarget = best;
    unit.angle = Math.atan2(best.y - unit.y, best.x - unit.x);
    const now = Date.now();
    if (!unit._beamT || now - unit._beamT > 90) {
        unit._beamT = now;
        unit.lastFiredAt = now;
        if (!gameState.beams) gameState.beams = [];
        const z2 = best.isFlying ? COMBAT.flyingUnitElevation : 7;
        gameState.beams.push({ x1: unit.x + Math.cos(unit.angle) * 5, y1: unit.y - 12, x2: best.x, y2: best.y - z2, t: now, dur: 120, w: 1.3, inner: '#ecfdf5', outer: 'rgba(52, 211, 153, 0.85)' });
        if (Math.random() < 0.25) spawnHealParticle(best.x, best.y);
    }
}

