// === TOGGLE SIEGE MODE (Coalition Siege Tank) ===
function toggleSiegeMode(unit) {
    const raceData = RACES[unit.race];
    const unitData = raceData.units[unit.type];
    
    if (!unitData?.canSiege) return;
    
    unit.siegeMode = !unit.siegeMode;
    SoundSystem.play('siege');
    
    if (unit.siegeMode) {
        // Enter siege mode - apply siege stats
        unit.baseDamage = unit.damage;
        unit.baseRange = unit.range;
        unit.baseSpeed = unit.speed;
        unit.baseAttackSpeed = unit.attackSpeed;
        
        unit.damage = unitData.siegeStats.damage;
        unit.range = unitData.siegeStats.range;
        unit.speed = unitData.siegeStats.speed;
        unit.attackSpeed = unitData.siegeStats.attackSpeed;
        unit.minRange = unitData.siegeStats.minRange;
        
        // Stop moving
        unit.state = UNIT_STATE.IDLE;
        unit.targetX = null;
        unit.targetY = null;
        // v33: orders end and the cannon needs a moment to deploy
        unit.target = null;
        unit.attackMoveTarget = null;
        unit.patrol = null;
        unit.attackCooldown = Math.max(unit.attackCooldown || 0, SIEGE_TRANSITION);

        addMessage('Siege mode activated!', '#4af');
        spawnSiegeParticles(unit.x, unit.y);
    } else {
        // Exit siege mode - restore normal stats
        unit.damage = unit.baseDamage || unitData.damage;
        unit.range = unit.baseRange || unitData.range;
        unit.speed = unit.baseSpeed || unitData.speed;
        unit.attackSpeed = unit.baseAttackSpeed || unitData.attackSpeed;
        unit.minRange = 0;
        unit.target = null;
        unit.state = UNIT_STATE.IDLE;
        unit.attackCooldown = Math.max(unit.attackCooldown || 0, SIEGE_TRANSITION);

        addMessage('Tank mode activated!', '#4af');
        spawnSiegeParticles(unit.x, unit.y);
    }
}

// === TOGGLE BURROW (Swarm Ultralisk) ===
function toggleBurrow(unit) {
    const raceData = RACES[unit.race];
    const unitData = raceData.units[unit.type];
    
    if (!unitData?.canBurrow) return;
    
    unit.burrowed = !unit.burrowed;
    SoundSystem.play('burrow');
    
    if (unit.burrowed) {
        // Enter burrow - hidden and regen HP
        unit.baseSpeed = unit.speed;
        unit.speed = 0;
        unit.hidden = true;
        
        // Stop moving
        unit.state = UNIT_STATE.IDLE;
        unit.target = null;
        unit.targetX = null;
        unit.targetY = null;
        
        addMessage('Burrowed!', '#059669');
        spawnBurrowParticles(unit.x, unit.y);
    } else {
        // Exit burrow
        unit.speed = unit.baseSpeed || unitData.speed;
        unit.hidden = false;
        
        addMessage('Unburrowed!', '#059669');
        spawnBurrowParticles(unit.x, unit.y);
    }
}

// === EXECUTE PHASE (Ascended Colossus) ===
function executePhase(unit, targetX, targetY) {
    const raceData = RACES[unit.race];
    const unitData = raceData.units[unit.type];
    
    if (!unitData?.canPhase) return false;
    
    const phaseRange = (unitData.phaseStats?.range || 6) * TILE_SIZE;
    const shieldCost = unitData.phaseStats?.shieldCost || 50;
    const cooldown = unitData.phaseStats?.cooldown || 10;
    
    // Check if phase is on cooldown
    if (unit.phaseCooldown > 0) {
        addMessage('Phase on cooldown!', '#fa4');
        return false;
    }
    
    // Check shield cost
    if (unit.shield < shieldCost) {
        addMessage('Not enough shields!', '#fa4');
        return false;
    }
    
    // Check range
    const dist = distance(unit.x, unit.y, targetX, targetY);
    if (dist > phaseRange) {
        addMessage('Target too far!', '#fa4');
        return false;
    }
    
    // Execute phase
    unit.shield -= shieldCost;
    unit.phaseCooldown = cooldown;
    
    SoundSystem.play('phase');
    
    // Spawn departure particles
    spawnPhaseParticles(unit.x, unit.y);
    
    // Teleport
    unit.x = targetX;
    unit.y = targetY;
    
    // Spawn arrival particles
    spawnPhaseParticles(unit.x, unit.y);
    
    addMessage('Phase complete!', '#b91c1c');
    return true;
}

