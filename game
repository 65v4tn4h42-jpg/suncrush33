    const LW = CW / PX, LH = CH / PX;           // 150 × 57.5 logo pixels
    const low = document.createElement('canvas'); low.width = LW; low.height = Math.ceil(LH);
    const c = low.getContext('2d');
    const sx = LW / 2, sy = 25;
    // --- rays (alternating long/short, two-tone) ---
    for (let i = 0; i < 16; i++) {
        const a = i / 16 * Math.PI * 2 - Math.PI / 2;
        const long = i % 2 === 0;
        const r0 = 15, r1 = long ? 29 : 23, hw = long ? 0.17 : 0.14;
        c.fillStyle = long ? '#f97316' : '#ea580c';
        c.beginPath();
        c.moveTo(sx + Math.cos(a - hw) * r0, sy + Math.sin(a - hw) * r0);
        c.lineTo(sx + Math.cos(a) * r1, sy + Math.sin(a) * r1);
        c.lineTo(sx + Math.cos(a + hw) * r0, sy + Math.sin(a + hw) * r0);
        c.closePath(); c.fill();
        c.fillStyle = long ? '#fbbf24' : '#f97316';
        c.beginPath();
        c.moveTo(sx + Math.cos(a - hw * 0.4) * r0, sy + Math.sin(a - hw * 0.4) * r0);
        c.lineTo(sx + Math.cos(a) * (r1 - 3), sy + Math.sin(a) * (r1 - 3));
        c.lineTo(sx + Math.cos(a + hw * 0.1) * r0, sy + Math.sin(a + hw * 0.1) * r0);
        c.closePath(); c.fill();
    }
    // --- banded sun disc ---
    const bands = [[17, '#c2410c'], [16, '#ea580c'], [14.5, '#f97316'], [12.5, '#fb923c'], [10.5, '#fbbf24'], [8, '#fcd34d'], [5, '#fde68a']];
    for (const [r, col] of bands) {
        c.fillStyle = col;
        c.beginPath(); c.arc(sx - (17 - r) * 0.25, sy - (17 - r) * 0.3, r, 0, Math.PI * 2); c.fill();
    }
    c.fillStyle = '#fff7d6'; c.fillRect(sx - 7, sy - 9, 3, 2); c.fillRect(sx - 8, sy - 7, 2, 2);
    // hard-threshold the sun so edges are crisp pixel steps
    const sid = c.getImageData(0, 0, low.width, low.height);
    for (let i = 3; i < sid.data.length; i += 4) sid.data[i] = sid.data[i] > 110 ? 255 : 0;
    c.putImageData(sid, 0, 0);
    // --- lettering ---
    const word = 'SUNCRUSH', cell = 2, gap = 1;
    const gw = 6, gh = 7;
    const totalW = word.length * gw * cell + (word.length - 1) * gap * cell;
    const tx = Math.round((LW - totalW) / 2), ty = 33;
    const textCanvas = document.createElement('canvas'); textCanvas.width = LW; textCanvas.height = Math.ceil(LH);
    const t = textCanvas.getContext('2d');
    const rowCol = ['#fef3c7', '#fde047', '#fcd34d', '#fbbf24', '#fb923c', '#f97316', '#ea580c'];
    for (let l = 0; l < word.length; l++) {
        const g = TITLE_GLYPHS[word[l]];
        const lx = tx + l * (gw + gap) * cell;
        for (let row = 0; row < gh; row++) for (let col = 0; col < gw; col++) {
            if (g[row][col] !== '#') continue;
            t.fillStyle = rowCol[row];
            t.fillRect(lx + col * cell, ty + row * cell, cell, cell);
        }
    }
    // extrusion (down-right) and dark outline, both at logo resolution
