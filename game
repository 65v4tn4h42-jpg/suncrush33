// === v33: VIEW + RENDER SCALE ===
// VIEW holds the game canvas size in CSS px (all camera/culling maths uses it);
// the backing store is VIEW × RENDER.scale (≤2) so art stays crisp on retina.
const VIEW = { w: 1280, h: 620 };
const FRAME = { overlays: [], now: 0, drawn: 0, lastPerfCheck: 0, samples: [] };

function resizeGameCanvas() {
    const canvas = document.getElementById('game-canvas');
    const container = document.getElementById('canvas-container');
    if (!canvas || !container) return false;
    const cw = Math.max(1, container.clientWidth || window.innerWidth || 1280);
    const ch = Math.max(1, container.clientHeight || window.innerHeight || 620);
    if (!RENDER.locked) RENDER.scale = Math.max(1, Math.min(RENDER.maxScale, window.devicePixelRatio || 1));
    const bw = Math.round(cw * RENDER.scale), bh = Math.round(ch * RENDER.scale);
    if (canvas.width !== bw || canvas.height !== bh) { canvas.width = bw; canvas.height = bh; }
    VIEW.w = cw; VIEW.h = ch;
    return true;
}

// Terrain art + sprite atlas are (re)built per battle for the current map
function currentTilesetKey() {
    const opt = (typeof gameOptions !== 'undefined' && gameOptions.tileset) || 'random';
    if (gameState.tileset && TILESETS[gameState.tileset]) return gameState.tileset;
    if (TILESETS[opt]) return opt;
    const keys = Object.keys(TILESETS);
    return keys[Math.floor(Math.random() * keys.length)];
}
function buildBattleArt() {
    const scale = Math.max(1, Math.min(2, window.devicePixelRatio || 1));
    SpriteCache.setScale(scale);
    gameState.tileset = currentTilesetKey();
    const avoid = [];
    for (const r of gameState.resources) avoid.push({ x: r.x, y: r.y, r: r.type === 'gas' ? 90 : 70 });
    for (const b of [...gameState.buildings, ...gameState.enemyBuildings]) if (b.type === 'base') avoid.push({ x: b.x, y: b.y, r: 150 });
    if (gameState.aiStartPositions) for (const p of gameState.aiStartPositions) avoid.push({ x: p.x, y: p.y, r: 150 });
    try { TerrainArt.build(TILESETS[gameState.tileset], scale, gameState.terrainMap, TILES_X, TILES_Y, avoid); } catch (e) { console.error('Terrain art build failed', e); }
    FogArt.reset();
    const races = new Set([gameState.selectedRace]);
    for (const ai of (gameState.aiPlayers || [])) races.add(ai.race);
    for (const e of [...gameState.enemyUnits, ...gameState.enemyBuildings]) if (e.race) races.add(e.race);
    try { SpriteCache.prewarm([...races].filter(Boolean)); } catch (e) { console.error('Sprite prewarm failed', e); }
}

// === MAIN RENDER ===
function render() {
const canvas = document.getElementById('game-canvas');
const ctx = canvas.getContext('2d');
resizeGameCanvas();
const t0 = performance.now();
const now = Date.now();
FRAME.now = now;
FRAME.overlays.length = 0;
const R = RENDER.scale, Z = gameState.camera.zoom, cam = gameState.camera;

ctx.setTransform(1, 0, 0, 1, 0, 0);
ctx.fillStyle = '#05060a';
ctx.fillRect(0, 0, canvas.width, canvas.height);
ctx.setTransform(R * Z, 0, 0, R * Z, -cam.x * R * Z, -cam.y * R * Z);
// nearest-neighbour when magnifying pixel art, smooth when shrinking
ctx.imageSmoothingEnabled = (R * Z) < SpriteCache.getScale() - 0.01;

renderTerrain(ctx);
renderDecals(ctx, now);
renderResources(ctx);

// Depth-sorted ground layer (buildings + ground units), then flyers on top
const ground = [], air = [];
for (const b of gameState.enemyBuildings) {
    if (!isOnScreen(b.x, b.y, b.size)) continue;
    if (isVisible(b.x, b.y)) b.seenByPlayer = true;
    else if (!b.seenByPlayer || !isExplored(b.x, b.y)) continue;   // BW: last-seen structures stay drawn under fog
    ground.push({ d: b.y + b.size * 0.18, b });
}
for (const b of gameState.buildings) {
    if (isOnScreen(b.x, b.y, b.size)) ground.push({ d: b.y + b.size * 0.18, b });
}
for (const u of gameState.enemyUnits) {
    if (!isOnScreen(u.x, u.y) || !isVisible(u.x, u.y)) continue;
    if (u.burrowed && !isDetected(u, true)) continue;   // burrowed enemies show only near your detectors (BW)
    (u.isFlying ? air : ground).push({ d: u.y, u });
}
for (const u of gameState.units) {
    if (!isOnScreen(u.x, u.y)) continue;
    (u.isFlying ? air : ground).push({ d: u.y, u });
}
ground.sort((a, b) => a.d - b.d);
air.sort((a, b) => a.d - b.d);
for (const e of ground) { if (e.b) renderBuilding(ctx, e.b); else renderUnit(ctx, e.u); }
for (const e of air) renderUnitShadow(ctx, e.u);
for (const e of air) renderUnit(ctx, e.u);

// Render psi storms and other ability effects
renderPsiStorms(ctx);

renderProjectiles(ctx);
renderParticles(ctx);
renderFog(ctx);
renderOverlays(ctx, now);
renderSelectionIndicators(ctx);

if (gameState.buildMode) renderBuildGhost(ctx);

// Screen-space layer (CSS px)
ctx.setTransform(R, 0, 0, R, 0, 0);
ctx.imageSmoothingEnabled = true;
renderScreenVignette(ctx);

if (gameState.isDragging && !gameState.isCommandDrag && !gameState.buildMode) {
    renderSelectionBox(ctx);
}

if (gameState.isCommandDrag && gameState.isDragging) {
    renderCommandDrag(ctx);
}

renderMinimap();
adaptRenderScale(performance.now() - t0);
}

// Drop to 1x backing store if frames are consistently slow on high-DPI devices
function adaptRenderScale(ms) {
    if (RENDER.locked || RENDER.scale <= 1) return;
    FRAME.samples.push(ms);
    if (FRAME.samples.length < 120) return;
    const avg = FRAME.samples.reduce((a, b) => a + b, 0) / FRAME.samples.length;
    FRAME.samples.length = 0;
    if (avg > 14) { RENDER.scale = 1; RENDER.locked = true; console.info('SunCrush: render scale lowered to 1x for performance (' + avg.toFixed(1) + 'ms/frame)'); }
}

function isExplored(x, y) {
    const tx = Math.floor(x / TILE_SIZE), ty = Math.floor(y / TILE_SIZE);
    const f = gameState.fogMap[ty]?.[tx];
    return f === FOG.EXPLORED || f === FOG.VISIBLE;
}

function renderScreenVignette(ctx) {
    if (!FRAME.vignette || FRAME.vignette.w !== VIEW.w || FRAME.vignette.h !== VIEW.h) {
        const cv = document.createElement('canvas'); cv.width = 256; cv.height = 256;
        const c = cv.getContext('2d');
        const g = c.createRadialGradient(128, 128, 70, 128, 128, 182);
        g.addColorStop(0, 'rgba(0,0,0,0)'); g.addColorStop(1, 'rgba(0,0,0,0.34)');
        c.fillStyle = g; c.fillRect(0, 0, 256, 256);
        FRAME.vignette = { cv, w: VIEW.w, h: VIEW.h };
    }
    ctx.drawImage(FRAME.vignette.cv, 0, 0, VIEW.w, VIEW.h);
}

// === RENDER TERRAIN ===
function renderTerrain(ctx) {
const cam = gameState.camera;
const startX = Math.floor(cam.x / TILE_SIZE) - 1;
const startY = Math.floor(cam.y / TILE_SIZE) - 1;
const endX = Math.ceil((cam.x + VIEW.w / cam.zoom) / TILE_SIZE) + 1;
const endY = Math.ceil((cam.y + VIEW.h / cam.zoom) / TILE_SIZE) + 1;
if (!TerrainArt.state || TerrainArt.state.map !== gameState.terrainMap) buildBattleArt();
TerrainArt.draw(ctx, startX, startY, endX, endY);
// map border: fade to black just outside the playable area
ctx.fillStyle = '#020305';
if (cam.x < 0) ctx.fillRect(cam.x - 50, cam.y - 50, -cam.x + 50, VIEW.h / cam.zoom + 100);
if (cam.y < 0) ctx.fillRect(cam.x - 50, cam.y - 50, VIEW.w / cam.zoom + 100, -cam.y + 50);
if (cam.x + VIEW.w / cam.zoom > MAP_WIDTH) ctx.fillRect(MAP_WIDTH, cam.y - 50, cam.x + VIEW.w / cam.zoom - MAP_WIDTH + 50, VIEW.h / cam.zoom + 100);
if (cam.y + VIEW.h / cam.zoom > MAP_HEIGHT) ctx.fillRect(cam.x - 50, MAP_HEIGHT, VIEW.w / cam.zoom + 100, cam.y + VIEW.h / cam.zoom - MAP_HEIGHT + 50);
}

// === RENDER RESOURCES ===
function renderResources(ctx) {
// Remove depleted resources
for (let i = gameState.resources.length - 1; i >= 0; i--) {
    if (gameState.resources[i].type === 'mineral' && gameState.resources[i].amount <= 0) {
        gameState.resources.splice(i, 1);
    }
}
const now = FRAME.now;
for (const res of gameState.resources) {
    if (!isOnScreen(res.x, res.y, 60)) continue;
    const tileX = Math.floor(res.x / TILE_SIZE);
    const tileY = Math.floor(res.y / TILE_SIZE);
    if (gameState.fogMap[tileY]?.[tileX] === FOG.UNEXPLORED) continue;
    if (res.type === 'mineral') {
        const pct = res.amount / (res.maxAmount || res.amount || 1);
        if (pct <= 0) continue;
        const stage = pct > 0.75 ? 0 : pct > 0.5 ? 1 : pct > 0.25 ? 2 : 3;
        const variant = res._v === undefined ? (res._v = (hashString(res.id) % 3)) : res._v;
        const spr = SpriteCache.mineral(stage, variant);
        SunForge.draw(ctx, spr, res.x, res.y + 8);
        // BW-style mineral sparkle
        const tw = (now / 900 + variant * 1.7 + res.x * 0.01) % 3;
        if (tw < 0.25) {
            const a = Math.sin(tw / 0.25 * Math.PI);
            ctx.save(); ctx.globalCompositeOperation = 'lighter'; ctx.globalAlpha = a * 0.9;
            ctx.fillStyle = '#e0f2ff';
            const sx = res.x - 4 + variant * 3, sy = res.y - 10 - stage * 1.5;
            ctx.fillRect(sx - 0.5, sy - 3, 1, 6); ctx.fillRect(sx - 3, sy - 0.5, 6, 1);
            ctx.restore();
        }
    } else {
        if (res.hasRefinery) continue;   // the refinery / extractor / tap is drawn on top
        const spr = SpriteCache.geyser(0);
        SunForge.draw(ctx, spr, res.x, res.y + 6);
        SunForge.drawGlow(ctx, spr, res.x, res.y + 6, 0.6 + Math.sin(now / 500 + res.x) * 0.2);
        // vespene plume puffs
        const k = res._puffT || 0;
        if (now - k > 260) {
            res._puffT = now;
            gameState.particles.push({ kind: 'gas', x: res.x + (Math.random() - 0.5) * 8, y: res.y - 2, vx: (Math.random() - 0.5) * 6, vy: -14 - Math.random() * 8, life: 1.8, maxLife: 1.8, size: 4 + Math.random() * 3, color: '#4ade80', noGravity: true });
        }
    }
}
}

function hashString(s) {
    s = String(s); let h = 2166136261;
    for (let i = 0; i < s.length; i++) { h ^= s.charCodeAt(i); h = Math.imul(h, 16777619); }
    return h >>> 0;
}

// === RENDER BUILDING ===
function renderBuilding(ctx, b) {
const now = FRAME.now;
const gy = b.y + b.size * 0.18;
if (b._ph === undefined) b._ph = (hashString(b.id) % 1000) / 1000 * 6;
const frame = Math.floor(now / 700 + b._ph) % 2;
const spr = SpriteCache.building(b.race, b.type, frame, b.size);
if (!spr) return;
const selected = gameState.selectedBuilding === b;
const visibleNow = b.isPlayer || isVisible(b.x, b.y);

// selection / ownership ellipse under the structure (BW convention)
if (selected) {
    ctx.save();
    ctx.strokeStyle = b.isPlayer ? 'rgba(80, 235, 110, 0.95)' : 'rgba(240, 80, 70, 0.95)';
    ctx.lineWidth = 2;
    ctx.beginPath();
    ctx.ellipse(b.x, gy + b.size * 0.06, b.size * 0.6, b.size * 0.36, 0, 0, Math.PI * 2);
    ctx.stroke();
    ctx.restore();
}

if (b.isConstructing) {
    renderConstruction(ctx, b, spr, gy, now);
} else {
    let sx = 1, sy = 1;
    if (b.race === 'swarm') { const br = Math.sin(now / 900 + b._ph); sx = 1 + br * 0.008; sy = 1 + br * 0.016; }
    SunForge.draw(ctx, spr, b.x, gy, sx, sy);
    const unpowered = b.unpowered;
    const glowA = unpowered ? 0.08 : 0.72 + Math.sin(now / 520 + b._ph) * 0.22;
    SunForge.drawGlow(ctx, spr, b.x, gy, glowA, sx, sy);
    if (unpowered) {
        ctx.save(); ctx.globalAlpha = 0.45;
        SunForge.draw(ctx, SpriteCache.silhouette(spr, '#0b0f1a'), b.x, gy, sx, sy);
        ctx.restore();
    }
    // production activity: occasional sparks / spores / embers while training
    if (visibleNow && b.trainingQueue && b.trainingQueue.length > 0 && Math.random() < 0.06) {
        const col = b.race === 'coalition' ? '#fde68a' : (b.race === 'swarm' ? '#bef264' : '#fb923c');
        gameState.particles.push({ kind: 'spark', x: b.x + (Math.random() - 0.5) * b.size * 0.5, y: gy - b.size * (0.2 + Math.random() * 0.3), vx: (Math.random() - 0.5) * 30, vy: -20 - Math.random() * 30, life: 0.6, maxLife: 0.6, size: 1.6, color: col });
    }
}

// v32: Impact flash — now a sprite-shaped white flash
if (b.lastHitAt) {
    const sinceHit = now - b.lastHitAt;
    if (sinceHit < 110 && sinceHit >= 0) {
        ctx.save();
        ctx.globalAlpha = 0.45 * (1 - sinceHit / 110);
        ctx.globalCompositeOperation = 'lighter';
        SunForge.draw(ctx, SpriteCache.silhouette(spr, '#ffffff'), b.x, gy);
        ctx.restore();
    }
}

// Damage state: BW-style burning structures (time-based emitters, visible ones only)
const hpPct = b.hp / b.maxHp;
if (!b.isConstructing && hpPct < 0.66 && visibleNow) {
    const intensity = 1 - hpPct / 0.66;
    const last = b._smokeT || 0;
    const interval = 220 - intensity * 150;
    if (now - last > interval) {
        b._smokeT = now;
        const fx = b.x + (Math.random() - 0.5) * b.size * 0.5;
        const fy = gy - b.size * (0.25 + Math.random() * 0.35);
        gameState.particles.push({ kind: 'smoke', x: fx, y: fy, vx: (Math.random() - 0.5) * 8 + 6, vy: -18 - Math.random() * 10, life: 2.2, maxLife: 2.2, size: 5 + Math.random() * 4, color: hpPct < 0.33 ? '#1f1d1b' : '#4b4a48', noGravity: true });
        if (hpPct < 0.33) gameState.particles.push({ kind: 'fire', x: fx, y: fy + 4, vx: (Math.random() - 0.5) * 6, vy: -22 - Math.random() * 14, life: 0.55, maxLife: 0.55, size: 4 + Math.random() * 3, color: '#fb923c', noGravity: true });
    }
}

if (selected || hpPct < 1 || (b.maxShield > 0 && b.shield < b.maxShield) || (b.isPlayer && b.trainingQueue && b.trainingQueue.length > 0)) {
    FRAME.overlays.push({ b });
}
}

// Race-specific construction presentation (Terran assembly, Zerg morph, Protoss warp-in)
function renderConstruction(ctx, b, spr, gy, now) {
    const p = Math.max(0, Math.min(1, b.constructionProgress / b.constructionTime));
    const top = gy - spr.oy / spr.scale, h = spr.h, w = spr.w, left = b.x - spr.ox / spr.scale;
    if (b.race === 'coalition') {
        const cut = top + h * (1 - p * 0.94 - 0.06);
        // blueprint ghost for the unbuilt part
        ctx.save(); ctx.beginPath(); ctx.rect(left - 2, top - 2, w + 4, cut - top + 2); ctx.clip();
        ctx.globalAlpha = 0.28; SunForge.draw(ctx, SpriteCache.silhouette(spr, '#7dd3fc'), b.x, gy);
        ctx.globalAlpha = 0.45; ctx.strokeStyle = '#fbbf24'; ctx.lineWidth = 0.8;
        const step = b.size / 6;
        for (let gx = b.x - b.size * 0.5; gx <= b.x + b.size * 0.5; gx += step) { ctx.beginPath(); ctx.moveTo(gx, cut); ctx.lineTo(gx, top + h * 0.2); ctx.stroke(); }
        for (let yy = cut; yy > top + h * 0.2; yy -= step * 0.7) { ctx.beginPath(); ctx.moveTo(b.x - b.size * 0.5, yy); ctx.lineTo(b.x + b.size * 0.5, yy); ctx.stroke(); }
        ctx.restore();
        ctx.save(); ctx.beginPath(); ctx.rect(left - 2, cut, w + 4, top + h - cut + 2); ctx.clip();
        SunForge.draw(ctx, spr, b.x, gy);
        ctx.restore();
        // welding sparks along the build line
        if (Math.random() < 0.35) {
            const sx = b.x + (Math.random() - 0.5) * b.size * 0.7;
            for (let i = 0; i < 3; i++) gameState.particles.push({ kind: 'spark', x: sx, y: cut, vx: (Math.random() - 0.5) * 70, vy: -30 - Math.random() * 50, life: 0.35, maxLife: 0.35, size: 1.4, color: Math.random() < 0.5 ? '#fff7cc' : '#fbbf24' });
        }
    } else if (b.race === 'swarm') {
        const k = 0.35 + 0.65 * p;
        const pulse = 1 + Math.sin(now / 240) * 0.03 * (1 - p);
        SunForge.draw(ctx, spr, b.x, gy, k * pulse, k * (2 - pulse));
        ctx.save(); ctx.globalAlpha = 0.55 * (1 - p);
        SunForge.draw(ctx, SpriteCache.silhouette(spr, '#3f6212'), b.x, gy, k * pulse, k * (2 - pulse));
        ctx.restore();
        ctx.save(); ctx.globalCompositeOperation = 'lighter'; ctx.globalAlpha = 0.25 + 0.15 * Math.sin(now / 300);
        ctx.fillStyle = '#84cc16'; ctx.beginPath(); ctx.ellipse(b.x, gy, b.size * 0.5 * k, b.size * 0.28 * k, 0, 0, Math.PI * 2); ctx.fill();
        ctx.restore();
    } else {
        // warp-in: cyan silhouette resolving into the structure
        ctx.save();
        ctx.globalAlpha = 0.35 + 0.25 * Math.sin(now / 160);
        ctx.globalCompositeOperation = 'lighter';
        SunForge.draw(ctx, SpriteCache.silhouette(spr, '#22d3ee'), b.x, gy);
        ctx.restore();
        ctx.save(); ctx.globalAlpha = Math.pow(p, 1.6);
        SunForge.draw(ctx, spr, b.x, gy);
        ctx.restore();
        const beamH = b.size * 1.3;
        ctx.save(); ctx.globalCompositeOperation = 'lighter';
        const g = ctx.createLinearGradient(0, gy - beamH, 0, gy);
        g.addColorStop(0, 'rgba(34,211,238,0)'); g.addColorStop(1, `rgba(34,211,238,${0.25 + 0.1 * Math.sin(now / 90)})`);
        ctx.fillStyle = g; ctx.fillRect(b.x - b.size * 0.3, gy - beamH, b.size * 0.6, beamH);
        ctx.restore();
        if (Math.random() < 0.3) gameState.particles.push({ kind: 'spark', x: b.x + (Math.random() - 0.5) * b.size * 0.6, y: gy - Math.random() * b.size * 0.6, vx: 0, vy: -30, life: 0.5, maxLife: 0.5, size: 1.5, color: '#a5f3fc', noGravity: true });
    }
}

// === RENDER UNIT ===
function unitAnimFrame(u, now) {
    if (u.lastFiredAt && now - u.lastFiredAt < 150 && now >= u.lastFiredAt) return 5;
    const anim = (UNIT_ANIM[u.race] && UNIT_ANIM[u.race][u.type]) || 'walk';
    if (u._rx !== undefined && (Math.abs(u.x - u._rx) + Math.abs(u.y - u._ry)) > 0.05) u._movedAt = now;
    u._rx = u.x; u._ry = u.y;
    const moving = u._movedAt && now - u._movedAt < 140;
    if (u.siegeMode || u.burrowed) return 0;
    if (anim === 'hover' || moving) {
        if (u._ph === undefined) u._ph = (hashString(u.id) % 1000) / 1000 * 4;
        const rate = moving ? 3.5 + (u.speed || 2) * 1.5 : 5;
        return 1 + (Math.floor(now / 1000 * rate + u._ph) % 4);
    }
    return 0;
}

function renderUnitShadow(ctx, u) {
    const r = unitRingRadius(u.race, u.type);
    ctx.fillStyle = 'rgba(0,0,0,0.22)';
    ctx.beginPath();
    ctx.ellipse(u.x + 6, u.y + 7, r * 0.8, r * 0.38, 0, 0, Math.PI * 2);
    ctx.fill();
}

function renderUnit(ctx, u) {
const now = FRAME.now;
const foot = unitFootOffset(u.race, u.type);
const gx = u.x, gy = u.y + foot;
if (u._ph === undefined) u._ph = (hashString(u.id) % 1000) / 1000 * 4;
const lift = u.isFlying ? COMBAT.flyingUnitElevation + Math.sin(now / 420 + u._ph) * 1.6 : 0;
const ringR = unitRingRadius(u.race, u.type);
const isSelected = gameState.selectedUnits.includes(u);

// Ground contact shadow + v32 team-colour ring (brighter when selected)
if (!u.isFlying) {
    ctx.fillStyle = 'rgba(0,0,0,0.3)';
    ctx.beginPath();
    ctx.ellipse(gx, gy, ringR * 0.9, ringR * 0.42, 0, 0, Math.PI * 2);
    ctx.fill();
}
const teamColor = u.isPlayer ? 'rgba(60, 220, 90,' : 'rgba(235, 70, 60,';
ctx.strokeStyle = teamColor + (isSelected ? '0.95)' : '0.42)');
ctx.lineWidth = isSelected ? 1.8 : 1.1;
ctx.beginPath();
ctx.ellipse(gx, gy - lift, ringR, ringR * 0.47, 0, 0, Math.PI * 2);
ctx.stroke();
if (isSelected) {
    ctx.strokeStyle = teamColor + '0.25)';
    ctx.lineWidth = 3.5;
    ctx.beginPath(); ctx.ellipse(gx, gy - lift, ringR + 1.5, ringR * 0.47 + 1, 0, 0, Math.PI * 2); ctx.stroke();
}

const dir = angleToDir(u.angle);
const frame = unitAnimFrame(u, now);
const variant = u.siegeMode ? 'sieged' : (u.burrowed ? 'burrowed' : '');
const spr = SpriteCache.unit(u.race, u.type, dir, u.siegeMode ? (frame === 5 ? 5 : 0) : frame, variant);
if (spr) {
    const prevA = ctx.globalAlpha;
    if (u.burrowed) ctx.globalAlpha = prevA * 0.75;
    SunForge.draw(ctx, spr, gx, gy - lift);
    SunForge.drawGlow(ctx, spr, gx, gy - lift, 0.78 + Math.sin(now / 380 + u._ph) * 0.18);
    ctx.globalAlpha = prevA;
    // v32 impact flash — sprite-shaped
    if (u.lastHitAt) {
        const sinceHit = now - u.lastHitAt;
        if (sinceHit < 110 && sinceHit >= 0) {
            ctx.save();
            ctx.globalAlpha = 0.65 * (1 - sinceHit / 110);
            ctx.globalCompositeOperation = 'lighter';
            SunForge.draw(ctx, SpriteCache.silhouette(spr, '#ffffff'), gx, gy - lift);
            ctx.restore();
        }
    }
}

// Carried cargo (BW: workers visibly haul a mineral chunk / gas canister)
if (u.carryAmount > 0 && u.type === 'worker') {
    const cs = SpriteCache.cargo(u.carryingResource === 'gas' ? 'gas' : 'mineral');
    const ca = u.angle || 0;
    const ox = Math.cos(ca) * 5, oy = Math.sin(ca) * 3;
    SunForge.draw(ctx, cs, gx + ox, gy - lift - (u.race === 'swarm' ? 7 : 3) + oy);
    SunForge.drawGlow(ctx, cs, gx + ox, gy - lift - 3 + oy, 0.7);
}

// Hold-position / patrol markers for your own selected units
if (u.isPlayer && isSelected && (u.holdPosition || u.patrol)) {
    ctx.save();
    ctx.fillStyle = u.holdPosition ? '#fde047' : '#7dd3fc';
    ctx.globalAlpha = 0.9;
    const mx = gx + ringR - 1, my = gy - lift + 2;
    if (u.holdPosition) { ctx.fillRect(mx - 1.5, my - 1.5, 3, 3); }
    else { ctx.beginPath(); ctx.moveTo(mx - 2, my - 2); ctx.lineTo(mx + 2, my); ctx.lineTo(mx - 2, my + 2); ctx.closePath(); ctx.fill(); }
    ctx.restore();
}

const showBars = isSelected || u.hp < u.maxHp || (u.maxShield > 0 && u.shield < u.maxShield);
if (showBars || (u.isPlayer && unitInControlGroup(u))) FRAME.overlays.push({ u, gx, gy: gy - lift, showBars, isSelected });
}

function unitInControlGroup(u) {
    for (let g = 1; g <= 9; g++) if (gameState.controlGroups[g] && gameState.controlGroups[g].includes(u.id)) return true;
    return false;
}

// Bars, badges and pips drawn after fog so they stay legible (StarCraft convention)
function renderOverlays(ctx, now) {
    for (const o of FRAME.overlays) {
        if (o.b) renderBuildingBars(ctx, o.b);
        else renderUnitBars(ctx, o);
    }
}

