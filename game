}

/* ===== GAME OVER OVERLAY ===== */
#game-over {
position: absolute;
inset: 0;
background: rgba(0, 0, 0, 0.85);
display: none;
flex-direction: column;
align-items: center;
justify-content: center;
z-index: 90;
}

#game-over.visible {
display: flex;
}

.game-over-title {
font-size: 3rem;
font-weight: bold;
text-transform: uppercase;
letter-spacing: 0.2em;
margin-bottom: 1rem;
}

.game-over-title.victory {
color: #4f4;
text-shadow: 0 0 30px rgba(68, 255, 68, 0.5);
}

.game-over-title.defeat {
color: #f44;
text-shadow: 0 0 30px rgba(255, 68, 68, 0.5);
}

.game-over-stats {
font-size: 1rem;
color: #888;
margin-bottom: 2rem;
}

#play-again-button {
padding: 1em 2em;
font-size: 1rem;
font-weight: bold;
text-transform: uppercase;
letter-spacing: 0.15em;
background: linear-gradient(180deg, #2a2a4a 0%, #1a1a2e 100%);
