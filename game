function attacksUphill(src, target, proj) {
    if (!src || !target || src.isFlying || target.isFlying) return false;
    if (proj && (proj.isSplash || proj.isSpell)) return false;
    if (proj && proj.fx && String(proj.fx).startsWith('melee')) return false;
    const def = !isBuildingEntity(src) && RACES[src.race] ? RACES[src.race].units[src.type] : null;
    if (src.siegeMode || (def && def.splash && !def.canSiege)) return false;
    return getTerrainAt(src.x, src.y) === TERRAIN.LOW && getTerrainAt(target.x, target.y) === TERRAIN.HIGH;
