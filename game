// v33: in-page confirmation — the first click arms the button for 3 s, the second acts
function armSecondClick(btn, armedLabel) {
    const now = Date.now();
    if (btn._armedUntil && now < btn._armedUntil) {
        btn._armedUntil = 0;
        if (btn._restLabel !== undefined) btn.textContent = btn._restLabel;
        return true;
    }
    btn._restLabel = btn.textContent;
    btn._armedUntil = now + 3000;
    if (armedLabel) btn.textContent = armedLabel;
    setTimeout(() => {
        if (btn._armedUntil && Date.now() >= btn._armedUntil) { btn._armedUntil = 0; btn.textContent = btn._restLabel; }
    }, 3100);
    return false;
}

// === TRAINING UI SETUP ===
function setupTrainingUI() {
    // Train AI button
    document.getElementById('train-ai-button').addEventListener('click', () => {
        document.getElementById('training-panel').classList.remove('hidden');
    });
    
    // Close training panel
    document.getElementById('close-training').addEventListener('click', (e) => {
        if (geneticState.isTraining) {
            if (armSecondClick(e.currentTarget)) {
                stopTraining();
                document.getElementById('start-training-btn').disabled = false;
                document.getElementById('pause-training-btn').disabled = true;
                document.getElementById('stop-training-btn').disabled = true;
                document.getElementById('pause-training-btn').textContent = '⏸ Pause';
                document.getElementById('training-panel').classList.add('hidden');
            } else {
                addBattleLogEntry('Training is running. Click ✕ again within 3 s to stop it and close.', 'battle-draw');
            }
        } else {
            document.getElementById('training-panel').classList.add('hidden');
        }
    });
    
    // Mutation rate slider display
    document.getElementById('train-mutation').addEventListener('input', (e) => {
        document.getElementById('mutation-display').textContent = e.target.value + '%';
    });
    
    // Start training button
    document.getElementById('start-training-btn').addEventListener('click', () => {
        const config = {
            populationSize: parseInt(document.getElementById('train-population').value),
            battlesPerGenome: parseInt(document.getElementById('train-battles').value),
            maxGenerations: parseInt(document.getElementById('train-generations').value),
            mutationRate: parseInt(document.getElementById('train-mutation').value) / 100,
            simTimeLimit: parseInt(document.getElementById('train-time-limit').value)
        };
        
        // Set up callbacks
        geneticState.onProgress = updateTrainingProgress;
        geneticState.onGenerationComplete = updateGenerationStats;
        geneticState.onTrainingComplete = onTrainingComplete;
        geneticState.maxGenerations = config.maxGenerations;
        
        // Update UI
        document.getElementById('start-training-btn').disabled = true;
        document.getElementById('pause-training-btn').disabled = false;
        document.getElementById('stop-training-btn').disabled = false;
        document.getElementById('train-gen-display').textContent = `0 / ${config.maxGenerations}`;
        document.getElementById('train-battle-display').textContent = `0 / ${config.populationSize * config.battlesPerGenome}`;
        document.getElementById('battle-log').innerHTML = '';
        
        startTraining(config);
    });
    
    // Pause training button
    document.getElementById('pause-training-btn').addEventListener('click', () => {
        if (geneticState.isPaused) {
            resumeTraining();
            document.getElementById('pause-training-btn').textContent = '⏸ Pause';
        } else {
            pauseTraining();
            document.getElementById('pause-training-btn').textContent = '▶ Resume';
        }
    });
    
    // Stop training button
    document.getElementById('stop-training-btn').addEventListener('click', (e) => {
        if (armSecondClick(e.currentTarget, 'Confirm stop')) {
            stopTraining();
            document.getElementById('start-training-btn').disabled = false;
            document.getElementById('pause-training-btn').disabled = true;
            document.getElementById('stop-training-btn').disabled = true;
            document.getElementById('pause-training-btn').textContent = '⏸ Pause';
        }
    });
    
    // Apply genome button
    document.getElementById('apply-genome-btn').addEventListener('click', () => {
        const genome = getBestGenome();
        if (genome) {
            applyGenomeToAI(genome);
            addBattleLogEntry('✓ Genome applied to game AI!', 'battle-win');
        }
    });
    
    // Export genome button
    document.getElementById('export-genome-btn').addEventListener('click', () => {
        const genome = getBestGenome();
        if (genome) {
            const json = exportGenome(genome);
            
            // Copy to clipboard
            const showForCopy = () => {   // v33: prompt() is refused in embedded viewers; select a text box instead
                addBattleLogEntry('Clipboard unavailable. Copy the genome JSON below.', 'battle-draw');
                const box = document.createElement('textarea');
                box.className = 'battle-log-entry genome-json';
                box.readOnly = true; box.value = json; box.rows = 4;
                box.style.cssText = 'width:100%;font:11px monospace;background:#05080e;color:#cbd5e1;border:1px solid #334155;user-select:text;-webkit-user-select:text;';
                const log = document.getElementById('battle-log');
                log.appendChild(box); log.scrollTop = log.scrollHeight;
                box.focus(); box.select();
            };
            try {
                navigator.clipboard.writeText(json).then(() => {
                    addBattleLogEntry('✓ Genome copied to clipboard!', 'battle-win');
                }).catch(showForCopy);
            } catch (err) { showForCopy(); }
        }
    });
}

// === TRAINING PROGRESS UPDATE ===
function updateTrainingProgress(progress) {
    const gs = geneticState;
    const totalBattles = gs.populationSize * gs.battlesPerGenome;
    const percent = (progress.currentBattle / totalBattles) * 100;
    
    document.getElementById('train-progress-bar').style.width = percent + '%';
    document.getElementById('train-battle-display').textContent = 
        `${progress.currentBattle} / ${totalBattles}`;
    
    // Add battle result to log
    const resultClass = progress.result.winner === 'ai' ? 'battle-win' : 
                        progress.result.winner === 'draw' ? 'battle-draw' : 'battle-loss';
    const duration = Math.floor(progress.result.duration);
    const logText = `G${progress.generation + 1}-${progress.genomeIndex + 1}: ${progress.result.winner.toUpperCase()} (${duration}s) ${progress.result.aiFaction} vs ${progress.result.playerFaction}`;
    addBattleLogEntry(logText, resultClass);
}

// === GENERATION STATS UPDATE ===
function updateGenerationStats(stats) {
    const gs = geneticState;
    
    document.getElementById('train-gen-display').textContent = 
        `${stats.generation + 1} / ${gs.maxGenerations}`;
    document.getElementById('best-fitness-display').textContent = 
        Math.floor(gs.bestFitness);
    document.getElementById('avg-fitness-display').textContent = 
        Math.floor(stats.avgFitness);
    
    // Calculate win rate
    let totalWins = 0;
    let totalBattles = 0;
    for (const results of gs.battleResults) {
        for (const r of results) {
            totalBattles++;
            if (r.winner === 'ai') totalWins++;
        }
    }
    const winRate = totalBattles > 0 ? Math.floor((totalWins / totalBattles) * 100) : 0;
    document.getElementById('win-rate-display').textContent = winRate + '%';
    document.getElementById('total-battles-display').textContent = totalBattles;
    
    // Update genome display
    if (gs.bestGenome) {
        updateGenomeDisplay(gs.bestGenome);
        document.getElementById('apply-genome-btn').disabled = false;
        document.getElementById('export-genome-btn').disabled = false;
    }
    
    // Draw fitness graph
    drawFitnessGraph();
    
    // Check if training should stop
    if (stats.generation >= gs.maxGenerations - 1) {
        stopTraining();
    }
}

// === TRAINING COMPLETE ===
function onTrainingComplete(result) {
    document.getElementById('start-training-btn').disabled = false;
    document.getElementById('pause-training-btn').disabled = true;
    document.getElementById('stop-training-btn').disabled = true;
    document.getElementById('pause-training-btn').textContent = '⏸ Pause';
    
    addBattleLogEntry(`══ TRAINING COMPLETE ══`, 'battle-win');
    addBattleLogEntry(`Generations: ${result.generations}`, 'battle-win');
    addBattleLogEntry(`Best Fitness: ${Math.floor(result.bestFitness)}`, 'battle-win');
}

// === UPDATE GENOME DISPLAY ===
function updateGenomeDisplay(genome) {
    const display = document.getElementById('genome-display');
    if (!genome || !display) return;   // v33: nothing evaluated yet
    
    let html = '<div style="line-height:1.6">';
    html += `<b>Army:</b> Sol:${(genome.soldierRatio*100).toFixed(0)}% Hvy:${(genome.heavyRatio*100).toFixed(0)}% Spc:${(genome.specialistRatio*100).toFixed(0)}% Fly:${(genome.flyerRatio*100).toFixed(0)}%<br>`;
    html += `<b>Attack:</b> ${Math.floor(genome.attackInterval)}s interval, ${Math.floor(genome.minWaveSize)}-${Math.floor(genome.maxWaveSize)} wave<br>`;
    html += `<b>Aggression:</b> ${(genome.aggression*100).toFixed(0)}% | Target: ${genome.targetPriority}<br>`;
    html += `<b>Workers:</b> ${Math.floor(genome.targetWorkers)} | Priority: ${(genome.workerPriority*100).toFixed(0)}%<br>`;
    html += `<b>Micro:</b> Retreat@${(genome.retreatThreshold*100).toFixed(0)}% | Focus:${genome.focusFireEnabled?'Y':'N'} | Kite:${genome.kitingEnabled?'Y':'N'}<br>`;
    html += `<b>Tech:</b> ${Math.floor(genome.upgradeDelay)}s delay | Priority: ${(genome.upgradePriority*100).toFixed(0)}%`;
    html += '</div>';
    
    display.innerHTML = html;
}

// === DRAW FITNESS GRAPH ===
function drawFitnessGraph() {
    const canvas = document.getElementById('fitness-graph');
    const ctx = canvas.getContext('2d');
    const stats = geneticState.generationStats;
    
    if (stats.length === 0) return;
    
    const w = canvas.width;
    const h = canvas.height;
    const padding = 10;
    
    ctx.clearRect(0, 0, w, h);
    
    // Background
    ctx.fillStyle = 'rgba(0, 0, 0, 0.3)';
    ctx.fillRect(0, 0, w, h);
    
    // Grid lines
    ctx.strokeStyle = 'rgba(255, 255, 255, 0.1)';
    ctx.lineWidth = 1;
    for (let i = 0; i < 4; i++) {
        const y = padding + (i / 3) * (h - 2 * padding);
        ctx.beginPath();
        ctx.moveTo(padding, y);
        ctx.lineTo(w - padding, y);
        ctx.stroke();
    }
    
    // Find max fitness for scaling
    const maxFitness = Math.max(...stats.map(s => s.maxFitness), 100);
    
    const graphW = w - 2 * padding;
    const graphH = h - 2 * padding;
    
    // Draw best fitness line
    ctx.strokeStyle = '#4ade80';
    ctx.lineWidth = 2;
    ctx.beginPath();
    for (let i = 0; i < stats.length; i++) {
        const x = padding + (i / Math.max(stats.length - 1, 1)) * graphW;
        const y = padding + graphH - (stats[i].maxFitness / maxFitness) * graphH;
        if (i === 0) ctx.moveTo(x, y);
        else ctx.lineTo(x, y);
    }
    ctx.stroke();
    
    // Draw average fitness line
    ctx.strokeStyle = '#8b5cf6';
    ctx.lineWidth = 1.5;
    ctx.beginPath();
    for (let i = 0; i < stats.length; i++) {
        const x = padding + (i / Math.max(stats.length - 1, 1)) * graphW;
        const y = padding + graphH - (stats[i].avgFitness / maxFitness) * graphH;
        if (i === 0) ctx.moveTo(x, y);
        else ctx.lineTo(x, y);
    }
    ctx.stroke();
    
    // Legend
    ctx.font = '10px sans-serif';
    ctx.fillStyle = '#4ade80';
    ctx.fillText('Best', w - 50, 15);
    ctx.fillStyle = '#8b5cf6';
    ctx.fillText('Avg', w - 50, 27);
}

// === ADD BATTLE LOG ENTRY ===
function addBattleLogEntry(text, className) {
    const log = document.getElementById('battle-log');
    const entry = document.createElement('div');
    entry.className = 'battle-log-entry ' + className;
    entry.textContent = text;
    log.appendChild(entry);
    log.scrollTop = log.scrollHeight;
    
    // Limit log entries
    while (log.children.length > 100) {
        log.removeChild(log.firstChild);
    }
}

