}

.pause-btn.primary {
border-color: #4af;
color: #fff;
}

.pause-btn.warning {
border-color: #f90;
}

.pause-btn.warning:hover {
border-color: #fb0;
box-shadow: 0 0 15px rgba(255, 153, 0, 0.3);
}

.pause-btn.danger {
border-color: #f44;
}

.pause-btn.danger:hover {
border-color: #f66;
box-shadow: 0 0 15px rgba(255, 68, 68, 0.3);
}

.pause-divider {
height: 1px;
background: #333;
margin: 0.5rem 0;
}

.pause-info {
font-size: 0.8rem;
color: #666;
text-align: center;
margin-top: 1rem;
}

/* ===== BUILD GHOST ===== */
.build-ghost {
position: absolute;
pointer-events: none;
border: 2px dashed #4af;
border-radius: 4px;
opacity: 0.6;
}

.build-ghost.invalid {
