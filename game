        const osc = this.ctx.createOscillator();
        const gain = this._createGain(vol * 0.25);
        
        osc.type = 'square';
        osc.frequency.setValueAtTime(200, now);
        osc.frequency.exponentialRampToValueAtTime(80, now + 0.05);
        
        gain.gain.exponentialRampToValueAtTime(0.001, now + 0.08);
        
        osc.connect(gain);
        osc.start(now);
        osc.stop(now + 0.1);
    },
    
    // Unit selection sound
    _playSelect(now, vol) {
        const osc = this.ctx.createOscillator();
        const gain = this._createGain(vol * 0.15);
        
        osc.type = 'sine';
        osc.frequency.setValueAtTime(500, now);
        osc.frequency.setValueAtTime(700, now + 0.03);
        
        gain.gain.exponentialRampToValueAtTime(0.001, now + 0.08);
        
        osc.connect(gain);
        osc.start(now);
        osc.stop(now + 0.1);
    },
    
    // UI click sound
    _playClick(now, vol) {
        const osc = this.ctx.createOscillator();
        const gain = this._createGain(vol * 0.1);
        
        osc.type = 'sine';
        osc.frequency.setValueAtTime(1000, now);
        
        gain.gain.exponentialRampToValueAtTime(0.001, now + 0.03);
        
        osc.connect(gain);
        osc.start(now);
        osc.stop(now + 0.05);
    },
    
    // Building placement sound
    _playBuild(now, vol) {
        const osc = this.ctx.createOscillator();
        const gain = this._createGain(vol * 0.2);
        
        osc.type = 'triangle';
        osc.frequency.setValueAtTime(200, now);
        osc.frequency.linearRampToValueAtTime(300, now + 0.1);
        osc.frequency.linearRampToValueAtTime(400, now + 0.2);
        
        gain.gain.exponentialRampToValueAtTime(0.001, now + 0.25);
        
        osc.connect(gain);
        osc.start(now);
        osc.stop(now + 0.3);
    },
    
    // Training/queue sound
    _playTrain(now, vol) {
        const osc = this.ctx.createOscillator();
        const gain = this._createGain(vol * 0.15);
        
        osc.type = 'sine';
        osc.frequency.setValueAtTime(400, now);
        osc.frequency.setValueAtTime(500, now + 0.05);
        osc.frequency.setValueAtTime(600, now + 0.1);
        
        gain.gain.exponentialRampToValueAtTime(0.001, now + 0.15);
        
        osc.connect(gain);
        osc.start(now);
        osc.stop(now + 0.18);
    },
    
    // Completion sound (building/unit ready)
    _playComplete(now, vol) {
        for (let i = 0; i < 3; i++) {
            const osc = this.ctx.createOscillator();
            const gain = this._createGain(vol * 0.12, 0.005);
            
            osc.type = 'sine';
            const freq = 600 + i * 200;
            osc.frequency.setValueAtTime(freq, now + i * 0.08);
            
            gain.gain.setValueAtTime(vol * 0.12, now + i * 0.08);
            gain.gain.exponentialRampToValueAtTime(0.001, now + i * 0.08 + 0.1);
            
            osc.connect(gain);
            osc.start(now + i * 0.08);
            osc.stop(now + i * 0.08 + 0.12);
        }
    },
    
    // Error/cannot do sound
    _playError(now, vol) {
        const osc = this.ctx.createOscillator();
        const gain = this._createGain(vol * 0.2);
        
        osc.type = 'square';
        osc.frequency.setValueAtTime(200, now);
        osc.frequency.setValueAtTime(150, now + 0.08);
        
        gain.gain.exponentialRampToValueAtTime(0.001, now + 0.15);
        
        osc.connect(gain);
        osc.start(now);
        osc.stop(now + 0.18);
    },
    
    // Upgrade complete sound
    _playUpgrade(now, vol) {
        for (let i = 0; i < 4; i++) {
            const osc = this.ctx.createOscillator();
            const gain = this._createGain(vol * 0.1, 0.005);
            
            osc.type = 'sine';
            const freq = 400 + i * 150;
            osc.frequency.setValueAtTime(freq, now + i * 0.06);
            
            gain.gain.setValueAtTime(vol * 0.1, now + i * 0.06);
            gain.gain.exponentialRampToValueAtTime(0.001, now + i * 0.06 + 0.12);
            
            osc.connect(gain);
            osc.start(now + i * 0.06);
            osc.stop(now + i * 0.06 + 0.15);
        }
    },
    
    // Move command sound
    _playMove(now, vol) {
        const osc = this.ctx.createOscillator();
        const gain = this._createGain(vol * 0.1);
        
        osc.type = 'sine';
        osc.frequency.setValueAtTime(600, now);
        osc.frequency.setValueAtTime(550, now + 0.04);
        
        gain.gain.exponentialRampToValueAtTime(0.001, now + 0.08);
        
        osc.connect(gain);
        osc.start(now);
        osc.stop(now + 0.1);
    },
    
    // Attack command sound
    _playAttackCommand(now, vol) {
        const osc = this.ctx.createOscillator();
        const gain = this._createGain(vol * 0.12);
        
        osc.type = 'sawtooth';
        osc.frequency.setValueAtTime(350, now);
        osc.frequency.setValueAtTime(500, now + 0.03);
        osc.frequency.setValueAtTime(350, now + 0.06);
        
        gain.gain.exponentialRampToValueAtTime(0.001, now + 0.1);
        
        osc.connect(gain);
        osc.start(now);
        osc.stop(now + 0.12);
    },
    
    // Unit death sound
    _playDeath(now, vol, options = {}) {
        // Noise burst
        const bufferSize = this.ctx.sampleRate * 0.2;
        const buffer = this.ctx.createBuffer(1, bufferSize, this.ctx.sampleRate);
        const data = buffer.getChannelData(0);
        
        for (let i = 0; i < bufferSize; i++) {
            const t = i / this.ctx.sampleRate;
            const envelope = Math.exp(-t * 12);
            data[i] = (Math.random() * 2 - 1) * envelope;
        }
        
        const noise = this.ctx.createBufferSource();
        noise.buffer = buffer;
        
        const filter = this.ctx.createBiquadFilter();
        filter.type = 'bandpass';
        filter.frequency.setValueAtTime(400, now);
        filter.Q.value = 1;
        
        const gain = this._createGain(vol * 0.25);
        gain.gain.exponentialRampToValueAtTime(0.001, now + 0.2);
        
        noise.connect(filter);
        filter.connect(gain);
        noise.start(now);
        
        // Low thud
        const osc = this.ctx.createOscillator();
        const oscGain = this._createGain(vol * 0.2);
        osc.type = 'sine';
        osc.frequency.setValueAtTime(100, now);
        osc.frequency.exponentialRampToValueAtTime(40, now + 0.15);
        oscGain.gain.exponentialRampToValueAtTime(0.001, now + 0.2);
        osc.connect(oscGain);
        osc.start(now);
        osc.stop(now + 0.25);
    },
    
    // Siege mode transformation sound
    _playSiege(now, vol) {
        const osc = this.ctx.createOscillator();
        const gain = this._createGain(vol * 0.2);
        
        osc.type = 'sawtooth';
        osc.frequency.setValueAtTime(150, now);
        osc.frequency.linearRampToValueAtTime(80, now + 0.3);
        
        gain.gain.linearRampToValueAtTime(vol * 0.15, now + 0.15);
        gain.gain.exponentialRampToValueAtTime(0.001, now + 0.35);
        
        osc.connect(gain);
        osc.start(now);
        osc.stop(now + 0.4);
    },
    
    // Burrow sound
    _playBurrow(now, vol) {
        const osc = this.ctx.createOscillator();
        const gain = this._createGain(vol * 0.15);
        
        osc.type = 'triangle';
        osc.frequency.setValueAtTime(300, now);
        osc.frequency.exponentialRampToValueAtTime(80, now + 0.2);
        
        gain.gain.exponentialRampToValueAtTime(0.001, now + 0.25);
        
        osc.connect(gain);
        osc.start(now);
        osc.stop(now + 0.3);
    },
    
    // Phase/teleport sound
    _playPhase(now, vol) {
        const osc = this.ctx.createOscillator();
        const gain = this._createGain(vol * 0.15);
        
        osc.type = 'sine';
        osc.frequency.setValueAtTime(300, now);
        osc.frequency.exponentialRampToValueAtTime(1200, now + 0.15);
        osc.frequency.exponentialRampToValueAtTime(400, now + 0.3);
        
        gain.gain.linearRampToValueAtTime(vol * 0.1, now + 0.15);
        gain.gain.exponentialRampToValueAtTime(0.001, now + 0.35);
        
        osc.connect(gain);
        osc.start(now);
        osc.stop(now + 0.4);
    },
    
    // Healing sound
    _playHeal(now, vol) {
        const osc = this.ctx.createOscillator();
        const gain = this._createGain(vol * 0.08);
        
        osc.type = 'sine';
        osc.frequency.setValueAtTime(800, now);
        osc.frequency.setValueAtTime(1000, now + 0.05);
        osc.frequency.setValueAtTime(900, now + 0.1);
        
        gain.gain.exponentialRampToValueAtTime(0.001, now + 0.15);
        
        osc.connect(gain);
        osc.start(now);
        osc.stop(now + 0.18);
    },
    
    // Generic ability sound
    _playAbility(now, vol) {
        const osc = this.ctx.createOscillator();
        const gain = this._createGain(vol * 0.15);
        
        osc.type = 'triangle';
        osc.frequency.setValueAtTime(500, now);
        osc.frequency.linearRampToValueAtTime(800, now + 0.1);
        osc.frequency.linearRampToValueAtTime(600, now + 0.2);
        
        gain.gain.exponentialRampToValueAtTime(0.001, now + 0.25);
        
        osc.connect(gain);
        osc.start(now);
        osc.stop(now + 0.3);
    }
};

