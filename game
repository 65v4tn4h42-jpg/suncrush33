#fitness-graph {
width: 100%;
height: 100px;
}

.genome-display {
background: rgba(0, 0, 0, 0.4);
border-radius: 6px;
padding: 0.8rem;
margin-bottom: 0.8rem;
font-family: monospace;
font-size: 0.7rem;
color: #8b5cf6;
max-height: 150px;
overflow-y: auto;
}

.genome-placeholder {
color: #444;
font-style: italic;
margin: 0;
}

.genome-actions {
display: flex;
gap: 0.5rem;
}

.battle-log {
background: rgba(0, 0, 0, 0.4);
border-radius: 6px;
padding: 0.5rem;
max-height: 120px;
overflow-y: auto;
font-size: 0.7rem;
font-family: monospace;
}

.battle-log-entry {
padding: 0.3rem 0;
border-bottom: 1px solid #222;
