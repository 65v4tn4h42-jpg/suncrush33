.training-panel {
position: fixed;
top: 50%;
left: 50%;
transform: translate(-50%, -50%);
width: 90%;
max-width: 500px;
max-height: 90vh;
background: linear-gradient(180deg, #1a1a2e 0%, #0d0d1a 100%);
border: 1px solid #444;
border-radius: 12px;
padding: 1.5rem;
z-index: 200;
overflow-y: auto;
box-shadow: 0 20px 60px rgba(0, 0, 0, 0.8);
}

.training-panel.hidden {
display: none;
}

.training-header {
display: flex;
justify-content: space-between;
align-items: center;
margin-bottom: 1rem;
padding-bottom: 0.8rem;
border-bottom: 1px solid #333;
}

.training-header h2 {
color: #c4b5fd;
font-size: 1.2rem;
margin: 0;
}

.training-close {
background: none;
border: none;
color: #666;
font-size: 1.5rem;
cursor: pointer;
transition: color 0.2s;
}

.training-close:hover {
color: #f44;
}

.training-config {
background: rgba(0, 0, 0, 0.3);
border-radius: 8px;
