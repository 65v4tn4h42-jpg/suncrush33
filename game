            const inside = val + (nz(x, y) - 0.5) * 0.42 > 0.5 ? 1 : 0;
            for (let yy = 0; yy < px && y + yy < N; yy++) for (let xx = 0; xx < px && x + xx < N; xx++) m[(y + yy) * N + x + xx] = inside;
        }
        maskCache.set(k, m);
        return m;
    }
    function patchTile(cls, c, sub) {
        const key = cls + '|' + c + '|' + sub;
        let cv = st.patchTiles.get(key);
        if (cv) return cv;
        const S = st.S, N = Math.round(T * S), px = Math.max(1, Math.round(S));
        cv = document.createElement('canvas'); cv.width = N; cv.height = N;
        const cx = cv.getContext('2d', { willReadFrequently: true });
