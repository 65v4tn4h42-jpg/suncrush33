// === UPDATE BUTTON AFFORDABILITY ===
function updateButtonAffordability() {
    const card = document.getElementById('command-card');
    if (!card) return;
    
    const buttons = card.querySelectorAll('.cmd-button');
    
    buttons.forEach(btn => {
        // Check if this is a build/train button with cost data
        const costMinerals = parseInt(btn.dataset.costMinerals) || 0;
        const costGas = parseInt(btn.dataset.costGas) || 0;
        const supply = parseFloat(btn.dataset.supply) || 0;
        
        if (costMinerals > 0 || costGas > 0) {
            const canAfford = gameState.minerals >= costMinerals && gameState.gas >= costGas;
            const hasSupply = supply === 0 || (gameState.supplyUsed + supply <= supplyCap(gameState.supplyMax));
            
            // Update disabled state
            if (canAfford && hasSupply && !btn.classList.contains('tech-locked') && !btn.classList.contains('unpowered')) {
                btn.classList.remove('disabled');
            } else {
                btn.classList.add('disabled');
            }
            
            // Update cost color indicators
            const costSpan = btn.querySelector('.cmd-cost');
            if (costSpan) {
                const mineralColor = gameState.minerals >= costMinerals ? '#4af' : '#f44';
                const gasColor = gameState.gas >= costGas ? '#4f4' : '#f44';
                
                let costHTML = `<span style="color:${mineralColor}">${costMinerals}</span>`;
                if (costGas > 0) {
                    costHTML += `<span style="color:${gasColor}; margin-left:4px">${costGas}</span>`;
                }
                costSpan.innerHTML = costHTML;
            }
        }
    });
}

