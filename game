function rigMineral(stage, variant) {
    // stage 0..3 (full → nearly depleted)
    const rnd = (k) => { const n = Math.sin((variant + 1) * 91.7 + k * 12.3) * 43758.5; return n - Math.floor(n); };
    Fz.groundEllipse(2, 3, 20, 13, 'rgba(0,0,0,0.3)');
    Fz.blob(0, 0, 1.5, 16, 2.4, ROCK_RAMP);
    const count = [6, 5, 4, 3][stage];
    const hMul = [1, 0.85, 0.68, 0.5][stage];
    const shards = [];
    for (let i = 0; i < count; i++) {
        const t = rnd(i) * Math.PI * 2, rr = 3 + rnd(i + 9) * 8;
        shards.push([Math.cos(t) * rr * 1.2, Math.sin(t) * rr * 0.8, (10 + rnd(i + 5) * 14) * hMul, 2.6 + rnd(i + 3) * 2.2, (rnd(i + 7) - 0.5) * 5]);
    }
    shards.push([0, 0, 22 * hMul, 4.6, 0]);
    shards.sort((a, b) => a[1] - b[1]);
    for (const [du, dv, h, r, lean] of shards) Fz.crystal(du, dv, 1.5, r, h, 0.5, MINERAL_RAMP, { sides: 5, rot: rnd(du) * 3, tip: [lean * 0.3, lean * 0.2] });
}
function rigGeyser(frame) {
