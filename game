}

.leaderboard-entry:hover {
background: rgba(60, 60, 90, 0.5);
}

.leaderboard-entry.current {
background: rgba(34, 197, 94, 0.15);
border: 1px solid rgba(34, 197, 94, 0.4);
}

.leaderboard-entry.current .rank,
.leaderboard-entry.current .player-name,
.leaderboard-entry.current .time,
.leaderboard-entry.current .score {
color: #4ade80;
font-weight: bold;
}

.leaderboard-entry .rank {
color: #666;
font-weight: bold;
text-align: center;
}

.leaderboard-entry .rank.gold { color: #fbbf24; }
.leaderboard-entry .rank.silver { color: #94a3b8; }
.leaderboard-entry .rank.bronze { color: #d97706; }

.leaderboard-entry .player-name {
color: #ccc;
white-space: nowrap;
overflow: hidden;
