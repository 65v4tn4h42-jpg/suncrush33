// === GENERATE UNIQUE ID ===
function generateId() {
return 'e' + (gameState.nextId++);
}

// === INITIALIZE TERRAIN MAP ===
function initializeMap() {
// Create terrain array (all low ground initially)
gameState.terrainMap = [];
for (let y = 0; y < TILES_Y; y++) {
gameState.terrainMap[y] = [];
for (let x = 0; x < TILES_X; x++) {
gameState.terrainMap[y][x] = TERRAIN.LOW;
}
}

// Create fog array (all unexplored)
gameState.fogMap = [];
for (let y = 0; y < TILES_Y; y++) {
    gameState.fogMap[y] = [];
    for (let x = 0; x < TILES_X; x++) {
        gameState.fogMap[y][x] = FOG.UNEXPLORED;
    }
}

// Add high ground plateaus - spread across larger map
addPlateau(20, 15, 14, 10);  // Top-left plateau
addPlateau(55, 10, 12, 8);   // Top-center plateau
addPlateau(35, 30, 10, 8);   // Mid-left plateau
addPlateau(50, 35, 14, 10);  // Center plateau
addPlateau(25, 50, 12, 8);   // Lower-left plateau
addPlateau(65, 45, 10, 8);   // Lower-right plateau

}

// === ADD PLATEAU WITH RAMPS ===
function addPlateau(startX, startY, width, height) {
// Fill plateau with high ground
for (let y = startY; y < startY + height && y < TILES_Y; y++) {
for (let x = startX; x < startX + width && x < TILES_X; x++) {
if (x >= 0 && y >= 0) {
gameState.terrainMap[y][x] = TERRAIN.HIGH;
}
}
}

// Add ramps on edges
const rampY = startY + Math.floor(height / 2);
const rampX = startX + Math.floor(width / 2);

// Left ramp
if (startX > 0) {
    for (let y = rampY - 1; y <= rampY + 1 && y < TILES_Y; y++) {
        if (y >= 0) {
            gameState.terrainMap[y][startX] = TERRAIN.RAMP;
        }
    }
}

// Right ramp
if (startX + width < TILES_X) {
    for (let y = rampY - 1; y <= rampY + 1 && y < TILES_Y; y++) {
        if (y >= 0) {
            gameState.terrainMap[y][startX + width - 1] = TERRAIN.RAMP;
        }
    }
}

// Bottom ramp
if (startY + height < TILES_Y) {
    for (let x = rampX - 1; x <= rampX + 1 && x < TILES_X; x++) {
        if (x >= 0) {
            gameState.terrainMap[startY + height - 1][x] = TERRAIN.RAMP;
        }
    }
}

}

// === GENERATE RESOURCES ===
// v33 fix: each AI's mineral field now sits at that AI's actual start corner, laid out like the
// player's (minerals behind the base, geysers in front). v32 shuffled the AI bases but not their
// resources, so an AI could spawn 450-600 px from the nearest patch.
function generateResources() {
gameState.resources = [];

const preset = RESOURCE_PRESETS[gameOptions.resourceAbundance];

// Player base resources (bottom-left corner)
addResourceCluster(350, MAP_HEIGHT - 400, preset);

if (!gameState.aiStartPositions) computeAIStartPositions();
for (const p of gameState.aiStartPositions) {
    addResourceCluster(p.x, p.y - 50, preset);
}

// Natural expansion locations (scaled to map size) — v33: nudged off cliff edges and ramps
addExpansionCluster(MAP_WIDTH / 2, MAP_HEIGHT / 2, preset);  // True center

// Only add extra expansions on medium/large maps
if (gameOptions.mapSize !== 'small') {
    addExpansionCluster(MAP_WIDTH / 4, MAP_HEIGHT / 4, preset);
    addExpansionCluster(MAP_WIDTH * 3/4, MAP_HEIGHT * 3/4, preset);
}

if (gameOptions.mapSize === 'large') {
    addExpansionCluster(MAP_WIDTH / 4, MAP_HEIGHT * 3/4, preset);
    addExpansionCluster(MAP_WIDTH * 3/4, MAP_HEIGHT / 4, preset);
    addExpansionCluster(MAP_WIDTH / 2, MAP_HEIGHT / 4, preset);
    addExpansionCluster(MAP_WIDTH / 2, MAP_HEIGHT * 3/4, preset);
}

}

// v33: a mineral line must sit on one terrain level (v32 placed some across plateau cliffs)
function clusterSiteOK(cx, cy, preset) {
    const lvl = getTerrainAt(cx, cy);
    if (lvl === TERRAIN.RAMP) return false;
    const pts = [[cx, cy]];
    const n = preset.mineralPatches;
    for (let i = 0; i < n; i++) {
        const a = (i / Math.max(n - 1, 1)) * Math.PI;
        const d = 120 + (i % 2) * 25;
        pts.push([cx + Math.cos(a) * d - 60, cy - 40 + Math.sin(a) * 30]);
    }
    for (let g = 0; g < preset.gasGeysers; g++) pts.push([cx + (g - (preset.gasGeysers - 1) / 2) * 140, cy + 150]);
    for (const [x, y] of pts) {
        if (x < 60 || y < 60 || x > MAP_WIDTH - 60 || y > MAP_HEIGHT - 60) return false;
        for (const [ox, oy] of [[0, 0], [-32, 0], [32, 0], [0, -32], [0, 32]]) {
            if (getTerrainAt(x + ox, y + oy) !== lvl) return false;
        }
    }
    return true;
}
function addExpansionCluster(cx, cy, preset) {
    if (!clusterSiteOK(cx, cy, preset)) {
        let found = null;
        for (let r = 40; r <= 520 && !found; r += 40) {
            for (let k = 0; k < 16 && !found; k++) {
                const a = k / 16 * Math.PI * 2;
                const x = Math.round(cx + Math.cos(a) * r), y = Math.round(cy + Math.sin(a) * r);
                if (clusterSiteOK(x, y, preset)) found = { x, y };
            }
        }
        if (found) { cx = found.x; cy = found.y; }
    }
    addResourceCluster(cx, cy, preset);
}

// === ADD RESOURCE CLUSTER ===
function addResourceCluster(centerX, centerY, preset = null) {
const resourcePreset = preset || RESOURCE_PRESETS[gameOptions.resourceAbundance];
const mineralCount = resourcePreset.mineralPatches;
const gasCount = resourcePreset.gasGeysers;
const mineralAmt = resourcePreset.mineralAmount;
const gasAmt = resourcePreset.gasAmount;

// Add mineral patches in arc formation on TOP side of cluster
for (let i = 0; i < mineralCount; i++) {
    // Spread minerals in a semi-circle on the top (negative Y direction)
    const angle = (i / Math.max(mineralCount - 1, 1)) * Math.PI;
    const dist = 120 + (i % 2) * 25;
    const x = centerX + Math.cos(angle) * dist - 60;
    const y = centerY - 40 + Math.sin(angle) * 30;

    gameState.resources.push({
        id: generateId(),
        type: 'mineral',
        x: x,
        y: y,
        amount: mineralAmt,
        maxAmount: mineralAmt
    });
}

// Add gas geysers - positioned on LEFT and RIGHT sides with more separation
for (let g = 0; g < gasCount; g++) {
    // Space geysers farther apart horizontally
    const geyserOffset = (g - (gasCount - 1) / 2) * 140;  // Increased from 100 to 140
    const geyserX = centerX + geyserOffset;
    // Place geysers at same Y level, below minerals
    gameState.resources.push({
        id: generateId(),
        type: 'gas',
        x: geyserX,
        y: centerY + 150,  // v33: was +130 — a refinery there overlapped the main building's footprint margin
        amount: gasAmt,
        maxAmount: gasAmt,
        hasRefinery: false
    });
}

}

// === INITIALIZE PLAYER ===
function initializePlayer() {
const race = gameState.selectedRace;
const raceData = RACES[race];
const baseX = 350;
const baseY = MAP_HEIGHT - 350;

// Create base building
const base = createBuilding('base', race, baseX, baseY, true);
gameState.buildings.push(base);

// Update supply
gameState.supplyMax = base.providesSupply || 0;

// Spawn workers in uniform grid formation around base
const workersPerRow = 3;
const spacing = 40;
const startX = baseX - spacing;
const startY = baseY + base.size / 2 + 30;

for (let i = 0; i < STARTING.workers; i++) {
    const row = Math.floor(i / workersPerRow);
    const col = i % workersPerRow;
    const x = startX + col * spacing;
    const y = startY + row * spacing;
    
    const worker = createUnit('worker', race, x, y, true);
    // v31: starting workers now auto-mine, matching StarCraft behavior. Previously sat idle.
    assignWorkerAutoMine(worker, true, x, y);
    gameState.units.push(worker);
    gameState.supplyUsed += worker.supply;
}

// Set initial camera position (use canvas dimensions)
const canvas = document.getElementById('game-canvas');
const viewWidth = canvas ? VIEW.w / gameState.camera.zoom : window.innerWidth;
const viewHeight = canvas ? VIEW.h / gameState.camera.zoom : window.innerHeight;
gameState.camera.x = baseX - viewWidth / 2;
gameState.camera.y = baseY - viewHeight / 2;
clampCamera();

}

// === INITIALIZE ENEMY ===
function initializeEnemy() {
const numAI = gameOptions.playerCount - 1;
// v33: corners come from computeAIStartPositions() so bases and resource fields agree
if (!gameState.aiStartPositions || gameState.aiStartPositions.length < numAI) computeAIStartPositions();
const startPositions = gameState.aiStartPositions;

gameState.aiPlayers = [];
const races = ['coalition', 'swarm', 'ascended'];

for (let i = 0; i < numAI; i++) {
    let aiRace;
    const aiOption = gameOptions.aiPlayers[i];
    if (aiOption.faction === 'random') {
        // Pick random race, preferring ones not already used
        const usedRaces = [gameState.selectedRace, ...gameState.aiPlayers.map(p => p.race)];
        const availableRaces = races.filter(r => !usedRaces.includes(r));
        aiRace = availableRaces.length > 0
            ? availableRaces[Math.floor(Math.random() * availableRaces.length)]
            : races[Math.floor(Math.random() * races.length)];
    } else {
        aiRace = aiOption.faction;
    }

    const pos = startPositions[i];
    // v33: supply is tallied from what the AI actually owns (v32 hard-coded 6/10)
    const aiPlayer = { index: i, race: aiRace, minerals: STARTING.minerals, gas: STARTING.gas, supply: 0, supplyMax: 0, eliminated: false };
    gameState.aiPlayers.push(aiPlayer);

    const base = createBuilding('base', aiRace, pos.x, pos.y, false);
    base.aiPlayerIndex = i;
    gameState.enemyBuildings.push(base);
    aiPlayer.supplyMax += base.providesSupply || 0;

    // Production building beside the base, toward the map centre, clear of minerals and geysers
    const side = pos.x > MAP_WIDTH / 2 ? -1 : 1;
    const prod = createBuilding('production', aiRace, pos.x + side * 135, pos.y + 5, false);
    prod.aiPlayerIndex = i;
    gameState.enemyBuildings.push(prod);

    // v33: an Empyeran Crucible needs Pylon power (BW), so the AI's free one comes with a Pylon
    if (aiRace === 'ascended') {
        const pylon = createBuilding('supply', aiRace, pos.x + side * 160, pos.y + 70, false);
        pylon.aiPlayerIndex = i;
        gameState.enemyBuildings.push(pylon);
        aiPlayer.supplyMax += pylon.providesSupply || 0;
    }

    // Spawn workers in uniform grid formation
    const workersPerRow = 3;
    const spacing = 40;
    const workerStartX = pos.x - spacing;
    const workerStartY = pos.y + 80;
    for (let w = 0; w < 6; w++) {
        const x = workerStartX + (w % workersPerRow) * spacing;
        const y = workerStartY + Math.floor(w / workersPerRow) * spacing;
        const worker = createUnit('worker', aiRace, x, y, false);
        worker.aiPlayerIndex = i;
        // v31: AI starting workers auto-mine, matching StarCraft behavior.
        assignWorkerAutoMine(worker, false, x, y);
        gameState.enemyUnits.push(worker);
        aiPlayer.supply += worker.supply;
    }

    // Spawn initial soldiers in line formation
    for (let s = 0; s < 3; s++) {
        const soldier = createUnit('soldier', aiRace, pos.x - 60 + s * 60, pos.y - 110, false);
        soldier.aiPlayerIndex = i;
        gameState.enemyUnits.push(soldier);
        aiPlayer.supply += soldier.supply;
    }
}

// Set enemyRace to first AI's race for backwards compatibility
gameState.enemyRace = gameState.aiPlayers.length > 0 ? gameState.aiPlayers[0].race : 'swarm';

}

// === CREATE UNIT ===
function createUnit(type, race, x, y, isPlayer) {
const raceData = RACES[race];
const unitData = raceData.units[type];

const unit = {
    id: generateId(),
    type: type,
    race: race,
    isPlayer: isPlayer,
    x: x,
    y: y,
    targetX: null,
    targetY: null,
    hp: unitData.hp,
    maxHp: unitData.hp,
    shield: unitData.shield || 0,
    maxShield: unitData.shield || 0,
    damage: unitData.damage,
    range: unitData.range,
    speed: unitData.speed,
    attackSpeed: unitData.attackSpeed || 1,
    attackCooldown: 0,
    sight: unitData.sight,
    supply: unitData.supply,
    // v32: damage type + size class for counter system
    damageType: unitData.damageType || 'normal',
    sizeClass: unitData.sizeClass || 'medium',
    state: UNIT_STATE.IDLE,
    target: null,
    gatherTarget: null,
    carryingResource: null,
    carryAmount: 0,
    carryCapacity: unitData.carryCapacity || 0,
    returnTarget: null,
    // Flying and air combat
    isFlying: unitData.isFlying || false,
    canAttackAir: unitData.canAttackAir !== false,  // Default true
    canAttackGround: unitData.canAttackGround !== false,  // Default true
    // Energy system for abilities
    energy: unitData.energy || 0,
    maxEnergy: unitData.maxEnergy || 0,
    energyRegen: unitData.energyRegen || 0,
    abilities: unitData.abilities || [],
    abilityCooldowns: {},
    // Ability targeting
    abilityTarget: null,
    castingAbility: null,
    // Stuck detection
    lastPositionX: x,
    lastPositionY: y,
    stuckTime: 0,
    stuckAttempts: 0,
    // Unit facing direction (radians, 0 = right)
    angle: Math.random() * Math.PI * 2,
    // Attack-move state
    attackMoving: false,
    // v33: BW armour / per-weapon upgrade step; hold & patrol orders
    armor: unitData.armor || 0,
    upgradeStep: unitData.upgradeStep,
    holdPosition: false,
    patrol: null
};

// Initialize ability cooldowns
if (unit.abilities) {
    for (const abilityId of unit.abilities) {
        unit.abilityCooldowns[abilityId] = 0;
    }
}

return unit;

}

// === ASSIGN WORKER TO NEAREST MINERAL (auto-mine on spawn) ===
// v31: Extracted from spawnUnitFromBuilding so starting workers also auto-mine.
// Per StarCraft canon and sc_research.pdf p.2 ("Workers rallied to mineral patches...
// automatically begin gathering — a crucial quality-of-life feature").
function assignWorkerAutoMine(unit, isPlayer, originX, originY) {
    let nearestMineral = null;
    let nearestDist = Infinity;
    for (const res of gameState.resources) {
        if (res.type === 'mineral' && res.amount > 0) {
            const d = distance(originX, originY, res.x, res.y);
            if (d < nearestDist) {
                nearestDist = d;
                nearestMineral = res;
            }
        }
    }
    if (nearestMineral && nearestDist < 500) {
        unit.gatherTarget = nearestMineral;
        unit.state = UNIT_STATE.GATHERING;
        unit.returnTarget = findNearestBase(originX, originY, isPlayer);
        return true;
    }
    return false;
}

// === CREATE BUILDING ===
function createBuilding(type, race, x, y, isPlayer) {
const raceData = RACES[race];
const buildingData = raceData.buildings[type];

return {
    id: generateId(),
    type: type,
    race: race,
    isPlayer: isPlayer,
    x: x,
    y: y,
    hp: buildingData.hp,
    maxHp: buildingData.hp,
    shield: buildingData.shield || 0,
    maxShield: buildingData.shield || 0,
    size: buildingData.size,
    isConstructing: false,
    constructionProgress: 0,
    constructionTime: buildingData.buildTime,
    produces: buildingData.produces || [],
    providesSupply: buildingData.providesSupply || 0,
    trainingQueue: [],
    trainingProgress: 0,
    rallyPoint: { x: x, y: y + buildingData.size / 2 + 30 },
    damage: buildingData.damage || 0,
    // v32: buildings are 'large' targets; turrets carry their damage type
    damageType: buildingData.damageType || 'normal',
    sizeClass: 'large',
    range: buildingData.range || 0,
    attackSpeed: buildingData.attackSpeed || 0,
    attackCooldown: 0,
    // v33: structure armour; turret targeting flags now copied from the race table
    armor: buildingData.armor || 0,
    canAttackAir: buildingData.canAttackAir !== false,
    canAttackGround: buildingData.canAttackGround !== false,
    target: null
};

}

// === SPAWN UNIT FROM BUILDING ===
function spawnUnitFromBuilding(building, unitType) {
const raceData = RACES[building.race];
const unitData = raceData.units[unitType];

// Seedlings hatch in pairs (BW Zergling)
const spawnCount = unitData.spawnCount || 1;

// Get current unit count at spawn area to offset new units
const spawnRadius = building.size / 2 + 40;
const existingUnits = (building.isPlayer ? gameState.units : gameState.enemyUnits)
    .filter(u => distance(u.x, u.y, building.x, building.y) < spawnRadius * 2);
const offsetIndex = existingUnits.length;

for (let i = 0; i < spawnCount; i++) {
    const totalIndex = offsetIndex + i;
    const row = Math.floor(totalIndex / 4);  // 4 units per row
    const col = totalIndex % 4;
    const spacing = 35;
    const x = building.x - (spacing * 1.5) + col * spacing;
    const y = building.y + building.size / 2 + 30 + row * spacing;

    const unit = createUnit(unitType, building.race, x, y, building.isPlayer);
    // v33 fix: AI-trained units belong to their AI player. v32 left aiPlayerIndex undefined, so
    // the AI never counted its own trained workers or army (it kept queueing Seedlings/Marines).
    if (!building.isPlayer) unit.aiPlayerIndex = building.aiPlayerIndex;

    if (unitType === 'worker') {
        assignWorkerAutoMine(unit, building.isPlayer, x, y);
    } else if (building.rallyPoint) {
        unit.targetX = building.rallyPoint.x;
        unit.targetY = building.rallyPoint.y;
        unit.state = UNIT_STATE.MOVING;
    }
    spawnArrivalFX(unit);

    // v33: supply was reserved when training was queued (BW), so none is added here
    if (building.isPlayer) gameState.units.push(unit);
    else gameState.enemyUnits.push(unit);
}

}

// === PAUSE MENU FUNCTIONS ===
function togglePause() {
    gameState.paused = !gameState.paused;
    const pauseMenu = document.getElementById('pause-menu');
    
    if (gameState.paused) {
        pauseMenu.classList.add('visible');
    } else {
        pauseMenu.classList.remove('visible');
    }
}

function saveGame() {
    try {
        const ai = gameState.aiState;
        const saveData = {
            version: SAVE_VERSION,
            timestamp: Date.now(),

            // Core game state
            selectedRace: gameState.selectedRace,
            enemyRace: gameState.enemyRace,
            minerals: gameState.minerals,
            gas: gameState.gas,
            supplyUsed: gameState.supplyUsed,
            supplyMax: gameState.supplyMax,
            gameTime: gameState.gameTime,

            // Upgrades
            upgrades: { ...gameState.upgrades },
            researchQueue: gameState.researchQueue ? {
                type: gameState.researchQueue.type,
                progress: gameState.researchQueue.progress,
                buildingId: gameState.researchQueue.building?.id
            } : null,

            camera: { ...gameState.camera },

            // Map state
            mapWidth: MAP_WIDTH,
            mapHeight: MAP_HEIGHT,
            terrainMap: gameState.terrainMap,
            fogMap: gameState.fogMap,
            tileset: gameState.tileset || null,                       // v33
            aiStartPositions: gameState.aiStartPositions || null,     // v33
            options: { mapSize: gameOptions.mapSize, playerCount: gameOptions.playerCount, aiDifficulty: gameOptions.aiDifficulty, resourceAbundance: gameOptions.resourceAbundance },

            // Entities (sanitized for JSON)
            units: gameState.units.map(u => sanitizeEntity(u)),
            buildings: gameState.buildings.map(b => sanitizeEntity(b)),
            enemyUnits: gameState.enemyUnits.map(u => sanitizeEntity(u)),
            enemyBuildings: gameState.enemyBuildings.map(b => sanitizeEntity(b)),
            resources: gameState.resources.map(r => ({ ...r })),

            controlGroups: { ...gameState.controlGroups },

            // v33 fix: per-AI economies and the shared AI state (upgrades, army) were not saved,
            // so a loaded game's AI could no longer build or remember its upgrades
            aiPlayers: (gameState.aiPlayers || []).map(p => ({ ...p })),
            aiState: ai ? {
                ...ai,
                upgrades: { ...(ai.upgrades || {}) },
                targetBuilding: ai.targetBuilding ? ai.targetBuilding.id : null,
                attackWave: (ai.attackWave || []).map(u => u.id)
            } : null,
            eliminatedPlayers: gameState.eliminatedPlayers || [],
            stats: { ...gameState.stats }
        };

        const saveString = JSON.stringify(saveData);
        localStorage.setItem('sectorConquest_save', saveString);

        addMessage('Game saved!', '#4f4');
        return true;
    } catch (error) {
        console.error('Save failed:', error);
        addMessage('Save failed: ' + error.message, '#f44');
        return false;
    }
}

// Helper to remove circular references for JSON
function sanitizeEntity(entity) {
    const sanitized = {};
    for (const key in entity) {
        const val = entity[key];
        // Entity references are saved as ids (v33: buildTarget / healTarget too)
        if (key === 'target' || key === 'building' || key === 'buildTarget' || key === 'healTarget') {
            sanitized[key] = val ? val.id : null;
        } else if (key === 'gatherTarget' || key === 'returnTarget') {
            sanitized[key] = val ? { x: val.x, y: val.y, id: val.id } : null;
        } else if (key === 'rallyPoint') {
            sanitized[key] = val ? { x: val.x, y: val.y } : null;
        } else if (typeof val !== 'function' && typeof val !== 'object') {
            sanitized[key] = val;
        } else if (Array.isArray(val)) {
            sanitized[key] = [...val];
        } else if (val && typeof val === 'object') {
            sanitized[key] = { ...val };
        }
    }
    return sanitized;
}

function loadGame() {
    try {
        const saveString = localStorage.getItem('sectorConquest_save');
        if (!saveString) {
            addMessage('No save file found!', '#fa4');
            return false;
        }

        const saveData = JSON.parse(saveString);
        const ver = saveData.version || 0;
        if (ver !== SAVE_VERSION) {
            addMessage(`Save from format ${ver} — converted to ${SAVE_VERSION}`, '#fa4');
        }

        // Restore map dimensions — v33 fix: tile counts follow the saved map
        MAP_WIDTH = saveData.mapWidth || 3600;
        MAP_HEIGHT = saveData.mapHeight || 2700;
        TILES_X = MAP_WIDTH / TILE_SIZE;
        TILES_Y = MAP_HEIGHT / TILE_SIZE;
        if (saveData.options) Object.assign(gameOptions, saveData.options);

        gameState.selectedRace = saveData.selectedRace;
        gameState.enemyRace = saveData.enemyRace;
        gameState.minerals = saveData.minerals;
        gameState.gas = saveData.gas;
        gameState.supplyUsed = saveData.supplyUsed;
        gameState.supplyMax = saveData.supplyMax;
        gameState.gameTime = saveData.gameTime;

        gameState.upgrades = { attackUpgrade: 0, armorUpgrade: 0, shieldUpgrade: 0, ...(saveData.upgrades || {}) };
        gameState.camera = { ...gameState.camera, ...(saveData.camera || {}) };

        gameState.terrainMap = saveData.terrainMap;
        gameState.fogMap = saveData.fogMap;
        gameState.tileset = saveData.tileset && TILESETS[saveData.tileset] ? saveData.tileset : null;
        gameState.aiStartPositions = saveData.aiStartPositions || null;

        gameState.units = saveData.units.map(u => restoreEntity(u, 'unit'));
        gameState.buildings = saveData.buildings.map(b => restoreEntity(b, 'building'));
        gameState.enemyUnits = saveData.enemyUnits.map(u => restoreEntity(u, 'unit'));
        gameState.enemyBuildings = saveData.enemyBuildings.map(b => restoreEntity(b, 'building'));
        gameState.resources = saveData.resources;

        gameState.controlGroups = saveData.controlGroups || { 1: [], 2: [], 3: [], 4: [], 5: [], 6: [], 7: [], 8: [], 9: [] };

        // v32 AI-trained units had no owner: give them to the nearest AI base first
        if (ver < 20) assignOrphanAIUnits();
        // AI: per-player economies (v33) — older saves rebuild them from the surviving AI entities
        gameState.aiPlayers = Array.isArray(saveData.aiPlayers) && saveData.aiPlayers.length
            ? saveData.aiPlayers.map(p => ({ ...p }))
            : rebuildAIPlayersFromEntities();
        gameState.aiState = Object.assign(freshAIState(), saveData.aiState || {});
        if (!gameState.aiState.upgrades) gameState.aiState.upgrades = { attackUpgrade: 0, armorUpgrade: 0, shieldUpgrade: 0 };
        for (const k of ['attackUpgrade', 'armorUpgrade', 'shieldUpgrade']) {
            // v32 wrote AI upgrade levels at the top level of aiState
            if (typeof gameState.aiState[k] === 'number') {
                gameState.aiState.upgrades[k] = Math.max(gameState.aiState.upgrades[k] || 0, gameState.aiState[k]);
            }
            delete gameState.aiState[k];
        }
        gameState.eliminatedPlayers = saveData.eliminatedPlayers || [];
        if (saveData.stats) gameState.stats = { ...gameState.stats, ...saveData.stats };

        if (saveData.researchQueue) {
            const building = gameState.buildings.find(b => b.id === saveData.researchQueue.buildingId);
            gameState.researchQueue = {
                type: saveData.researchQueue.type,
                progress: saveData.researchQueue.progress,
                building: building
            };
        } else {
            gameState.researchQueue = null;
        }

        restoreEntityReferences();
        gameState.aiState.targetBuilding = gameState.buildings.find(b => b.id === gameState.aiState.targetBuilding) || null;
        gameState.aiState.attackWave = (gameState.aiState.attackWave || []).map(id => gameState.enemyUnits.find(u => u.id === id)).filter(Boolean);

        // v33 migration: supply is now reserved at queue time and granted at completion
        if (ver < 20) {
            for (const b of gameState.buildings) {
                for (const t of (b.trainingQueue || [])) { const d = RACES[b.race]?.units?.[t]; if (d) gameState.supplyUsed += unitSupplyCost(d); }
                if (b.isConstructing && b.providesSupply) gameState.supplyMax -= b.providesSupply;
            }
            recomputeAISupply();
        }

        // Clear transient state
        gameState.projectiles = [];
        gameState.particles = [];
        gameState.beams = [];
        gameState.decals = [];
        gameState.psiStorms = [];
        gameState.minimapPings = [];
        gameState.selectedUnits = [];
        gameState.selectedBuilding = null;
        gameState.buildMode = null;
        gameState.commandMenu = MENU.MAIN;
        gameState.attackMoveMode = false;
        gameState.patrolMode = false;
        gameState.moveMode = false;
        gameState.abilityMode = null;
        gameState.rallyMode = false;
        gameState.phaseMode = false;

        // v33 fix: ids are 'e<n>' strings — v32 took Math.max over the strings (NaN), so every
        // entity created after a load got the id 'eNaN'
        let maxId = 0;
        for (const list of [gameState.units, gameState.buildings, gameState.enemyUnits, gameState.enemyBuildings, gameState.resources]) {
            for (const e of list) {
                const n = parseInt(String(e.id).replace(/^\D+/, ''), 10);
                if (n > maxId) maxId = n;
            }
        }
        gameState.nextId = maxId + 1;

        // Rebuild the battlefield art for the loaded map
        resizeGameCanvas();
        buildBattleArt();
        if (typeof applyConsoleSkin === 'function') applyConsoleSkin(gameState.selectedRace);
        updatePowerGrid();

        updateHUD();
        updateCommandCard();

        addMessage('Game loaded!', '#4f4');
        if (gameState.paused) togglePause(); // Unpause after load
        return true;
    } catch (error) {
        console.error('Load failed:', error);
        addMessage('Load failed: ' + error.message, '#f44');
        return false;
    }
}

function restoreEntity(data, type) {
    const entity = { ...data };
    if (!entity.state) entity.state = UNIT_STATE.IDLE;

    if (type === 'unit' && entity.race && entity.type && RACES[entity.race]?.units?.[entity.type]) {
        const def = RACES[entity.race].units[entity.type];
        // v32: damage type / size class backfill
        if (!entity.damageType) entity.damageType = def.damageType || 'normal';
        if (!entity.sizeClass) entity.sizeClass = def.sizeClass || 'medium';
        // v33: armour, weapon-upgrade step, order flags
        if (entity.armor === undefined) entity.armor = def.armor || 0;
        if (entity.upgradeStep === undefined) entity.upgradeStep = def.upgradeStep;
        if (entity.holdPosition === undefined) entity.holdPosition = false;
        if (entity.patrol === undefined) entity.patrol = null;
        if (entity.siegeMode && def.siegeStats && !entity.minRange) entity.minRange = def.siegeStats.minRange;
        if (entity.maxShield > 0 && entity.shield > entity.maxShield) entity.shield = entity.maxShield;   // v32 capacity upgrade
        delete entity._dead;
    } else if (type === 'building') {
        if (!entity.sizeClass) entity.sizeClass = 'large';
        const def = entity.race && entity.type ? RACES[entity.race]?.buildings?.[entity.type] : null;
        if (def) {
            if (!entity.damageType) entity.damageType = def.damageType || 'normal';
            if (entity.armor === undefined) entity.armor = def.armor || 0;
            if (entity.canAttackAir === undefined) entity.canAttackAir = def.canAttackAir !== false;
            if (entity.canAttackGround === undefined) entity.canAttackGround = def.canAttackGround !== false;
        }
        if (!Array.isArray(entity.trainingQueue)) entity.trainingQueue = [];
        if (entity.maxShield > 0 && entity.shield > entity.maxShield) entity.shield = entity.maxShield;
        delete entity._dead;
    }

    return entity;
}

function restoreEntityReferences() {
    const allUnits = [...gameState.units, ...gameState.enemyUnits];
    const allBuildings = [...gameState.buildings, ...gameState.enemyBuildings];
    const byId = (id) => allUnits.find(u => u.id === id) || allBuildings.find(b => b.id === id) || null;

    for (const unit of allUnits) {
        if (unit.target) unit.target = byId(unit.target);
        if (unit.buildTarget) unit.buildTarget = allBuildings.find(b => b.id === unit.buildTarget) || null;
        unit.healTarget = null;
        if (unit.gatherTarget && unit.gatherTarget.id) {
            unit.gatherTarget = gameState.resources.find(r => r.id === unit.gatherTarget.id) || null;
        }
        if (unit.returnTarget && unit.returnTarget.id) {
            unit.returnTarget = allBuildings.find(b => b.id === unit.returnTarget.id) || null;
        }
    }
    // v33: turret targets are re-acquired
    for (const b of allBuildings) b.target = null;
}

