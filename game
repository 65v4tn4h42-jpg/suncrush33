        if (collisionType === 'valid_gas') {
            ctx.fillStyle = '#4f4';  // Green for valid gas placement
        } else if (collisionType === 'power') {
            ctx.fillStyle = '#fbbf24';  // Amber: outside Pylon power
        } else if (hasCollision) {
            ctx.fillStyle = '#f44';  // Red for collision
        } else {
            ctx.fillStyle = '#4f4';  // Green for valid
        }
        ctx.fillRect(gx + 1, gy + 1, gridCellSize - 2, gridCellSize - 2);
        
        // Draw collision icon for clarity
        if (hasCollision && collisionType) {
            ctx.globalAlpha = 0.6;
            ctx.fillStyle = '#fff';
            ctx.font = '10px sans-serif';
            ctx.textAlign = 'center';
            if (collisionType === 'building') ctx.fillText('B', cellCenterX, cellCenterY + 4);
            else if (collisionType === 'mineral') ctx.fillText('M', cellCenterX, cellCenterY + 4);
            else if (collisionType === 'gas' || collisionType === 'occupied_gas') ctx.fillText('G', cellCenterX, cellCenterY + 4);
            else if (collisionType === 'cliff') ctx.fillText('X', cellCenterX, cellCenterY + 4);
            else if (collisionType === 'power') ctx.fillText('⚡', cellCenterX, cellCenterY + 4);
        }
    }
}
ctx.globalAlpha = 1;

// v33: Pylon power fields (Red Empyeran) so powered placement is visible, as in StarCraft
if (gameState.selectedRace === 'ascended') renderPowerFields(ctx, buildingData.requiresPower);

// Draw the building ghost (v33: the real sprite, tinted by placement validity)
const ghostSpr = SpriteCache.building(gameState.selectedRace, gameState.buildMode, 0, size);
if (ghostSpr) {
    ctx.globalAlpha = 0.62;
    SunForge.draw(ctx, ghostSpr, x, y + size * 0.18);
    ctx.globalAlpha = 0.25;
    ctx.globalCompositeOperation = 'lighter';
    SunForge.draw(ctx, SpriteCache.silhouette(ghostSpr, gameState.buildGhost.valid ? '#4ade80' : '#ef4444'), x, y + size * 0.18);
    ctx.globalCompositeOperation = 'source-over';
