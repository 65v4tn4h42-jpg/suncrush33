// ---- hit resolution: primary damage + splash / cleave / glaive bounce ----
function splashFactor(dist, outer) {
    for (const [f, m] of SPLASH_FALLOFF) if (dist <= outer * f) return m;
    return 0;
}
function resolveAttackHit(proj, target) {
    if (!target || target.hp <= 0) return;
    const src = proj.source;
    dealDamage(target, proj.damage, proj);
    if (!src) return;
    const def = !isBuildingEntity(src) && RACES[src.race] ? RACES[src.race].units[src.type] : null;
    // Siege tank (sieged) radial splash with friendly fire; Magma Titan enemy-only splash
    let splash = 0, friendly = false;
    if (src.siegeMode && def && def.siegeStats) { splash = def.siegeStats.splash || 0; friendly = COMBAT_V33.siegeFriendlyFire; }
    else if (def && def.splash && !def.canSiege) { splash = def.splash; friendly = false; }
    if (splash > 0 && !target.isFlying) {
        const outer = splash * TILE_SIZE;
        const pools = friendly ? [gameState.units, gameState.enemyUnits] : [src.isPlayer ? gameState.enemyUnits : gameState.units];
        const cx = proj.impactX !== undefined ? proj.impactX : target.x, cy = proj.impactY !== undefined ? proj.impactY : target.y;
        for (const pool of pools) {
            for (const u of pool.slice()) {
                if (u === target || u === src || u.hp <= 0 || u.isFlying) continue;
                const d = Math.max(0, Math.hypot(u.x - cx, u.y - cy) - entityRadius(u));
                const m = splashFactor(d, outer);
                if (m > 0) dealDamage(u, proj.damage, Object.assign({}, proj, { dmgMult: (proj.dmgMult || 1) * m, isSplash: true }));
            }
        }
    }
    // Titan Root cleave
    if (def && def.cleave && !proj.isSplash) {
        const pool = src.isPlayer ? gameState.enemyUnits : gameState.units;
        const r = COMBAT_V33.cleaveRadius * TILE_SIZE;
        for (const u of pool.slice()) {
            if (u === target || u.hp <= 0 || u.isFlying) continue;
            if (Math.hypot(u.x - target.x, u.y - target.y) - entityRadius(u) <= r) dealDamage(u, proj.damage, Object.assign({}, proj, { dmgMult: COMBAT_V33.cleavePct, isSplash: true }));
        }
    }
    // Spore Wing glaive: bounce to the nearest un-hit enemy (Mutalisk canon)
    if (def && def.bounceAttack && (proj.bounces === undefined || proj.bounces > 0) && !isBuildingEntity(target)) {
        const left = proj.bounces === undefined ? COMBAT_V33.glaiveBounces : proj.bounces;
        const hit = (proj.hitIds || []).concat([target.id]);
        const pool = src.isPlayer ? gameState.enemyUnits : gameState.units;
        let best = null, bestD = COMBAT_V33.glaiveRange * TILE_SIZE;
        for (const u of pool) {
            if (u.hp <= 0 || hit.includes(u.id) || u.burrowed) continue;
