// === TRAIN UNIT ===
function trainUnit(building, unitType) {
const raceData = RACES[building.race];
const unitData = raceData.units[unitType];

// v33: BW — an unpowered Empyeran structure cannot train
if (building.unpowered) {
    addMessage('Structure unpowered — build a Pylon nearby!', '#fbbf24');
    SoundSystem.play('error');
    return;
}

// v32: Tech tree prerequisite check
const prereq = unitPrereqsMet(building.race, unitType, building.isPlayer, building.aiPlayerIndex);
if (!prereq.met) {
    addMessage(`Requires ${prereq.missing}!`, '#fa4');
    SoundSystem.play('error');
    return;
}

if (gameState.minerals < unitData.cost.minerals || gameState.gas < (unitData.cost.gas || 0)) {
    addMessage(gameState.minerals < unitData.cost.minerals ? 'Not enough minerals!' : 'Not enough gas!', '#f44');
    SoundSystem.play('error');
    return;
}

// v33: supply is reserved per order (BW) — a Seedling pair needs 1, not 0.5
const need = unitSupplyCost(unitData);
if (gameState.supplyUsed + need > supplyCap(gameState.supplyMax)) {
    addMessage(supplyBlockedMessage(building.race), '#fa4');
    SoundSystem.play('error');
    return;
}

if (building.trainingQueue.length >= 5) {
    addMessage('Queue full!', '#f44');
    SoundSystem.play('error');
    return;
}

gameState.minerals -= unitData.cost.minerals;
gameState.gas -= unitData.cost.gas || 0;
gameState.supplyUsed += need;
building.trainingQueue.push(unitType);

SoundSystem.play('train');
addMessage(`Training ${unitData.name}...`, '#4af');
updateHUD();
updateCommandCard();

}

// === DRAW COMMAND ICON ===
// v33: pixel-art command card. Each icon is painted on a 14×14 grid, alpha-thresholded, given a
// 1-px dark outline (the same treatment as the unit sprites) and scaled up with nearest-neighbour,
// so the console matches the battlefield art. Hi-DPI aware.
const ICON_DPR = Math.min(2, Math.max(1, window.devicePixelRatio || 1));
function hiDPICanvas(cv, w, h, cssSized) {
    const d = ICON_DPR;
    if (cv.width !== Math.round(w * d) || cv.height !== Math.round(h * d)) { cv.width = Math.round(w * d); cv.height = Math.round(h * d); }
    if (!cssSized) {                       // cssSized: the stylesheet decides the display size
        cv.style.width = w + 'px';
        cv.style.height = h + 'px';
    }
    const ctx = cv.getContext('2d');
    ctx.setTransform(d, 0, 0, d, 0, 0);
    ctx.clearRect(0, 0, w, h);
    return ctx;
}

const PixIcon = (() => {
    const N = 14;
    const cache = new Map();
    function make(paint) {
        const cv = document.createElement('canvas'); cv.width = N; cv.height = N;
        const c = cv.getContext('2d', { willReadFrequently: true });
        const P = {
            px(x, y, col) { c.fillStyle = col; c.fillRect(Math.round(x), Math.round(y), 1, 1); },
            rect(x, y, w, h, col) { c.fillStyle = col; c.fillRect(x, y, w, h); },
            line(x0, y0, x1, y1, col, w) {
                w = w || 1; c.fillStyle = col;
                x0 = Math.round(x0); y0 = Math.round(y0); x1 = Math.round(x1); y1 = Math.round(y1);
                const dx = Math.abs(x1 - x0), dy = -Math.abs(y1 - y0), sx = x0 < x1 ? 1 : -1, sy = y0 < y1 ? 1 : -1;
                let err = dx + dy;
                for (let guard = 0; guard < 64; guard++) {
                    c.fillRect(x0, y0, w, w);
                    if (x0 === x1 && y0 === y1) break;
                    const e2 = 2 * err;
                    if (e2 >= dy) { err += dy; x0 += sx; }
                    if (e2 <= dx) { err += dx; y0 += sy; }
                }
            },
            disc(cx, cy, r, col) {
                c.fillStyle = col;
                for (let y = 0; y < N; y++) for (let x = 0; x < N; x++) {
                    const dx = x + 0.5 - cx, dy = y + 0.5 - cy;
                    if (dx * dx + dy * dy <= r * r) c.fillRect(x, y, 1, 1);
                }
            },
            ring(cx, cy, r0, r1, col) {
                c.fillStyle = col;
                for (let y = 0; y < N; y++) for (let x = 0; x < N; x++) {
                    const dx = x + 0.5 - cx, dy = y + 0.5 - cy, d = dx * dx + dy * dy;
                    if (d <= r1 * r1 && d >= r0 * r0) c.fillRect(x, y, 1, 1);
                }
            },
            poly(pts, col) {
                c.fillStyle = col; c.beginPath();
                pts.forEach((p, i) => i ? c.lineTo(p[0], p[1]) : c.moveTo(p[0], p[1]));
                c.closePath(); c.fill();
            }
        };
        try { paint(P); } catch (e) { console.error('icon paint', e); }
        const id = c.getImageData(0, 0, N, N), d = id.data;
        for (let i = 3; i < d.length; i += 4) d[i] = d[i] > 110 ? 255 : 0;
        const solid = new Uint8Array(N * N);
        for (let i = 0; i < N * N; i++) solid[i] = d[i * 4 + 3] ? 1 : 0;
        for (let y = 0; y < N; y++) for (let x = 0; x < N; x++) {
            const i = y * N + x;
            if (solid[i]) continue;
            const nb = (x > 0 && solid[i - 1]) || (x < N - 1 && solid[i + 1]) || (y > 0 && solid[i - N]) || (y < N - 1 && solid[i + N]);
            if (nb) { d[i * 4] = 6; d[i * 4 + 1] = 8; d[i * 4 + 2] = 14; d[i * 4 + 3] = 230; }
        }
        c.putImageData(id, 0, 0);
        return cv;
    }
    function draw(ctx, key, size) {
        const painter = ICON_PAINTERS[key] || ICON_PAINTERS.ability;
        let cv = cache.get(key);
        if (!cv) { cv = make(painter); cache.set(key, cv); }
        const s = Math.max(1, Math.floor(size / N));
        const off = Math.floor((size - N * s) / 2);
        const prev = ctx.imageSmoothingEnabled;
        ctx.imageSmoothingEnabled = false;
        ctx.drawImage(cv, off, off, N * s, N * s);
        ctx.imageSmoothingEnabled = prev;
    }
    return { draw, N };
})();

const ICON_PAINTERS = {
    move(P) {
        P.rect(2, 6, 6, 2, '#14b8a6'); P.rect(2, 6, 6, 1, '#5eead4');
        P.poly([[7, 2], [12.6, 7], [7, 12]], '#14b8a6'); P.line(8, 4, 10, 6, '#99f6e4');
    },
    stop(P) {
        P.rect(3, 3, 8, 8, '#991b1b'); P.rect(4, 4, 6, 6, '#dc2626');
        P.rect(4, 4, 6, 1, '#fca5a5'); P.rect(4, 4, 1, 6, '#f87171');
    },
    attack(P) {
        P.line(5, 8, 11, 2, '#94a3b8', 2); P.line(5, 7, 10, 2, '#f1f5f9');
        P.px(12, 1, '#ffffff');
        P.line(3, 6, 7, 10, '#f59e0b'); P.px(3, 6, '#fde68a');
        P.line(4, 9, 2, 11, '#7c2d12', 2); P.px(1, 12, '#fbbf24');
    },
    patrol(P) {
        P.rect(2, 3, 6, 2, '#0ea5e9'); P.poly([[7.5, 0.8], [12.2, 4], [7.5, 7.2]], '#38bdf8');
        P.rect(6, 9, 6, 2, '#0284c7'); P.poly([[6.5, 6.8], [1.8, 10], [6.5, 13.2]], '#7dd3fc');
    },
    hold(P) {
