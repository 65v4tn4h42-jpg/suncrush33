            Math.abs(cellCenterY - y) > halfSize + gridCellSize) continue;
        
        let hasCollision = false;
        let collisionType = null;
        
        // Check building collision
        const allBuildings = [...gameState.buildings, ...gameState.enemyBuildings];
        for (const b of allBuildings) {
            const bHalf = b.size / 2;
            if (cellCenterX >= b.x - bHalf - 5 && cellCenterX <= b.x + bHalf + 5 &&
                cellCenterY >= b.y - bHalf - 5 && cellCenterY <= b.y + bHalf + 5) {
                hasCollision = true;
                collisionType = 'building';
                break;
            }
        }
        
        // Check resource collision
        if (!hasCollision) {
            for (const res of gameState.resources) {
                const resRadius = res.type === 'gas' ? 40 : 25;
                if (distance(cellCenterX, cellCenterY, res.x, res.y) < resRadius + 10) {
                    // For refineries on gas, show as valid target
                    if (gameState.buildMode === 'refinery' && res.type === 'gas' && !res.hasRefinery) {
                        collisionType = 'valid_gas';
                    } else if (gameState.buildMode === 'refinery' && res.type === 'gas' && res.hasRefinery) {
                        hasCollision = true;
                        collisionType = 'occupied_gas';
                    } else {
                        hasCollision = true;
                        collisionType = res.type;
                    }
                    break;
                }
            }
        }
        
        // Check terrain (v33: a footprint may not span a cliff between levels)
        if (!hasCollision) {
            const terrain = getTerrainAt(cellCenterX, cellCenterY);
            const centerLvl = getTerrainAt(x, y);
            if (terrain === TERRAIN.CLIFF || (terrain !== centerLvl && terrain !== TERRAIN.RAMP && centerLvl !== TERRAIN.RAMP)) {
                hasCollision = true;
                collisionType = 'cliff';
            }
        }
        // v33: Empyeran structures need Pylon power (BW)
        if (!hasCollision && buildingData.requiresPower && gameState.selectedRace === 'ascended' && !isPositionPowered(cellCenterX, cellCenterY, true)) {
