<!DOCTYPE html>

<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no, viewport-fit=cover">
    <title>SunCrush v33</title>
    <style>
        /* ===== BASE STYLES ===== */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            -webkit-user-select: none;
            user-select: none;
            -webkit-touch-callout: none;
        }

body {
background: #0a0a12;
color: #e0e0e0;
font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
overflow: hidden;
height: 100vh;
width: 100vw;
}

/* ===== TITLE SCREEN ===== */
#title-screen {
position: absolute;
inset: 0;
background: #050510;
display: flex;
flex-direction: column;
align-items: center;
justify-content: center;
z-index: 100;
overflow: hidden;
}

#title-screen::before {
content: '';
position: absolute;
inset: 0;
background:
radial-gradient(ellipse at 20% 20%, rgba(37, 99, 235, 0.08) 0%, transparent 50%),
radial-gradient(ellipse at 80% 80%, rgba(185, 28, 28, 0.08) 0%, transparent 50%),
radial-gradient(ellipse at 50% 50%, rgba(5, 150, 105, 0.05) 0%, transparent 60%);
pointer-events: none;
}

#title-screen.hidden {
display: none;
}

/* Starfield canvas - fills entire screen */
#starfield-canvas {
position: absolute;
inset: 0;
width: 100%;
height: 100%;
z-index: 0;
}

#title-art {
margin-top: 1.5em;
margin-bottom: 0.3em;
filter: drop-shadow(0 0 30px rgba(255,255,255,0.15));
position: relative;
z-index: 2;
}

/* Start button container with sun effect */
#start-container {
position: relative;
margin: 1em 0 0.8em 0;
z-index: 2;
}

/* Pulsing sun rays behind button when active */
#start-sun-rays {
position: absolute;
top: 50%;
left: 50%;
transform: translate(-50%, -50%);
width: 120px;
height: 120px;
pointer-events: none;
opacity: 0;
transition: opacity 0.5s ease;
}

#start-container.active #start-sun-rays {
opacity: 1;
animation: sunPulse 2s ease-in-out infinite;
}

@keyframes sunPulse {
0%, 100% { transform: translate(-50%, -50%) scale(1); opacity: 0.8; }
50% { transform: translate(-50%, -50%) scale(1.15); opacity: 1; }
}

@keyframes rayRotate {
0% { transform: translate(-50%, -50%) rotate(0deg); }
100% { transform: translate(-50%, -50%) rotate(360deg); }
}

#start-sun-rays.rotating {
animation: rayRotate 20s linear infinite, sunPulse 2s ease-in-out infinite;
}

.game-title {
font-size: clamp(2rem, 6vw, 4rem);
font-weight: bold;
text-transform: uppercase;
letter-spacing: 0.3em;
margin-bottom: 0.5em;
background: linear-gradient(180deg, #fff 0%, #888 100%);
-webkit-background-clip: text;
-webkit-text-fill-color: transparent;
background-clip: text;
text-shadow: 0 0 30px rgba(255,255,255,0.3);
}

.game-subtitle {
font-size: clamp(0.75rem, 1.8vw, 1rem);
color: #555;
letter-spacing: 0.6em;
margin-bottom: 2.5em;
text-transform: uppercase;
}

.race-selection-label {
font-size: 0.85rem;
color: #666;
margin-bottom: 1.2em;
text-transform: uppercase;
letter-spacing: 0.25em;
position: relative;
z-index: 2;
}

.race-cards {
display: flex;
gap: clamp(0.8rem, 2.5vw, 1.5rem);
margin-bottom: 1.5em;
flex-wrap: wrap;
position: relative;
z-index: 2;
justify-content: center;
padding: 0 1rem;
}

.race-card {
width: clamp(100px, 18vw, 130px);
height: clamp(100px, 18vw, 130px);
background: linear-gradient(180deg, rgba(26, 26, 46, 0.95) 0%, rgba(13, 13, 26, 0.98) 100%);
border: 1px solid #333;
border-radius: 10px;
cursor: pointer;
transition: all 0.3s ease;
display: flex;
flex-direction: column;
align-items: center;
justify-content: center;
padding: 0.6rem;
position: relative;
overflow: hidden;
text-align: center;
}

.race-card::before {
content: '';
position: absolute;
inset: 0;
background: radial-gradient(circle at 50% 0%, var(--race-color, #333) 0%, transparent 70%);
opacity: 0.15;
transition: opacity 0.3s;
}

.race-card:hover {
transform: translateY(-5px);
border-color: var(--race-color, #666);
box-shadow: 0 10px 30px rgba(0,0,0,0.5), 0 0 20px var(--race-glow, transparent);
}

.race-card:hover::before {
opacity: 0.3;
}

.race-card.selected {
border-color: var(--race-color, #fff);
box-shadow: 0 0 30px var(--race-glow, #fff), inset 0 0 20px rgba(255,255,255,0.1);
}

.race-card.selected::before {
opacity: 0.4;
}

.race-card[data-race="coalition"] {
--race-color: #2563eb;
--race-glow: rgba(37, 99, 235, 0.4);
}

.race-card[data-race="swarm"] {
--race-color: #059669;
--race-glow: rgba(5, 150, 105, 0.4);
}

.race-card[data-race="ascended"] {
--race-color: #b91c1c;
--race-glow: rgba(185, 28, 28, 0.4);
}

.race-icon-canvas {
width: 48px;
height: 48px;
margin-bottom: 0.5rem;
}

.race-name {
font-size: 0.85rem;
font-weight: bold;
color: var(--race-color, #fff);
text-transform: uppercase;
letter-spacing: 0.1em;
text-shadow: 0 0 10px var(--race-glow, transparent);
font-family: 'Segoe UI', Tahoma, sans-serif;
}

.race-tagline {
display: none;
}

.race-traits {
display: none;
}

/* Faction descriptions shown below buttons */
.faction-descriptions {
display: flex;
gap: 0.5rem;
margin-bottom: 1.5em;
justify-content: center;
max-width: 600px;
padding: 0 1rem;
position: relative;
z-index: 2;
}

.faction-desc {
flex: 1;
padding: 0.6rem;
background: rgba(26, 26, 46, 0.6);
border: 1px solid transparent;
border-radius: 6px;
text-align: center;
font-size: 0.7rem;
color: #777;
line-height: 1.4;
transition: all 0.3s ease;
opacity: 0.6;
max-width: 180px;
}

.faction-desc.active {
border-color: var(--faction-color, #555);
opacity: 1;
background: rgba(26, 26, 46, 0.9);
}

.faction-desc[data-faction="coalition"] { --faction-color: #2563eb; }
.faction-desc[data-faction="swarm"] { --faction-color: #059669; }
.faction-desc[data-faction="ascended"] { --faction-color: #b91c1c; }

.faction-desc .desc-name {
font-weight: bold;
color: var(--faction-color, #888);
margin-bottom: 0.3rem;
text-transform: uppercase;
letter-spacing: 0.1em;
font-size: 0.75rem;
}

.faction-desc .desc-text {
color: #888;
}

.faction-desc .desc-traits {
margin-top: 0.3rem;
color: #666;
font-size: 0.65rem;
}

#start-button {
padding: 0.8em 2.5em;
font-size: 1rem;
font-weight: bold;
text-transform: uppercase;
letter-spacing: 0.2em;
background: linear-gradient(180deg, #2a2a4a 0%, #1a1a2e 100%);
border: 2px solid #444;
border-radius: 8px;
color: #888;
cursor: not-allowed;
transition: all 0.3s ease;
position: relative;
z-index: 2;
}

#start-button.active {
border-color: #f97316;
color: #fff;
cursor: pointer;
background: linear-gradient(180deg, #4a3a2a 0%, #3a2a1e 100%);
box-shadow: 0 0 25px rgba(249, 115, 22, 0.5), 0 0 50px rgba(249, 115, 22, 0.2);
}

#start-button.active:hover {
background: linear-gradient(180deg, #5a4a3a 0%, #4a3a2e 100%);
transform: scale(1.05);
box-shadow: 0 0 35px rgba(249, 115, 22, 0.7), 0 0 60px rgba(249, 115, 22, 0.3);
}

/* ===== GAME OPTIONS PANEL ===== */
.game-options {
display: flex;
flex-wrap: wrap;
gap: 1rem;
justify-content: center;
margin: 1em 0;
padding: 0.75rem 1.25rem;
background: rgba(0,0,0,0.25);
border-radius: 8px;
border: 1px solid rgba(100,100,120,0.3);
max-width: 550px;
position: relative;
z-index: 2;
}

.option-group {
display: flex;
flex-direction: column;
align-items: center;
gap: 0.3rem;
min-width: 110px;
}

.option-label {
font-size: 0.65rem;
color: #666;
text-transform: uppercase;
letter-spacing: 0.08em;
}

.option-select {
padding: 0.4em 0.8em;
font-size: 0.8rem;
background: linear-gradient(180deg, #252538 0%, #181828 100%);
border: 1px solid #3a3a4a;
border-radius: 4px;
color: #ccc;
cursor: pointer;
min-width: 100px;
text-align: center;
}

.option-select:hover {
border-color: #555;
}

.option-select:focus {
outline: none;
border-color: var(--selected-color, #4af);
box-shadow: 0 0 8px var(--selected-glow, rgba(68,170,255,0.2));
}

/* AI Player Setup */
.ai-players-container {
display: flex;
flex-direction: row;
flex-wrap: wrap;
gap: 0.5rem;
justify-content: center;
width: 100%;
max-width: 500px;
margin-top: 0.3rem;
}

.ai-player-row {
display: flex;
align-items: center;
gap: 0.4rem;
padding: 0.3rem 0.5rem;
background: rgba(0,0,0,0.2);
border-radius: 6px;
border: 1px solid #333;
}

.ai-player-row.disabled {
opacity: 0.4;
pointer-events: none;
}

.ai-player-label {
font-size: 0.8rem;
color: #aaa;
min-width: 50px;
}

.ai-faction-select {
flex: 1;
padding: 0.4em 0.8em;
font-size: 0.85rem;
background: linear-gradient(180deg, #2a2a4a 0%, #1a1a2e 100%);
border: 1px solid #444;
border-radius: 4px;
color: #fff;
cursor: pointer;
}

.ai-faction-select:disabled {
cursor: not-allowed;
opacity: 0.5;
}

.ai-faction-select option {
background: #1a1a2e;
color: #fff;
}

/* ===== GAME CONTAINER ===== */
#game-container {
position: absolute;
inset: 0;
display: none;
flex-direction: column;
}

#game-container.visible {
display: flex;
}

/* ===== TOP HUD ===== */
#top-hud {
position: relative;
height: 40px;
background: linear-gradient(180deg, #1a1a2e 0%, #0d0d1a 100%);
border-bottom: 1px solid #333;
display: flex;
align-items: center;
padding: 0 1rem;
gap: 2rem;
z-index: 10;
}

.resource-display {
display: flex;
align-items: center;
gap: 0.5rem;
}

.resource-icon {
width: 20px;
height: 20px;
}

.resource-value {
font-size: 1rem;
font-weight: bold;
min-width: 50px;
}

#minerals-display { color: #4af; }
#gas-display { color: #4f4; }
#supply-display { color: #fa4; }

.supply-warning {
color: #f44 !important;
animation: pulse-warning 0.5s ease-in-out infinite alternate;
}

@keyframes pulse-warning {
from { opacity: 0.7; }
to { opacity: 1; }
}

#game-speed-control {
position: absolute;
left: 50%;
transform: translateX(-50%);
display: flex;
align-items: center;
gap: 0.5rem;
}

#game-speed-control label {
font-size: 0.75rem;
color: #888;
}

#speed-slider {
width: 80px;
accent-color: #4af;
}

#speed-value {
font-size: 0.75rem;
color: #4af;
min-width: 35px;
}

/* ===== CANVAS AREA ===== */
#canvas-container {
flex: 1;
position: relative;
overflow: hidden;
}

#game-canvas {
position: absolute;
top: 0;
left: 0;
width: 100%;
height: 100%;
touch-action: none;
}

/* ===== BOTTOM PANEL ===== */
#bottom-panel {
height: 140px;
background: linear-gradient(180deg, #0d0d1a 0%, #1a1a2e 100%);
border-top: 1px solid #333;
display: flex;
padding: 8px;
gap: 8px;
z-index: 10;
}

/* Minimap - now first (left side) */
#minimap-container {
width: 176px;
background: #0a0a12;
border: 1px solid #333;
border-radius: 6px;
padding: 8px;
display: flex;
flex-direction: column;
align-items: center;
order: 0;
}

/* Selection Info Panel */
#selection-panel {
width: 180px;
background: #0a0a12;
border: 1px solid #333;
border-radius: 6px;
padding: 8px;
display: flex;
flex-direction: column;
order: 1;
}

#selection-header {
display: flex;
gap: 8px;
margin-bottom: 6px;
}

#portrait-container {
width: 56px;
height: 56px;
background: #1a1a2e;
border: 1px solid #444;
border-radius: 4px;
display: flex;
align-items: center;
justify-content: center;
}

#portrait-canvas {
width: 48px;
height: 48px;
}

#selection-info {
flex: 1;
display: flex;
flex-direction: column;
justify-content: center;
}

#selection-name {
font-size: 0.85rem;
font-weight: bold;
color: #fff;
margin-bottom: 4px;
}

#selection-type {
font-size: 0.7rem;
color: #888;
}

#selection-stats {
font-size: 0.65rem;
color: #666;
line-height: 1.4;
}

/* Health/Shield Bars */
#health-bars {
margin-top: auto;
}

.bar-container {
height: 8px;
background: #1a1a2e;
border-radius: 2px;
margin-bottom: 3px;
overflow: hidden;
}

.bar-fill {
height: 100%;
transition: width 0.2s ease;
}

#health-bar { background: linear-gradient(90deg, #2a2 0%, #4c4 100%); }
#shield-bar { background: linear-gradient(90deg, #44f 0%, #88f 100%); }

.bar-container.hidden { display: none; }

/* Command Card */
#command-card {
flex: 1;
display: grid;
grid-template-columns: repeat(5, 1fr);
grid-template-rows: repeat(3, 1fr);
gap: 3px;
max-width: 320px;
order: 2;
}

.cmd-button {
background: linear-gradient(180deg, #2a2a3a 0%, #1a1a2a 100%);
border: 1px solid #444;
border-radius: 4px;
display: flex;
flex-direction: column;
align-items: center;
justify-content: flex-start;
cursor: pointer;
transition: all 0.15s ease;
position: relative;
padding: 2px 2px 14px 2px;
min-height: 48px;
overflow: hidden;
}

.cmd-label {
font-size: 0.65rem;
color: #ccc;
text-transform: uppercase;
letter-spacing: 0.02em;
margin-top: 1px;
text-align: center;
line-height: 1.1;
max-width: 100%;
overflow: hidden;
white-space: nowrap;
text-overflow: ellipsis;
padding: 0 3px;
font-weight: 500;
}

.cmd-button:hover:not(.disabled):not(.empty) {
background: linear-gradient(180deg, #3a3a4a 0%, #2a2a3a 100%);
border-color: #666;
}

.cmd-button:active:not(.disabled):not(.empty) {
transform: scale(0.95);
}

.cmd-button.disabled {
opacity: 0.4;
cursor: not-allowed;
}

/* v32: tech-locked units show amber border + desaturated icon */
.cmd-button.tech-locked {
border-color: #7a5a20;
filter: saturate(0.3);
}

.cmd-button.empty {
background: #151520;
border-color: #222;
cursor: default;
}

.cmd-button.highlighted {
border-color: #4af;
box-shadow: 0 0 10px rgba(68, 170, 255, 0.3);
}

.cmd-icon {
width: 28px;
height: 28px;
}

.cmd-hotkey {
position: absolute;
bottom: 1px;
right: 2px;
font-size: 0.5rem;
color: #666;
font-weight: bold;
background: rgba(0,0,0,0.4);
padding: 0 2px;
border-radius: 2px;
}

.cmd-cost {
position: absolute;
bottom: 1px;
left: 2px;
font-size: 0.45rem;
color: #4af;
background: rgba(0,0,0,0.4);
padding: 0 2px;
border-radius: 2px;
}

/* Training Queue */
#training-queue {
position: absolute;
top: -24px;
left: 0;
right: 0;
height: 22px;
display: flex;
gap: 2px;
padding: 2px;
background: rgba(0,0,0,0.5);
border-radius: 3px;
}

.queue-item {
width: 24px;
height: 24px;
background: #1a1a2e;
border: 1px solid #444;
border-radius: 3px;
position: relative;
display: flex;
align-items: center;
justify-content: center;
cursor: pointer;
transition: border-color 0.2s;
}

.queue-item:hover {
border-color: #f44;
}

.queue-item.active {
border-color: #4af;
box-shadow: 0 0 4px rgba(68, 170, 255, 0.4);
}

.queue-item canvas {
width: 20px;
height: 20px;
}

.queue-progress {
position: absolute;
bottom: 0;
left: 0;
right: 0;
height: 3px;
background: #4af;
border-radius: 0 0 2px 2px;
}

.queue-cancel {
position: absolute;
top: -4px;
right: -4px;
width: 12px;
height: 12px;
background: #f44;
border-radius: 50%;
font-size: 8px;
color: white;
display: none;
align-items: center;
justify-content: center;
cursor: pointer;
z-index: 1;
}

.queue-item:hover .queue-cancel {
display: flex;
}

/* Production Queue Container */
#production-queue {
display: flex;
gap: 4px;
padding: 4px;
background: rgba(0,0,0,0.5);
border-radius: 4px;
margin-top: 4px;
min-height: 32px;
align-items: center;
}

#production-queue.hidden {
display: none;
}

.queue-label {
font-size: 0.5rem;
margin-left: 4px;
color: #666;
text-transform: uppercase;
margin-right: 4px;
}

/* Minimap already defined in bottom-panel section */

#minimap-label {
font-size: 0.65rem;
color: #666;
margin-bottom: 4px;
text-transform: uppercase;
letter-spacing: 0.1em;
}

#minimap-canvas {
width: 160px;
height: 120px;
background: #1a1a2e;
border: 1px solid #444;
border-radius: 2px;
cursor: pointer;
}

#minimap-zoom-btn {
position: absolute;
top: 2px;
right: 2px;
width: 20px;
height: 20px;
background: rgba(0, 0, 0, 0.6);
border: 1px solid #555;
border-radius: 3px;
color: #aaa;
font-size: 12px;
cursor: pointer;
display: flex;
align-items: center;
justify-content: center;
z-index: 10;
transition: all 0.2s;
}

#minimap-zoom-btn:hover {
background: rgba(0, 100, 150, 0.6);
border-color: #4af;
color: #fff;
}

#minimap-zoom-btn.active {
background: rgba(0, 150, 200, 0.4);
border-color: #4af;
color: #4af;
}

#minimap-container {
position: relative;
}

/* ===== INFO PANEL (Right side of bottom menu) ===== */
#info-panel {
width: 200px;
background: #0a0a12;
border: 1px solid #333;
border-radius: 6px;
padding: 8px;
display: flex;
flex-direction: column;
order: 3;
overflow: hidden;
transition: border-color 0.2s ease;
}

#info-panel.sticky {
border-color: #555;
}

#info-panel.sticky::after {
content: '📌 Click elsewhere to dismiss';
display: block;
font-size: 0.55rem;
color: #555;
text-align: center;
margin-top: 4px;
}

#info-panel-header {
font-size: 0.65rem;
color: #666;
text-transform: uppercase;
letter-spacing: 0.1em;
margin-bottom: 6px;
border-bottom: 1px solid #333;
padding-bottom: 4px;
}

#info-panel-content {
flex: 1;
font-size: 0.7rem;
color: #aaa;
line-height: 1.5;
overflow-y: auto;
}

#info-panel-content .info-title {
font-size: 0.8rem;
font-weight: bold;
color: #fff;
margin-bottom: 4px;
}

#info-panel-content .info-type {
font-size: 0.65rem;
color: #888;
margin-bottom: 6px;
text-transform: uppercase;
}

#info-panel-content .info-stat {
display: flex;
justify-content: space-between;
margin-bottom: 2px;
}

#info-panel-content .info-stat-label {
color: #666;
}

#info-panel-content .info-stat-value {
color: #4af;
}

#info-panel-content .info-desc {
font-size: 0.65rem;
color: #888;
margin-top: 6px;
padding-top: 6px;
border-top: 1px solid #333;
font-style: italic;
}

/* Enhanced info panel styles */
#info-panel-content .info-header-row {
display: flex;
gap: 8px;
margin-bottom: 8px;
align-items: center;
}

#info-panel-content .info-avatar {
width: 36px;
height: 36px;
border-radius: 6px;
border: 2px solid #444;
display: flex;
align-items: center;
justify-content: center;
flex-shrink: 0;
}

#info-panel-content .info-avatar.building {
border-radius: 4px;
}

#info-panel-content .info-header-text {
flex: 1;
min-width: 0;
}

#info-panel-content .info-tag {
font-size: 0.55rem;
padding: 1px 4px;
border-radius: 3px;
margin-left: 4px;
}

#info-panel-content .info-tag.flying {
background: rgba(68, 170, 255, 0.3);
color: #4af;
}

#info-panel-content .info-tag.ground {
background: rgba(100, 100, 100, 0.3);
color: #888;
}

#info-panel-content .info-stat-row {
display: flex;
gap: 8px;
margin-bottom: 4px;
}

#info-panel-content .info-stat-row .info-stat {
flex: 1;
font-size: 0.6rem;
}

#info-panel-content .info-section-title {
font-size: 0.55rem;
color: #555;
text-transform: uppercase;
letter-spacing: 0.05em;
margin: 6px 0 4px 0;
padding-top: 4px;
border-top: 1px solid #222;
}

#info-panel-content .info-targeting {
display: flex;
gap: 8px;
margin-bottom: 4px;
}

#info-panel-content .target-type {
font-size: 0.6rem;
padding: 2px 6px;
border-radius: 3px;
}

