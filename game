// === UPDATE FOG OF WAR ===
function updateFog() {
// Decay all visible to explored
for (let y = 0; y < TILES_Y; y++) {
for (let x = 0; x < TILES_X; x++) {
if (gameState.fogMap[y][x] === FOG.VISIBLE) {
gameState.fogMap[y][x] = FOG.EXPLORED;
}
}
}

// Reveal around player units
for (const unit of gameState.units) {
    revealAround(unit.x, unit.y, unit.sight, unit.isFlying, getTerrainAt(unit.x, unit.y));
}

// Reveal around player buildings
for (const building of gameState.buildings) {
    revealAround(building.x, building.y, 8, false, getTerrainAt(building.x, building.y));
}

}

function revealAround(worldX, worldY, sightRange, isFlying, viewerTerrain) {
const centerTileX = Math.floor(worldX / TILE_SIZE);
const centerTileY = Math.floor(worldY / TILE_SIZE);
const range = Math.ceil(sightRange);

for (let dy = -range; dy <= range; dy++) {
    for (let dx = -range; dx <= range; dx++) {
        const tileX = centerTileX + dx;
        const tileY = centerTileY + dy;
        
        if (tileX < 0 || tileX >= TILES_X || tileY < 0 || tileY >= TILES_Y) {
            continue;
        }
        
        const dist = Math.sqrt(dx * dx + dy * dy);
        if (dist <= sightRange) {
            // Terrain-based vision check (StarCraft style)
            const targetTerrain = gameState.terrainMap[tileY]?.[tileX] || TERRAIN.LOW;
            
            // Flying units see everything
            if (isFlying) {
                gameState.fogMap[tileY][tileX] = FOG.VISIBLE;
                continue;
            }
            
            // Ground units terrain vision rules:
            // - Same level: always visible
            // - Ramps: always visible
            // - LOW -> HIGH: blocked (unless adjacent to ramp)
            // - HIGH -> LOW: always visible
            
            if (targetTerrain === viewerTerrain || 
                targetTerrain === TERRAIN.RAMP || 
                viewerTerrain === TERRAIN.RAMP) {
                gameState.fogMap[tileY][tileX] = FOG.VISIBLE;
            } else if (viewerTerrain === TERRAIN.HIGH && targetTerrain === TERRAIN.LOW) {
                // Looking down from high ground - can see
                gameState.fogMap[tileY][tileX] = FOG.VISIBLE;
            } else if (viewerTerrain === TERRAIN.LOW && targetTerrain === TERRAIN.HIGH) {
                // Looking up at high ground from low - check for ramp proximity
                if (hasAdjacentRamp(tileX, tileY)) {
                    gameState.fogMap[tileY][tileX] = FOG.VISIBLE;
                }
                // else: stays explored/unexplored (can't see high ground without ramp)
            } else {
                gameState.fogMap[tileY][tileX] = FOG.VISIBLE;
            }
        }
    }
}

}

// Check if a tile has an adjacent ramp (allows vision between terrain levels)
function hasAdjacentRamp(tileX, tileY) {
    for (let dy = -1; dy <= 1; dy++) {
        for (let dx = -1; dx <= 1; dx++) {
            const nx = tileX + dx;
            const ny = tileY + dy;
            if (nx >= 0 && nx < TILES_X && ny >= 0 && ny < TILES_Y) {
                if (gameState.terrainMap[ny][nx] === TERRAIN.RAMP) {
                    return true;
                }
            }
        }
    }
    return false;
}

