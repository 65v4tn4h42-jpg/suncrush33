// === SIMPLE AI FOR PLAYER SIDE IN SIMULATION ===
function updateSimPlayerAI(simState, dt) {
    // Use a basic AI for the player side to test against
    const resources = simState.minerals;
    
    // Worker management - send idle workers to gather
    for (const unit of simState.units) {
        if (unit.type === 'worker' && unit.state === UNIT_STATE.IDLE && !unit.carryAmount) {
            // Find nearest mineral
            let nearest = null;
            let nearestDist = Infinity;
            for (const res of simState.resources) {
                if (res.type === 'mineral' && res.amount > 0) {
                    const d = Math.sqrt((res.x - unit.x) ** 2 + (res.y - unit.y) ** 2);
                    if (d < nearestDist) {
                        nearestDist = d;
                        nearest = res;
                    }
                }
            }
            if (nearest) {
                unit.gatherTarget = nearest;
                unit.state = UNIT_STATE.GATHERING;
            }
        }
    }
    
    // Train units from production buildings
    for (const building of simState.buildings) {
        if (building.type === 'production' && !building.isConstructing && 
            building.trainingQueue.length < 3) {
            const raceData = RACES[simState.playerRace];
            const soldierData = raceData.units.soldier;
            
            if (simState.minerals >= soldierData.cost.minerals) {
                simState.minerals -= soldierData.cost.minerals;
                simState.stats.playerResourcesSpent += soldierData.cost.minerals;
                building.trainingQueue.push('soldier');
            }
        }
        
        // Train workers from base
        if (building.type === 'base' && !building.isConstructing && 
            building.trainingQueue.length < 2) {
            const workers = simState.units.filter(u => u.type === 'worker').length;
            if (workers < 12) {
                const raceData = RACES[simState.playerRace];
                const workerData = raceData.units.worker;
                
                if (simState.minerals >= workerData.cost.minerals) {
                    simState.minerals -= workerData.cost.minerals;
                    simState.stats.playerResourcesSpent += workerData.cost.minerals;
                    building.trainingQueue.push('worker');
                }
            }
        }
    }
    
    // Build production building if we don't have one
    const hasProd = simState.buildings.some(b => b.type === 'production');
    if (!hasProd && simState.minerals >= 150) {
        const base = simState.buildings.find(b => b.type === 'base');
        if (base) {
            const raceData = RACES[simState.playerRace];
            const prodData = raceData.buildings.production;
            
            simState.buildings.push({
                id: 'b' + simState.nextId++,
                type: 'production',
                race: simState.playerRace,
                x: base.x + 120,
                y: base.y,
                hp: prodData.hp,
                maxHp: prodData.hp,
                size: prodData.size,
                isConstructing: false,
                trainingQueue: [],
                rallyPoint: { x: base.x + 200, y: base.y }
            });
            simState.minerals -= 150;
            simState.stats.playerResourcesSpent += 150;
        }
    }
    
    // Simple attack logic - send army to attack when we have enough
    const armyUnits = simState.units.filter(u => u.type !== 'worker' && u.state === UNIT_STATE.IDLE);
    if (armyUnits.length >= 6) {
        const enemyBase = simState.enemyBuildings.find(b => b.type === 'base');
        if (enemyBase) {
            for (const unit of armyUnits) {
                unit.targetX = enemyBase.x + (Math.random() - 0.5) * 50;
                unit.targetY = enemyBase.y + (Math.random() - 0.5) * 50;
                unit.state = UNIT_STATE.MOVING;
            }
        }
    }
}

// === GENOME-BASED AI FOR ENEMY SIDE ===
function updateSimGenomeAI(simState, dt) {
    const ai = simState.aiState;
    const genome = ai.genome;
    
    // Worker management
    for (const unit of simState.enemyUnits) {
        if (unit.type === 'worker' && unit.state === UNIT_STATE.IDLE && !unit.carryAmount) {
            let nearest = null;
            let nearestDist = Infinity;
            for (const res of simState.resources) {
                if (res.type === 'mineral' && res.amount > 0) {
                    const d = Math.sqrt((res.x - unit.x) ** 2 + (res.y - unit.y) ** 2);
                    if (d < nearestDist) {
                        nearestDist = d;
                        nearest = res;
                    }
                }
            }
            if (nearest) {
                unit.gatherTarget = nearest;
                unit.state = UNIT_STATE.GATHERING;
            }
        }
    }
    
    // Build production building
    const hasProd = simState.enemyBuildings.some(b => b.type === 'production');
    if (!hasProd && ai.minerals >= 150) {
        const base = simState.enemyBuildings.find(b => b.type === 'base');
        if (base) {
            const raceData = RACES[simState.enemyRace];
            const prodData = raceData.buildings.production;
            
            simState.enemyBuildings.push({
                id: 'b' + simState.nextId++,
                type: 'production',
                race: simState.enemyRace,
                x: base.x - 120,
                y: base.y,
                hp: prodData.hp,
                maxHp: prodData.hp,
                size: prodData.size,
                isConstructing: false,
                trainingQueue: [],
                rallyPoint: { x: base.x - 200, y: base.y }
            });
            ai.minerals -= 150;
            simState.stats.aiResourcesSpent += 150;
        }
    }
    
    // Train workers based on genome
    const workers = simState.enemyUnits.filter(u => u.type === 'worker').length;
    const targetWorkers = Math.floor(genome.targetWorkers);
    
    for (const building of simState.enemyBuildings) {
        if (building.type === 'base' && !building.isConstructing && 
            building.trainingQueue.length < 2 && workers < targetWorkers) {
            
            const raceData = RACES[simState.enemyRace];
            const workerData = raceData.units.worker;
            
            if (ai.minerals >= workerData.cost.minerals && 
                Math.random() < genome.workerPriority) {
                ai.minerals -= workerData.cost.minerals;
                simState.stats.aiResourcesSpent += workerData.cost.minerals;
                building.trainingQueue.push('worker');
            }
        }
        
        // Train combat units based on genome ratios
        if (building.type === 'production' && !building.isConstructing && 
            building.trainingQueue.length < 3) {
            
            const raceData = RACES[simState.enemyRace];
            let unitType = null;
            
            // Pick unit type based on genome ratios
            const roll = Math.random();
            if (roll < genome.soldierRatio) {
                unitType = 'soldier';
            } else if (roll < genome.soldierRatio + genome.heavyRatio) {
                unitType = 'heavy';
            } else if (roll < genome.soldierRatio + genome.heavyRatio + genome.specialistRatio) {
                unitType = 'specialist';
            } else {
                unitType = 'flyer';
            }
            
            const unitData = raceData.units[unitType];
            if (unitData && 
                ai.minerals >= unitData.cost.minerals && 
                ai.gas >= (unitData.cost.gas || 0)) {
                ai.minerals -= unitData.cost.minerals;
                ai.gas -= unitData.cost.gas || 0;
                simState.stats.aiResourcesSpent += unitData.cost.minerals + (unitData.cost.gas || 0);
                building.trainingQueue.push(unitType);
            }
        }
    }
    
    // Army coordination based on genome
    const combatUnits = simState.enemyUnits.filter(u => u.type !== 'worker');
    const idleArmy = combatUnits.filter(u => u.state === UNIT_STATE.IDLE);
    
    // Check if it's time to attack based on genome
    const timeSinceLastAttack = simState.gameTime - ai.lastAttackTime;
    const shouldAttack = timeSinceLastAttack > genome.attackInterval && 
                         simState.gameTime > genome.firstAttackDelay &&
                         idleArmy.length >= genome.minWaveSize;
    
    if (shouldAttack) {
        // Find target based on genome priority
        let target = null;
        if (genome.targetPriority === 'production') {
            target = simState.buildings.find(b => b.type === 'production');
        } else if (genome.targetPriority === 'workers') {
            target = simState.units.find(u => u.type === 'worker');
        } else if (genome.targetPriority === 'army') {
            target = simState.units.find(u => u.type !== 'worker');
        }
        if (!target) {
            target = simState.buildings.find(b => b.type === 'base');
        }
        
        if (target) {
            const waveSize = Math.min(idleArmy.length, Math.floor(genome.maxWaveSize));
            const attackWave = idleArmy.slice(0, waveSize);
            
            for (const unit of attackWave) {
                unit.target = target;
                unit.targetX = target.x + (Math.random() - 0.5) * 50;
                unit.targetY = target.y + (Math.random() - 0.5) * 50;
                unit.state = UNIT_STATE.ATTACKING;
            }
            
            ai.lastAttackTime = simState.gameTime;
        }
    }
    
    // Micro based on genome
    if (genome.retreatThreshold > 0) {
        for (const unit of combatUnits) {
            if (unit.hp / unit.maxHp < genome.retreatThreshold && 
                unit.state === UNIT_STATE.ATTACKING) {
                const base = simState.enemyBuildings.find(b => b.type === 'base');
                if (base) {
                    unit.targetX = base.x;
                    unit.targetY = base.y;
                    unit.state = UNIT_STATE.MOVING;
                    unit.target = null;
                }
            }
        }
    }
}

// === INITIALIZE TRAINING ===
function initializeTraining(config = {}) {
    geneticState.populationSize = config.populationSize || 20;
    geneticState.battlesPerGenome = config.battlesPerGenome || 3;
    geneticState.eliteCount = config.eliteCount || 4;
    geneticState.mutationRate = config.mutationRate || 0.15;
    geneticState.simTimeLimit = config.simTimeLimit || 600;
    
    geneticState.generation = 0;
    geneticState.currentBattle = 0;
    geneticState.population = [];
    geneticState.fitnessScores = [];
    geneticState.battleResults = [];
    geneticState.generationStats = [];
    
    // Initialize population with random genomes
    for (let i = 0; i < geneticState.populationSize; i++) {
        geneticState.population.push(createRandomGenome());
        geneticState.fitnessScores.push(0);
        geneticState.battleResults.push([]);
    }
    
    geneticState.isTraining = true;
    geneticState.isPaused = false;
}

// === RUN TRAINING LOOP ===
async function runTrainingGeneration(session) {
    const gs = geneticState;
    const live = () => gs.isTraining && gs.session === session;
    
    // Evaluate each genome
    for (let i = 0; i < gs.populationSize; i++) {
        // v33: pausing waits here instead of ending the generation; a stopped or restarted
        // generation is dropped rather than evolved with its untested genomes scored 0
        while (gs.isPaused && live()) await new Promise(resolve => setTimeout(resolve, 100));
        if (!live()) return;
        
        gs.battleResults[i] = [];
        
        // Run multiple battles for each genome
        for (let b = 0; b < gs.battlesPerGenome; b++) {
            // Alternate factions for balanced testing
            const playerFaction = gs.factions[b % gs.factions.length];
            const aiFaction = gs.factions[(b + 1) % gs.factions.length];
            
            // Create and run simulation
            const simState = createSimulationState(playerFaction, aiFaction, gs.population[i]);
            initializeSimulation(simState);
            
            const result = runSimulation(simState, gs.simTimeLimit);
            result.playerFaction = playerFaction;
            result.aiFaction = aiFaction;
            
            gs.battleResults[i].push(result);
            gs.currentBattle++;
            
            // Update progress callback
            if (gs.onProgress) {
                gs.onProgress({
                    generation: gs.generation,
                    genomeIndex: i,
                    battleIndex: b,
                    totalGenomes: gs.populationSize,
                    totalBattles: gs.populationSize * gs.battlesPerGenome,
                    currentBattle: gs.currentBattle,
                    result: result
                });
            }
            
            // Yield to prevent blocking (allow UI updates)
            await new Promise(resolve => setTimeout(resolve, 0));
            if (!live()) return;
        }
        
        // Calculate fitness for this genome
        gs.fitnessScores[i] = calculateFitness(gs.battleResults[i]);
    }
    
    // Record generation stats
    const genStats = {
        generation: gs.generation,
        avgFitness: gs.fitnessScores.reduce((a, b) => a + b, 0) / gs.populationSize,
        maxFitness: Math.max(...gs.fitnessScores),
        minFitness: Math.min(...gs.fitnessScores)
    };
    gs.generationStats.push(genStats);
    
    // Update best genome
    const bestIdx = gs.fitnessScores.indexOf(Math.max(...gs.fitnessScores));
    if (gs.fitnessScores[bestIdx] > gs.bestFitness) {
        gs.bestFitness = gs.fitnessScores[bestIdx];
        gs.bestGenome = { ...gs.population[bestIdx] };
    }
    
    // Evolution - create next generation
    const newPopulation = [];
    
    // Elitism - keep top performers
    const sortedIndices = gs.fitnessScores
        .map((f, i) => ({ fitness: f, index: i }))
        .sort((a, b) => b.fitness - a.fitness)
        .map(x => x.index);
    
    for (let i = 0; i < gs.eliteCount; i++) {
        newPopulation.push({ ...gs.population[sortedIndices[i]] });
    }
    
    // Fill rest with crossover and mutation
    while (newPopulation.length < gs.populationSize) {
        if (Math.random() < gs.crossoverRate) {
            const parent1 = tournamentSelect(gs.population, gs.fitnessScores);
            const parent2 = tournamentSelect(gs.population, gs.fitnessScores);
            let child = crossoverGenomes(parent1, parent2);
            child = mutateGenome(child);
            newPopulation.push(child);
        } else {
            const parent = tournamentSelect(gs.population, gs.fitnessScores);
            const child = mutateGenome({ ...parent });
            newPopulation.push(child);
        }
    }
    
    gs.population = newPopulation;
    gs.fitnessScores = new Array(gs.populationSize).fill(0);
    gs.battleResults = gs.population.map(() => []);
    gs.generation++;
    gs.currentBattle = 0;
    
    if (gs.onGenerationComplete) {
        gs.onGenerationComplete(genStats);
    }
}

// === TRAINING CONTROL FUNCTIONS ===
function startTraining(config = {}) {
    geneticState.session = (geneticState.session || 0) + 1;   // v33: a restart retires the previous loop
    initializeTraining(config);
    runTrainingLoop(geneticState.session);
}

async function runTrainingLoop(session) {
    const gs = geneticState;
    
    while (gs.isTraining && gs.session === session) {
        if (gs.isPaused) {
            await new Promise(resolve => setTimeout(resolve, 100));
            continue;
        }
        
        await runTrainingGeneration(session);
        
        // Check for manual stop
        if (!gs.isTraining || gs.session !== session) break;
    }
    if (gs.session !== session) return;   // v33: a newer session owns the panel
    
    if (gs.onTrainingComplete) {
        gs.onTrainingComplete({
            generations: gs.generation,
            bestGenome: gs.bestGenome,
            bestFitness: gs.bestFitness,
            stats: gs.generationStats
        });
    }
}

function pauseTraining() {
    geneticState.isPaused = true;
}

function resumeTraining() {
    geneticState.isPaused = false;
}

function stopTraining() {
    geneticState.isTraining = false;
    geneticState.isPaused = false;
}

function getBestGenome() {
    return geneticState.bestGenome;
}

function applyGenomeToAI(genome) {
    // Apply the evolved genome to the main game AI
    if (!genome) return;
    
    // Update AI difficulty settings based on genome
    const difficulty = AI_DIFFICULTY[gameOptions.aiDifficulty];
    difficulty.attackInterval = genome.attackInterval;
    difficulty.minWaveSize = Math.floor(genome.minWaveSize);
    difficulty.maxWaveSize = Math.floor(genome.maxWaveSize);
    difficulty.aggression = genome.aggression;
    
    // Store genome in AI state for use
    if (gameState.aiState) {
        gameState.aiState.genome = genome;
    }
}

function exportGenome(genome) {
    return JSON.stringify(genome, null, 2);
}

function importGenome(jsonString) {
    try {
