                out[key].push({ cv, w, h });
            }
        };
        const ell = (c, x, y, rx, ry, col) => { c.fillStyle = col; for (let yy = -ry; yy <= ry; yy++) { const hw = Math.round(rx * Math.sqrt(Math.max(0, 1 - (yy * yy) / (ry * ry)))); c.fillRect(Math.round(x - hw), Math.round(y + yy), hw * 2, 1); } };
        mk('puddle', 30, 16, (c, v, r, w, h) => {
            ell(c, 15, 8, 12 - v, 5, '#0d1a1c'); ell(c, 15, 8, 10 - v, 4, '#17333a'); ell(c, 14, 7, 7 - v, 2, '#24505a');
            c.fillStyle = 'rgba(190,230,255,0.55)'; c.fillRect(10, 6, 4, 1); c.fillRect(17, 9, 2, 1);
            c.fillStyle = '#3d5a2a'; c.fillRect(3 + v, 8, 2, 1); c.fillRect(25 - v, 7, 2, 1);
        });
        mk('crater', 30, 18, (c, v, r) => {
            ell(c, 15, 9, 13 - v, 7 - v * 0.5, 'rgba(0,0,0,0.22)'); ell(c, 15, 10, 10 - v, 5, 'rgba(0,0,0,0.30)');
            c.fillStyle = 'rgba(255,240,220,0.10)'; for (let k = 0; k < 7; k++) c.fillRect(4 + Math.floor(r(k) * 22), 3 + Math.floor(r(k + 9) * 3), 2, 1);
        });
        mk('leaves', 22, 14, (c, v, r) => {
            const cols = ['#6b4f1d', '#8a6a24', '#a3401c', '#4a5d23'];
            for (let k = 0; k < 9; k++) { c.fillStyle = cols[k % 4]; c.fillRect(Math.floor(r(k) * 20), Math.floor(r(k + 30) * 12), 2, 1); }
        });
        mk('roots', 28, 14, (c, v, r) => {
            c.fillStyle = '#2a1d10';
            for (let k = 0; k < 3; k++) { let x = 14, y = 7; for (let j = 0; j < 9; j++) { c.fillRect(Math.round(x), Math.round(y), 1, 1); x += (k - 1) * 1.3 + (r(k * 10 + j) - 0.5); y += (r(k * 20 + j) - 0.5) * 1.6; } }
        });
        mk('lavaPool', 30, 16, (c, v) => {
            ell(c, 15, 8, 12 - v, 6, '#1a0b06'); ell(c, 15, 8, 10 - v, 4, '#7c2d12'); ell(c, 15, 8, 8 - v, 3, '#ea580c'); ell(c, 14, 7, 4, 1, '#fdba74');
