// === START RESEARCH ===
function startResearch(building, upgradeType, currentLevel) {
    const upgradeData = UPGRADES[upgradeType];
    const cost = upgradeData.cost[currentLevel];
    
    // Deduct resources
    gameState.minerals -= cost.minerals;
    gameState.gas -= cost.gas;
    
    // Set research queue
    building.researchQueue = {
        type: upgradeType,
        progress: 0,
        totalTime: upgradeData.researchTime[currentLevel]
    };
    
    addMessage(`Researching ${upgradeData.name} Level ${currentLevel + 1}...`, '#4af');
    updateHUD();
    updateCommandCard();
}

// === CANCEL RESEARCH ===
function cancelResearch(building) {
    if (!building.researchQueue) return;
    
    const upgradeType = building.researchQueue.type;
    const upgradeData = UPGRADES[upgradeType];
    const currentLevel = gameState.upgrades[upgradeType] || 0;
    const cost = upgradeData.cost[currentLevel];
    
    // v33: BW refunds the full cost of cancelled research (was 75%)
    const refundMinerals = cost.minerals;
    const refundGas = cost.gas;
    
    gameState.minerals += refundMinerals;
    gameState.gas += refundGas;
    
    building.researchQueue = null;
    
    addMessage(`${upgradeData.name} cancelled. Refunded: ${refundMinerals} minerals, ${refundGas} gas`, '#fa4');
    
    updateHUD();
    updateCommandCard();
    updateSelectionPanel();
}

