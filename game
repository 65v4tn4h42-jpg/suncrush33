            }
        }
    }

    // BW-style terrain transitions: 16 marching-squares cases, bilinear corner field + periodic
    // noise (identical on opposite tile edges, so neighbouring tiles meet seamlessly)
    const maskCache = new Map();
    function maskFor(c, S) {
        const k = c + '|' + S;
        if (maskCache.has(k)) return maskCache.get(k);
        const N = Math.round(T * S), px = Math.max(1, Math.round(S));
        const tl = (c >> 3) & 1, tr = (c >> 2) & 1, br = (c >> 1) & 1, bl = c & 1;
        const nz = makeNoise(N, 5, 303);
