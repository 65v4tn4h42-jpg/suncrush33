// === UPDATE UNIT ENERGY ===
function updateUnitEnergy(dt) {
    const allUnits = [...gameState.units, ...gameState.enemyUnits];
    
    for (const unit of allUnits) {
        // Regenerate energy
        if (unit.maxEnergy > 0 && unit.energy < unit.maxEnergy) {
            unit.energy = Math.min(unit.maxEnergy, unit.energy + unit.energyRegen * dt);
        }
        
        // Update ability cooldowns
        for (const abilityId in unit.abilityCooldowns) {
            if (unit.abilityCooldowns[abilityId] > 0) {
                unit.abilityCooldowns[abilityId] = Math.max(0, unit.abilityCooldowns[abilityId] - dt);
            }
        }
        
        // Update phase cooldown
        if (unit.phaseCooldown > 0) {
            unit.phaseCooldown -= dt;
        }
        
        // Burrowed HP regen for Swarm
        if (unit.burrowed) {
            const unitData = RACES[unit.race]?.units?.[unit.type];
            if (unitData?.burrowStats?.hpRegen) {
                unit.hp = Math.min(unit.maxHp, unit.hp + unitData.burrowStats.hpRegen * dt);
            }
        }
    }
}

// === UPDATE PSI STORMS ===
// v33: BW Psionic Storm — hits every unit under it, friend or foe (buildings are immune), ignores
// armour, and overlapping storms don't stack (a unit takes at most one storm tick at a time).
function updatePsiStorms(dt) {
    if (!gameState.psiStorms) gameState.psiStorms = [];

    for (let i = gameState.psiStorms.length - 1; i >= 0; i--) {
        const storm = gameState.psiStorms[i];
        storm.elapsed += dt;
        storm.tickTimer += dt;

        if (storm.tickTimer >= 0.5) {
            storm.tickTimer -= 0.5;
            const damagePerTick = storm.damage / (storm.duration * 2);
            const R = storm.radius * TILE_SIZE;
            for (const pool of [gameState.units, gameState.enemyUnits]) {
                for (const u of pool.slice()) {
                    if (u.hp <= 0) continue;
                    if (distance(storm.x, storm.y, u.x, u.y) >= R) continue;
                    if (u._stormT !== undefined && gameState.gameTime - u._stormT < 0.45) continue;
                    u._stormT = gameState.gameTime;
                    dealDamage(u, damagePerTick, { isSpell: true, source: null, ownerIsPlayer: storm.isPlayer });
                    spawnPsiStormParticle(u.x, u.y);
                }
            }
        }

        if (storm.elapsed >= storm.duration) {
            gameState.psiStorms.splice(i, 1);
        }
    }
}

// === CAST ABILITY ===
function castAbility(unit, abilityId, targetX, targetY, targetUnit) {
    const ability = ABILITIES[abilityId];
    if (!ability) return false;
    
    // Check energy
    if (unit.energy < ability.energyCost) {
        addMessage('Not enough energy!', '#f44');
        return false;
    }
    
    // Check cooldown
    if (unit.abilityCooldowns[abilityId] > 0) {
        addMessage('Ability on cooldown!', '#f44');
        return false;
    }
    
    // Check range
    if (ability.range && targetX !== undefined) {
        const dist = distance(unit.x, unit.y, targetX, targetY) / TILE_SIZE;
        if (dist > ability.range) {
            addMessage('Target out of range!', '#f44');
            return false;
        }
    }
    
    // Consume energy and start cooldown
    unit.energy -= ability.energyCost;
    unit.abilityCooldowns[abilityId] = ability.cooldown;
    
    // Execute ability
    switch (abilityId) {
        case 'psiStorm':
            createPsiStorm(targetX, targetY, ability, unit.isPlayer);
            addMessage('Psi Storm unleashed!', '#b91c1c');
            break;
            
        case 'healBurst':
            if (targetUnit && targetUnit.isPlayer === unit.isPlayer) {
                targetUnit.hp = Math.min(targetUnit.maxHp, targetUnit.hp + ability.healAmount);
                spawnHealBurstParticles(targetUnit.x, targetUnit.y);
                addMessage('Emergency Heal!', '#44ffaa');
            }
            break;
            
        case 'spineVolley':
            if (targetUnit) {
                // Fire multiple projectiles
                for (let i = 0; i < ability.projectiles; i++) {
                    setTimeout(() => {
                        if (targetUnit.hp > 0) {
                            const proj = {
                                x: unit.x,
                                y: unit.y,
                                targetX: targetUnit.x + (Math.random() - 0.5) * 20,
                                targetY: targetUnit.y + (Math.random() - 0.5) * 20,
                                target: targetUnit,
                                damage: ability.damage / ability.projectiles,
                                color: '#059669',
                                source: unit,
                                speed: WEAPON_SPEED.spine,   // v33 fix: had none — shards never landed
                                fx: 'spine',
                                isPlayerSource: unit.isPlayer,
                                race: unit.race,
                                z: 8, z0: 8, z1: targetUnit.isFlying ? COMBAT.flyingUnitElevation : 6
                            };
                            gameState.projectiles.push(proj);
                        }
                    }, i * 100);
                }
                addMessage('Spine Volley!', '#059669');
            }
            break;
            
        case 'feedback':
            if (targetUnit && targetUnit.maxEnergy > 0) {
                const feedbackDamage = targetUnit.energy;
                targetUnit.energy = 0;
                dealDamage(targetUnit, feedbackDamage, null);
                spawnFeedbackParticles(targetUnit.x, targetUnit.y);
                addMessage(`Feedback dealt ${Math.round(feedbackDamage)} damage!`, '#b91c1c');
            }
            break;
    }
    
    return true;
}

// === CREATE PSI STORM ===
function createPsiStorm(x, y, ability, isPlayer) {
    if (!gameState.psiStorms) gameState.psiStorms = [];
    
    gameState.psiStorms.push({
        x: x,
        y: y,
        damage: ability.damage,
        duration: ability.duration,
        radius: ability.radius,
        elapsed: 0,
        tickTimer: 0,
        isPlayer: isPlayer
    });
}

