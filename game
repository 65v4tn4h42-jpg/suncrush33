// === CREATE RANDOM GENOME ===
function createRandomGenome() {
    const genome = {};
    
    // Timing genes with realistic ranges
    genome.attackInterval = 30 + Math.random() * 90;      // 30-120s
    genome.firstAttackDelay = 60 + Math.random() * 120;   // 60-180s
    genome.scoutInterval = 15 + Math.random() * 45;       // 15-60s
    
    // Army composition (normalized to sum to 1)
    let soldier = Math.random();
    let heavy = Math.random();
    let specialist = Math.random();
    let flyer = Math.random();
    const total = soldier + heavy + specialist + flyer;
    genome.soldierRatio = soldier / total;
    genome.heavyRatio = heavy / total;
    genome.specialistRatio = specialist / total;
    genome.flyerRatio = flyer / total;
    
    // Economy
    genome.targetWorkers = 6 + Math.floor(Math.random() * 18);  // 6-24
    genome.workerPriority = Math.random();
    genome.expansionThreshold = 1000 + Math.random() * 3000;
    
    // Micro
    genome.retreatThreshold = 0.1 + Math.random() * 0.4;  // 10-50%
    genome.focusFireEnabled = Math.random() > 0.3;
    genome.kitingEnabled = Math.random() > 0.4;
    genome.abilityUsage = Math.random();
    
    // Attack
    genome.minWaveSize = 2 + Math.floor(Math.random() * 8);  // 2-10
    genome.maxWaveSize = genome.minWaveSize + Math.floor(Math.random() * 10);  // +0-10
    genome.aggression = Math.random();
    genome.targetPriority = ['production', 'workers', 'army', 'base'][Math.floor(Math.random() * 4)];
    
    // Tech
    genome.upgradeDelay = 30 + Math.random() * 150;  // 30-180s
    genome.upgradePriority = Math.random();
    
    // Tactical
    genome.highGroundPreference = Math.random();
    genome.regroupThreshold = 0.2 + Math.random() * 0.5;
    genome.defendBaseRadius = 200 + Math.random() * 300;
    
    // Adaptive
    genome.counterAirBonus = Math.random() * 0.5;
    genome.counterRangedBonus = Math.random() * 0.5;
    
    return genome;
}

// === CROSSOVER TWO GENOMES ===
function crossoverGenomes(parent1, parent2) {
    const child = {};
    
    for (const key in DEFAULT_GENOME) {
        if (typeof DEFAULT_GENOME[key] === 'boolean') {
            // Boolean: pick from either parent
            child[key] = Math.random() > 0.5 ? parent1[key] : parent2[key];
        } else if (typeof DEFAULT_GENOME[key] === 'string') {
            // String: pick from either parent
            child[key] = Math.random() > 0.5 ? parent1[key] : parent2[key];
        } else {
            // Number: blend or pick
            if (Math.random() > 0.5) {
                // Blend
                const alpha = Math.random();
                child[key] = parent1[key] * alpha + parent2[key] * (1 - alpha);
            } else {
                // Pick one
                child[key] = Math.random() > 0.5 ? parent1[key] : parent2[key];
            }
        }
    }
    
    // Normalize army ratios
    const armyTotal = child.soldierRatio + child.heavyRatio + 
                      child.specialistRatio + child.flyerRatio;
    if (armyTotal > 0) {
        child.soldierRatio /= armyTotal;
        child.heavyRatio /= armyTotal;
        child.specialistRatio /= armyTotal;
        child.flyerRatio /= armyTotal;
    }
    
    return child;
}

// === MUTATE GENOME ===
function mutateGenome(genome) {
    const mutated = { ...genome };
    const rate = geneticState.mutationRate;
    const strength = geneticState.mutationStrength;
    
    for (const key in mutated) {
        if (Math.random() > rate) continue;
        
        if (typeof mutated[key] === 'boolean') {
            // Flip boolean
            mutated[key] = !mutated[key];
        } else if (typeof mutated[key] === 'string') {
            // Pick new random option
            if (key === 'targetPriority') {
                mutated[key] = ['production', 'workers', 'army', 'base'][Math.floor(Math.random() * 4)];
            }
        } else {
            // Mutate number with Gaussian-like perturbation
            const delta = (Math.random() - 0.5) * 2 * strength * Math.abs(mutated[key] || 1);
            mutated[key] += delta;
            
            // Clamp ratios and probabilities to 0-1
            if (key.includes('Ratio') || key.includes('Priority') || 
                key.includes('Threshold') || key.includes('Preference') ||
                key === 'aggression' || key === 'abilityUsage' ||
                key.includes('Bonus')) {
                mutated[key] = Math.max(0, Math.min(1, mutated[key]));
            }
            
            // Ensure positive values for counts and times
            if (key.includes('Wave') || key.includes('Workers') || 
                key.includes('Interval') || key.includes('Delay') ||
                key.includes('Radius') || key.includes('Threshold')) {
                mutated[key] = Math.max(1, mutated[key]);
            }
        }
    }
    
    // Re-normalize army ratios after mutation
    const armyTotal = mutated.soldierRatio + mutated.heavyRatio + 
                      mutated.specialistRatio + mutated.flyerRatio;
    if (armyTotal > 0) {
        mutated.soldierRatio /= armyTotal;
        mutated.heavyRatio /= armyTotal;
        mutated.specialistRatio /= armyTotal;
        mutated.flyerRatio /= armyTotal;
    }
    
    return mutated;
}

// === TOURNAMENT SELECTION ===
function tournamentSelect(population, fitness, tournamentSize = 3) {
    let best = null;
    let bestFitness = -Infinity;
    
    for (let i = 0; i < tournamentSize; i++) {
        const idx = Math.floor(Math.random() * population.length);
        if (fitness[idx] > bestFitness) {
            bestFitness = fitness[idx];
            best = population[idx];
        }
    }
    
    return best;
}

// === CALCULATE FITNESS FROM BATTLE RESULTS ===
function calculateFitness(results) {
    let fitness = 0;
    
    for (const result of results) {
        // Base score: win = 1000, loss = 0, draw = 200
        if (result.winner === 'ai') {
            fitness += 1000;
            
            // Bonus for fast wins (max 500 bonus at 60s, 0 bonus at 600s)
            const timeBonus = Math.max(0, 500 * (1 - result.duration / geneticState.simTimeLimit));
            fitness += timeBonus;
            
            // Bonus for efficiency (units killed / units lost ratio)
            const efficiency = ((result.aiUnitsKilled ?? result.playerUnitsLost ?? 0) + 1) / ((result.aiUnitsLost || 0) + 1);   // v33: the sim reports player losses, not AI kills (every win and draw scored NaN)
            fitness += Math.min(300, efficiency * 50);
            
            // Bonus for resource efficiency
            const resourceRatio = result.aiResourcesSpent > 0 ? 
                result.aiDamageDealt / result.aiResourcesSpent : 0;
            fitness += Math.min(200, resourceRatio * 100);
        } else if (result.winner === 'draw') {
            fitness += 200;
            // Partial efficiency bonus for draws
            const efficiency = ((result.aiUnitsKilled ?? result.playerUnitsLost ?? 0) + 1) / ((result.aiUnitsLost || 0) + 1);   // v33: the sim reports player losses, not AI kills (every win and draw scored NaN)
            fitness += Math.min(100, efficiency * 20);
        } else {
            // Loss: small bonus for lasting longer / dealing damage
            const survivalBonus = (result.duration / geneticState.simTimeLimit) * 100;
            fitness += survivalBonus;
            
            const damageBonus = Math.min(100, result.aiDamageDealt / 100);
            fitness += damageBonus;
        }
    }
    
    // Average across battles
    if (!Number.isFinite(fitness)) fitness = 0;
    return results.length > 0 ? fitness / results.length : 0;
}

