// === GET TERRAIN AT POSITION ===
function getTerrainAt(x, y) {
const tileX = Math.floor(x / TILE_SIZE);
const tileY = Math.floor(y / TILE_SIZE);

if (tileX < 0 || tileX >= TILES_X || tileY < 0 || tileY >= TILES_Y) {
    return TERRAIN.LOW;
}

return gameState.terrainMap[tileY][tileX];

}

// === CHECK IF TERRAIN TRANSITION IS VALID ===
// Units can only move between HIGH and LOW terrain via RAMP tiles
// Flying units ignore all terrain restrictions
function canTraverseTerrain(fromX, fromY, toX, toY, unit) {
    // Flying units ignore terrain
    if (unit && unit.isFlying) return true;
    
    const fromTerrain = getTerrainAt(fromX, fromY);
    const toTerrain = getTerrainAt(toX, toY);
    
    // Same terrain level - always allowed
    if (fromTerrain === toTerrain) return true;
    
    // Ramp tiles allow all transitions
    if (fromTerrain === TERRAIN.RAMP || toTerrain === TERRAIN.RAMP) return true;
    
    // Check if unit has cliffWalk ability (like Colossus)
    if (unit) {
        const raceData = RACES[unit.race];
        const unitData = raceData?.units?.[unit.type];
        if (unitData?.cliffWalk) return true;
    }
    
    // HIGH to LOW or LOW to HIGH without ramp - blocked
    if ((fromTerrain === TERRAIN.HIGH && toTerrain === TERRAIN.LOW) ||
        (fromTerrain === TERRAIN.LOW && toTerrain === TERRAIN.HIGH)) {
        return false;
    }
    
    return true;
}

// === FIND NEAREST RAMP TO TARGET ===
function findNearestRamp(fromX, fromY, toX, toY) {
    let nearestRamp = null;
    let nearestDist = Infinity;
    
    // Scan terrain map for ramps
    for (let tileY = 0; tileY < TILES_Y; tileY++) {
        for (let tileX = 0; tileX < TILES_X; tileX++) {
            if (gameState.terrainMap[tileY][tileX] === TERRAIN.RAMP) {
                const rampX = tileX * TILE_SIZE + TILE_SIZE / 2;
                const rampY = tileY * TILE_SIZE + TILE_SIZE / 2;
                
                // Prefer ramps that are between us and target
                const distToRamp = distance(fromX, fromY, rampX, rampY);
                const rampToTarget = distance(rampX, rampY, toX, toY);
                const totalDist = distToRamp + rampToTarget;
                
                if (totalDist < nearestDist) {
                    nearestDist = totalDist;
                    nearestRamp = { x: rampX, y: rampY };
                }
            }
        }
    }
    
    return nearestRamp;
}

// === CHECK IF POSITION IS VISIBLE ===
function isVisible(x, y) {
const tileX = Math.floor(x / TILE_SIZE);
const tileY = Math.floor(y / TILE_SIZE);

if (tileX < 0 || tileX >= TILES_X || tileY < 0 || tileY >= TILES_Y) {
    return false;
}

return gameState.fogMap[tileY][tileX] === FOG.VISIBLE;

}

// === DISTANCE HELPER ===
function distance(x1, y1, x2, y2) {
const dx = x2 - x1;
const dy = y2 - y1;
return Math.sqrt(dx * dx + dy * dy);
}

// === SHUFFLE ARRAY (Fisher-Yates) ===
function shuffleArray(array) {
    for (let i = array.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [array[i], array[j]] = [array[j], array[i]];
    }
    return array;
}
