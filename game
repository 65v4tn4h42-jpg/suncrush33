}

/* ===== TRAIN AI BUTTON ===== */
.train-ai-btn {
margin-top: 1.5rem;
padding: 0.6rem 1.5rem;
background: linear-gradient(180deg, #1a1a2e 0%, #0d0d1a 100%);
border: 1px solid #444;
border-radius: 6px;
color: #9ca3af;
font-size: 0.85rem;
cursor: pointer;
transition: all 0.3s ease;
}

.train-ai-btn:hover {
border-color: #8b5cf6;
color: #c4b5fd;
box-shadow: 0 0 15px rgba(139, 92, 246, 0.3);
}

