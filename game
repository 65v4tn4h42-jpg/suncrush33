// === v32: TECH TREE, DAMAGE TYPES, UNIT SIZES ===
// Central table merged into RACES below. Mirrors StarCraft's tech pacing
// ("rushing tactics less practical" — BW design) and its damage-type vs
// unit-size counter system, the core of enduring composition strategy.

// Unit prerequisites: which building types (and counts) must be complete before training.
// Format: array of { type, count } — all must be satisfied.
const TECH_REQUIREMENTS = {
    worker:     [],                                                        // base only (implicit — trained at base)
    soldier:    [],                                                        // tier 1: production building itself suffices
    specialist: [{ type: 'techlab', count: 1 }],                           // tier 2
    heavy:      [{ type: 'techlab', count: 1 }],                           // tier 2
    flyer:      [{ type: 'techlab', count: 1 }, { type: 'production', count: 2 }]  // tier 3
};

// BW damage-type vs size-class multiplier table.
// normal: full vs everything. concussive: shreds small, weak vs large.
// explosive: full vs large, weak vs small. Buildings count as 'large'.
const DAMAGE_MODIFIERS = {
    normal:     { small: 1.0,  medium: 1.0,  large: 1.0  },
    concussive: { small: 1.0,  medium: 0.5,  large: 0.25 },
    explosive:  { small: 0.5,  medium: 0.75, large: 1.0  }
};

// Per-race damage type + size assignments (BW analogs).
const UNIT_COMBAT_PROFILE = {
    coalition: {
        worker:     { damageType: 'normal',     sizeClass: 'small'  },
        soldier:    { damageType: 'normal',     sizeClass: 'small'  },   // Marine
        heavy:      { damageType: 'explosive',  sizeClass: 'large'  },   // Siege Tank
        specialist: { damageType: 'normal',     sizeClass: 'small'  },   // Medic
        flyer:      { damageType: 'explosive',  sizeClass: 'large'  }    // Wraith
    },
    swarm: {
        worker:     { damageType: 'normal',     sizeClass: 'small'  },
        soldier:    { damageType: 'normal',     sizeClass: 'small'  },   // Zergling
        heavy:      { damageType: 'normal',     sizeClass: 'large'  },   // Ultralisk-style
        specialist: { damageType: 'explosive',  sizeClass: 'medium' },   // Hydralisk-style
        flyer:      { damageType: 'normal',     sizeClass: 'medium' }    // Mutalisk-style
    },
    ascended: {
        worker:     { damageType: 'normal',     sizeClass: 'small'  },
        soldier:    { damageType: 'normal',     sizeClass: 'small'  },   // Zealot
        heavy:      { damageType: 'explosive',  sizeClass: 'large'  },   // Reaver/Colossus-style
        specialist: { damageType: 'normal',     sizeClass: 'small'  },   // High Templar
        flyer:      { damageType: 'explosive',  sizeClass: 'large'  }    // Corsair-style
    }
};

// Merge tables into RACES unit definitions at load time.
for (const raceKey of Object.keys(RACES)) {
    const units = RACES[raceKey].units;
    for (const unitKey of Object.keys(units)) {
        if (!units[unitKey].requires) {
            units[unitKey].requires = TECH_REQUIREMENTS[unitKey] || [];
        }
        const profile = UNIT_COMBAT_PROFILE[raceKey] && UNIT_COMBAT_PROFILE[raceKey][unitKey];
        if (profile) {
