color: #f97316;
font-weight: bold;
text-align: right;
font-family: 'Consolas', monospace;
}

/* ===== TERRAIN LEGEND ===== */
#terrain-legend {
position: absolute;
bottom: 150px;
right: 10px;
background: rgba(10, 10, 18, 0.9);
border: 1px solid #444;
border-radius: 6px;
padding: 6px 8px;
font-size: 0.5rem;
margin-left: 4px;
z-index: 15;
transition: all 0.3s ease;
}

#terrain-legend.dismissed {
display: none;
}

#terrain-legend-toggle {
position: absolute;
bottom: 150px;
right: 10px;
background: rgba(10, 10, 18, 0.9);
border: 1px solid #444;
border-radius: 4px;
padding: 4px 8px;
font-size: 0.5rem;
margin-left: 4px;
color: #888;
cursor: pointer;
z-index: 15;
display: none;
}

#terrain-legend-toggle:hover {
background: rgba(20, 20, 30, 0.95);
color: #aaa;
border-color: #555;
}

#terrain-legend-toggle.visible {
display: block;
}

.legend-header {
display: flex;
justify-content: space-between;
align-items: center;
margin-bottom: 4px;
}

.legend-title {
color: #888;
text-transform: uppercase;
letter-spacing: 0.1em;
cursor: pointer;
}

.legend-dismiss {
color: #666;
cursor: pointer;
font-size: 0.7rem;
padding: 0 4px;
margin-left: 8px;
}

.legend-dismiss:hover {
color: #f66;
}

.legend-item {
display: flex;
align-items: center;
gap: 6px;
margin-bottom: 2px;
color: #aaa;
}

.legend-color {
width: 10px;
height: 10px;
border-radius: 2px;
}

#terrain-legend.collapsed .legend-item {
display: none;
}

#terrain-legend .legend-toggle {
cursor: pointer;
display: flex;
align-items: center;
gap: 4px;
}

#terrain-legend .legend-toggle::after {
