// === v33: CONSOLE — faction skin, generated panel texture, HUD icon ===
function consoleTexture(race) {
    const N = 96;
    const cv = document.createElement('canvas'); cv.width = N; cv.height = N;
    const c = cv.getContext('2d');
    let seed = race === 'coalition' ? 11 : (race === 'swarm' ? 23 : 37);
    const rnd = () => { seed = (seed * 16807) % 2147483647; return seed / 2147483647; };
    const wrap = (fn) => { for (const ox of [-N, 0, N]) for (const oy of [-N, 0, N]) fn(ox, oy); };
    if (race === 'coalition') {
        c.fillStyle = 'rgba(255,255,255,0.022)';
        for (let y = 0; y < N; y += 2) if (rnd() < 0.45) c.fillRect(0, y, N, 1);
        const seams = [[0, 47, N, 1], [47, 0, 1, 47], [23, 48, 1, 48], [71, 48, 1, 48]];
        c.fillStyle = 'rgba(0,0,0,0.5)'; for (const s of seams) c.fillRect(...s);
        c.fillStyle = 'rgba(190,210,255,0.07)'; for (const s of seams) c.fillRect(s[0] + (s[2] === 1 ? 1 : 0), s[1] + (s[3] === 1 ? 1 : 0), s[2], s[3]);
        const rivets = [[4, 4], [41, 4], [52, 4], [90, 4], [4, 41], [41, 41], [52, 41], [90, 41], [4, 52], [17, 52], [28, 52], [65, 52], [76, 52], [90, 52], [4, 90], [17, 90], [28, 90], [65, 90], [76, 90], [90, 90]];
        for (const [x, y] of rivets) { c.fillStyle = 'rgba(0,0,0,0.55)'; c.fillRect(x, y + 1, 2, 2); c.fillStyle = 'rgba(200,220,255,0.16)'; c.fillRect(x, y, 2, 2); }
    } else if (race === 'swarm') {
        for (let i = 0; i < 24; i++) {
            const x = rnd() * N, y = rnd() * N, rx = 6 + rnd() * 11, ry = 5 + rnd() * 8, a = rnd() * Math.PI;
            wrap((ox, oy) => {
                c.beginPath(); c.ellipse(x + ox, y + oy, rx, ry, a, 0, Math.PI * 2);
                c.fillStyle = 'rgba(120,200,90,0.035)'; c.fill();
                c.strokeStyle = 'rgba(0,0,0,0.35)'; c.lineWidth = 1; c.stroke();
            });
        }
        c.strokeStyle = 'rgba(190,60,120,0.10)'; c.lineWidth = 1;
        for (let i = 0; i < 5; i++) {
            let x = rnd() * N, y = rnd() * N;
            c.beginPath(); c.moveTo(x, y);
            for (let k = 0; k < 10; k++) { x += (rnd() - 0.5) * 18; y += (rnd() - 0.5) * 18; c.lineTo(x, y); }
            c.stroke();
        }
    } else {
        c.fillStyle = 'rgba(255,255,255,0.02)';
        for (let i = 0; i < 160; i++) c.fillRect(Math.floor(rnd() * N), Math.floor(rnd() * N), 1, 1);
        for (let i = 0; i < 7; i++) {
            let x = rnd() * N, y = rnd() * N;
            const pts = [[x, y]];
            for (let k = 0; k < 7; k++) { x += (rnd() - 0.5) * 22; y += (rnd() - 0.5) * 22; pts.push([x, y]); }
            wrap((ox, oy) => {
                c.beginPath(); pts.forEach((p, j) => j ? c.lineTo(p[0] + ox, p[1] + oy) : c.moveTo(p[0] + ox, p[1] + oy));
                c.strokeStyle = 'rgba(0,0,0,0.55)'; c.lineWidth = 1.4; c.stroke();
                c.strokeStyle = 'rgba(251,113,40,0.10)'; c.lineWidth = 0.7; c.stroke();
            });
        }
    }
    return cv.toDataURL();
}
function applyConsoleSkin(race) {
    const cls = ['race-coalition', 'race-swarm', 'race-ascended'];
    for (const id of ['bottom-panel', 'top-hud']) {
        const el = document.getElementById(id);
        if (!el) continue;
        el.classList.remove(...cls);
        if (race) el.classList.add('race-' + race);
    }
    const bp = document.getElementById('bottom-panel');
    if (bp && race) {
        if (!applyConsoleSkin.tex) applyConsoleSkin.tex = {};
        try { if (!applyConsoleSkin.tex[race]) applyConsoleSkin.tex[race] = consoleTexture(race); } catch (e) { applyConsoleSkin.tex[race] = null; }
        if (applyConsoleSkin.tex[race]) bp.style.setProperty('--c-texture', `url(${applyConsoleSkin.tex[race]})`);
    }
    // terrain legend swatches follow the battlefield palette
    const ts = TILESETS[gameState.tileset];
    if (ts) {
        const sw = document.querySelectorAll('#terrain-legend .legend-color');
        if (sw.length >= 3) { sw[0].style.background = ts.low[2]; sw[1].style.background = ts.high[3]; sw[2].style.background = ts.ramp[3]; }
    }
    updateHUD._race = null;
}

// === v33: PORTRAIT — slowly turning hologram of the selection ===
function drawPortrait(cv, entity, isUnit) {
    if (!cv) return;
    const S = 64;
    const ctx = hiDPICanvas(cv, S, S, true);
    if (!entity) return;
    const now = Date.now();
    const accent = entity.isPlayer ? ({ coalition: '56,189,248', swarm: '163,230,53', ascended: '34,211,238' }[entity.race] || '56,189,248') : '239,68,68';
    const g = ctx.createRadialGradient(32, 38, 2, 32, 38, 34);
    g.addColorStop(0, `rgba(${accent},0.32)`); g.addColorStop(1, 'rgba(0,0,0,0)');
    ctx.fillStyle = g; ctx.fillRect(0, 0, S, S);
    ctx.strokeStyle = `rgba(${accent},0.35)`; ctx.lineWidth = 1;
    ctx.beginPath(); ctx.ellipse(32, 50, 20, 6, 0, 0, Math.PI * 2); ctx.stroke();
    let spr = null, ref = null;
    if (isUnit) {
        const variant = entity.siegeMode ? 'sieged' : (entity.burrowed ? 'burrowed' : '');
        const dir = Math.floor(now / 650) % 8;
        const hover = UNIT_ANIM[entity.race] && UNIT_ANIM[entity.race][entity.type] === 'hover';
        const frame = hover ? 1 + Math.floor(now / 170) % 4 : 0;
        spr = SpriteCache.unit(entity.race, entity.type, variant === 'burrowed' ? 0 : dir, frame, variant);
        ref = SpriteCache.unit(entity.race, entity.type, 1, 0, variant);
    } else {
        spr = SpriteCache.building(entity.race, entity.type, Math.floor(now / 700) % 2, entity.size);
        ref = spr;
    }
    if (spr && ref) {
        const bb = SpriteCache.bounds(ref);
        const k = (isUnit ? (entity.type === 'heavy' ? 50 : 42) : 54) / Math.max(bb.w, bb.h, 1);
        // anchor so the reference sprite's box is centred in the portrait
        const ax = 32 - (bb.x + bb.w / 2 - spr.ox / spr.scale) * k;
        const ay = 34 - (bb.y + bb.h / 2 - spr.oy / spr.scale) * k;
        ctx.imageSmoothingEnabled = k < 1;
        SunForge.draw(ctx, spr, ax, ay, k, k);
        SunForge.drawGlow(ctx, spr, ax, ay, 0.8, k, k);
        if (entity.lastHitAt && now - entity.lastHitAt < 160) {
            ctx.globalAlpha = 0.5 * (1 - (now - entity.lastHitAt) / 160);
            ctx.globalCompositeOperation = 'lighter';
            SunForge.draw(ctx, SpriteCache.silhouette(spr, '#ff5a4a'), ax, ay, k, k);
            ctx.globalAlpha = 1; ctx.globalCompositeOperation = 'source-over';
        }
    }
    // hologram sweep + scanlines
    const sweep = (now / 22) % 96 - 16;
    const sg = ctx.createLinearGradient(0, sweep, 0, sweep + 10);
    sg.addColorStop(0, 'rgba(255,255,255,0)'); sg.addColorStop(0.5, `rgba(${accent},0.14)`); sg.addColorStop(1, 'rgba(255,255,255,0)');
    ctx.fillStyle = sg; ctx.fillRect(0, sweep, S, 10);
}

// === v33: SELECTION WIREFRAMES (StarCraft multi-select panel) ===
function updateSelectionGrid(grid, units) {
    if (!grid) return;
    if (!units || units.length < 2) {
        if (!grid.classList.contains('hidden')) { grid.classList.add('hidden'); grid.innerHTML = ''; grid._sig = ''; }
        return;
    }
    const shown = units.slice(0, 12);
    const sig = shown.map(u => u.id + ':' + Math.ceil((u.hp / u.maxHp) * 5)).join(',') + '|' + units.length;
    if (grid._sig === sig) return;
    grid._sig = sig;
    grid.classList.remove('hidden');
    grid.innerHTML = '';
    for (const u of shown) {
        const cell = document.createElement('div');
        cell.className = 'sel-cell';
        const pct = u.hp / u.maxHp;
        cell.style.borderColor = pct > 0.5 ? 'rgba(74,222,128,0.7)' : (pct > 0.25 ? 'rgba(250,204,21,0.8)' : 'rgba(248,113,113,0.9)');
        const cv = document.createElement('canvas');
        drawUnitIcon(hiDPICanvas(cv, 22, 22), u.type, u.race, 22);
        cell.appendChild(cv);
        const hp = document.createElement('div'); hp.className = 'hp';
        const fill = document.createElement('i'); fill.style.width = Math.round(pct * 100) + '%'; fill.style.background = hpColor(pct);
        hp.appendChild(fill); cell.appendChild(hp);
        cell.title = RACES[u.race].units[u.type].name;
        cell.onclick = (e) => {
            e.stopPropagation();
            if (e.shiftKey) gameState.selectedUnits = gameState.selectedUnits.filter(x => x !== u);   // BW: shift-click drops it
            else gameState.selectedUnits = [u];
            updateCommandCard();
            updateSelectionPanel();
        };
        grid.appendChild(cell);
    }
    if (units.length > 12) {
        const more = document.createElement('div');
        more.className = 'sel-more';
        more.textContent = '+' + (units.length - 12);
        grid.appendChild(more);
    }
}

