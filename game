for (const b of gameState.buildings) drawB(b);
for (const b of gameState.enemyBuildings) if (isVisible(b.x, b.y) || (b.seenByPlayer && isExplored(b.x, b.y))) drawB(b);
for (const u of gameState.units) drawU(u);
for (const u of gameState.enemyUnits) if (isVisible(u.x, u.y) && (!u.burrowed || isDetected(u, true))) drawU(u);

// Rally lines for your structures
