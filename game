/* ===== PAUSE MENU ===== */
#pause-menu {
position: absolute;
inset: 0;
background: rgba(0, 0, 0, 0.85);
display: none;
flex-direction: column;
align-items: center;
justify-content: center;
z-index: 85;
}

#pause-menu.visible {
display: flex;
}

.pause-title {
font-size: 2.5rem;
font-weight: bold;
text-transform: uppercase;
letter-spacing: 0.2em;
color: #4af;
text-shadow: 0 0 20px rgba(68, 170, 255, 0.5);
margin-bottom: 2rem;
}

.pause-buttons {
display: flex;
flex-direction: column;
gap: 1rem;
width: 280px;
}

.pause-btn {
padding: 1em 2em;
font-size: 1rem;
font-weight: bold;
text-transform: uppercase;
letter-spacing: 0.15em;
