        else if (unitData.splash) traits.push({ name: 'Splash', desc: `${unitData.splash} tiles · 100/50/25% · enemies only` });
        if (unitData.cleave) traits.push({ name: 'Cleave', desc: `${Math.round(COMBAT_V33.cleavePct * 100)}% to enemies within ${COMBAT_V33.cleaveRadius} tiles` });
        if (unitData.cliffWalk) traits.push({ name: 'Cliff Walk', desc: 'Ignores terrain' });
        if (unitData.bounceAttack) traits.push({ name: 'Glaive', desc: 'Bounces to 2 more targets, each hit ⅓ of the last' });
        
        if (traits.length > 0) {
            html += `<div class="info-section-title">Traits</div>`;
            for (const trait of traits) {
                html += `<div class="info-trait"><span class="trait-name">${trait.name}</span><span class="trait-desc">${trait.desc}</span></div>`;
            }
        }
        
        // Status (v33 fix: v32 read isSieged / isBurrowed, which were never set)
        if (entity.siegeMode) html += `<div class="info-status sieged">⚡ SIEGE MODE ACTIVE</div>`;
        if (entity.burrowed) html += `<div class="info-status burrowed">🔽 BURROWED</div>`;
        if (entity.holdPosition) html += `<div class="info-status hold">■ HOLDING POSITION</div>`;
        if (entity.patrol) html += `<div class="info-status patrol">⇄ PATROLLING</div>`;
        
        // Energy bar (if applicable)
        if (entity.energy !== undefined && entity.maxEnergy > 0) {
            const energyPct = (entity.energy / entity.maxEnergy) * 100;
            html += `<div class="info-energy-bar">`;
            html += `<div class="energy-label">Energy: ${Math.floor(entity.energy)}/${entity.maxEnergy}</div>`;
            html += `<div class="energy-bar-bg"><div class="energy-bar-fill" style="width:${energyPct}%"></div></div>`;
            html += `</div>`;
        }
        
    } else {
        // Building
        const buildingData = raceData.buildings[entity.type];
        
        // Header with avatar
        html += `<div class="info-header-row">`;
        html += `<div class="info-avatar building" style="background:${colors.dark}; border-color:${colors.primary};">`;
        html += `<canvas id="building-avatar-canvas" width="32" height="32"></canvas>`;
        html += `</div>`;
        html += `<div class="info-header-text">`;
        html += `<div class="info-title">${buildingData.name}</div>`;
        html += `<div class="info-type">${raceData.name} ${entity.isPlayer ? 'Building' : 'Enemy'}</div>`;
        html += `</div></div>`;
        
        // Stats
        html += `<div class="info-stat-row">`;
        html += `<div class="info-stat"><span class="info-stat-label">❤ HP</span><span class="info-stat-value">${Math.floor(entity.hp)}/${entity.maxHp}</span></div>`;
        if (entity.maxShield > 0) {
            html += `<div class="info-stat"><span class="info-stat-label">🛡 Shield</span><span class="info-stat-value" style="color:#44f;">${Math.floor(entity.shield)}/${entity.maxShield}</span></div>`;
        }
        html += `</div>`;
        
        // v33: structure armour and Pylon power
        html += `<div class="info-stat-row"><div class="info-stat"><span class="info-stat-label">▣ Armor</span><span class="info-stat-value">${armorFor(entity)}</span></div>`;
        if (buildingNeedsPower(entity)) html += `<div class="info-stat"><span class="info-stat-label">⚡ Power</span><span class="info-stat-value" style="color:${entity.unpowered ? '#fbbf24' : '#67e8f9'}">${entity.unpowered ? 'OFF' : 'ON'}</span></div>`;
        html += `</div>`;

        // Construction progress
        if (entity.isConstructing) {
            const pct = Math.floor((entity.constructionProgress / entity.constructionTime) * 100);
            html += `<div class="info-progress">`;
            html += `<div class="progress-label">Building: ${pct}%</div>`;
            html += `<div class="progress-bar-bg"><div class="progress-bar-fill" style="width:${pct}%"></div></div>`;
            html += `</div>`;
        }
        
        // Turret combat stats
        if (entity.type === 'turret' && buildingData.damage) {
            html += `<div class="info-section-title">Combat</div>`;
            html += `<div class="info-stat-row">`;
            html += `<div class="info-stat"><span class="info-stat-label">⚔ Damage</span><span class="info-stat-value">${buildingData.damage}</span></div>`;
            html += `<div class="info-stat"><span class="info-stat-label">↔ Range</span><span class="info-stat-value">${buildingData.range}</span></div>`;
            html += `</div>`;
            html += `<div class="info-targeting">`;
            html += `<span class="target-type ${buildingData.canAttackGround ? 'active' : 'inactive'}">◆ Ground</span>`;
            html += `<span class="target-type ${buildingData.canAttackAir ? 'active' : 'inactive'}">✈ Air</span>`;
            html += `</div>`;
            html += `<div class="info-trait"><span class="trait-name">Detector</span><span class="trait-desc">Reveals burrowed units within ${DETECTION_RANGE} tiles · ${buildingData.damageType || 'normal'} damage</span></div>`;
        }
        
        // Production info
        if (entity.produces && entity.produces.length > 0 && !entity.isConstructing) {
            html += `<div class="info-section-title">Produces</div>`;
            html += `<div class="info-produces">`;
            for (const unitType of entity.produces) {
                const unitData = raceData.units[unitType];
                if (unitData) {
                    html += `<span class="produces-unit">${unitData.name}</span>`;
                }
            }
            html += `</div>`;
        }
        
        // Supply info
        if (buildingData.providesSupply) {
            html += `<div class="info-stat"><span class="info-stat-label">Supply</span><span class="info-stat-value" style="color:#4f4;">+${buildingData.providesSupply}</span></div>`;
        }
        
        // Description
        const descriptions = {
            base: 'Main structure. Trains workers and provides supply.',
            production: 'Produces combat units.',
            supply: 'Increases maximum supply capacity.',
            refinery: 'Built on geysers to harvest gas.',
            turret: 'Defensive structure that attacks enemies.',
            techlab: 'Research facility for upgrades.'
        };
        html += `<div class="info-desc">${descriptions[entity.type] || 'Structure.'}</div>`;
    }
    
    if (infoContent._v33html !== html) { infoContent.innerHTML = html; infoContent._v33html = html; }

    // v33: draw the avatar once per rebuild, hi-DPI, from the sprite atlas
    const avatar = document.getElementById(isUnit ? 'unit-avatar-canvas' : 'building-avatar-canvas');
    if (avatar && !avatar._drawn) {
        avatar._drawn = true;
        const actx = hiDPICanvas(avatar, 32, 32);
        if (isUnit) drawUnitIcon(actx, entity.type, entity.race, 32);
        else drawBuildingIcon(actx, entity.type, entity.race, 32);
    }
}

