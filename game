}

.elimination-race {
font-size: 1.2rem;
color: #fff;
margin-bottom: 0.5rem;
}

.elimination-message {
font-size: 0.9rem;
color: #aaa;
}

/* ===== LEADERBOARD STYLES ===== */
.game-over-leaderboard {
margin-top: 1.5rem;
padding: 1rem;
border-top: 1px solid #333;
background: rgba(0, 0, 0, 0.3);
border-radius: 8px;
}

.leaderboard-title {
font-size: 0.9rem;
color: #888;
text-transform: uppercase;
letter-spacing: 0.15em;
margin-bottom: 0.75rem;
text-align: center;
border-bottom: 1px solid #333;
padding-bottom: 0.5rem;
}

.leaderboard-entry {
display: grid;
grid-template-columns: 30px 1fr 60px 80px;
gap: 8px;
align-items: center;
font-size: 0.8rem;
color: #aaa;
