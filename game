};

// === UNIT STATES ===
const UNIT_STATE = {
IDLE: 'idle',
MOVING: 'moving',
ATTACKING: 'attacking',
GATHERING: 'gathering',
RETURNING: 'returning',
BUILDING: 'building'
};

// ============================================
// SOUND EFFECTS SYSTEM
// ============================================
// Procedural audio using Web Audio API - no external files needed

const SoundSystem = {
    ctx: null,
    enabled: true,
    masterVolume: 0.4,
    
    // Initialize audio context (must be called from user interaction)
    init() {
        if (this.ctx) return;
        try {
            this.ctx = new (window.AudioContext || window.webkitAudioContext)();
        } catch (e) {
            console.warn('Web Audio not supported');
            this.enabled = false;
        }
    },
    
    // Resume audio context (browsers require user interaction)
    resume() {
        if (this.ctx && this.ctx.state === 'suspended') {
            this.ctx.resume();
        }
    },
    
    // Toggle sound on/off
    toggle() {
        this.enabled = !this.enabled;
        return this.enabled;
    },
    
    // Set master volume (0-1)
    setVolume(vol) {
        this.masterVolume = Math.max(0, Math.min(1, vol));
    },
    
    // Play a procedural sound
    play(type, options = {}) {
        if (!this.enabled || !this.ctx) return;
        this.resume();
        
        const vol = (options.volume || 1) * this.masterVolume;
        const now = this.ctx.currentTime;
        
        switch(type) {
            case 'laser':
                this._playLaser(now, vol, options);
                break;
            case 'explosion':
                this._playExplosion(now, vol, options);
                break;
            case 'hit':
                this._playHit(now, vol, options);
                break;
            case 'select':
                this._playSelect(now, vol);
                break;
            case 'click':
                this._playClick(now, vol);
                break;
            case 'build':
                this._playBuild(now, vol);
                break;
            case 'train':
                this._playTrain(now, vol);
                break;
            case 'complete':
                this._playComplete(now, vol);
                break;
            case 'error':
                this._playError(now, vol);
                break;
            case 'upgrade':
                this._playUpgrade(now, vol);
                break;
            case 'move':
                this._playMove(now, vol);
                break;
            case 'attack':
                this._playAttackCommand(now, vol);
                break;
            case 'death':
                this._playDeath(now, vol, options);
                break;
            case 'siege':
                this._playSiege(now, vol);
                break;
            case 'burrow':
                this._playBurrow(now, vol);
                break;
            case 'phase':
                this._playPhase(now, vol);
                break;
            case 'heal':
                this._playHeal(now, vol);
                break;
            case 'ability':
                this._playAbility(now, vol);
                break;
        }
    },
    
    // Create gain node with envelope
    _createGain(vol, attackTime = 0.01) {
        const gain = this.ctx.createGain();
        gain.gain.setValueAtTime(0, this.ctx.currentTime);
        gain.gain.linearRampToValueAtTime(vol, this.ctx.currentTime + attackTime);
        gain.connect(this.ctx.destination);
        return gain;
    },
    
    // Laser/projectile sound
    _playLaser(now, vol, options = {}) {
        const osc = this.ctx.createOscillator();
        const gain = this._createGain(vol * 0.3);
        
        osc.type = 'sawtooth';
        const startFreq = options.race === 'ascended' ? 800 : options.race === 'swarm' ? 400 : 600;
        osc.frequency.setValueAtTime(startFreq, now);
        osc.frequency.exponentialRampToValueAtTime(startFreq * 0.3, now + 0.1);
        
        gain.gain.exponentialRampToValueAtTime(0.001, now + 0.1);
        
        osc.connect(gain);
        osc.start(now);
        osc.stop(now + 0.12);
    },
    
    // Explosion/impact sound
    _playExplosion(now, vol, options = {}) {
        const bufferSize = this.ctx.sampleRate * 0.3;
        const buffer = this.ctx.createBuffer(1, bufferSize, this.ctx.sampleRate);
        const data = buffer.getChannelData(0);
        
        for (let i = 0; i < bufferSize; i++) {
            const t = i / this.ctx.sampleRate;
            const envelope = Math.exp(-t * 8);
            data[i] = (Math.random() * 2 - 1) * envelope;
        }
        
        const noise = this.ctx.createBufferSource();
        noise.buffer = buffer;
        
        const filter = this.ctx.createBiquadFilter();
        filter.type = 'lowpass';
        filter.frequency.setValueAtTime(1000, now);
        filter.frequency.exponentialRampToValueAtTime(200, now + 0.2);
        
        const gain = this._createGain(vol * 0.4);
        gain.gain.exponentialRampToValueAtTime(0.001, now + 0.3);
        
        noise.connect(filter);
        filter.connect(gain);
        noise.start(now);
    },
    
    // Hit/damage sound
