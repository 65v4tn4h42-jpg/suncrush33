const tx0 = viewX / TILE_SIZE, ty0 = viewY / TILE_SIZE, tw = viewW / TILE_SIZE, th = viewH / TILE_SIZE;
ctx.imageSmoothingEnabled = false;
if (st && st.minimap) ctx.drawImage(st.minimap, tx0, ty0, tw, th, 0, 0, cssW, cssH);
const fog = FogArt.update();
ctx.imageSmoothingEnabled = true;
ctx.drawImage(fog, tx0, ty0, tw, th, 0, 0, cssW, cssH);

// Resources
for (const r of gameState.resources) {
    if (r.x < viewX || r.x > viewX + viewW || r.y < viewY || r.y > viewY + viewH) continue;
    if (!isExplored(r.x, r.y)) continue;
    ctx.fillStyle = r.type === 'mineral' ? '#7cc4ff' : '#4ade80';
    const s = r.type === 'mineral' ? 1.6 : 2.4;
