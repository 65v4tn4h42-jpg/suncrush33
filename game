// Burrowed units are only visible/targetable near an enemy detector (BW)
function isDetected(target, byPlayer) {
    const pool = byPlayer ? gameState.buildings : gameState.enemyBuildings;
    const R = DETECTION_RANGE * TILE_SIZE;
    for (const b of pool) {
        if (b.type !== 'turret' || b.isConstructing || b.unpowered || b.hp <= 0) continue;
        const dx = b.x - target.x, dy = b.y - target.y;
        if (dx * dx + dy * dy <= R * R) return true;
    }
    return false;
}
function targetableBy(unit, t) {
    if (!t || t.hp <= 0) return false;
    if (t.burrowed && !isDetected(t, unit.isPlayer)) return false;
    if (unit.siegeMode && unit.minRange && rangeGap(unit, t) < unit.minRange * TILE_SIZE) return false;
