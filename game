}

/* ===== PAUSE BUTTON IN TOP BAR ===== */
#pause-btn-bar {
background: linear-gradient(180deg, #3a3a4a 0%, #2a2a3a 100%);
border: 1px solid #555;
border-radius: 4px;
color: #ccc;
padding: 4px 12px;
font-size: 0.75rem;
font-weight: bold;
cursor: pointer;
transition: all 0.2s;
text-transform: uppercase;
letter-spacing: 0.05em;
margin-right: 10px;
}

#pause-btn-bar:hover {
background: linear-gradient(180deg, #4a4a5a 0%, #3a3a4a 100%);
border-color: #4af;
color: #fff;
}

/* ===== DRAG INDICATOR ===== */
#drag-indicator {
position: absolute;
bottom: 160px;
left: 50%;
transform: translateX(-50%);
background: rgba(68, 170, 255, 0.9);
color: #fff;
