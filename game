// === CHECK AI ELIMINATIONS ===
function checkAIEliminations() {
    for (const ai of gameState.aiPlayers) {
        if (ai.eliminated) continue;
        
        // Check if this AI has any buildings left
        const aiBuildingsRemain = gameState.enemyBuildings.some(b => b.aiPlayerIndex === ai.index);
        
        if (!aiBuildingsRemain) {
            ai.eliminated = true;
            ai.eliminatedAt = gameState.gameTime;
            
            gameState.eliminatedPlayers.push({
                index: ai.index,
                race: ai.race,
                time: gameState.gameTime
            });
            
            // Show popup
            showEliminationPopup(ai);
            
            // Log message
            const raceName = ai.race.charAt(0).toUpperCase() + ai.race.slice(1);
            addMessage(`The ${raceName} has been eliminated!`, RACES[ai.race]?.colors?.primary || '#f90');
        }
    }
}

// === CALCULATE GAME SCORE ===
function calculateScore() {
    const s = gameState.stats;
    const timeBonus = Math.max(0, 10000 - Math.floor(gameState.gameTime * 10));
    
    let score = 0;
    score += s.unitsKilled * 100;
    score += s.buildingsDestroyed * 500;
    score += Math.floor(s.damageDealt / 10);
    score += Math.floor(s.resourcesGathered / 5);
    score -= s.unitsLost * 50;
    score -= s.buildingsLost * 200;
    
    // Victory bonus
    if (gameState.gameResult === 'victory') {
        score += 5000;
        score += timeBonus;
        score += gameState.eliminatedPlayers.length * 1000;
    }
    
    return Math.max(0, score);
}

