const TerrainArt = (() => {
    const T = 40;               // tile size (world px) — matches TILE_SIZE
    const MEGA = 4;             // megatile size in tiles
    const WALL_H = 22;          // south cliff face height (world px)
    const SIDE_W = 7;           // west/east side face width
    let st = null;              // built state

    function hash(x, y, s) { let h = (x * 374761393 + y * 668265263 + (s || 0) * 982451653) | 0; h = (h ^ (h >>> 13)) * 1274126177 | 0; return ((h ^ (h >>> 16)) >>> 0) / 4294967296; }
    function hexRgb(h) { const n = parseInt(h.slice(1), 16); return [(n >> 16) & 255, (n >> 8) & 255, n & 255]; }
    // non-periodic value noise / fbm over tile coordinates (map-scale features)
    function vnoise(x, y, seed) {
        const xi = Math.floor(x), yi = Math.floor(y), u0 = x - xi, v0 = y - yi;
        const u = u0 * u0 * (3 - 2 * u0), v = v0 * v0 * (3 - 2 * v0);
        const a = hash(xi, yi, seed), b = hash(xi + 1, yi, seed), c = hash(xi, yi + 1, seed), d = hash(xi + 1, yi + 1, seed);
        return a + (b - a) * u + (c - a) * v + (a - b - c + d) * u * v;
    }
    function fbm(x, y, seed) { return vnoise(x, y, seed) * 0.6 + vnoise(x * 2.1, y * 2.1, seed + 1) * 0.28 + vnoise(x * 4.3, y * 4.3, seed + 2) * 0.12; }

    // periodic value noise (wraps every `period` art px)
    function makeNoise(period, cells, seed) {
        const v = [];
        for (let j = 0; j < cells; j++) { v[j] = []; for (let i = 0; i < cells; i++) v[j][i] = hash(i, j, seed); }
        const sm = t => t * t * (3 - 2 * t);
        return (x, y) => {
            const fx = x / period * cells, fy = y / period * cells;
            const i0 = Math.floor(fx), j0 = Math.floor(fy), tx = sm(fx - i0), ty = sm(fy - j0);
            const i1 = (i0 + 1) % cells, j1 = (j0 + 1) % cells, ii = ((i0 % cells) + cells) % cells, jj = ((j0 % cells) + cells) % cells;
            const a = v[jj][ii], b = v[jj][i1], c = v[j1][ii], d = v[j1][i1];
            return (a + (b - a) * tx) + ((c + (d - c) * tx) - (a + (b - a) * tx)) * ty;
