// === RENDER PSI STORMS ===
function renderPsiStorms(ctx) {
    if (!gameState.psiStorms) return;
    
    for (const storm of gameState.psiStorms) {
        const radius = storm.radius * TILE_SIZE;
        const alpha = 0.4 + Math.sin(Date.now() / 100) * 0.2;
        
        // Outer glow
        const gradient = ctx.createRadialGradient(storm.x, storm.y, 0, storm.x, storm.y, radius);
        gradient.addColorStop(0, `rgba(185, 28, 28, ${alpha})`);
        gradient.addColorStop(0.5, `rgba(0, 221, 255, ${alpha * 0.5})`);
        gradient.addColorStop(1, 'rgba(185, 28, 28, 0)');
        
        ctx.fillStyle = gradient;
        ctx.beginPath();
        ctx.arc(storm.x, storm.y, radius, 0, Math.PI * 2);
        ctx.fill();
        
        // Lightning bolts
        ctx.strokeStyle = `rgba(200, 150, 255, ${alpha + 0.3})`;
        ctx.lineWidth = 2;
        for (let i = 0; i < 4; i++) {
            const angle = (Date.now() / 200 + i * Math.PI / 2) % (Math.PI * 2);
            ctx.beginPath();
            ctx.moveTo(storm.x, storm.y);
            const segments = 5;
            let px = storm.x, py = storm.y;
            for (let s = 1; s <= segments; s++) {
                const dist = (s / segments) * radius;
                const offsetX = (Math.random() - 0.5) * 20;
                const offsetY = (Math.random() - 0.5) * 20;
                const nx = storm.x + Math.cos(angle) * dist + offsetX;
                const ny = storm.y + Math.sin(angle) * dist + offsetY;
                ctx.lineTo(nx, ny);
                px = nx; py = ny;
            }
            ctx.stroke();
        }
    }
}

// === UPDATE PARTICLES ===
// v33: typed particles — smoke/fire/gas float and drag, debris arcs (z) and bounces
function updateParticles(dt) {
const list = gameState.particles;
let w = 0;
for (let i = 0; i < list.length; i++) {
    const p = list[i];
    p.life -= dt;
    if (p.life <= 0) continue;
    p.x += (p.vx || 0) * dt;
    p.y += (p.vy || 0) * dt;
    if (p.kind === 'debris') {
        p.z = (p.z || 0) + (p.vz || 0) * dt;
        p.vz = (p.vz || 0) - 260 * dt;
        if (p.z < 0) { p.z = 0; p.vz = -p.vz * 0.35; p.vx *= 0.6; p.vy *= 0.6; }
    } else if (p.noGravity) {
        p.vx *= (1 - 1.2 * dt); p.vy *= (1 - 0.8 * dt);
    } else {
        p.vy += 100 * dt;
        p.vx *= 0.98;
    }
    list[w++] = p;
}
list.length = w;
if (list.length > 900) list.splice(0, list.length - 900);
}

