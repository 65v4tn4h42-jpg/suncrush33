.config-row input[type="range"] {
width: 80px;
margin-right: 0.5rem;
}

#mutation-display {
color: #8b5cf6;
font-size: 0.85rem;
min-width: 40px;
}

.training-controls {
display: flex;
gap: 0.5rem;
margin-bottom: 1rem;
}

.train-btn {
flex: 1;
padding: 0.6rem;
border-radius: 6px;
border: 1px solid #333;
background: #1a1a2e;
color: #9ca3af;
font-size: 0.8rem;
