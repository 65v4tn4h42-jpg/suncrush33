// Draw the pulsing sun rays behind the start button
function drawStartSunRays() {
    const canvas = document.getElementById('start-sun-rays');
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    const w = canvas.width;
    const h = canvas.height;
    const cx = w / 2;
    const cy = h / 2;
    
    ctx.clearRect(0, 0, w, h);
    
    // Outer glow
    const glow = ctx.createRadialGradient(cx, cy, 10, cx, cy, 60);
    glow.addColorStop(0, 'rgba(255, 200, 50, 0.6)');
    glow.addColorStop(0.4, 'rgba(255, 150, 30, 0.3)');
    glow.addColorStop(1, 'rgba(255, 100, 0, 0)');
    ctx.fillStyle = glow;
    ctx.beginPath();
    ctx.arc(cx, cy, 60, 0, Math.PI * 2);
    ctx.fill();
    
    // Sun rays (triangular spikes)
    ctx.fillStyle = 'rgba(249, 115, 22, 0.5)';
    const numRays = 12;
    const innerR = 25;
    const outerR = 50;
    
    for (let i = 0; i < numRays; i++) {
        const angle = (i / numRays) * Math.PI * 2 - Math.PI / 2;
        const nextAngle = ((i + 1) / numRays) * Math.PI * 2 - Math.PI / 2;
        const midAngle = (angle + nextAngle) / 2;
        
        ctx.beginPath();
        ctx.moveTo(cx + Math.cos(angle) * innerR, cy + Math.sin(angle) * innerR);
        ctx.lineTo(cx + Math.cos(midAngle) * outerR, cy + Math.sin(midAngle) * outerR);
        ctx.lineTo(cx + Math.cos(nextAngle) * innerR, cy + Math.sin(nextAngle) * innerR);
        ctx.closePath();
        ctx.fill();
    }
    
    // Inner sun circle
    const sunGrad = ctx.createRadialGradient(cx - 3, cy - 3, 0, cx, cy, 20);
    sunGrad.addColorStop(0, 'rgba(251, 191, 36, 0.8)');
    sunGrad.addColorStop(0.6, 'rgba(249, 115, 22, 0.6)');
    sunGrad.addColorStop(1, 'rgba(234, 88, 12, 0.4)');
    ctx.fillStyle = sunGrad;
    ctx.beginPath();
    ctx.arc(cx, cy, 20, 0, Math.PI * 2);
    ctx.fill();
}

