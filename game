// === UPDATE PRODUCTION QUEUE DISPLAY ===
// v33: the queue DOM is rebuilt only when the queue changes (v32 rebuilt it — canvases included —
// every frame); progress bars update in place.
function updateProductionQueueDisplay(entity, isUnit) {
    const queueEl = document.getElementById('production-queue');
    if (!queueEl) return;

    if (!entity || isUnit || !entity.isPlayer || (!(entity.trainingQueue && entity.trainingQueue.length) && !entity.researchQueue)) {
        if (!queueEl.classList.contains('hidden')) queueEl.classList.add('hidden');
        queueEl._sig = '';
        return;
    }

    const raceData = RACES[entity.race];
    const sig = entity.id + '|' + entity.trainingQueue.join(',') + '|' + (entity.researchQueue ? entity.researchQueue.type : '');
    if (queueEl._sig !== sig) {
        queueEl._sig = sig;
        queueEl.innerHTML = '<span class="queue-label">Queue:</span>';
        queueEl.classList.remove('hidden');
        entity.trainingQueue.forEach((unitType, index) => {
            const unitData = raceData.units[unitType];
            const queueItem = document.createElement('div');
            queueItem.className = 'queue-item' + (index === 0 ? ' active' : '');
            queueItem.title = `${unitData.name} (${index + 1}/${entity.trainingQueue.length})\nRight-click to cancel`;
            const miniCanvas = document.createElement('canvas');
            drawUnitIcon(hiDPICanvas(miniCanvas, 20, 20), unitType, entity.race, 20);
            queueItem.appendChild(miniCanvas);
            if (index === 0) {
                const progressEl = document.createElement('div');
                progressEl.className = 'queue-progress';
                progressEl.dataset.kind = 'train';
                queueItem.appendChild(progressEl);
            }
            const cancelBtn = document.createElement('div');
            cancelBtn.className = 'queue-cancel';
            cancelBtn.textContent = '×';
            cancelBtn.onclick = (e) => { e.stopPropagation(); cancelQueueItem(entity, index); };
            queueItem.appendChild(cancelBtn);
            queueItem.oncontextmenu = (e) => { e.preventDefault(); cancelQueueItem(entity, index); };
            queueEl.appendChild(queueItem);
        });
        if (entity.researchQueue) {
            const upgradeData = UPGRADES[entity.researchQueue.type];
            const queueItem = document.createElement('div');
            queueItem.className = 'queue-item active';
            queueItem.title = `Researching: ${upgradeData.name}\nRight-click to cancel`;
            const miniCanvas = document.createElement('canvas');
            drawUpgradeIcon(hiDPICanvas(miniCanvas, 20, 20), entity.researchQueue.type, 20);
            queueItem.appendChild(miniCanvas);
            const progressEl = document.createElement('div');
            progressEl.className = 'queue-progress';
            progressEl.dataset.kind = 'research';
            queueItem.appendChild(progressEl);
            const cancelBtn = document.createElement('div');
            cancelBtn.className = 'queue-cancel';
            cancelBtn.textContent = '×';
            cancelBtn.onclick = (e) => { e.stopPropagation(); cancelResearch(entity); };
            queueItem.appendChild(cancelBtn);
            queueItem.oncontextmenu = (e) => { e.preventDefault(); cancelResearch(entity); };
            queueEl.appendChild(queueItem);
        }
    }
    for (const bar of queueEl.querySelectorAll('.queue-progress')) {
        let pct = 0;
        if (bar.dataset.kind === 'train' && entity.trainingQueue.length) pct = entity.trainingProgress / raceData.units[entity.trainingQueue[0]].buildTime;
        else if (bar.dataset.kind === 'research' && entity.researchQueue) pct = entity.researchQueue.progress / entity.researchQueue.totalTime;
        const w = (Math.min(1, pct) * 100).toFixed(1) + '%';
        if (bar.style.width !== w) bar.style.width = w;
    }
}

// === CANCEL QUEUE ITEM ===
// v33: the queue icons share cancelTraining (full refund, reserved supply released). v32 refunded
// 50-75%, kept the supply and then threw on an undefined updateUI(). The duplicate cancelResearch that
// stood here was dead code (the later declaration wins) and is removed.
function cancelQueueItem(building, index) {
    if (!building || !building.isPlayer || !building.trainingQueue || index >= building.trainingQueue.length) return;
    cancelTraining(building, index);
}

// === UPDATE COMMAND CARD ===
function updateCommandCard() {
const card = document.getElementById('command-card');
card.innerHTML = '';

for (let i = 0; i < 15; i++) {
    const btn = document.createElement('div');
    btn.className = 'cmd-button empty';
    card.appendChild(btn);
}

const buttons = card.querySelectorAll('.cmd-button');

if (gameState.selectedUnits.length > 0) {
    const unit = gameState.selectedUnits[0];
    if (unit.isPlayer) {
        setupUnitCommands(buttons, unit);
    }
} else if (gameState.selectedBuilding) {
    const building = gameState.selectedBuilding;
    if (building.isPlayer) {
        // Show rally point option even during construction, but only unit training when complete
        setupBuildingCommands(buttons, building);
    }
}

}

// === SETUP UNIT COMMANDS ===
// v33: StarCraft card layout on the hotkey grid — Move Q · Stop W · Attack E · Patrol R · Hold T /
// Build B · special D · abilities F G. (v32 had Attack and several abilities on E, Build on A —
// the attack-move key — so those hotkeys could never fire.) A, S, H and M also work as BW aliases.
function setupUnitCommands(buttons, unit) {
const raceData = RACES[unit.race];
const unitData = raceData.units[unit.type];

if (gameState.commandMenu === MENU.MAIN) {
    const sel = playerSelection();
    const anyMobile = sel.some(u => !u.siegeMode && !u.burrowed);
    const anyArmed = sel.some(u => u.damage > 0);

    addCommandButton(buttons[0], 'Move', 'Q', () => beginOrder('move'), 'move');
    addCommandButton(buttons[1], 'Stop', 'W', () => stopSelected(), 'stop');
    if (anyArmed) addCommandButton(buttons[2], 'Attack', 'E', () => beginOrder('attack'), 'attack');
    addCommandButton(buttons[3], 'Patrol', 'R', () => beginOrder('patrol'), 'patrol');
    addCommandButton(buttons[4], 'Hold', 'T', () => holdSelected(), 'hold');
    if (!anyMobile) { buttons[0].classList.add('disabled'); buttons[3].classList.add('disabled'); }
    if (gameState.attackMoveMode && anyArmed) buttons[2].classList.add('highlighted');
    if (gameState.patrolMode) buttons[3].classList.add('highlighted');
    if (gameState.moveMode) buttons[0].classList.add('highlighted');
    if (sel.length && sel.every(u => u.holdPosition)) buttons[4].classList.add('highlighted');

    if (unit.type === 'worker') {
        addCommandButton(buttons[5], 'Build', 'B', () => {
            gameState.commandMenu = MENU.BUILD_BASIC;
            updateCommandCard();
        }, 'build');
    }

    // Coalition Siege Tank - Siege Mode
    if (unitData?.canSiege) {
        const isSieged = unit.siegeMode || false;
        addCommandButton(buttons[7], isSieged ? 'Unsiege' : 'Siege', 'D', () => {
            for (const u of gameState.selectedUnits) {
                if (u.isPlayer && RACES[u.race].units[u.type]?.canSiege) toggleSiegeMode(u);
            }
            updateCommandCard();
        }, isSieged ? 'unsiege' : 'siege');
    }

    // Swarm Titan Root - Burrow
    if (unitData?.canBurrow) {
        const isBurrowed = unit.burrowed || false;
        addCommandButton(buttons[7], isBurrowed ? 'Unburrow' : 'Burrow', 'D', () => {
            for (const u of gameState.selectedUnits) {
                if (u.isPlayer && RACES[u.race].units[u.type]?.canBurrow) toggleBurrow(u);
            }
            updateCommandCard();
        }, isBurrowed ? 'unburrow' : 'burrow');
    }

    // Ascended Magma Titan - Phase
    if (unitData?.canPhase) {
        const phaseCooldown = unit.phaseCooldown || 0;
        const canPhase = phaseCooldown <= 0 && unit.shield >= (unitData.phaseStats?.shieldCost || 50);
        addCommandButton(buttons[7], 'Phase', 'D', () => {
            if (canPhase) {
                cancelPendingOrders(true);
                gameState.phaseMode = true;
                addMessage('Click location to phase (ESC to cancel)', '#a6f');
            } else if (phaseCooldown > 0) {
                addMessage(`Phase on cooldown: ${Math.ceil(phaseCooldown)}s`, '#fa4');
            } else {
                addMessage('Not enough shields!', '#fa4');
            }
        }, 'phase');
        if (!canPhase) buttons[7].classList.add('disabled');
    }

    // Abilities on F / G
    if (unitData?.abilities && unitData.abilities.length > 0) {
        let abilitySlot = 8;
        for (const abilityId of unitData.abilities) {
            const ability = ABILITIES[abilityId];
            if (!ability || abilitySlot > 9) continue;
            const cooldown = unit.abilityCooldowns?.[abilityId] || 0;
            const hasEnergy = unit.energy >= ability.energyCost;
            const canUse = cooldown <= 0 && hasEnergy;
            const abilityLabel = `${ability.name} (${ability.energyCost}E)`;

            addCommandButton(buttons[abilitySlot], abilityLabel, ability.hotkey, () => {
                if (!canUse) {
                    if (cooldown > 0) addMessage(`${ability.name} on cooldown: ${Math.ceil(cooldown)}s`, '#fa4');
                    else addMessage(`Not enough energy! Need ${ability.energyCost}`, '#fa4');
                    return;
                }
                if (ability.targetType === 'ground') {
                    cancelPendingOrders(true);
                    gameState.abilityMode = { abilityId, unit };
                    addMessage(`Click location to cast ${ability.name} (ESC to cancel)`, '#a6f');
                } else if (ability.targetType === 'enemy_unit' || ability.targetType === 'friendly_unit') {
                    cancelPendingOrders(true);
                    gameState.abilityMode = { abilityId, unit };
                    addMessage(`Click ${ability.targetType === 'enemy_unit' ? 'enemy' : 'ally'} to target ${ability.name}`, '#a6f');
                } else if (ability.targetType === 'self') {
                    useAbility(abilityId, unit, unit.x, unit.y, unit);
                }
            }, 'ability:' + abilityId);

            if (!canUse) buttons[abilitySlot].classList.add('disabled');
            buttons[abilitySlot].title = `${ability.description}\nEnergy: ${Math.floor(unit.energy)}/${ability.energyCost}\nCooldown: ${cooldown > 0 ? Math.ceil(cooldown) + 's' : 'Ready'}`;
            abilitySlot++;
        }
    }

} else if (gameState.commandMenu === MENU.BUILD_BASIC) {
    // Row 1: Economy buildings
    addBuildButton(buttons[0], 'supply', raceData.buildings.supply, 'Q');
    addBuildButton(buttons[1], 'refinery', raceData.buildings.refinery, 'W');
    addBuildButton(buttons[2], 'base', raceData.buildings.base, 'E');
    // Row 2: Military buildings
    addBuildButton(buttons[5], 'production', raceData.buildings.production, 'A');
    addBuildButton(buttons[6], 'turret', raceData.buildings.turret, 'S');
    if (raceData.buildings.techlab) addBuildButton(buttons[7], 'techlab', raceData.buildings.techlab, 'D');

    addCommandButton(buttons[10], 'Cancel', 'Z', () => {
        gameState.commandMenu = MENU.MAIN;
        updateCommandCard();
    }, 'cancel');
}

}

// === SETUP BUILDING COMMANDS ===
function setupBuildingCommands(buttons, building) {
const raceData = RACES[building.race];
const buildingData = raceData.buildings[building.type];

// Allow rally point setting even during construction
if (building.produces && building.produces.length > 0) {
    addCommandButton(buttons[4], 'Rally', 'T', () => {
        gameState.rallyMode = true;
        addMessage('Click to set rally point (ESC to cancel)', '#ff0');
    }, 'rally');
}

// Cancel construction button (during building construction)
if (building.isConstructing && building.isPlayer) {
    addCommandButton(buttons[5], 'Cancel', 'X', () => {
        cancelConstruction(building);
    }, 'cancel');
    return;
}

// Only show buttons if not constructing
if (building.isConstructing) return;

// Handle techlab/upgrade buildings
if (buildingData.isUpgradeBuilding && buildingData.upgrades) {
    // Show upgrade buttons
    buildingData.upgrades.forEach((upgradeType, index) => {
        const upgradeData = UPGRADES[upgradeType];
        const currentLevel = gameState.upgrades[upgradeType] || 0;
        const hotkey = HOTKEYS[0][index];
        
        if (currentLevel < upgradeData.levels) {
            addUpgradeButton(buttons[index], upgradeType, upgradeData, currentLevel, hotkey, building);
        } else {
            // Max level - show disabled
            addMaxLevelButton(buttons[index], upgradeData.name);
        }
    });
    
    // Cancel research button (when research in progress)
    if (building.researchQueue && building.isPlayer) {
        addCommandButton(buttons[5], 'Cancel', 'X', () => {
            cancelResearch(building);
        }, 'cancel');
    }
    return;
}

// Production buildings
if (!building.produces || building.produces.length === 0) return;

building.produces.forEach((unitType, index) => {
    const unitData = raceData.units[unitType];
    const hotkey = HOTKEYS[0][index];
    addTrainButton(buttons[index], unitType, unitData, hotkey, building);
});

// Cancel training button (when queue has items)
if (building.trainingQueue.length > 0 && building.isPlayer) {
    addCommandButton(buttons[5], 'Cancel', 'X', () => {
        cancelTraining(building);
    }, 'cancel');
}

}

// === CANCEL CONSTRUCTION ===
function cancelConstruction(building) {
    if (!building.isConstructing) return;

    const raceData = RACES[building.race];
    const buildingData = raceData.buildings[building.type];

    // Refund 75% of resources (BW)
    const refundMinerals = Math.floor(buildingData.cost.minerals * 0.75);
    const refundGas = Math.floor((buildingData.cost.gas || 0) * 0.75);
    gameState.minerals += refundMinerals;
    gameState.gas += refundGas;

    // v33: unfinished structures never granted supply, so none is removed here
    if (building.type === 'refinery') releaseGeyser(building);   // v33 fix: the geyser stayed blocked

    const index = gameState.buildings.indexOf(building);
    if (index !== -1) gameState.buildings.splice(index, 1);
    releaseBuilders(building);

    // v33: BW — cancelling a Zerg morph gives the Drone back
    if (building.race === 'swarm') {
        const drone = createUnit('worker', building.race, building.x, building.y + building.size / 2 + 12, true);
        gameState.units.push(drone);
        gameState.supplyUsed += drone.supply;
        assignWorkerAutoMine(drone, true, drone.x, drone.y);
    }

    if (gameState.selectedBuilding === building) gameState.selectedBuilding = null;

    addMessage(`${buildingData.name} cancelled. Refunded: ${refundMinerals} minerals${refundGas > 0 ? ', ' + refundGas + ' gas' : ''}`, '#fa4');

    updateHUD();
    updateCommandCard();
    updateSelectionPanel();
}

// === CANCEL TRAINING ===
// v33: BW refunds the full cost of a cancelled unit and releases its reserved supply
function cancelTraining(building, queueIndex = 0) {
    if (building.trainingQueue.length === 0) return;

    const raceData = RACES[building.race];
    const unitType = building.trainingQueue[queueIndex];
    const unitData = raceData.units[unitType];

    const refundMinerals = unitData.cost.minerals;
    const refundGas = unitData.cost.gas || 0;
    gameState.minerals += refundMinerals;
    gameState.gas += refundGas;
    gameState.supplyUsed = Math.max(0, gameState.supplyUsed - unitSupplyCost(unitData));

    building.trainingQueue.splice(queueIndex, 1);
    if (queueIndex === 0) building.trainingProgress = 0;

    addMessage(`${unitData.name} cancelled. Refunded: ${refundMinerals} minerals${refundGas > 0 ? ', ' + refundGas + ' gas' : ''}`, '#fa4');

    updateHUD();
    updateCommandCard();
    updateSelectionPanel();
}

// === ADD UPGRADE BUTTON ===
function addUpgradeButton(btn, upgradeType, upgradeData, currentLevel, hotkey, building) {
    btn.className = 'cmd-button';
    btn.dataset.hotkey = hotkey;
    
    const cost = upgradeData.cost[currentLevel];
    const canAfford = gameState.minerals >= cost.minerals && gameState.gas >= cost.gas;
    const isResearching = building.researchQueue && building.researchQueue.type === upgradeType;
    
    if (!canAfford && !isResearching) btn.classList.add('disabled');
    if (isResearching) btn.classList.add('highlighted');
    
    const iconCanvas = document.createElement('canvas');
    iconCanvas.className = 'cmd-icon';
    drawUpgradeIcon(hiDPICanvas(iconCanvas, 28, 28), upgradeType, 28);
    btn.appendChild(iconCanvas);
    
    const labelSpan = document.createElement('span');
    labelSpan.className = 'cmd-label';
    const shortName = upgradeData.name.replace(' Upgrade', '');
    labelSpan.textContent = `${shortName} ${currentLevel + 1}`;
    btn.appendChild(labelSpan);
    
    const costSpan = document.createElement('span');
    costSpan.className = 'cmd-cost';
    costSpan.innerHTML = `<span style="color:#4af">${cost.minerals}</span>`;
    costSpan.innerHTML += `<span style="color:#4f4; margin-left:4px">${cost.gas}</span>`;
    btn.appendChild(costSpan);
    
    const hotkeySpan = document.createElement('span');
    hotkeySpan.className = 'cmd-hotkey';
    hotkeySpan.textContent = hotkey;
    btn.appendChild(hotkeySpan);
    
    // v33: hover explains the upgrade (per-weapon steps, shield armour)
    btn.onmouseenter = () => {
        gameState.hoveredButton = { type: 'upgrade', upgradeType: upgradeType };
        updateInfoPanelForUpgrade(upgradeType, upgradeData, currentLevel);
    };
    btn.onmouseleave = () => {
        gameState.hoveredButton = null;
        let entity = null, isUnit = false;
        if (gameState.selectedUnits.length > 0) { entity = gameState.selectedUnits[0]; isUnit = true; }
        else if (gameState.selectedBuilding) { entity = gameState.selectedBuilding; }
        updateInfoPanel(entity, isUnit);
    };

    btn.onclick = () => {
        if (isResearching) {
            addMessage('Already researching!', '#fa4');
            return;
        }
        if (building.researchQueue) {
            addMessage('Building is busy!', '#fa4');
            return;
        }
        if (!canAfford) {
            addMessage('Not enough resources!', '#f44');
            return;
        }
        startResearch(building, upgradeType, currentLevel);
    };
}

