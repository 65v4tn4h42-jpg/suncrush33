}

// === DRAW STARFIELD BACKGROUND ===
// v33: layered starfield, soft nebulae in the three faction hues, and a banded pixel planet
function drawStarfield() {
    const canvas = document.getElementById('starfield-canvas');
    if (!canvas) return;
    const dpr = Math.min(2, window.devicePixelRatio || 1);
    const w = window.innerWidth, h = window.innerHeight;
    canvas.width = Math.round(w * dpr);
    canvas.height = Math.round(h * dpr);
    const ctx = canvas.getContext('2d');
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    ctx.fillStyle = '#04040c';
    ctx.fillRect(0, 0, w, h);
    // faction-tinted nebulae
    const neb = [[0.18, 0.28, 0.45, 'rgba(37,99,235,0.10)'], [0.82, 0.78, 0.5, 'rgba(185,28,28,0.10)'], [0.5, 0.62, 0.55, 'rgba(5,150,105,0.07)'], [0.62, 0.16, 0.3, 'rgba(249,115,22,0.06)']];
    for (const [x, y, r, c] of neb) {
        const g = ctx.createRadialGradient(x * w, y * h, 0, x * w, y * h, r * Math.max(w, h));
        g.addColorStop(0, c); g.addColorStop(1, 'rgba(0,0,0,0)');
        ctx.fillStyle = g; ctx.fillRect(0, 0, w, h);
    }
    // stars (square pixels, a few with cross glints)
    const starCount = Math.floor((w * h) / 2600);
    let seed = 1337;
    const rnd = () => { seed = (seed * 16807) % 2147483647; return seed / 2147483647; };
    for (let i = 0; i < starCount; i++) {
        const x = Math.floor(rnd() * w), y = Math.floor(rnd() * h), k = rnd();
        const a = 0.25 + k * 0.75;
        const tint = rnd();
        ctx.fillStyle = tint < 0.08 ? `rgba(160,200,255,${a})` : (tint < 0.14 ? `rgba(255,210,160,${a})` : `rgba(255,255,255,${a})`);
        const s = k > 0.93 ? 2 : 1;
        ctx.fillRect(x, y, s, s);
        if (k > 0.985) { ctx.fillStyle = `rgba(255,255,255,${a * 0.5})`; ctx.fillRect(x - 2, y, 5 + s - 1, 1); ctx.fillRect(x, y - 2, 1, 5 + s - 1); }
    }
    // banded pixel planet (upper right) — drawn at low resolution then scaled up
    const pr = Math.max(26, Math.min(w, h) * 0.075);
    const px = w * 0.86, py = h * 0.17;
    const lowR = 22;
    const pc = document.createElement('canvas'); pc.width = lowR * 2 + 4; pc.height = lowR * 2 + 4;
    const p = pc.getContext('2d');
    const bands = ['#1f3b35', '#2b5147', '#3a6b58', '#284a40', '#4a7a62', '#2f5a4c', '#1c342f'];
    for (let yy = 0; yy < lowR * 2; yy++) for (let xx = 0; xx < lowR * 2; xx++) {
        const dx = xx - lowR + 0.5, dy = yy - lowR + 0.5;
        const d = Math.sqrt(dx * dx + dy * dy);
        if (d > lowR) continue;
        const band = bands[Math.floor(((yy + Math.sin(xx * 0.35) * 1.5) / (lowR * 2)) * bands.length) % bands.length];
        p.fillStyle = band; p.fillRect(xx + 2, yy + 2, 1, 1);
        const lit = (dx * -0.6 + dy * -0.5) / lowR;
        if (lit < -0.35) { p.fillStyle = `rgba(0,0,0,${Math.min(0.75, (-lit - 0.35) * 1.3)})`; p.fillRect(xx + 2, yy + 2, 1, 1); }
        else if (lit > 0.55 && d > lowR - 2.2) { p.fillStyle = 'rgba(160,230,200,0.5)'; p.fillRect(xx + 2, yy + 2, 1, 1); }
    }
    ctx.save();
    const glow = ctx.createRadialGradient(px, py, pr * 0.8, px, py, pr * 1.6);
    glow.addColorStop(0, 'rgba(90,180,150,0.18)'); glow.addColorStop(1, 'rgba(90,180,150,0)');
    ctx.fillStyle = glow; ctx.beginPath(); ctx.arc(px, py, pr * 1.6, 0, Math.PI * 2); ctx.fill();
    ctx.imageSmoothingEnabled = false;
    ctx.drawImage(pc, px - pr - pr / lowR * 2, py - pr - pr / lowR * 2, pc.width * pr / lowR, pc.height * pr / lowR);
    ctx.restore();
}

// === DRAW TITLE ART ===
// v33: the SunCrush logo as true pixel art (per the title concept): a banded sun with
// alternating rays behind chunky extruded lettering, built at low resolution and
// scaled up with nearest-neighbour sampling, then given a soft bloom.
const TITLE_GLYPHS = {
    S: ['.#####', '##....', '##....', '.####.', '....##', '....##', '#####.'],
    U: ['##..##', '##..##', '##..##', '##..##', '##..##', '##..##', '.####.'],
    N: ['##..##', '###.##', '######', '##.###', '##..##', '##..##', '##..##'],
    C: ['.#####', '##....', '##....', '##....', '##....', '##....', '.#####'],
    R: ['#####.', '##..##', '##..##', '#####.', '##.##.', '##..##', '##..##'],
    H: ['##..##', '##..##', '##..##', '######', '##..##', '##..##', '##..##']
};
function drawTitleArt() {
    const canvas = document.getElementById('title-art');
    if (!canvas) return;
    const dpr = Math.min(2, window.devicePixelRatio || 1);
    const CW = 600, CH = 230;
    canvas.style.width = CW + 'px'; canvas.style.height = CH + 'px';
    canvas.width = CW * dpr; canvas.height = CH * dpr;
    const ctx = canvas.getContext('2d');
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    ctx.clearRect(0, 0, CW, CH);
