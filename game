// === CENTER CAMERA ON PLAYER BASE ===
function centerCameraOnPlayerBase() {
    const canvas = document.getElementById('game-canvas');
    if (!canvas) return;
    
    // Find player base
    const playerBase = gameState.buildings.find(b => b.type === 'base' && b.isPlayer);
    if (!playerBase) return;
    
    // Center camera on base
    const viewWidth = VIEW.w / gameState.camera.zoom;
    const viewHeight = VIEW.h / gameState.camera.zoom;
    gameState.camera.x = playerBase.x - viewWidth / 2;
    gameState.camera.y = playerBase.y - viewHeight / 2;
    clampCamera();
}

// === CLAMP CAMERA TO MAP BOUNDS ===
function clampCamera() {
const canvas = document.getElementById('game-canvas');
if (!canvas) return;

const viewWidth = VIEW.w / gameState.camera.zoom;
const viewHeight = VIEW.h / gameState.camera.zoom;

// Clamp camera position
gameState.camera.x = Math.max(0, Math.min(MAP_WIDTH - viewWidth, gameState.camera.x));
gameState.camera.y = Math.max(0, Math.min(MAP_HEIGHT - viewHeight, gameState.camera.y));

}

