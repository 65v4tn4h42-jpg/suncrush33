function addSimPlateau(simState, startX, startY, width, height) {
    for (let y = startY; y < startY + height && y < TILES_Y; y++) {
        for (let x = startX; x < startX + width && x < TILES_X; x++) {
            if (x >= 0 && y >= 0 && simState.terrainMap[y]) {
                simState.terrainMap[y][x] = TERRAIN.HIGH;
            }
        }
    }
    // Add ramps
    const rampY = startY + Math.floor(height / 2);
    if (startX > 0 && simState.terrainMap[rampY]) {
        simState.terrainMap[rampY][startX] = TERRAIN.RAMP;
    }
    if (startX + width - 1 < TILES_X && simState.terrainMap[rampY]) {
        simState.terrainMap[rampY][startX + width - 1] = TERRAIN.RAMP;
    }
}

