// === COORDINATE CONVERSION ===
function screenToWorld(screenX, screenY) {
const canvas = document.getElementById('game-canvas');
const rect = canvas.getBoundingClientRect();

const canvasX = (screenX - rect.left) * (VIEW.w / (rect.width || VIEW.w));
const canvasY = (screenY - rect.top) * (VIEW.h / (rect.height || VIEW.h));

return {
    x: canvasX / gameState.camera.zoom + gameState.camera.x,
    y: canvasY / gameState.camera.zoom + gameState.camera.y
};

}

function worldToScreen(worldX, worldY) {
return {
x: (worldX - gameState.camera.x) * gameState.camera.zoom,
y: (worldY - gameState.camera.y) * gameState.camera.zoom
};
}

// === FIND ENTITY AT POSITION ===
function findUnitAt(x, y, units) {
const clickRadius = 20;
for (let i = units.length - 1; i >= 0; i--) {
const unit = units[i];
if (distance(x, y, unit.x, unit.y) < clickRadius) {
return unit;
}
}
return null;
}

function findBuildingAt(x, y, buildings) {
for (let i = buildings.length - 1; i >= 0; i--) {
const b = buildings[i];
const halfSize = b.size / 2;
if (x >= b.x - halfSize && x <= b.x + halfSize &&
y >= b.y - halfSize && y <= b.y + halfSize) {
return b;
}
}
return null;
}

function findResourceAt(x, y) {
const clickRadius = 25;
for (const res of gameState.resources) {
if (distance(x, y, res.x, res.y) < clickRadius) {
return res;
}
}
return null;
}

