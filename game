.battle-loss {
color: #f87171;
}

.battle-draw {
color: #fbbf24;
}


/* =====================================================================
   v33: BEAUTIFICATION LAYER
   Faction-skinned console (StarCraft gives each race its own console),
   crisp pixel-art canvases, refined title screen. Appended last so it
   overrides the base rules without rewriting them.
   ===================================================================== */
:root {
    color-scheme: dark;   /* native selects and scrollbars follow the dark console */
    --ui-font: 'Segoe UI', 'Helvetica Neue', Tahoma, Geneva, Verdana, sans-serif;
    --c-bg1: #111827; --c-bg2: #070b12; --c-trim: #334155; --c-trim2: #1e293b;
    --c-accent: #38bdf8; --c-accent2: #f97316; --c-glow: rgba(56, 189, 248, 0.35);
    --c-screen: #04070c; --c-text: #cbd5e1; --c-dim: #64748b;
}
body { font-family: var(--ui-font); }

canvas#game-canvas, canvas#minimap-canvas, canvas.cmd-icon, canvas#portrait-canvas,
canvas.race-icon-canvas, canvas#title-art, .queue-item canvas, #unit-avatar-canvas, #building-avatar-canvas {
    image-rendering: pixelated;
    image-rendering: crisp-edges;
}

/* ---------- Title screen ---------- */
#title-screen { overflow-y: auto; justify-content: flex-start; padding: 1.2rem 0 2rem; }
#title-screen::before {
    content: '';
    background:
        radial-gradient(ellipse at 20% 20%, rgba(37, 99, 235, 0.10) 0%, transparent 50%),
        radial-gradient(ellipse at 80% 80%, rgba(185, 28, 28, 0.10) 0%, transparent 50%),
        radial-gradient(ellipse at 50% 50%, rgba(5, 150, 105, 0.06) 0%, transparent 60%);
}
#title-art { margin-top: 0.4em; margin-bottom: 0; filter: drop-shadow(0 6px 18px rgba(0, 0, 0, 0.6)); }
.game-subtitle { color: #8a7a64; letter-spacing: 0.7em; margin-bottom: 1.2em; font-weight: 600; }
.race-selection-label { color: #8b95a7; letter-spacing: 0.35em; }
.race-cards { gap: 1.1rem; margin-bottom: 1.1em; }
.race-card {
    width: 168px; height: auto; padding: 8px 8px 10px;
    background: linear-gradient(180deg, rgba(20, 24, 38, 0.96) 0%, rgba(8, 10, 18, 0.98) 100%);
    border: 2px solid #232a3a; border-radius: 10px;
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.55), inset 0 1px 0 rgba(255, 255, 255, 0.05);
    justify-content: flex-start;
}
.race-card::before {
    content: '';
    background: radial-gradient(circle at 50% 0%, var(--race-color, #333) 0%, transparent 70%);
    opacity: 0.18;
}
.race-card:hover { transform: translateY(-4px); border-color: var(--race-color, #666); box-shadow: 0 10px 30px rgba(0, 0, 0, 0.6), 0 0 22px var(--race-glow, transparent); }
.race-card:hover::before { opacity: 0.32; }
.race-card.selected { border-color: var(--race-color, #fff); box-shadow: 0 0 28px var(--race-glow, #fff), inset 0 0 18px rgba(255, 255, 255, 0.08); transform: translateY(-4px); }
.race-card.selected::before { opacity: 0.45; }
.race-card[data-race="coalition"] { --race-color: #3b82f6; --race-glow: rgba(59, 130, 246, 0.45); }
.race-card[data-race="swarm"] { --race-color: #10b981; --race-glow: rgba(16, 185, 129, 0.45); }
.race-card[data-race="ascended"] { --race-color: #ef4444; --race-glow: rgba(239, 68, 68, 0.45); }
.race-icon-canvas { width: 150px; height: 96px; margin-bottom: 0.45rem; border-radius: 6px; position: relative; z-index: 1; }
.race-name { color: var(--race-color, #fff); text-shadow: 0 0 10px var(--race-glow, transparent), 0 2px 0 rgba(0, 0, 0, 0.8); font-family: var(--ui-font); position: relative; z-index: 1; letter-spacing: 0.14em; }
.race-tagline { display: block; font-size: 0.62rem; color: #8b95a7; margin-top: 0.3rem; line-height: 1.3; position: relative; z-index: 1; }
.faction-desc[data-faction="coalition"] { --faction-color: #3b82f6; }
.faction-desc[data-faction="swarm"] { --faction-color: #10b981; }
.faction-desc[data-faction="ascended"] { --faction-color: #ef4444; }
.faction-desc.active { border-color: var(--faction-color, #555); box-shadow: 0 0 14px rgba(0, 0, 0, 0.4); }
.faction-desc .desc-name { color: var(--faction-color, #888); }
.option-select:focus { border-color: var(--selected-color, #4af); box-shadow: 0 0 8px var(--selected-glow, rgba(68, 170, 255, 0.2)); }
#start-button {
    background: linear-gradient(180deg, #1c2233 0%, #10141f 100%);
    border: 2px solid #2d3548; border-radius: 999px; color: #6b7280; letter-spacing: 0.3em;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.06);
}
#start-button.active {
    border-color: #fb923c; color: #fff7ed;
    background: linear-gradient(180deg, #f97316 0%, #c2410c 55%, #7c2d12 100%);
    text-shadow: 0 2px 0 rgba(67, 20, 7, 0.8);
    box-shadow: 0 0 25px rgba(249, 115, 22, 0.55), 0 0 60px rgba(249, 115, 22, 0.2), inset 0 1px 0 rgba(255, 237, 213, 0.6);
}
#start-button.active:hover { background: linear-gradient(180deg, #fb923c 0%, #ea580c 55%, #9a3412 100%); }
.game-options { border-color: rgba(120, 130, 160, 0.25); background: rgba(6, 8, 14, 0.55); backdrop-filter: blur(2px); max-width: 680px; }
.option-select { background: linear-gradient(180deg, #1b2130 0%, #10141d 100%); border-color: #2d3548; color: #d1d5db; }

/* ---------- In-game top HUD ---------- */
#top-hud {
    height: 42px; gap: 0.9rem; padding: 0 0.8rem;
    background: linear-gradient(180deg, var(--c-bg1) 0%, var(--c-bg2) 100%);
    border-bottom: 2px solid var(--c-trim);
    box-shadow: 0 2px 0 var(--c-trim2), 0 6px 14px rgba(0, 0, 0, 0.45);
}
.resource-display {
    gap: 0.4rem; padding: 3px 10px 3px 6px; border-radius: 999px;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0.55), rgba(0, 0, 0, 0.3));
    border: 1px solid rgba(255, 255, 255, 0.07);
    box-shadow: inset 0 1px 2px rgba(0, 0, 0, 0.6);
}
.resource-icon { width: 20px; height: 20px; }
.resource-value { font-variant-numeric: tabular-nums; font-size: 0.95rem; min-width: 44px; text-shadow: 0 1px 0 rgba(0, 0, 0, 0.8); }
#minerals-display { color: #93c5fd; }
#gas-display { color: #86efac; }
#supply-display { color: #fde68a; }
#game-timer { margin-left: auto; font-variant-numeric: tabular-nums; color: var(--c-text); font-size: 0.85rem; letter-spacing: 0.08em; padding: 3px 10px; border-radius: 6px; background: rgba(0, 0, 0, 0.35); border: 1px solid rgba(255, 255, 255, 0.06); }
#game-speed-control button, #pause-btn-bar {
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.08), rgba(255, 255, 255, 0.02));
    border: 1px solid var(--c-trim); color: var(--c-text); border-radius: 5px; padding: 3px 10px; font-weight: 700; letter-spacing: 0.1em; cursor: pointer;
}
#speed-slider { accent-color: var(--c-accent); }
#speed-value { color: var(--c-accent); }

/* ---------- Bottom console ---------- */
#bottom-panel {
    height: 188px; padding: 10px 10px 8px; gap: 10px; position: relative;
    background-color: var(--c-bg2);
    background-image: var(--c-texture, none), linear-gradient(180deg, var(--c-bg1) 0%, var(--c-bg2) 100%);
    background-size: auto, 100% 100%;
    border-top: 2px solid var(--c-trim);
    box-shadow: 0 -2px 0 var(--c-trim2), 0 -8px 18px rgba(0, 0, 0, 0.5);
    align-items: stretch;
}
#bottom-panel::before {
    content: ''; position: absolute; left: 0; right: 0; top: 0; height: 3px;
    background: linear-gradient(90deg, transparent, var(--c-accent2) 20%, var(--c-accent) 50%, var(--c-accent2) 80%, transparent);
    opacity: 0.7; pointer-events: none;
}
#minimap-container, #selection-panel, #info-panel {
    background: linear-gradient(180deg, rgba(0, 0, 0, 0.55), rgba(0, 0, 0, 0.72));
    border: 1px solid var(--c-trim);
    border-radius: 8px;
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.7), inset 0 2px 10px rgba(0, 0, 0, 0.8), 0 1px 0 rgba(255, 255, 255, 0.05);
}
#minimap-container { width: 184px; padding: 6px; justify-content: flex-start; }
#minimap-label { color: var(--c-dim); margin-bottom: 3px; font-size: 0.58rem; letter-spacing: 0.22em; }
#minimap-canvas { width: 170px; height: 128px; border: 1px solid rgba(0, 0, 0, 0.9); border-radius: 3px; box-shadow: 0 0 0 1px var(--c-trim2), 0 0 10px var(--c-glow); background: #020305; }
#minimap-zoom-btn { top: 4px; right: 4px; width: 18px; height: 18px; font-size: 10px; background: rgba(0, 0, 0, 0.7); border-color: var(--c-trim); }
#selection-panel { width: 200px; padding: 8px; }
#portrait-container {
    width: 70px; height: 70px; border-radius: 6px; position: relative; overflow: hidden;
    background: radial-gradient(circle at 50% 40%, var(--c-glow) 0%, rgba(0, 0, 0, 0.9) 75%);
    border: 1px solid var(--c-trim); box-shadow: inset 0 0 12px rgba(0, 0, 0, 0.9), 0 0 0 1px rgba(0, 0, 0, 0.8);
}
#portrait-container::after {
    content: ''; position: absolute; inset: 0; pointer-events: none;
    background: repeating-linear-gradient(180deg, rgba(255, 255, 255, 0.05) 0 1px, transparent 1px 3px);
    mix-blend-mode: overlay;
}
#portrait-canvas { width: 64px; height: 64px; }
#selection-name { color: #f1f5f9; font-size: 0.86rem; text-shadow: 0 1px 0 rgba(0, 0, 0, 0.9); }
#selection-type { color: var(--c-accent); font-size: 0.66rem; letter-spacing: 0.06em; }
#selection-stats { color: var(--c-dim); font-size: 0.64rem; }
.bar-container { height: 7px; background: rgba(0, 0, 0, 0.6); border: 1px solid rgba(0, 0, 0, 0.8); border-radius: 2px; box-shadow: inset 0 1px 2px rgba(0, 0, 0, 0.8); }
#health-bar { background: linear-gradient(180deg, #6ee77a 0%, #22b23a 60%, #15802a 100%); }
#shield-bar { background: linear-gradient(180deg, #9cc8ff 0%, #4d8ef6 60%, #1f4fbf 100%); }

#command-card { max-width: 336px; gap: 4px; align-content: center; }
.cmd-button {
    min-height: 0; border-radius: 6px; padding: 2px 2px 12px;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.07) 0%, rgba(255, 255, 255, 0.01) 45%, rgba(0, 0, 0, 0.25) 100%), var(--c-bg1);
    border: 1px solid var(--c-trim);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.08), inset 0 -2px 0 rgba(0, 0, 0, 0.45), 0 2px 4px rgba(0, 0, 0, 0.5);
}
.cmd-button:hover:not(.disabled):not(.empty) {
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.14) 0%, rgba(255, 255, 255, 0.03) 45%, rgba(0, 0, 0, 0.2) 100%), var(--c-bg1);
    border-color: var(--c-accent); box-shadow: 0 0 10px var(--c-glow), inset 0 1px 0 rgba(255, 255, 255, 0.12);
}
.cmd-button.empty { background: rgba(0, 0, 0, 0.35); border-color: rgba(255, 255, 255, 0.04); box-shadow: inset 0 1px 3px rgba(0, 0, 0, 0.7); }
.cmd-button.highlighted { border-color: var(--c-accent); box-shadow: 0 0 12px var(--c-glow); }
.cmd-button.tech-locked { border-color: #7a5a20; filter: saturate(0.25) brightness(0.8); }
.cmd-label { color: #e2e8f0; font-size: 0.56rem; line-height: 10px; margin-top: 0; text-shadow: 0 1px 0 rgba(0, 0, 0, 0.9); }
.cmd-hotkey { color: var(--c-accent); background: rgba(0, 0, 0, 0.6); font-size: 0.52rem; border-radius: 3px; padding: 0 3px; }
.cmd-cost { font-size: 0.5rem; background: rgba(0, 0, 0, 0.6); border-radius: 3px; }
.cmd-icon { width: 28px; height: 28px; filter: drop-shadow(0 1px 0 rgba(0, 0, 0, 0.8)); }
#info-panel { width: 210px; }
#info-panel-header { color: var(--c-dim); letter-spacing: 0.2em; border-bottom-color: var(--c-trim) !important; }

/* Faction skins */
#bottom-panel.race-coalition, #top-hud.race-coalition {
    --c-bg1: #1a2436; --c-bg2: #0a101b; --c-trim: #3b4d6b; --c-trim2: #111a2a;
    --c-accent: #38bdf8; --c-accent2: #f97316; --c-glow: rgba(56, 189, 248, 0.32); --c-text: #dbe7f5; --c-dim: #7b8ba3;
}
#bottom-panel.race-swarm, #top-hud.race-swarm {
    --c-bg1: #15261a; --c-bg2: #07120a; --c-trim: #2f5a33; --c-trim2: #0b1d0e;
    --c-accent: #a3e635; --c-accent2: #f472b6; --c-glow: rgba(163, 230, 53, 0.28); --c-text: #dcf7d6; --c-dim: #6f9a74;
}
#bottom-panel.race-ascended, #top-hud.race-ascended {
    --c-bg1: #2a1414; --c-bg2: #100707; --c-trim: #6b2a22; --c-trim2: #1f0a08;
    --c-accent: #22d3ee; --c-accent2: #f59e0b; --c-glow: rgba(34, 211, 238, 0.28); --c-text: #fbe3dc; --c-dim: #a07a70;
}
#bottom-panel.race-swarm #minimap-container, #bottom-panel.race-swarm #selection-panel, #bottom-panel.race-swarm #info-panel { border-radius: 14px; }
#bottom-panel.race-ascended .cmd-button { border-radius: 3px; }

/* Messages & legend */
#message-log .game-message { text-shadow: 0 1px 2px rgba(0, 0, 0, 0.9); }
/* overlays sit just above the console, whatever height it has (v32 assumed 140 px) */
:root { --console-h: 188px; }
#message-log, #terrain-legend { bottom: calc(var(--console-h) + 10px); }
#drag-indicator { bottom: calc(var(--console-h) + 20px); }
#terrain-legend { left: 10px; right: auto; }   /* clear of the message log on the right */
#terrain-legend-toggle { background: rgba(0, 0, 0, 0.55); border-radius: 6px; }

/* Small screens: keep the console usable */
@media (max-height: 640px) {
    :root { --console-h: 150px; }
    #bottom-panel { height: 150px; padding: 6px; gap: 6px; }
    #minimap-canvas { width: 150px; height: 108px; }
    #minimap-container { width: 162px; }
    .cmd-button { padding-bottom: 11px; }
    .cmd-label { display: none; }
    #portrait-container { width: 56px; height: 56px; }
    #portrait-canvas { width: 52px; height: 52px; }
}

/* v33: multi-selection wireframes (StarCraft), damage-type colours, order status */
#selection-grid { display: grid; grid-template-columns: repeat(6, 27px); gap: 3px; margin: 6px 0 2px; }
#selection-grid.hidden { display: none; }
.sel-cell { width: 27px; height: 27px; border-radius: 4px; background: rgba(0, 0, 0, 0.55); border: 1px solid var(--c-trim); position: relative; cursor: pointer; box-shadow: inset 0 0 6px rgba(0, 0, 0, 0.8); }
.sel-cell canvas { position: absolute; left: 1px; top: 0; }
.sel-cell .hp { position: absolute; left: 2px; right: 2px; bottom: 2px; height: 2px; background: #111; }
.sel-cell .hp i { display: block; height: 100%; }
.sel-cell:hover { box-shadow: 0 0 6px var(--c-glow), inset 0 0 6px rgba(0, 0, 0, 0.8); }
.sel-more { color: var(--c-dim); font-size: 0.62rem; align-self: center; text-align: center; }
#selection-panel.multi #selection-stats, #selection-panel.multi #health-bars { display: none; }
#selection-panel.multi #selection-type { white-space: normal; line-height: 1.25; }
.dmg-normal { color: #e2e8f0; }
.dmg-explosive { color: #fb923c; }
.dmg-concussive { color: #facc15; }
.info-status.hold { color: #fde047; }
.info-status.patrol { color: #7dd3fc; }
.cmd-button.unpowered { border-color: #7a5a20; filter: saturate(0.3) brightness(0.75); }
.queue-item canvas { width: 20px; height: 20px; }
#portrait-canvas { width: 64px; height: 64px; }

/* v33: score screen + controls card */
#game-over-emblem { width: 150px; height: 96px; border-radius: 8px; margin-bottom: 0.6rem; box-shadow: 0 0 30px rgba(0, 0, 0, 0.8); }
#game-over-emblem.victory { box-shadow: 0 0 34px rgba(74, 222, 128, 0.45), 0 0 0 2px rgba(74, 222, 128, 0.6); }
#game-over-emblem.defeat { box-shadow: 0 0 34px rgba(248, 113, 113, 0.4), 0 0 0 2px rgba(248, 113, 113, 0.55); filter: grayscale(0.55) brightness(0.8); }
.score-table { border-collapse: separate; border-spacing: 14px 3px; margin: 0.4rem auto 0.2rem; font-size: 0.78rem; color: #94a3b8; }
.score-table th { color: #e2e8f0; font-size: 0.72rem; letter-spacing: 0.18em; text-transform: uppercase; border-bottom: 1px solid rgba(255, 255, 255, 0.12); padding-bottom: 3px; }
.score-table td { text-align: left; white-space: nowrap; }
.score-table b { color: #fde68a; font-variant-numeric: tabular-nums; margin-left: 4px; }
.pause-controls { margin-top: 1rem; padding: 0.7rem 1rem; border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 8px; background: rgba(0, 0, 0, 0.45); color: #94a3b8; font-size: 0.72rem; line-height: 1.9; text-align: left; }
.pause-controls kbd { display: inline-block; min-width: 1.2em; padding: 0 5px; border-radius: 4px; border: 1px solid #475569; border-bottom-width: 2px; background: #111827; color: #e2e8f0; font-family: inherit; font-size: 0.68rem; line-height: 1.5; text-align: center; }

/* v33: narrow screens (phones) — the base layout's compact console, restated after the skin */
@media (max-width: 600px) {
    :root { --console-h: 128px; }
    #bottom-panel { height: 128px; padding: 4px; gap: 4px; }
    #selection-panel { width: 104px; padding: 4px; }
    #portrait-container { width: 42px; height: 42px; }
    #portrait-canvas { width: 38px; height: 38px; }
    #selection-grid { grid-template-columns: repeat(3, 27px); }
    #command-card { max-width: 210px; gap: 2px; }
    .cmd-button { padding-bottom: 10px; }
    .cmd-label { display: none; }
    #minimap-container { width: 100px; padding: 4px; }
    #minimap-canvas { width: 90px; height: 70px; }
    #info-panel { display: none; }        /* the command card needs the width on phones */
    #game-timer { display: none; }
    .race-card { width: 140px; }
    .race-icon-canvas { width: 124px; height: 80px; }
}
</style>

</head>
