    }

    // flat ground decals, painted at world-pixel resolution (units walk over them)
    function makeDecals(theme, S) {
        const out = {};
        const mk = (key, w, h, fn) => {
            out[key] = [];
            for (let v = 0; v < 3; v++) {
                const cv = document.createElement('canvas'); cv.width = w; cv.height = h;
                const c = cv.getContext('2d');
                const r = (k) => hash(k, v, key.length * 13);
