}

@keyframes message-fade {
0%, 70% { opacity: 1; }
100% { opacity: 0; }
}

/* ===== TOOLTIP ===== */
#tooltip {
position: absolute;
background: rgba(10, 10, 18, 0.95);
border: 1px solid #444;
border-radius: 6px;
padding: 10px;
max-width: 220px;
pointer-events: none;
z-index: 50;
display: none;
}

#tooltip.visible {
display: block;
}

.tooltip-title {
font-weight: bold;
color: #fff;
margin-bottom: 4px;
}

.tooltip-cost {
font-size: 0.8rem;
color: #4af;
margin-bottom: 6px;
}

.tooltip-desc {
font-size: 0.75rem;
color: #aaa;
line-height: 1.4;
}

.tooltip-stats {
font-size: 0.7rem;
color: #888;
margin-top: 6px;
